<Item class="ModuleScript" referent="RBXJ0000001">
<Properties>
<string name="Name">Alas</string>
<ProtectedString name="Source"><![CDATA[-- Alas de «+1 de lanzamiento por segundo» (Lua puro, probado con lupa): datos, requisitos y bonus. Maikol (30/10): las alas dan un
-- multiplicador de resistencia y de impulso «mucho mas notorio que las mascotas», y escalan con los rebirths; se multiplican con los
-- bonus de las mascotas. Requisitos de Maikol: iniciales en el 3.er lanzamiento, roboticas con 3 dias seguidos, avanzadas con
-- puntos, misiones o cofres (aqui: 10 cofres, o comprarlas). La interfaz (client/Inventario.client.lua) lee LISTA con
-- {id, nombre, requisito, precio}. CIFRAS PROVISIONALES. Modelos: Codex (iniciales, roboticas), Coordinador (avanzadas v0.2).
local A = {}

A.LISTA = {
	{ id = "iniciales", nombre = "Alas iniciales", requisito = "Tu 3.er lanzamiento", precio = 0, impulso = 20, resistencia = 50,
		pide = { lanzamientos = 3 } },
	{ id = "roboticas", nombre = "Alas robóticas", requisito = "Juega 3 días seguidos", precio = 0, impulso = 40, resistencia = 100,
		pide = { diasSeguidos = 3 } },
	{ id = "avanzadas", nombre = "Alas avanzadas", requisito = "Atrapa 10 cofres o cómpralas", precio = 25000, impulso = 80,
		resistencia = 200, pide = { cofres = 10 } },
}
A.PORREBIRTH = 0.25 -- cada rebirth sube un 25% lo que dan las alas

local porId = {}
for _, a in ipairs(A.LISTA) do porId[a.id] = a end

function A.get(id)
	return porId[id]
end

-- Multiplicadores de unas alas con cierto numero de rebirths: { impulso, resistencia } (1 = sin alas).
function A.bonus(id, rebirths)
	local a = porId[id]
	if not a then return { impulso = 1, resistencia = 1 } end
	local f = 1 + A.PORREBIRTH * (rebirths or 0)
	return { impulso = 1 + a.impulso / 100 * f, resistencia = 1 + a.resistencia / 100 * f }
end

-- ¿Cumple los requisitos? progreso = { lanzamientos, diasSeguidos, cofres }.
function A.desbloqueada(id, progreso)
	local a = porId[id]
	if not a then return false end
	for k, n in pairs(a.pide) do
		if (progreso[k] or 0) < n then return false end
	end
	return true
end

-- Bonus de un vuelo: los de las mascotas (Mascotas.multiplicadores) por los de las alas (A.bonus).
function A.combinar(mascotas, alas)
	local t = {}
	for k, v in pairs(mascotas) do t[k] = v end
	t.impulso = (t.impulso or 1) * (alas.impulso or 1)
	t.resistencia = (t.resistencia or 1) * (alas.resistencia or 1)
	return t
end

return A
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000002">
<Properties>
<string name="Name">Datos</string>
<ProtectedString name="Source"><![CDATA[-- Datos guardados de un jugador de «+1 de lanzamiento por segundo» (Lua puro, probado con lupa; el DataStore lo lleva
-- server/Guardado.lua). Tres cosas: los datos por defecto y la limpieza de lo que se carga (tipos, negativos, mascotas que no
-- existen, mas de 3 equipadas...), el bloqueo de sesion (un servidor «toma» los datos del jugador; otro no los pisa salvo que el
-- bloqueo caduque, porque el primero se cayo) y la racha de dias seguidos (alas roboticas). Lo guardado en el DataStore es
-- { dato = {...}, bloqueo = { sesion, t } }.
local D = {}

D.VERSION = 1

function D.nuevo()
	return { version = D.VERSION, potencia = 0, dinero = 0, exp = 0, rebirths = 0, cofres = 0, lanzamientos = 0,
		diasSeguidos = 0, ultimoDia = -1, inventario = { mascotas = {}, equipadas = {}, alas = {}, alaEquipada = nil } }
end

local function numero(x, minimo)
	if type(x) ~= "number" or x ~= x or x == math.huge or x == -math.huge then return minimo end -- nil, texto, NaN, infinito
	return math.max(minimo, x)
end

-- Limpia unos datos cargados: lo que falte o venga mal se queda por defecto. M = Mascotas, A = Alas.
function D.limpiar(d, M, A)
	local n = D.nuevo()
	if type(d) ~= "table" then return n end
	for _, k in ipairs({ "potencia", "dinero", "exp", "rebirths", "cofres", "lanzamientos", "diasSeguidos" }) do
		n[k] = numero(d[k], 0)
	end
	for _, k in ipairs({ "rebirths", "cofres", "lanzamientos", "diasSeguidos" }) do n[k] = math.floor(n[k]) end
	n.ultimoDia = math.floor(numero(d.ultimoDia, -1))
	local inv = type(d.inventario) == "table" and d.inventario or {}
	if type(inv.mascotas) == "table" then
		for id, c in pairs(inv.mascotas) do
			if type(id) == "string" and M.get(id) and type(c) == "number" and c >= 1 then n.inventario.mascotas[id] = math.floor(c) end
		end
	end
	local usadas = {}
	if type(inv.equipadas) == "table" then
		for _, id in ipairs(inv.equipadas) do
			if #n.inventario.equipadas < M.MAX_EQUIPADAS and (usadas[id] or 0) < (n.inventario.mascotas[id] or 0) then
				usadas[id] = (usadas[id] or 0) + 1
				n.inventario.equipadas[#n.inventario.equipadas + 1] = id
			end
		end
	end
	local tiene = {}
	if type(inv.alas) == "table" then
		for _, id in ipairs(inv.alas) do
			if type(id) == "string" and A.get(id) and not tiene[id] then
				tiene[id] = true
				n.inventario.alas[#n.inventario.alas + 1] = id
			end
		end
	end
	if tiene[inv.alaEquipada] then n.inventario.alaEquipada = inv.alaEquipada end
	return n
end

-- Bloqueo de sesion, dentro del UpdateAsync al cargar: devuelve true y lo que hay que guardar (con el bloqueo de esta sesion), o
-- false si otra sesion lo tiene y su bloqueo no ha caducado (no se escribe nada).
function D.tomar(guardado, sesion, ahora, caduca)
	if type(guardado) ~= "table" or type(guardado.dato) ~= "table" then
		return true, { dato = D.nuevo(), bloqueo = { sesion = sesion, t = ahora } } -- jugador nuevo
	end
	local b = guardado.bloqueo
	if type(b) == "table" and b.sesion ~= sesion and type(b.t) == "number" and ahora - b.t < caduca then return false end
	return true, { dato = guardado.dato, bloqueo = { sesion = sesion, t = ahora } }
end

-- Al guardar: solo si el bloqueo sigue siendo de esta sesion (o no hay); soltar = al salir el jugador. Devuelve false si otra sesion
-- se lo quedo (este servidor ya no debe escribir).
function D.escribir(guardado, sesion, dato, ahora, soltar)
	local b = type(guardado) == "table" and guardado.bloqueo
	if type(b) == "table" and b.sesion ~= sesion then return false end
	return true, { dato = dato, bloqueo = (not soltar) and { sesion = sesion, t = ahora } or nil }
end

-- Racha de dias: hoy = dias desde 1970 (os.time() // 86400). Devuelve true si es un dia nuevo.
function D.registrarDia(d, hoy)
	if d.ultimoDia == hoy then return false end
	d.diasSeguidos = (d.ultimoDia == hoy - 1) and d.diasSeguidos + 1 or 1
	d.ultimoDia = hoy
	return true
end

return D
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000003">
<Properties>
<string name="Name">Efectos</string>
<ProtectedString name="Source"><![CDATA[-- Efectos visuales de «+1 de lanzamiento por segundo»: especificaciones de ParticleEmitter (datos puros, sin API de Roblox) para
-- lanzamiento, estela de vuelo, aleteo, recoger aro, golpe, rebirth y fuego del fenix. Valores PROVISIONALES: se ajustan viendolos.
-- Colores vivos (estilo Steal a Brainrot). Cada efecto: count (rafaga) o rate (continuo), vida, velocidad, tamano, colores, aceleracion.
local E = {}

E.TIPOS = {
	lanzamiento = { count = 60, life = { 0.5, 1.0 }, speed = { 25, 55 }, size = { 2.5, 0 }, spread = 180, accel = { 0, -30, 0 }, colors = { "#fff3b0", "#ffb347", "#ff5d8f" }, light = 0.4 },
	estela = { rate = 40, life = { 0.5, 0.9 }, speed = { 0, 2 }, size = { 1.6, 0 }, spread = 20, accel = { 0, 0, 0 }, colors = { "#ffffff", "#bdeaff" }, light = 0.3 },
	aleteo = { count = 8, life = { 0.4, 0.7 }, speed = { 4, 9 }, size = { 0.9, 0 }, spread = 60, accel = { 0, -8, 0 }, colors = { "#ffffff", "#d8f1ff" }, light = 0.2 },
	aro = { count = 36, life = { 0.5, 0.9 }, speed = { 14, 28 }, size = { 1.6, 0 }, spread = 180, accel = { 0, -4, 0 }, colors = { "#ffd23f", "#fff7e0", "#3ddc97" }, light = 0.6 },
	golpe = { count = 14, life = { 0.25, 0.45 }, speed = { 12, 22 }, size = { 1.4, 0 }, spread = 180, accel = { 0, 0, 0 }, colors = { "#ffffff", "#ff5d8f" }, light = 0.5 },
	rebirth = { count = 120, life = { 0.8, 1.6 }, speed = { 10, 30 }, size = { 3, 0 }, spread = 180, accel = { 0, 6, 0 }, colors = { "#7c5cff", "#3ddc97", "#ffd23f" }, light = 0.7 },
	fuego_fenix = { rate = 70, life = { 0.4, 0.8 }, speed = { 3, 8 }, size = { 2.2, 0 }, spread = 25, accel = { 0, 10, 0 }, colors = { "#fff3b0", "#ff9d00", "#ff3d00" }, light = 0.8 },
	-- Auras de huevos/mascotas por rareza (continuas, sobre el modelo). Comun: sin aura.
	aura_poco_comun = { rate = 6, life = { 0.8, 1.2 }, speed = { 0, 1 }, size = { 0.6, 0 }, spread = 180, accel = { 0, 1, 0 }, colors = { "#8fe38f", "#d8ffd8" }, light = 0.2 },
	aura_raro = { rate = 14, life = { 0.8, 1.4 }, speed = { 0, 2 }, size = { 0.9, 0 }, spread = 180, accel = { 0, 2, 0 }, colors = { "#4da6ff", "#d8f1ff" }, light = 0.4 },
	aura_legendario = { rate = 26, life = { 1.0, 1.6 }, speed = { 1, 3 }, size = { 1.2, 0 }, spread = 180, accel = { 0, 3, 0 }, colors = { "#ffd23f", "#fff7e0", "#ff9d00" }, light = 0.6 },
	aura_mitico = { rate = 45, life = { 1.0, 1.8 }, speed = { 1, 4 }, size = { 1.6, 0 }, spread = 180, accel = { 0, 4, 0 }, colors = { "#7c5cff", "#ff5d8f", "#bdeaff", "#ffd23f" }, light = 0.9 },
}

-- Orden fijo para las pruebas (sin depender de pairs)
E.ORDEN = { "lanzamiento", "estela", "aleteo", "aro", "golpe", "rebirth", "fuego_fenix", "aura_poco_comun", "aura_raro", "aura_legendario", "aura_mitico" }

return E
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000004">
<Properties>
<string name="Name">Encuentros</string>
<ProtectedString name="Source"><![CDATA[-- Encuentros del vuelo de «+1 de lanzamiento por segundo» (Lua puro, probado con lupa): aros que se cruzan, enemigos que se golpean y
-- cofres voladores que huyen. Faciles a proposito: el aro cuenta con un margen por fuera del borde, el golpe alcanza al enemigo vivo
-- mas cercano a 12 studs y el cofre huye algo mas rapido que el vuelo normal (hay que usar el boost para pillarlo, pero con boost se
-- pilla en un par de segundos). Los enemigos van repartidos por zona, alternando lados, separados entre si y lejos de los aros: sin
-- saturar. Coordenadas de Roblox; el vuelo va hacia -Z. Vectores como tablas {x, y, z}.
local E = {}

E.CFG = {
	margenAro = 1.5, -- studs por fuera del radio que aun cuentan
	alcance = 12, -- golpe: distancia maxima al enemigo (delante, o como mucho 4 studs detras)
	reaparicion = 15, -- segundos hasta que vuelve un enemigo golpeado
	cofreDistancia = 140, -- aparece por delante del jugador
	cofreAltura = 18,
	cofreVista = 55, -- a esta distancia empieza a huir
	cofreHuida = 52, -- studs/s huyendo: mas que Vuelo.CFG.velocidadBase (40), menos que velocidadBoost (70)
	cofreCalma = 22, -- studs/s sin nadie cerca
	cofreEspera = 170, -- si se adelanta tanto, espera
	cofreAtrapar = 7,
	cofresPorVuelo = 2,
	separacion = 40, -- entre enemigos
	lejosDeAros = 18, -- de un aro (sumado a su radio)
	-- enemigos por zona (studs hacia -Z), con los tipos de enemigos-v02: globo en la Pradera, nube en el Mar de Nubes,
	-- nubarron en la Tormenta, cometa en el Cielo alto, ovni y meteorito en el Espacio
	zonas = {
		{ desde = 40, hasta = 172, tipos = { "globo" }, cantidad = 2 },
		{ desde = 172, hasta = 532, tipos = { "nube", "globo" }, cantidad = 5 },
		{ desde = 532, hasta = 892, tipos = { "nubarron", "nube" }, cantidad = 5 },
		{ desde = 892, hasta = 1252, tipos = { "cometa" }, cantidad = 5 },
		{ desde = 1252, hasta = 1612, tipos = { "ovni", "meteorito" }, cantidad = 5 },
	},
}

local function d2(a, b)
	return (a.x - b.x) ^ 2 + (a.y - b.y) ^ 2 + (a.z - b.z) ^ 2
end

-- ¿El tramo a -> b atraviesa el aro (de cara a -Z)? Cruza su plano z y en ese punto queda dentro del radio + margen.
function E.cruzaAro(a, b, aro, cfg)
	cfg = cfg or E.CFG
	local c = aro.centro
	if a.z == b.z or (a.z - c.z) * (b.z - c.z) > 0 then return false end
	local t = (c.z - a.z) / (b.z - a.z)
	local x, y = a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t
	return (x - c.x) ^ 2 + (y - c.y) ^ 2 <= (aro.radio + cfg.margenAro) ^ 2
end

-- El enemigo vivo mas cercano al alcance del golpe desde pos. Devuelve su indice o nil.
function E.enemigoAlAlcance(pos, enemigos, cfg)
	cfg = cfg or E.CFG
	local mejor, dmin = nil, cfg.alcance ^ 2
	for i, en in ipairs(enemigos) do
		if en.vivo and en.pos.z - pos.z < 4 then
			local d = d2(en.pos, pos)
			if d <= dmin then mejor, dmin = i, d end
		end
	end
	return mejor
end

-- Coloca los enemigos de todas las zonas. aros: lista de {centro, radio}; aleatorio(): numero en [0, 1).
-- Devuelve lista de {tipo, pos, vivo}. Si un hueco no cabe tras 12 intentos, se queda sin enemigo (mejor de menos que saturar).
function E.colocarEnemigos(aros, aleatorio, cfg)
	cfg = cfg or E.CFG
	local lista = {}
	local function libre(p)
		for _, a in ipairs(aros) do
			if d2(p, a.centro) < (cfg.lejosDeAros + a.radio) ^ 2 then return false end
		end
		for _, en in ipairs(lista) do
			if d2(p, en.pos) < cfg.separacion ^ 2 then return false end
		end
		return true
	end
	for _, z in ipairs(cfg.zonas) do
		local tramo = (z.hasta - z.desde) / z.cantidad
		for k = 1, z.cantidad do
			local lado = (k % 2 == 0) and 1 or -1
			for _ = 1, 12 do
				local p = { x = lado * (6 + aleatorio() * 18), y = 10 + aleatorio() * 18,
					z = -(z.desde + (k - 0.5) * tramo + (aleatorio() - 0.5) * tramo * 0.5) }
				if libre(p) then
					lista[#lista + 1] = { tipo = z.tipos[(k - 1) % #z.tipos + 1], pos = p, vivo = true }
					break
				end
			end
		end
	end
	return lista
end

-- Cofre volador por delante de pos.
function E.nuevoCofre(pos, cfg)
	cfg = cfg or E.CFG
	return { pos = { x = 0, y = cfg.cofreAltura, z = pos.z - cfg.cofreDistancia }, vel = cfg.cofreCalma, t = 0, atrapado = false }
end

-- Mueve el cofre dt segundos segun donde esta el jugador (pj). Devuelve true si el jugador lo atrapa en este paso.
function E.pasoCofre(c, dt, pj, cfg)
	cfg = cfg or E.CFG
	if c.atrapado then return false end
	if math.sqrt(d2(c.pos, pj)) <= cfg.cofreAtrapar then
		c.atrapado = true
		return true
	end
	c.t = c.t + dt
	local delante = pj.z - c.pos.z -- > 0: el cofre va por delante
	local objetivo = math.sqrt(d2(c.pos, pj)) < cfg.cofreVista and cfg.cofreHuida or cfg.cofreCalma
	if delante > cfg.cofreEspera or delante < -10 then objetivo = 0 end -- muy adelantado, o ya lo pasaron: espera
	c.vel = c.vel + (objetivo - c.vel) * (1 - math.exp(-2.5 * dt))
	c.pos.z = c.pos.z - c.vel * dt
	c.pos.x = math.sin(c.t * 0.8) * 12 -- zigzag suave dentro del carril
	c.pos.y = cfg.cofreAltura + math.sin(c.t * 1.3) * 3
	return false
end

return E
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000005">
<Properties>
<string name="Name">Inventario</string>
<ProtectedString name="Source"><![CDATA[-- Inventario de un jugador de «+1 de lanzamiento por segundo» (Lua puro, probado con lupa): mascotas por cantidad, hasta 3 equipadas
-- (se puede repetir una si tienes varias), huevos que se pagan con dinero, alas compradas o desbloqueadas y la equipada. Lo usa el
-- servidor (server/Partida.server.lua) y se manda a la interfaz con la forma acordada con Linux 2.0 (MAS1_Inventario). El fenix solo
-- se da con Robux (I.darFenix, sin producto configurado todavia). Cada funcion que cambia algo devuelve ok y, si no, el motivo
-- (texto para MAS1_Aviso).
local I = {}

function I.nuevo()
	return { mascotas = {}, equipadas = {}, alas = {}, alaEquipada = nil }
end

local function cuantas(lista, id)
	local n = 0
	for _, x in ipairs(lista) do
		if x == id then n = n + 1 end
	end
	return n
end

-- Abre un huevo pagando con dinero. Devuelve ok, dinero que queda, mascota (de Mascotas.LISTA), nueva (primera vez) o false, motivo.
function I.abrirHuevo(M, inv, dinero, rareza, rng)
	local precio = M.PRECIO_HUEVO[rareza]
	if not precio then return false, "Ese huevo no existe" end
	if dinero < precio then return false, string.format("Te falta dinero: el huevo cuesta %d", precio) end
	local p = M.abrirHuevo(rareza, rng)
	if not p then return false, "Ese huevo no existe" end
	local nueva = (inv.mascotas[p.id] or 0) == 0
	inv.mascotas[p.id] = (inv.mascotas[p.id] or 0) + 1
	return true, dinero - precio, p, nueva
end

function I.darFenix(inv) -- compra con Robux (MarketplaceService.ProcessReceipt): hito 4 sin producto configurado
	inv.mascotas.fenix = (inv.mascotas.fenix or 0) + 1
end

function I.equipar(M, inv, id)
	if not M.get(id) then return false, "Esa mascota no existe" end
	if #inv.equipadas >= M.MAX_EQUIPADAS then return false, string.format("Ya llevas %d mascotas", M.MAX_EQUIPADAS) end
	if cuantas(inv.equipadas, id) >= (inv.mascotas[id] or 0) then return false, "No tienes otra de esas" end
	inv.equipadas[#inv.equipadas + 1] = id
	return true
end

function I.desequipar(inv, id)
	for i, x in ipairs(inv.equipadas) do
		if x == id then
			table.remove(inv.equipadas, i)
			return true
		end
	end
	return false, "No llevas esa mascota"
end

-- La mascota que se ve en el HUD: la de mas rareza de las equipadas (nil si no hay).
function I.principal(M, inv)
	local orden = {}
	for i, r in ipairs(M.RAREZAS) do orden[r] = i end
	local mejor
	for _, id in ipairs(inv.equipadas) do
		local p = M.get(id)
		if p and (not mejor or orden[p.rareza] > orden[mejor.rareza]) then mejor = p end
	end
	return mejor
end

-- Alas: comprarlas con dinero, conseguirlas al cumplir el requisito (Alas.desbloqueada) y equiparlas.
function I.tieneAla(inv, id)
	for _, x in ipairs(inv.alas) do
		if x == id then return true end
	end
	return false
end

function I.darAla(inv, id)
	if I.tieneAla(inv, id) then return false end
	inv.alas[#inv.alas + 1] = id
	return true
end

function I.comprarAla(Alas, inv, dinero, id)
	local a = Alas.get(id)
	if not a then return false, "Esas alas no existen" end
	if I.tieneAla(inv, id) then return false, "Ya tienes esas alas" end
	if not a.precio or a.precio <= 0 then return false, "Esas alas no se compran: " .. a.requisito end
	if dinero < a.precio then return false, string.format("Te falta dinero: cuestan %d", a.precio) end
	I.darAla(inv, id)
	return true, dinero - a.precio
end

function I.equiparAla(inv, id)
	if not I.tieneAla(inv, id) then return false, "No tienes esas alas" end
	inv.alaEquipada = id
	return true
end

function I.desequiparAla(inv)
	inv.alaEquipada = nil
	return true
end

-- Copia para la interfaz (MAS1_Inventario) y para guardar: solo datos, sin referencias compartidas.
function I.copia(inv)
	local m, e, a = {}, {}, {}
	for k, v in pairs(inv.mascotas) do m[k] = v end
	for i, v in ipairs(inv.equipadas) do e[i] = v end
	for i, v in ipairs(inv.alas) do a[i] = v end
	return { mascotas = m, equipadas = e, alas = a, alaEquipada = inv.alaEquipada }
end

return I
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000006">
<Properties>
<string name="Name">Manejo</string>
<ProtectedString name="Source"><![CDATA[-- Manejo del vuelo de «+1 de lanzamiento por segundo» (Lua puro, probado con lupa): a que velocidad volar en cada fotograma segun los
-- mandos. Lo usa el cliente (client/VueloControl.client.lua) para mover su personaje; el servidor valida con los mismos limites de
-- Vuelo.CFG (src/Partida.lua). Pensado para que sea facil y se sienta bien:
--   avanzar hacia -Z es automatico (W solo acelera); A/D mueven de lado con un muro suave en el borde del carril; Espacio sube,
--   S baja y sin mandos se mantiene la altura; mientras queda energia no se baja de alturaMin; al planear se baja solo hasta el suelo;
--   todos los cambios de velocidad son suaves (nada de tirones) y el personaje se inclina en los giros.
-- Coordenadas de Roblox: x a la derecha, y arriba, el vuelo va hacia -Z (vf es la velocidad hacia delante, positiva).
local M = {}

function M.nuevo()
	return { vx = 0, vy = 0, vf = 0, t = 0, alabeo = 0, cabeceo = 0 }
end

local function hacia(actual, objetivo, rapidez, dt) -- acercamiento exponencial: igual de suave con cualquier dt
	return actual + (objetivo - actual) * (1 - math.exp(-rapidez * dt))
end

-- s: estado de M.nuevo; entrada = { lateral = -1..1, subir, bajar }; info = { planeando, boost (el que confirma el servidor), impulso };
-- x, y: posicion actual de la raiz del personaje. Devuelve s con vx, vy, vf (studs/s), alabeo y cabeceo (radianes).
function M.paso(s, dt, entrada, info, x, y, cfg)
	entrada, info = entrada or {}, info or {}
	local imp = info.impulso or 1
	local L = cfg.lanzamiento
	s.t = s.t + dt
	local vfObj, vyObj
	if s.t < L.duracion then -- disparo del cañon: rapido y subiendo cada vez menos
		vfObj = L.velocidad * imp
		vyObj = L.subida * (1 - s.t / L.duracion)
	elseif info.planeando then
		vfObj = cfg.velocidadPlaneo
		vyObj = -cfg.caidaPlaneo * (entrada.bajar and 2 or 1)
	else
		vfObj = (info.boost and cfg.velocidadBoost or cfg.velocidadBase) * imp
		vyObj = (entrada.subir and cfg.velocidadSubir or 0) - (entrada.bajar and cfg.velocidadBajar or 0)
	end
	local vxObj = math.max(-1, math.min(1, entrada.lateral or 0)) * cfg.velocidadLateral
	local borde = cfg.anchoLibre - 6 -- muro suave: empuja hacia dentro cuanto mas se pasa (con A/D a tope se queda a ~2 del limite)
	if math.abs(x) > borde then
		local signo = x > 0 and 1 or -1
		vxObj = vxObj - signo * (math.abs(x) - borde) * 6
		if signo * vxObj > 0 and math.abs(x) >= cfg.anchoLibre then vxObj = 0 end
	end
	s.vx = hacia(s.vx, vxObj, 6, dt)
	s.vy = hacia(s.vy, vyObj, 5, dt)
	-- suelo y techo blandos sobre la velocidad (no sobre el objetivo, para no pasarse): frenan antes del limite y empujan si se pasa
	if s.t >= L.duracion and not info.planeando then s.vy = math.max(s.vy, (cfg.alturaMin - y) * 4) end
	s.vy = math.min(s.vy, (cfg.alturaMax - y) * 4)
	s.vf = hacia(s.vf, vfObj, s.t < L.duracion and 12 or 3, dt) -- el disparo arranca de golpe; el boost entra y sale suave
	s.alabeo = hacia(s.alabeo, -s.vx / cfg.velocidadLateral * 0.6, 8, dt) -- unos 35 grados en el giro maximo
	s.cabeceo = hacia(s.cabeceo, math.max(-0.35, math.min(0.35, s.vy / 30)), 6, dt)
	return s
end

return M
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000007">
<Properties>
<string name="Name">Mascotas</string>
<ProtectedString name="Source"><![CDATA[-- Mascotas de «+1 de lanzamiento por segundo»: datos y calculo de bonus (Lua puro, sin API de Roblox).
-- Cuatro cosas que suben: impulso (poder del canon), resistencia (energia de vuelo), dinero y exp (mascotas y alas).
-- Cada mascota da +% en 1 a 4 de ellas segun rareza. VALORES PROVISIONALES: se ajustan jugando.
local M = {}

M.STATS = { "impulso", "resistencia", "dinero", "exp" }
M.RAREZAS = { "comun", "poco_comun", "raro", "epico", "legendario", "mitico", "robux" }

-- id, modelo, rareza, bonus (en porcentaje). Los enemigos usan su version amable como mascota.
M.LISTA = {
	{ id = "gorrion", nombre = "Gorrion Miga", rareza = "comun", bonus = { dinero = 10 } },
	{ id = "golondrina", nombre = "Golondrina Brisa", rareza = "comun", bonus = { impulso = 10 } },
	{ id = "nube", nombre = "Nubecita", rareza = "poco_comun", bonus = { resistencia = 20 } },
	{ id = "globo", nombre = "Globito", rareza = "poco_comun", bonus = { exp = 20 } },
	{ id = "nubarron", nombre = "Truenito", rareza = "raro", bonus = { impulso = 30, resistencia = 30 } },
	{ id = "ovni", nombre = "Marcianito", rareza = "raro", bonus = { dinero = 30, exp = 30 } },
	{ id = "meteorito", nombre = "Meteorito Chispa", rareza = "epico", bonus = { impulso = 40, dinero = 40, exp = 40 } },
	{ id = "cometa", nombre = "Cometa Colita", rareza = "epico", bonus = { resistencia = 40, dinero = 40, exp = 40 } },
	{ id = "aguila", nombre = "Aguila legendaria", rareza = "legendario", bonus = { impulso = 55, resistencia = 55, dinero = 55 } },
	{ id = "grifo", nombre = "Grifo mitico", rareza = "mitico", bonus = { impulso = 70, resistencia = 70, dinero = 70, exp = 70 } },
	{ id = "fenix", nombre = "Fenix de fuego", rareza = "robux", bonus = { impulso = 90, resistencia = 90, dinero = 90, exp = 90 }, fuego = true },
}

-- Pesos de cada huevo (rareza del huevo -> rareza de la mascota). El fenix NO sale de huevos.
M.HUEVOS = {
	comun = { comun = 80, poco_comun = 20 },
	poco_comun = { comun = 30, poco_comun = 55, raro = 15 },
	raro = { poco_comun = 30, raro = 55, epico = 15 },
	epico = { raro = 40, epico = 50, legendario = 10 },
	legendario = { epico = 45, legendario = 50, mitico = 5 },
	mitico = { legendario = 60, mitico = 40 },
}

-- Precio de cada huevo en dinero (hito 4, PROVISIONAL): un primer vuelo da unos 2.600 y uno largo, 10.000 o mas.
M.PRECIO_HUEVO = { comun = 500, poco_comun = 2000, raro = 8000, epico = 25000, legendario = 80000, mitico = 250000 }
M.MAX_EQUIPADAS = 3

local porId = {}
for _, p in ipairs(M.LISTA) do porId[p.id] = p end
function M.get(id) return porId[id] end

function M.cantidadBonus(p)
	local n = 0
	for _ in pairs(p.bonus) do n = n + 1 end
	return n
end

-- Suma los bonus de las mascotas equipadas (ids). Devuelve multiplicadores: 1 + suma/100.
function M.multiplicadores(equipadas)
	local m = {}
	for _, s in ipairs(M.STATS) do m[s] = 1 end
	for _, id in ipairs(equipadas) do
		local p = porId[id]
		if p then
			for s, v in pairs(p.bonus) do m[s] = m[s] + v / 100 end
		end
	end
	return m
end

-- Elige una mascota al abrir un huevo. rng() devuelve [0,1). elegirEn(lista, rng) escoge dentro de la rareza.
function M.abrirHuevo(rarezaHuevo, rng)
	local tabla = M.HUEVOS[rarezaHuevo]
	if not tabla then return nil end
	local total = 0
	for _, r in ipairs(M.RAREZAS) do total = total + (tabla[r] or 0) end
	local x, acc, rareza = rng() * total, 0, nil
	for _, r in ipairs(M.RAREZAS) do
		if tabla[r] then
			acc = acc + tabla[r]
			if x < acc then rareza = r break end
		end
	end
	local cand = {}
	for _, p in ipairs(M.LISTA) do if p.rareza == rareza then cand[#cand + 1] = p end end
	return cand[math.min(#cand, math.floor(rng() * #cand) + 1)]
end

return M
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000008">
<Properties>
<string name="Name">Partida</string>
<ProtectedString name="Source"><![CDATA[-- Sesion de vuelo de un jugador en el servidor de «+1 de lanzamiento por segundo» (Lua puro, probado con lupa; el adaptador de
-- Roblox es server/Partida.server.lua). El cliente mueve su personaje (para que responda al instante) y solo manda intenciones
-- (lanzar, boost, turbo, ataque); aqui se lleva lo que cuenta (energia, boost, distancia, zona, puntos) y se valida cada paso:
-- cada tick gana un presupuesto de distancia segun la velocidad permitida en ese momento (con margen para el lag); si el personaje
-- se mueve mas de lo que tiene, o se sale de los limites, el servidor lo devuelve a la ultima posicion buena. La distancia es lo
-- avanzado hacia -Z desde el lanzamiento y la zona sale de la posicion en el mapa. Vectores como tablas {x, y, z}.
local P = {}

P.TOL = {
	factor = 1.3, -- margen sobre la velocidad permitida
	extra = 6, -- studs/s de margen fijo
	rafaga = 1.5, -- segundos de presupuesto acumulable (paquetes que llegan juntos)
	salto = 2, -- studs de margen por paso
	frenada = 45, -- studs/s2: lo rapido que baja la velocidad permitida al soltar el boost (el cliente frena suave)
	planeoExtra = 4, -- segundos de margen para llegar al suelo planeando
	vueloMax = 600, -- segundos: corte de seguridad
	gracia = 0.4, -- segundos sin medir tras un teletransporte (lanzar o corregir): aun llegan posiciones de antes
	ventana = 4, -- segundos: media hacia delante, mas estricta que el presupuesto (pilla ir algo mas rapido de forma seguida)
	factorMedia = 1.15,
	extraMedia = 10, -- studs
}

-- V = src/Vuelo.lua; E = src/Encuentros.lua (aros, enemigos y cofres; sin E el vuelo va sin encuentros).
function P.nueva(V, E)
	return { V = V, E = E, estado = "tierra", violaciones = 0 }
end

function P.enVuelo(s)
	return s.estado == "vuelo"
end

function P.lanzar(s, pos, potencia, bonus)
	if s.estado == "vuelo" then return false end
	s.estado = "vuelo"
	s.v = s.V.nuevo(potencia or 0, bonus)
	s.z0 = pos.z
	s.ultima = { x = pos.x, y = pos.y, z = pos.z }
	s.presZ, s.presX, s.presY = 0, 0, 0
	s.hist, s.pendiente = {}, 0
	s.boost, s.turboHasta, s.t, s.avance = false, -1, 0, 0
	s.vPermitida = nil
	s.planeoT, s.yPlaneo = nil, nil
	s.gracia = P.TOL.gracia
	s.arosHechos = {}
	s.cofre = s.E and s.E.nuevoCofre(pos) or nil
	s.cofresSalidos = s.cofre and 1 or 0
	return true
end

function P.cancelar(s) -- murio, se fue o se quedo sin personaje: sin resultado
	s.estado = "tierra"
end

function P.boostActivo(s)
	return s.estado == "vuelo" and not s.v.planeando and (s.boost or s.t < s.turboHasta)
end

-- Intenciones del cliente. Devuelve el nombre de un efecto si hay que mostrarlo ("golpe") y, si el golpe alcanza a un enemigo de
-- mundo.enemigos, su indice (queda con vivo = false: su reaparicion la lleva quien guarda el mundo).
function P.intencion(s, nombre, valor, mundo)
	if s.estado ~= "vuelo" then return nil end
	if nombre == "boost" then
		s.boost = valor == true
	elseif nombre == "turbo" then -- boton TURBO del HUD (un toque): 1,2 s de boost
		s.turboHasta = s.t + 1.2
	elseif nombre == "ataque" or nombre == "puno" or nombre == "patada" then
		if not s.V.atacar(s.v) then return nil end
		local i = s.E and mundo and mundo.enemigos and s.E.enemigoAlAlcance(s.ultima, mundo.enemigos)
		if i then
			mundo.enemigos[i].vivo = false
			s.V.golpearEnemigo(s.v)
		end
		return "golpe", i
	end
	return nil
end

-- Velocidades maximas permitidas ahora: hacia delante (z), de lado (x) y vertical (y), cada una con su presupuesto.
function P.limites(s, dt)
	local c, imp, T = s.v.cfg, s.v.bonus.impulso or 1, P.TOL
	local objetivo
	if s.t < c.lanzamiento.duracion then objetivo = c.lanzamiento.velocidad * imp
	elseif s.v.planeando then objetivo = c.velocidadPlaneo
	elseif P.boostActivo(s) then objetivo = c.velocidadBoost * imp
	else objetivo = c.velocidadBase * imp end
	-- sube al momento y baja poco a poco (el cliente tambien frena suave)
	s.vPermitida = math.max(objetivo, (s.vPermitida or objetivo) - T.frenada * dt)
	local z = s.vPermitida * T.factor + T.extra
	local x = (c.velocidadLateral + 12) * T.factor + T.extra -- + el empujon del muro suave
	local y = math.max(c.lanzamiento.subida, c.velocidadSubir, c.velocidadBajar, c.caidaPlaneo * 2) * T.factor + T.extra
	return z, x, y
end

-- Un tick del servidor con la posicion actual del personaje; mundo = { aros = {{centro, radio}}, enemigos = ... } (opcional). Devuelve:
-- { corregir = pos buena o nil, aterrizaje = resultado o nil, energia (0-1), planeando, distancia, mult, puntos, boost,
--   aros = indices de aros cruzados en este tick o nil, cofre = posicion del cofre o nil, cofreAtrapado = posicion o nil }
function P.tick(s, dt, pos, mundo)
	if s.estado ~= "vuelo" then return nil end
	local V, c, T = s.V, s.v.cfg, P.TOL
	s.t = s.t + dt
	local maxZ, maxX, maxY = P.limites(s, dt)
	s.presZ = math.min(s.presZ + maxZ * dt, maxZ * T.rafaga)
	s.presX = math.min(s.presX + maxX * dt, maxX * T.rafaga)
	s.presY = math.min(s.presY + maxY * dt, maxY * T.rafaga)
	local u = s.ultima
	local dZ, dX, dY = math.abs(pos.z - u.z), math.abs(pos.x - u.x), math.abs(pos.y - u.y)
	local fuera = math.abs(pos.x) > c.anchoLibre + 8 or pos.y > c.alturaMax + 15
	s.pendiente = s.pendiente + s.vPermitida * dt
	local media = false -- lo avanzado en la ventana frente a lo permitido en el mismo tiempo (el lag no le afecta)
	if s.gracia <= 0 then
		local hecho, permitido = u.z - pos.z, s.pendiente
		for _, h in ipairs(s.hist) do
			if h.t > s.t - T.ventana then hecho, permitido = hecho + h.dz, permitido + h.perm end
		end
		media = hecho > permitido * T.factorMedia + T.extraMedia
	end
	local r = {}
	if s.gracia > 0 then
		s.gracia = s.gracia - dt -- el presupuesto sigue creciendo: lo avanzado mientras tanto se mide despues
	elseif dZ > s.presZ + T.salto or dX > s.presX + T.salto or dY > s.presY + T.salto or fuera or media then
		s.violaciones = s.violaciones + 1
		s.gracia = T.gracia
		s.hist, s.pendiente = {}, 0
		r.corregir = { x = u.x, y = u.y, z = u.z }
	else
		s.presZ, s.presX, s.presY = s.presZ - dZ, s.presX - dX, s.presY - dY
		s.hist[#s.hist + 1] = { t = s.t, dz = u.z - pos.z, perm = s.pendiente }
		s.pendiente = 0
		while s.hist[1] and s.hist[1].t <= s.t - T.ventana do table.remove(s.hist, 1) end
		if s.E and mundo and mundo.aros then -- aros: con el tramo validado, cada uno una vez por vuelo
			for i, aro in ipairs(mundo.aros) do
				if not s.arosHechos[i] and s.E.cruzaAro(u, pos, aro) then
					s.arosHechos[i] = true
					s.V.cruzarAro(s.v)
					r.aros = r.aros or {}
					r.aros[#r.aros + 1] = i
				end
			end
		end
		s.ultima = { x = pos.x, y = pos.y, z = pos.z }
		s.avance = math.max(s.avance, s.z0 - pos.z)
	end
	V.paso(s.v, dt, { boost = P.boostActivo(s) })
	s.v.distancia = s.avance -- cuenta lo avanzado de verdad, no lo que dice la velocidad
	if s.cofre then -- cofre volador: huye del jugador; al atraparlo, puntos y (si quedan) otro por delante
		if s.E.pasoCofre(s.cofre, dt, s.ultima) then
			s.V.atraparCofre(s.v)
			r.cofreAtrapado = { x = s.cofre.pos.x, y = s.cofre.pos.y, z = s.cofre.pos.z }
			if s.cofresSalidos < s.E.CFG.cofresPorVuelo then
				s.cofre = s.E.nuevoCofre(s.ultima)
				s.cofresSalidos = s.cofresSalidos + 1
			else
				s.cofre = nil
			end
		end
		r.cofre = s.cofre and s.cofre.pos
	end
	local y = s.ultima.y
	if s.v.planeando then
		if not s.planeoT then s.planeoT, s.yPlaneo = 0, y end
		s.planeoT = s.planeoT + dt
	end
	local enSuelo = s.v.planeando and y <= c.suelo + 4.5 -- la raiz de un personaje de pie queda unos 3 studs sobre el suelo
	local caido = y < c.suelo - 30 -- se salio del mapa
	local tarde = s.planeoT and s.planeoT > (s.yPlaneo - c.suelo) / c.caidaPlaneo + T.planeoExtra -- no baja al planear
	local posZona = -s.ultima.z
	if enSuelo or caido or tarde or s.t > T.vueloMax then
		s.estado = "tierra"
		r.aterrizaje = V.aterrizar(s.v, posZona)
	end
	r.energia = s.v.energiaMax > 0 and s.v.energia / s.v.energiaMax or 0
	r.planeando = s.v.planeando
	r.distancia = s.avance
	r.mult = V.multiplicadorZona(posZona, c)
	r.puntos = math.floor((s.avance + s.v.bote) * r.mult * (s.v.bonus.dinero or 1))
	r.boost = P.boostActivo(s)
	return r
end

return P
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000009">
<Properties>
<string name="Name">Red</string>
<ProtectedString name="Source"><![CDATA[-- RemoteEvents de «+1 de lanzamiento por segundo» en ReplicatedStorage (adaptador de Roblox, no es Lua puro): en el servidor se
-- crean la primera vez que se piden (asi dos scripts no los duplican) y en el cliente se esperan. Nombres en CONTRATO.md.
-- SIN PROBAR EN STUDIO.
local RS, RunService = game:GetService("ReplicatedStorage"), game:GetService("RunService")
local R = {}

function R.evento(nombre)
	local e = RS:FindFirstChild(nombre)
	if e then return e end
	if RunService:IsServer() then
		e = Instance.new("RemoteEvent")
		e.Name = nombre
		e.Parent = RS
		return e
	end
	return RS:WaitForChild(nombre)
end

return R
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ000000A">
<Properties>
<string name="Name">Vuelo</string>
<ProtectedString name="Source"><![CDATA[-- Logica pura del vuelo de «+1 de lanzamiento por segundo» (sin API de Roblox, probada con lupa).
-- Todas las cifras son PROVISIONALES (Maikol no ha fijado numeros): se ajustan jugando.
-- Reglas acordadas: la potencia (+1/s) fija la reserva de energia de cada vuelo; volar siempre consume; acelerar (W) y atacar
-- consumen mas; sin energia se planea (solo A/D, sin boost ni ataque). Aros y enemigos golpeados suben los puntos del vuelo;
-- al aterrizar, la distancia por el multiplicador de zona da los puntos. Rebirth reinicia SOLO la potencia.
local V = {}

V.CFG = {
	energiaBase = 12, -- segundos de vuelo con potencia 0: el primer vuelo ya llega al Mar de Nubes
	energiaPorRaiz = 1.6, -- + por la raiz de la potencia: con +1 potencia/s una curva lineal agotaba el mapa en minutos
	consumoVuelo = 1.0, -- energia/s siempre
	consumoBoost = 1.5, -- extra/s con W (era 2,5: con potencia 0 el boost vaciaba la energia en 3 s y pillar un cofre no compensaba)
	costeAtaque = 3, -- por golpe
	velocidadBase = 40, -- studs/s
	velocidadBoost = 70,
	velocidadPlaneo = 30,
	puntosAro = 25, -- sumados al "bote" del vuelo (que se multiplica por la zona al aterrizar): que merezca la pena buscarlos
	puntosEnemigo = 30,
	puntosCofre = 250, -- mas que la distancia que se pierde por el boost para pillarlo
	potenciaPorSegundo = 1,
	-- entrenamiento y rebirth (hito 3): en tierra siempre se gana potencia; mas en las zonas AFK (aunque no te muevas) y en el
	-- circuito de entrenamiento (corriendo). Cada rebirth reinicia la potencia, sube el entrenamiento y dobla lo que cuesta el siguiente.
	multAFK = 1.5,
	multEntreno = 2,
	entrenoPorRebirth = 0.5, -- +50% de entrenamiento por rebirth
	rebirthBase = 500, -- potencia para el primer rebirth
	-- Manejo (src/Manejo.lua en el cliente) y limites que valida el servidor (src/Partida.lua). Faciles a proposito: avanzar es
	-- automatico, no se puede salir del carril ni tocar el suelo mientras quede energia, y al planear se aterriza solo.
	velocidadLateral = 22, -- A/D
	velocidadSubir = 16, -- Espacio / salto
	velocidadBajar = 20, -- S / joystick abajo
	alturaMin = 6, -- altura minima de la raiz del personaje mientras queda energia
	alturaMax = 48,
	caidaPlaneo = 4.5, -- studs/s de bajada al planear
	anchoLibre = 30, -- |x| maximo: el carril del mapa mide 66
	suelo = 0, -- techo del carril del mapa (y de la Pradera)
	lanzamiento = { duracion = 1.2, velocidad = 85, subida = 30 }, -- disparo del cañon: rapido y hacia arriba
	-- multiplicador segun la posicion hacia -Z (studs desde el origen de la Pradera), como las marcas del suelo de mapa-v01:
	-- Pradera x1, prado de la Pradera x2 (desde y=37), Mar de Nubes x3 (172), Tormenta x4 (532), Cielo alto x5 (892), Espacio x6 (1252)
	zonas = { { 0, 1 }, { 37, 2 }, { 172, 3 }, { 532, 4 }, { 892, 5 }, { 1252, 6 } },
}

function V.energiaMax(potencia, cfg)
	cfg = cfg or V.CFG
	return cfg.energiaBase + cfg.energiaPorRaiz * math.sqrt(math.max(0, potencia))
end

function V.multiplicadorZona(distancia, cfg)
	cfg = cfg or V.CFG
	local m = cfg.zonas[1][2]
	for _, z in ipairs(cfg.zonas) do
		if distancia >= z[1] then m = z[2] end
	end
	return m
end

-- Estado de un vuelo. potencia viene del jugador; bonus = multiplicadores de Mascotas.multiplicadores (impulso/resistencia/dinero/exp).
function V.nuevo(potencia, bonus, cfg)
	cfg = cfg or V.CFG
	bonus = bonus or { impulso = 1, resistencia = 1, dinero = 1, exp = 1 }
	local emax = V.energiaMax(potencia, cfg) * (bonus.resistencia or 1)
	return {
		cfg = cfg, bonus = bonus, potencia = potencia,
		energia = emax, energiaMax = emax,
		distancia = 0, bote = 0, aros = 0, golpes = 0,
		planeando = false, terminado = false, tiempo = 0,
	}
end

-- Avanza dt segundos. entrada = { boost = bool }. Devuelve la velocidad usada.
function V.paso(v, dt, entrada)
	if v.terminado then return 0 end
	local c = v.cfg
	local boost = entrada and entrada.boost and v.energia > 0
	local gasto = c.consumoVuelo + (boost and c.consumoBoost or 0)
	v.energia = math.max(0, v.energia - gasto * dt)
	v.planeando = v.energia <= 0
	local vel
	if v.planeando then vel = c.velocidadPlaneo
	elseif boost then vel = c.velocidadBoost * (v.bonus.impulso or 1)
	else vel = c.velocidadBase * (v.bonus.impulso or 1) end
	v.distancia = v.distancia + vel * dt
	v.tiempo = v.tiempo + dt
	return vel
end

-- Ataca (puño/patada): consume energia y no se puede planeando. Devuelve true si el golpe cuenta.
function V.atacar(v)
	if v.terminado or v.planeando or v.energia < v.cfg.costeAtaque then return false end
	v.energia = v.energia - v.cfg.costeAtaque
	v.golpes = v.golpes + 1
	return true
end

function V.golpearEnemigo(v)
	if v.terminado then return end
	v.bote = v.bote + v.cfg.puntosEnemigo
end

function V.cruzarAro(v)
	if v.terminado then return end
	v.aros = v.aros + 1
	v.bote = v.bote + v.cfg.puntosAro
end

function V.atraparCofre(v)
	if v.terminado then return end
	v.cofres = (v.cofres or 0) + 1
	v.bote = v.bote + v.cfg.puntosCofre
end

-- Aterrizaje: puntos = (distancia + bote) * multiplicador de zona * bonus dinero. Devuelve resultado.
-- posZona: posicion hacia -Z donde aterriza (el servidor la pasa); sin ella, la zona sale de la distancia recorrida.
function V.aterrizar(v, posZona)
	v.terminado = true
	local mult = V.multiplicadorZona(posZona or v.distancia, v.cfg)
	local base = v.distancia + v.bote
	local dinero = math.floor(base * mult * (v.bonus.dinero or 1))
	local exp = math.floor((v.distancia / 10 + v.aros * 2 + v.golpes) * (v.bonus.exp or 1))
	return { distancia = v.distancia, aros = v.aros, golpes = v.golpes, cofres = v.cofres or 0, multiplicador = mult, dinero = dinero, exp = exp,
		tiempo = v.tiempo }
end

-- Entrenamiento en tierra (+1 potencia por segundo); rebirths aumentan principalmente la velocidad de entrenamiento.
function V.entrenar(potencia, segundos, rebirths, cfg)
	cfg = cfg or V.CFG
	local vel = cfg.potenciaPorSegundo * (1 + cfg.entrenoPorRebirth * (rebirths or 0))
	return potencia + vel * segundos
end

-- Potencia por segundo en tierra. zona: nil, "afk" o "entreno" (el circuito solo cuenta si corres).
function V.ritmoEntreno(rebirths, zona, corriendo, cfg)
	cfg = cfg or V.CFG
	local m = 1
	if zona == "afk" then m = cfg.multAFK elseif zona == "entreno" and corriendo then m = cfg.multEntreno end
	return cfg.potenciaPorSegundo * (1 + cfg.entrenoPorRebirth * (rebirths or 0)) * m
end

function V.costeRebirth(rebirths, cfg)
	cfg = cfg or V.CFG
	return cfg.rebirthBase * 2 ^ (rebirths or 0)
end

-- Rebirth: reinicia SOLO la potencia; conserva todo lo demas. Devuelve jugador nuevo.
function V.rebirth(jugador)
	return {
		potencia = 0, rebirths = (jugador.rebirths or 0) + 1,
		puntos = jugador.puntos, alas = jugador.alas, mascotas = jugador.mascotas, desbloqueos = jugador.desbloqueos,
	}
end

return V
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBXJ0000011">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBXJ0000010">
<Properties>
<string name="Name">Mas1Servidor</string>
</Properties>
<Item class="Script" referent="RBXJ000000D">
<Properties>
<string name="Name">DemoVisual</string>
<ProtectedString name="Source"><![CDATA[-- SOLO PARA VER LA CAPA VISUAL antes de que exista el juego: si workspace tiene el atributo MAS1_Demo = true, simula un vuelo (energia que baja,
-- puntos y distancia que suben, aros, multiplicadores) y dispara efectos de ejemplo. No es logica de juego. SIN PROBAR EN STUDIO.
local Players, RS = game:GetService("Players"), game:GetService("ReplicatedStorage")
local Red = require(RS:WaitForChild("Mas1"):WaitForChild("Red")) -- los mismos eventos que el juego (server/Partida.server.lua), sin duplicarlos
local Efecto, Accion = Red.evento("MAS1_Efecto"), Red.evento("MAS1_Accion")
while workspace:GetAttribute("MAS1_Demo") ~= true do workspace:GetAttributeChangedSignal("MAS1_Demo"):Wait() end -- sirve activarlo antes o durante el Play

local function raiz(plr) local c = plr.Character; return c and c:FindFirstChild("HumanoidRootPart") end
Accion.OnServerEvent:Connect(function(plr, nombre)
	local r = raiz(plr); if not r then return end
	if nombre == "puno" or nombre == "patada" then Efecto:FireClient(plr, "golpe", r.Position + r.CFrame.LookVector * 4)
	elseif nombre == "turbo" then Efecto:FireClient(plr, "aleteo", r.Position) end
end)

local ZONAS = { 1, 2, 3, 5 }
task.spawn(function()
	local t0 = os.clock()
	while true do
		task.wait(0.25)
		local t = os.clock() - t0; local ciclo = t % 20 -- un "vuelo" de 20 s que se repite
		for _, plr in ipairs(Players:GetPlayers()) do
			plr:SetAttribute("Energia", math.max(0, 1 - ciclo / 18)); plr:SetAttribute("Potencia", 1250 + math.floor(t))
			plr:SetAttribute("Puntos", math.floor(ciclo * 640)); plr:SetAttribute("Distancia", math.floor(ciclo * 47))
			plr:SetAttribute("ZonaMult", ZONAS[math.floor(ciclo / 5) % #ZONAS + 1]); plr:SetAttribute("ArosTotal", 12); plr:SetAttribute("Aros", math.min(12, math.floor(ciclo / 1.7)))
			plr:SetAttribute("Mascota", "Gorrión Miga"); plr:SetAttribute("MascotaBonus", 1.5)
			local r = raiz(plr)
			if r and math.floor(ciclo * 4) % 7 == 0 then Efecto:FireClient(plr, "aro", r.Position + Vector3.new(0, 4, -6)) end
			if r and ciclo < 0.3 then Efecto:FireClient(plr, "lanzamiento", r.Position) end
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ000000E">
<Properties>
<string name="Name">Guardado</string>
<ProtectedString name="Source"><![CDATA[-- Guardado de «+1 de lanzamiento por segundo» con DataStore: adaptador de Roblox de src/Datos.lua (Lua puro, probado con lupa).
-- Carga tomando el bloqueo de sesion (si otro servidor tiene los datos del jugador, espera a que los suelte o a que su bloqueo
-- caduque), guarda con reintentos y espera creciente, y nunca pisa datos de otra sesion. Solo EN STUDIO, si no hay acceso al
-- DataStore (place sin publicar o sin «Enable Studio Access to API Services»), se juega sin guardar y se avisa en el Output; en un
-- servidor de verdad nunca se juega sin guardar: si no se pueden cargar los datos, el jugador sale con un mensaje (revision de
-- Linux 2.0: una prueba de acceso fallida al arrancar dejaba todo el servidor sin guardar en silencio).
-- Lo usa server/Partida.server.lua (autoguardado cada G.AUTOGUARDADO s, al salir y al cerrar el servidor). SIN PROBAR EN STUDIO.
local DataStoreService, HttpService, RS = game:GetService("DataStoreService"), game:GetService("HttpService"), game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local D = require(Mas1:WaitForChild("Datos"))
local M = require(Mas1:WaitForChild("Mascotas"))
local Alas = require(Mas1:WaitForChild("Alas"))

local G = {}
G.CADUCA = 180 -- s sin refrescar para dar por abandonado un bloqueo (el otro servidor se cayo)
G.AUTOGUARDADO = 60
local SESION = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

local tienda
do
	local ok, t = pcall(function() return DataStoreService:GetDataStore("MAS1_Datos_v1") end)
	if ok then tienda = t end
	-- la prueba de acceso solo en Studio: en un servidor de verdad un fallo pasajero no puede dejar a nadie sin guardar
	if tienda and RunService:IsStudio() and not pcall(function() tienda:GetAsync("prueba_de_acceso") end) then tienda = nil end
	if not tienda then
		if RunService:IsStudio() then
			warn("[MAS1 guardado] Studio sin acceso al DataStore: se juega SIN GUARDAR (place sin publicar o sin acceso a las API)")
		else
			warn("[MAS1 guardado] Servidor sin DataStore: no se dejara jugar a nadie (sus datos no se podrian guardar)")
		end
	end
end
G.sinGuardar = tienda == nil and RunService:IsStudio() -- solo Studio juega sin guardar
G.activo = tienda ~= nil

local function reintentar(f)
	local espera = 1
	for intento = 1, 5 do
		local ok, r = pcall(f)
		if ok then return true, r end
		warn(string.format("[MAS1 guardado] intento %d fallido: %s", intento, tostring(r)))
		if intento < 5 then
			task.wait(espera)
			espera *= 2
		end
	end
	return false
end

-- Carga los datos de plr, limpios, tomando el bloqueo. Devuelve los datos, o nil y el motivo ("bloqueado", "error" o "se fue").
function G.cargar(plr)
	if not tienda then
		if G.sinGuardar then return D.limpiar(nil, M, Alas) end
		return nil, "error"
	end
	local clave = "j_" .. plr.UserId
	for _ = 1, 8 do -- si acaba de cambiar de servidor, el otro aun puede tener el bloqueo: se espera a que lo suelte
		local bloqueado = false
		local ok, guardado = reintentar(function()
			return tienda:UpdateAsync(clave, function(viejo)
				local tomado, nuevo = D.tomar(viejo, SESION, os.time(), G.CADUCA)
				bloqueado = not tomado
				return nuevo -- nil: no se escribe nada
			end)
		end)
		if not ok then return nil, "error" end
		if not bloqueado then return D.limpiar(guardado and guardado.dato, M, Alas) end
		if not plr.Parent then return nil, "se fue" end
		task.wait(6)
	end
	return nil, "bloqueado"
end

-- Guarda dato (soltar = al salir). Devuelve dos cosas: si el DataStore respondio y si se escribio (false = otra sesion tiene el
-- bloqueo: este servidor ya no debe seguir con el jugador).
function G.guardar(plr, dato, soltar)
	if not tienda then return G.sinGuardar, G.sinGuardar end
	local escrito = false
	local ok = reintentar(function()
		return tienda:UpdateAsync("j_" .. plr.UserId, function(viejo)
			local puede, nuevo = D.escribir(viejo, SESION, dato, os.time(), soltar)
			escrito = puede
			return nuevo
		end)
	end)
	return ok, escrito
end

return G
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBXJ000000F">
<Properties>
<string name="Name">Partida</string>
<ProtectedString name="Source"><![CDATA[-- Partida de «+1 de lanzamiento por segundo» en el servidor: adaptador de Roblox de src/Partida.lua y src/Encuentros.lua (Lua puro,
-- probados con lupa). El cliente mueve su personaje y manda intenciones por MAS1_Accion. Aqui se lanza, se llevan la energia, el
-- boost, la distancia y los puntos, se valida cada paso (si va mas rapido de lo permitido o se sale de los limites, se le devuelve
-- atras), se cuentan los aros del mapa (Models «Aro» con su pieza «Centro»), los golpes a los enemigos y los cofres que huyen, y al
-- aterrizar se pagan el dinero y la exp y se manda MAS1_Resultado. Los enemigos y los cofres son anclas invisibles en
-- Workspace.MAS1_Entidades (atributos Tipo, Vivo y Dueno); los dibuja el cliente (client/Entidades.client.lua).
-- En tierra se entrena (+1 potencia/s, mas en las zonas MAS1_AFK y MAS1_Entreno del mapa) y se puede hacer rebirth; el bonus del
-- vuelo combina las mascotas equipadas y las alas (src/Alas.lua, que escalan con los rebirths). El inventario (src/Inventario.lua:
-- huevos, mascotas equipadas, alas) va a la interfaz por MAS1_Inventario y MAS1_Huevo, y los fallos por MAS1_Aviso.
-- Los datos se cargan y guardan con server/Guardado.lua (DataStore con bloqueo de sesion); hasta que cargan, el jugador no actua.
-- Las alas se desbloquean solas al cumplir su requisito (Alas.desbloqueada). Atributos y eventos en CONTRATO.md. SIN PROBAR EN STUDIO.
local Players, RS, RunService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local V = require(Mas1:WaitForChild("Vuelo"))
local P = require(Mas1:WaitForChild("Partida"))
local E = require(Mas1:WaitForChild("Encuentros"))
local M = require(Mas1:WaitForChild("Mascotas"))
local Alas = require(Mas1:WaitForChild("Alas"))
local I = require(Mas1:WaitForChild("Inventario"))
local D = require(Mas1:WaitForChild("Datos"))
local G = require(script.Parent:WaitForChild("Guardado"))
local Red = require(Mas1:WaitForChild("Red"))
local accion, efecto, resultado = Red.evento("MAS1_Accion"), Red.evento("MAS1_Efecto"), Red.evento("MAS1_Resultado")
local avisoEv, inventarioEv, huevoEv = Red.evento("MAS1_Aviso"), Red.evento("MAS1_Inventario"), Red.evento("MAS1_Huevo")
local PRODUCTO_FENIX = nil -- id del producto de Robux del fenix: SIN CONFIGURAR (no se ha creado ningun producto ni precio)

local INICIALES = { Potencia = 0, Dinero = 0, Exp = 0, Rebirths = 0, Cofres = 0, Lanzamientos = 0, Puntos = 0, Distancia = 0,
	ZonaMult = 1, Aros = 0, ArosTotal = 0, Energia = 1, EnergiaMax = 0, Impulso = 1, EnVuelo = false, Planeando = false, Boost = false,
	Mascota = "—", MascotaBonus = 1, Alas = "", Entreno = 1, CosteRebirth = V.costeRebirth(0) }
local MENSAJES_POR_SEGUNDO = 30
local jugadores = {} -- [plr] = { s = sesion de Partida, msgs, desde, hud, cofre = ancla del cofre, potencia, entreno }

local function aviso(plr, texto)
	avisoEv:FireClient(plr, texto)
end

-- inventario: a la interfaz con la forma acordada, y la mascota principal y su bonus de dinero al HUD
local function mandarInventario(plr, j)
	inventarioEv:FireClient(plr, I.copia(j.inv))
	local p = I.principal(M, j.inv)
	plr:SetAttribute("Mascota", p and p.nombre or "—")
	plr:SetAttribute("MascotaBonus", math.floor(M.multiplicadores(j.inv.equipadas).dinero * 100 + 0.5) / 100)
	plr:SetAttribute("Alas", j.inv.alaEquipada or "")
end

local function tabla(v)
	return { x = v.X, y = v.Y, z = v.Z }
end

local function v3(t)
	return Vector3.new(t.x, t.y, t.z)
end

local function raiz(plr)
	local c = plr.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h and h.Health > 0 then return c:FindFirstChild("HumanoidRootPart"), h end
	return nil
end

-- ---------------------------------------------------------------- mundo: aros del mapa y enemigos repartidos por zona
local entidades = Instance.new("Folder")
entidades.Name = "MAS1_Entidades"
entidades.Parent = workspace
local mundo = { aros = {}, enemigos = {} }

for _, m in ipairs(workspace:GetDescendants()) do
	local c = m:IsA("Model") and m.Name == "Aro" and m:FindFirstChild("Centro")
	if c then
		local suma, n = 0, 0 -- radio: la distancia media de los bloques del aro a su centro
		for _, p in ipairs(m:GetChildren()) do
			if p:IsA("BasePart") and p ~= c then
				suma += (p.Position - c.Position).Magnitude
				n += 1
			end
		end
		mundo.aros[#mundo.aros + 1] = { centro = tabla(c.Position), radio = n > 0 and suma / n or 8 }
	end
end
table.sort(mundo.aros, function(a, b) return a.centro.z > b.centro.z end) -- en el orden del vuelo

local function ancla(nombre, pos, atributos)
	local p = Instance.new("Part")
	p.Name = nombre
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	for k, v in pairs(atributos) do p:SetAttribute(k, v) end
	p.Parent = entidades
	return p
end

local azar = Random.new(30)
mundo.enemigos = E.colocarEnemigos(mundo.aros, function() return azar:NextNumber() end)
for _, en in ipairs(mundo.enemigos) do
	en.ancla = ancla("Enemigo", v3(en.pos), { Tipo = en.tipo, Vivo = true })
end

-- zonas de entrenamiento del mapa: partes llamadas MAS1_AFK (x1,5 aunque no te muevas) y MAS1_Entreno (x2 corriendo)
local zonasEntreno = {}
for _, p in ipairs(workspace:GetDescendants()) do
	if p:IsA("BasePart") and (p.Name == "MAS1_AFK" or p.Name == "MAS1_Entreno") then
		zonasEntreno[#zonasEntreno + 1] = { parte = p, tipo = p.Name == "MAS1_AFK" and "afk" or "entreno" }
	end
end

local function zonaDe(pos)
	for _, z in ipairs(zonasEntreno) do
		local rel, s = z.parte.CFrame:PointToObjectSpace(pos), z.parte.Size
		if math.abs(rel.X) <= s.X / 2 and math.abs(rel.Z) <= s.Z / 2 and rel.Y >= -2 and rel.Y <= s.Y / 2 + 8 then return z.tipo end
	end
	return nil
end

local function golpeado(i)
	local en = mundo.enemigos[i]
	en.ancla:SetAttribute("Vivo", false)
	efecto:FireAllClients("golpe", en.ancla.Position)
	task.delay(E.CFG.reaparicion, function()
		en.vivo = true
		en.ancla:SetAttribute("Vivo", true)
	end)
end

-- ---------------------------------------------------------------- jugadores: datos, alas que se desbloquean y guardado
local function revisarAlas(plr, j) -- hito 6: iniciales en el 3.er lanzamiento, roboticas con 3 dias seguidos, avanzadas con 10 cofres
	local progreso = { lanzamientos = plr:GetAttribute("Lanzamientos") or 0, diasSeguidos = j.dias.diasSeguidos,
		cofres = plr:GetAttribute("Cofres") or 0 }
	local nuevas = false
	for _, a in ipairs(Alas.LISTA) do
		if not I.tieneAla(j.inv, a.id) and Alas.desbloqueada(a.id, progreso) then
			I.darAla(j.inv, a.id)
			if not j.inv.alaEquipada then I.equiparAla(j.inv, a.id) end -- las primeras se ponen solas
			aviso(plr, "¡Nuevas alas: " .. a.nombre .. "!")
			nuevas = true
		end
	end
	if nuevas then mandarInventario(plr, j) end
end

local function aplicar(plr, j, d)
	j.potencia = d.potencia
	j.inv = d.inventario
	j.dias = { diasSeguidos = d.diasSeguidos, ultimoDia = d.ultimoDia }
	plr:SetAttribute("Potencia", math.floor(d.potencia))
	plr:SetAttribute("Dinero", d.dinero)
	plr:SetAttribute("Exp", d.exp)
	plr:SetAttribute("Rebirths", d.rebirths)
	plr:SetAttribute("CosteRebirth", V.costeRebirth(d.rebirths))
	plr:SetAttribute("Cofres", d.cofres)
	plr:SetAttribute("Lanzamientos", d.lanzamientos)
	plr:SetAttribute("DiasSeguidos", d.diasSeguidos)
	mandarInventario(plr, j)
	revisarAlas(plr, j)
end

local function datosDe(plr, j)
	return { version = D.VERSION, potencia = j.potencia, dinero = plr:GetAttribute("Dinero") or 0, exp = plr:GetAttribute("Exp") or 0,
		rebirths = plr:GetAttribute("Rebirths") or 0, cofres = plr:GetAttribute("Cofres") or 0,
		lanzamientos = plr:GetAttribute("Lanzamientos") or 0, diasSeguidos = j.dias.diasSeguidos, ultimoDia = j.dias.ultimoDia,
		inventario = I.copia(j.inv) }
end

local function alEntrar(plr)
	for k, v in pairs(INICIALES) do
		if plr:GetAttribute(k) == nil then plr:SetAttribute(k, v) end
	end
	plr:SetAttribute("ArosTotal", #mundo.aros)
	local j = { s = P.nueva(V, E), msgs = 0, desde = 0, hud = 0, potencia = 0, entreno = 0, inv = I.nuevo(), cargado = false,
		dias = { diasSeguidos = 0, ultimoDia = -1 } }
	jugadores[plr] = j
	plr:GetAttributeChangedSignal("Potencia"):Connect(function() -- cambiada a mano (en Studio, para probar): se adopta
		local v = plr:GetAttribute("Potencia")
		if j.cargado and type(v) == "number" and math.abs(v - math.floor(j.potencia)) >= 1 then j.potencia = v end
	end)
	plr.CharacterAdded:Connect(function() mandarInventario(plr, j) end) -- para cuando los scripts del cliente ya escuchan
	task.spawn(function()
		local d, motivo = G.cargar(plr)
		if not plr.Parent or jugadores[plr] ~= j then return end
		if not d then -- mejor no jugar que jugar con datos vacios y pisar los buenos al guardar
			plr:Kick(motivo == "bloqueado" and "Tus datos siguen abiertos en otro servidor. Vuelve a entrar en un momento."
				or "No se pudieron cargar tus datos. Vuelve a entrar en un momento.")
			return
		end
		D.registrarDia(d, math.floor(os.time() / 86400))
		aplicar(plr, j, d)
		j.cargado = true
	end)
end
Players.PlayerAdded:Connect(alEntrar)
for _, plr in ipairs(Players:GetPlayers()) do alEntrar(plr) end

local enCurso = 0 -- guardados en marcha: al cerrar el servidor se espera a todos, tambien a los de jugadores que ya salieron

local function guardar(plr, j, soltar)
	if not j.cargado then return end
	enCurso += 1
	local ok, escrito = G.guardar(plr, datosDe(plr, j), soltar)
	enCurso -= 1
	if ok and not escrito and not soltar then -- otra sesion se quedo sus datos: este servidor ya no puede seguir con el
		j.cargado = false
		plr:Kick("Tus datos se abrieron en otro servidor.")
	end
end

local function despedir(plr, j) -- guardar y soltar el bloqueo una sola vez (al salir o al cerrar el servidor)
	if j.saliendo then return end
	j.saliendo = true
	guardar(plr, j, true)
end

task.spawn(function() -- autoguardado
	while true do
		task.wait(G.AUTOGUARDADO)
		for plr, j in pairs(jugadores) do
			if not j.saliendo then task.spawn(guardar, plr, j, false) end
		end
	end
end)

game:BindToClose(function() -- al cerrar el servidor: guardar y soltar a todos (Roblox espera hasta 30 s)
	for plr, j in pairs(jugadores) do task.spawn(despedir, plr, j) end
	task.wait() -- que arranquen
	local t0 = os.clock()
	while enCurso > 0 and os.clock() - t0 < 25 do task.wait(0.2) end
end)

local function quitarCofre(j)
	if j.cofre then
		j.cofre:Destroy()
		j.cofre = nil
	end
end

Players.PlayerRemoving:Connect(function(plr)
	local j = jugadores[plr]
	if not j then return end
	quitarCofre(j)
	jugadores[plr] = nil
	despedir(plr, j) -- guarda y suelta el bloqueo
end)

local function bonusDe(plr, j) -- mascotas equipadas por las alas equipadas, que escalan con los rebirths
	return Alas.combinar(M.multiplicadores(j.inv.equipadas), Alas.bonus(j.inv.alaEquipada, plr:GetAttribute("Rebirths") or 0))
end

local azarHuevos = Random.new()

-- intenciones del inventario (en tierra): abrir huevos, equipar y desequipar mascotas y alas, comprar alas
local function inventario(plr, j, nombre, a, b)
	if P.enVuelo(j.s) then
		aviso(plr, "Eso se hace en tierra")
		return
	end
	local ok, x, p, nueva
	if nombre == "abrirHuevo" and type(a) == "string" then
		ok, x, p, nueva = I.abrirHuevo(M, j.inv, plr:GetAttribute("Dinero") or 0, a, function() return azarHuevos:NextNumber() end)
		if ok then
			plr:SetAttribute("Dinero", x)
			huevoEv:FireClient(plr, { rareza = a, mascotaId = p.id, nueva = nueva })
		end
	elseif nombre == "equipar" and a == "mascota" and type(b) == "string" then
		ok, x = I.equipar(M, j.inv, b)
	elseif nombre == "desequipar" and a == "mascota" and type(b) == "string" then
		ok, x = I.desequipar(j.inv, b)
	elseif nombre == "equipar" and a == "ala" and type(b) == "string" then
		ok, x = I.equiparAla(j.inv, b)
	elseif nombre == "desequipar" and a == "ala" then
		ok, x = I.desequiparAla(j.inv)
	elseif nombre == "comprarAla" and type(a) == "string" then
		ok, x = I.comprarAla(Alas, j.inv, plr:GetAttribute("Dinero") or 0, a)
		if ok then plr:SetAttribute("Dinero", x) end
	elseif nombre == "inventario" then
		ok = true
	else
		return
	end
	if ok then mandarInventario(plr, j) elseif type(x) == "string" then aviso(plr, x) end
end

if PRODUCTO_FENIX then -- fenix solo con Robux: al cobrar el producto se da la mascota (hito 5 lo guardara)
	game:GetService("MarketplaceService").ProcessReceipt = function(recibo)
		local plr = Players:GetPlayerByUserId(recibo.PlayerId)
		local j = plr and jugadores[plr]
		if not j or recibo.ProductId ~= PRODUCTO_FENIX then return Enum.ProductPurchaseDecision.NotProcessedYet end
		I.darFenix(j.inv)
		mandarInventario(plr, j)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

local function rebirth(plr, j)
	if P.enVuelo(j.s) then return end
	local r = plr:GetAttribute("Rebirths") or 0
	local coste = V.costeRebirth(r)
	if j.potencia < coste then
		aviso(plr, string.format("Te falta potencia para el rebirth: %d / %d", math.floor(j.potencia), coste))
		return
	end
	j.potencia = 0
	plr:SetAttribute("Potencia", 0)
	plr:SetAttribute("Rebirths", r + 1)
	plr:SetAttribute("CosteRebirth", V.costeRebirth(r + 1))
	local hrp = raiz(plr)
	if hrp then efecto:FireAllClients("rebirth", hrp.Position) end
end

local function cerrarVuelo(plr, j, hrp)
	quitarCofre(j)
	plr:SetAttribute("EnVuelo", false)
	plr:SetAttribute("Planeando", false)
	if plr:GetAttribute("Boost") then
		plr:SetAttribute("Boost", false)
		if hrp then efecto:FireAllClients("estela", nil, hrp, false) end
	end
end

local function lanzar(plr, j)
	local hrp, hum = raiz(plr)
	if not hrp or P.enVuelo(j.s) or hum.Sit or hum.FloorMaterial == Enum.Material.Air then return end -- solo desde el suelo
	local canon = workspace:FindFirstChild("MAS1_Canon", true) -- el cañon de la Pradera cuando este; si no, desde donde esta
	local base = (canon and canon:IsA("BasePart")) and canon.Position or hrp.Position
	local pos = base + Vector3.new(0, 4, 0)
	hrp.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))
	hrp.AssemblyLinearVelocity = Vector3.zero
	local b = bonusDe(plr, j)
	P.lanzar(j.s, tabla(pos), j.potencia, b)
	plr:SetAttribute("Lanzamientos", (plr:GetAttribute("Lanzamientos") or 0) + 1)
	plr:SetAttribute("Entreno", 0)
	revisarAlas(plr, j)
	quitarCofre(j)
	if j.s.cofre then j.cofre = ancla("Cofre", v3(j.s.cofre.pos), { Tipo = "cofre", Dueno = plr.UserId }) end
	plr:SetAttribute("Impulso", b.impulso)
	plr:SetAttribute("EnergiaMax", j.s.v.energiaMax)
	plr:SetAttribute("Energia", 1)
	plr:SetAttribute("Puntos", 0)
	plr:SetAttribute("Distancia", 0)
	plr:SetAttribute("Aros", 0)
	plr:SetAttribute("ArosTotal", #mundo.aros)
	plr:SetAttribute("Planeando", false)
	plr:SetAttribute("Boost", false)
	plr:SetAttribute("EnVuelo", true)
	efecto:FireAllClients("lanzamiento", pos)
end

accion.OnServerEvent:Connect(function(plr, nombre, valor, extra)
	local j = jugadores[plr]
	if not j or not j.cargado or type(nombre) ~= "string" then return end -- hasta que cargan sus datos, nada
	local ahora = os.clock()
	if ahora - j.desde > 1 then j.desde, j.msgs = ahora, 0 end
	j.msgs += 1
	if j.msgs > MENSAJES_POR_SEGUNDO then return end
	if nombre == "lanzar" then
		lanzar(plr, j)
		return
	elseif nombre == "rebirth" then
		rebirth(plr, j)
		return
	elseif nombre == "abrirHuevo" or nombre == "equipar" or nombre == "desequipar" or nombre == "comprarAla" or nombre == "inventario" then
		inventario(plr, j, nombre, valor, extra)
		return
	end
	local fx, i = P.intencion(j.s, nombre, valor, mundo)
	if i then
		golpeado(i)
	elseif fx == "golpe" then -- golpe al aire: solo el efecto
		local hrp = raiz(plr)
		if hrp then efecto:FireAllClients("golpe", hrp.Position + Vector3.new(0, 0, -5)) end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	for plr, j in pairs(jugadores) do
		if not P.enVuelo(j.s) then -- en tierra: entrenar (+1/s, mas en las zonas AFK y de entrenamiento y con los rebirths)
			if not j.cargado then continue end
			j.entreno += dt
			if j.entreno >= 0.25 then
				local hrp, hum = raiz(plr)
				if hrp then
					local ritmo = V.ritmoEntreno(plr:GetAttribute("Rebirths") or 0, zonaDe(hrp.Position), hum.MoveDirection.Magnitude > 0.1)
					j.potencia += ritmo * j.entreno
					plr:SetAttribute("Potencia", math.floor(j.potencia))
					plr:SetAttribute("Entreno", ritmo)
				end
				j.entreno = 0
			end
			continue
		end
		local hrp = raiz(plr)
		if not hrp then -- murio o se quedo sin personaje: el vuelo no paga
			P.cancelar(j.s)
			cerrarVuelo(plr, j, nil)
			continue
		end
		local r = P.tick(j.s, dt, tabla(hrp.Position), mundo)
		if r.corregir then
			hrp.CFrame = CFrame.new(r.corregir.x, r.corregir.y, r.corregir.z) * hrp.CFrame.Rotation
		end
		if r.aros then
			for _, i in ipairs(r.aros) do efecto:FireClient(plr, "aro", v3(mundo.aros[i].centro)) end
			plr:SetAttribute("Aros", j.s.v.aros)
		end
		if r.cofreAtrapado then
			efecto:FireClient(plr, "aro", v3(r.cofreAtrapado))
			plr:SetAttribute("Cofres", (plr:GetAttribute("Cofres") or 0) + 1)
			quitarCofre(j)
			revisarAlas(plr, j)
		end
		if r.cofre then
			if not j.cofre then j.cofre = ancla("Cofre", v3(r.cofre), { Tipo = "cofre", Dueno = plr.UserId }) end
			j.cofre.Position = v3(r.cofre)
		end
		if plr:GetAttribute("Boost") ~= r.boost then
			plr:SetAttribute("Boost", r.boost)
			efecto:FireAllClients("estela", nil, hrp, r.boost)
		end
		plr:SetAttribute("Planeando", r.planeando)
		j.hud += dt
		if j.hud >= 0.1 or r.aterrizaje then -- el HUD no necesita 60 cambios por segundo
			j.hud = 0
			plr:SetAttribute("Energia", math.floor(r.energia * 1000) / 1000)
			plr:SetAttribute("Distancia", math.floor(r.distancia))
			plr:SetAttribute("ZonaMult", r.mult)
			plr:SetAttribute("Puntos", r.puntos)
		end
		if r.aterrizaje then
			local res = r.aterrizaje
			plr:SetAttribute("Dinero", (plr:GetAttribute("Dinero") or 0) + res.dinero)
			plr:SetAttribute("Exp", (plr:GetAttribute("Exp") or 0) + res.exp)
			cerrarVuelo(plr, j, hrp)
			resultado:FireClient(plr, { distancia = math.floor(res.distancia), aros = res.aros, golpes = res.golpes, cofres = res.cofres,
				multiplicador = res.multiplicador, dinero = res.dinero, exp = res.exp, tiempo = res.tiempo })
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
