<Item class="StarterPlayer" referent="RBXJ000001D">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBXJ000001C">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBXJ000001B">
<Properties>
<string name="Name">Mas1Cliente</string>
</Properties>
<Item class="LocalScript" referent="RBXJ0000012">
<Properties>
<string name="Name">Efectos</string>
<ProtectedString name="Source"><![CDATA[-- Dibuja los efectos de src/Efectos.lua con ParticleEmitter. El servidor (o el juego) dispara RemoteEvent MAS1_Efecto:
--   FireClient(plr, "aro", Vector3)           -> rafaga en un punto
--   FireClient(plr, "estela", nil, parteOModelo, true/false) -> activa/desactiva un efecto continuo pegado a una parte
-- SIN PROBAR EN STUDIO.
local RS, Debris = game:GetService("ReplicatedStorage"), game:GetService("Debris")
local E = require(RS:WaitForChild("Mas1"):WaitForChild("Efectos"))
local R = RS:WaitForChild("MAS1_Efecto")

local function rgb(h) h = h:gsub("#", ""); return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16)) end
local function emisor(spec, padre)
	local pe = Instance.new("ParticleEmitter"); pe.Rate = spec.rate or 0
	pe.Lifetime = NumberRange.new(spec.life[1], spec.life[2]); pe.Speed = NumberRange.new(spec.speed[1], spec.speed[2])
	pe.SpreadAngle = Vector2.new(spec.spread, spec.spread); pe.Acceleration = Vector3.new(spec.accel[1], spec.accel[2], spec.accel[3]); pe.Drag = 2
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, spec.size[1]), NumberSequenceKeypoint.new(1, spec.size[2]) })
	local ks = {}
	for i, c in ipairs(spec.colors) do ks[#ks + 1] = ColorSequenceKeypoint.new((i - 1) / math.max(1, #spec.colors - 1), rgb(c)) end
	pe.Color = ColorSequence.new(ks); pe.LightEmission = spec.light or 0.3
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = padre; return pe
end

local continuos = {} -- [parte] = {tipo = emisor}
R.OnClientEvent:Connect(function(tipo, pos, parte, activo)
	local spec = E.TIPOS[tipo]; if not spec then return end
	if parte then -- efecto continuo pegado a una parte
		local p = parte:IsA("Model") and (parte.PrimaryPart or parte:FindFirstChildWhichIsA("BasePart")) or parte
		if not p then return end
		continuos[p] = continuos[p] or {}
		if activo == false then if continuos[p][tipo] then continuos[p][tipo]:Destroy(); continuos[p][tipo] = nil end
		elseif not continuos[p][tipo] then continuos[p][tipo] = emisor(spec, p) end
		return
	end
	local ancla = Instance.new("Part"); ancla.Anchored = true; ancla.CanCollide = false; ancla.CanQuery = false; ancla.Transparency = 1
	ancla.Size = Vector3.new(0.2, 0.2, 0.2); ancla.Position = pos; ancla.Parent = workspace
	local pe = emisor(spec, ancla); pe:Emit(spec.count or 20); Debris:AddItem(ancla, spec.life[2] + 0.5)
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000013">
<Properties>
<string name="Name">Entidades</string>
<ProtectedString name="Source"><![CDATA[-- Enemigos y cofres de «+1 de lanzamiento por segundo» vistos en el cliente. El servidor solo pone anclas invisibles en
-- Workspace.MAS1_Entidades (atributos Tipo, Vivo y, en los cofres, Dueno); aqui cada una se construye con piezas, se mueve suave y se
-- anima: los enemigos flotan con cara enfadada mirando a +Z (por donde llega el jugador) y encogen al ser golpeados; el cofre de cada
-- jugador (solo lo ve el) aletea mientras huye. Los modelos de piezas son PROVISIONALES hasta importar las mallas voxel de mas1-arte
-- (enemigos-v02). Colores de esas piezas. SIN PROBAR EN STUDIO.
local Players, RunService = game:GetService("Players"), game:GetService("RunService")
local plr = Players.LocalPlayer
local anclas = workspace:WaitForChild("MAS1_Entidades")
local vista = Instance.new("Folder")
vista.Name = "MAS1_EntidadesVista"
vista.Parent = workspace

local function rgb(h)
	h = h:gsub("#", "")
	return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16))
end

local function pieza(m, forma, tam, cf, color, neon, transp)
	local p = forma == "Wedge" and Instance.new("WedgePart") or Instance.new("Part")
	if forma ~= "Wedge" then p.Shape = Enum.PartType[forma] end
	p.Size, p.CFrame, p.Color = tam, cf, rgb(color)
	p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	p.Transparency = transp or 0
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, not neon
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = m
	return p
end

local GIRO = CFrame.Angles(0, 0, math.rad(90)) -- un cilindro de Roblox va a lo largo de X: asi queda de pie

local function cara(m, y, z, s) -- ojos pequeños con brillo y cejas enfadadas, mirando a +Z
	for _, x in ipairs({ -0.6, 0.6 }) do
		pieza(m, "Block", Vector3.new(0.45, 0.65, 0.2) * s, CFrame.new(x * s, y, z), "#1d1626")
		pieza(m, "Block", Vector3.new(0.18, 0.18, 0.22) * s, CFrame.new((x + 0.1) * s, y + 0.15 * s, z + 0.02), "#ffffff")
		pieza(m, "Block", Vector3.new(0.75, 0.18, 0.2) * s, CFrame.new(x * s, y + 0.62 * s, z) * CFrame.Angles(0, 0, x > 0 and 0.45 or -0.45), "#1d1626")
	end
	pieza(m, "Block", Vector3.new(0.9, 0.18, 0.2) * s, CFrame.new(0, y - 0.6 * s, z), "#1d1626") -- morro gruñon
end

local MODELOS = {
	nube = function(m)
		pieza(m, "Ball", Vector3.one * 4.6, CFrame.new(), "#f4f6ff")
		pieza(m, "Ball", Vector3.one * 3.4, CFrame.new(-2.6, -0.5, 0), "#e8ebfb")
		pieza(m, "Ball", Vector3.one * 3.4, CFrame.new(2.6, -0.5, 0), "#e8ebfb")
		cara(m, 0.2, 2.25, 1.3)
	end,
	nubarron = function(m)
		pieza(m, "Ball", Vector3.one * 4.8, CFrame.new(), "#7a86a8")
		pieza(m, "Ball", Vector3.one * 3.6, CFrame.new(-2.7, -0.5, 0), "#56607f")
		pieza(m, "Ball", Vector3.one * 3.6, CFrame.new(2.7, -0.5, 0), "#56607f")
		pieza(m, "Block", Vector3.new(0.6, 2.4, 0.4), CFrame.new(-0.3, -3.2, 0) * CFrame.Angles(0, 0, 0.5), "#ffd23f", true)
		pieza(m, "Block", Vector3.new(0.6, 2.4, 0.4), CFrame.new(0.2, -4.9, 0) * CFrame.Angles(0, 0, -0.5), "#ffd23f", true)
		cara(m, 0.2, 2.35, 1.3)
	end,
	globo = function(m)
		pieza(m, "Ball", Vector3.one * 4.4, CFrame.new(), "#ff5d6c")
		pieza(m, "Ball", Vector3.one * 0.7, CFrame.new(0, -2.3, 0), "#e04a58")
		pieza(m, "Cylinder", Vector3.new(3, 0.12, 0.12), CFrame.new(0, -4, 0) * GIRO, "#ffffff")
		cara(m, 0.3, 2.1, 1.2)
	end,
	cometa = function(m)
		pieza(m, "Block", Vector3.new(4, 4, 0.4), CFrame.Angles(0, 0, math.rad(45)), "#ff6b5a")
		pieza(m, "Block", Vector3.new(2.2, 2.2, 0.44), CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.rad(45)), "#ffd23f")
		for k, c in ipairs({ "#ff6b5a", "#ffd23f", "#ff6b5a" }) do
			pieza(m, "Block", Vector3.one * 0.7, CFrame.new((k % 2 == 0) and 0.4 or -0.3, -2.6 - k, 0) * CFrame.Angles(0, 0, 0.4 * k), c)
		end
		cara(m, -0.2, 0.3, 1.0)
	end,
	ovni = function(m)
		pieza(m, "Cylinder", Vector3.new(1.2, 7, 7), GIRO, "#7c5cff")
		pieza(m, "Ball", Vector3.one * 2.8, CFrame.new(0, 0.9, 0), "#bdeaff", false, 0.35)
		pieza(m, "Ball", Vector3.one * 1.7, CFrame.new(0, 1.0, 0), "#6cd36c")
		for k = 0, 5 do
			local a = k * math.pi / 3
			pieza(m, "Ball", Vector3.one * 0.6, CFrame.new(math.cos(a) * 3.2, -0.1, math.sin(a) * 3.2), "#ffe14d", true)
		end
		cara(m, 1.05, 0.85, 0.55)
	end,
	meteorito = function(m)
		pieza(m, "Block", Vector3.new(3.6, 3.2, 3.4), CFrame.Angles(0.4, 0.6, 0.2), "#4a4359")
		pieza(m, "Block", Vector3.new(2.6, 2.8, 2.6), CFrame.new(0.6, 0.4, -0.5) * CFrame.Angles(-0.3, 0.2, 0.5), "#605670")
		pieza(m, "Wedge", Vector3.new(1.2, 2.6, 3.4), CFrame.new(-0.5, 1.6, -2.4) * CFrame.Angles(0.6, 0, 0), "#ff9d00", true)
		pieza(m, "Wedge", Vector3.new(0.9, 2.0, 2.6), CFrame.new(0.7, 1.4, -2.2) * CFrame.Angles(0.8, 0, 0), "#ff3d00", true)
		cara(m, 0.1, 2.05, 1.1)
	end,
	cofre = function(m)
		pieza(m, "Block", Vector3.new(3.4, 2.2, 2.4), CFrame.new(), "#8a5a34")
		pieza(m, "Block", Vector3.new(3.5, 0.8, 2.5), CFrame.new(0, 1.45, 0), "#a8703f")
		pieza(m, "Block", Vector3.new(0.5, 3.1, 2.6), CFrame.new(0, 0.4, 0), "#ffc42e")
		pieza(m, "Block", Vector3.new(0.7, 0.8, 0.3), CFrame.new(0, 0.6, 1.3), "#ffd23f", true)
		for _, s in ipairs({ -1, 1 }) do -- alas que aletean (las mueve el bucle de abajo)
			local ala = pieza(m, "Wedge", Vector3.new(0.3, 1.8, 3.2), CFrame.new(s * 2.4, 0.6, 0) * CFrame.Angles(0, 0, s * 0.3), "#ffffff")
			ala.Name = s < 0 and "AlaIzq" or "AlaDer"
		end
	end,
}

local vistos = {} -- [ancla] = { m, base (CFrame suavizado), fase, alas, vivo }

local function crear(a)
	local hacer = MODELOS[a:GetAttribute("Tipo") or ""]
	if not hacer or vistos[a] then return end
	if a:GetAttribute("Tipo") == "cofre" and a:GetAttribute("Dueno") ~= plr.UserId then return end -- cada uno ve solo su cofre
	local m = Instance.new("Model")
	m.Name = a:GetAttribute("Tipo")
	hacer(m)
	m.WorldPivot = CFrame.new() -- las piezas se hacen alrededor del origen: PivotTo y ScaleTo trabajan desde ahi
	m.Parent = vista
	local alas = {}
	for _, n in ipairs({ "AlaIzq", "AlaDer" }) do
		local p = m:FindFirstChild(n)
		if p then alas[#alas + 1] = { p = p, base = p.CFrame, s = n == "AlaIzq" and -1 or 1 } end
	end
	vistos[a] = { m = m, pos = a.Position, fase = math.random() * 6.28, alas = alas, escala = 1 }
end

local function quitar(a)
	local v = vistos[a]
	if v then
		v.m:Destroy()
		vistos[a] = nil
	end
end

for _, a in ipairs(anclas:GetChildren()) do crear(a) end
anclas.ChildAdded:Connect(crear)
anclas.ChildRemoved:Connect(quitar)

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for a, v in pairs(vistos) do
		v.pos = v.pos:Lerp(a.Position, 1 - math.exp(-12 * dt)) -- los cofres se mueven: suave aunque el servidor mande a saltos
		local vivo = a:GetAttribute("Vivo") ~= false
		local objetivo = vivo and 1 or 0.05 -- golpeado: encoge hasta desaparecer y vuelve al reaparecer
		v.escala += (objetivo - v.escala) * (1 - math.exp(-10 * dt))
		local cf = CFrame.new(v.pos + Vector3.new(0, math.sin(t * 2 + v.fase) * 0.6, 0)) * CFrame.Angles(0, math.sin(t + v.fase) * 0.15, 0)
		if math.abs(v.m:GetScale() - v.escala) > 0.01 then v.m:ScaleTo(math.max(0.05, v.escala)) end
		v.m:PivotTo(cf)
		for _, ala in ipairs(v.alas) do
			ala.p.CFrame = cf * ala.base * CFrame.Angles(0, 0, ala.s * math.sin(t * 14) * 0.6)
		end
		for _, p in ipairs(v.m:GetDescendants()) do
			if p:IsA("BasePart") then p.LocalTransparencyModifier = v.escala < 0.08 and 1 or 0 end
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000014">
<Properties>
<string name="Name">HudVuelo</string>
<ProtectedString name="Source"><![CDATA[-- HUD de vuelo de «+1 de lanzamiento por segundo». Lee atributos del jugador local (los pone el juego o DemoVisual.server.lua):
-- Energia (0-1), Potencia, Puntos, Distancia (m), ZonaMult, Aros, ArosTotal, Mascota (nombre), MascotaBonus (numero). SIN PROBAR EN STUDIO.
local Players, RS, UIS = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local plr = Players.LocalPlayer
local T = require(script.Parent:WaitForChild("Tema"))
local C, n = T.col, T.n
local accion = RS:WaitForChild("MAS1_Accion", 3) -- RemoteEvent opcional (puno / patada / turbo)

local gui = n("ScreenGui", { Name = "Mas1Hud", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local function fmt(x) -- 12480 -> "12.480"
	local s = tostring(math.floor(x + 0.5)); local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return (out:gsub("^%.", ""))
end
local function pop(label) -- pequeno rebote al cambiar un numero
	label.TextSize = label:GetAttribute("base") * 1.25
	TweenService:Create(label, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = label:GetAttribute("base") }):Play()
end
local function numero(padre, texto, color) -- etiqueta pequeña + número grande; devuelve el número
	T.texto(padre, { Text = string.upper(texto), TextSize = 17, Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(14, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color or C.crema })
	local l = T.texto(padre, { Text = "0", TextSize = 42, Size = UDim2.new(1, -24, 0, 46), Position = UDim2.fromOffset(14, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color or C.crema })
	l:SetAttribute("base", 42); return l
end

-- Energia (arriba al centro)
local pEn = T.panel(gui, { Size = UDim2.fromOffset(620, 84), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 18) }, C.crema)
T.texto(pEn, { Text = "ENERGÍA", TextSize = 20, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromOffset(200, 24), Position = UDim2.fromOffset(18, 6), TextXAlignment = Enum.TextXAlignment.Left })
local tEnPct = T.texto(pEn, { Text = "100%", TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromOffset(120, 28), Position = UDim2.new(1, -138, 0, 4), TextXAlignment = Enum.TextXAlignment.Right })
local bEn = T.barra(pEn, { Size = UDim2.new(1, -36, 0, 30), Position = UDim2.fromOffset(18, 40) })

local pPun = T.panel(gui, { Size = UDim2.fromOffset(300, 84), Position = UDim2.fromOffset(24, 18) }, C.rosa)
local tPun = numero(pPun, "puntos del vuelo")
local pDis = T.panel(gui, { Size = UDim2.fromOffset(300, 84), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 18) }, C.cielo)
local tDis = numero(pDis, "distancia", C.tinta); tDis.TextXAlignment = Enum.TextXAlignment.Right
local pPot = T.panel(gui, { Size = UDim2.fromOffset(250, 84), Position = UDim2.fromOffset(24, 122) }, C.menta)
local tPot = numero(pPot, "potencia")
local pAro = T.panel(gui, { Size = UDim2.fromOffset(250, 84), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 122) }, C.crema)
local tAro = numero(pAro, "aros", C.tinta)

-- Multiplicador de zona (centro, inclinado)
local pMul = T.panel(gui, { Size = UDim2.fromOffset(200, 96), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 114), Rotation = -3 }, C.sol)
T.texto(pMul, { Text = "ZONA", TextSize = 17, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 6) })
local tMul = T.texto(pMul, { Text = "x1", TextSize = 58, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 24) }); tMul:SetAttribute("base", 58)

-- Mascota (abajo a la izquierda)
local pMas = T.panel(gui, { Size = UDim2.fromOffset(280, 92), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -34) }, C.crema)
T.texto(pMas, { Text = "MASCOTA", TextSize = 16, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(14, 6), TextXAlignment = Enum.TextXAlignment.Left })
local tMas = T.texto(pMas, { Text = "—", TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, -24, 0, 32), Position = UDim2.fromOffset(14, 22), TextXAlignment = Enum.TextXAlignment.Left })
local chip = T.panel(pMas, { Size = UDim2.fromOffset(150, 28), Position = UDim2.fromOffset(14, 56) }, C.menta); chip.UIStroke.Thickness = 3
local tChip = T.texto(chip, { Text = "x1 ganancias", TextSize = 18, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromScale(1, 1) })

-- Botones (movil y escritorio; en escritorio: clic = puño, E = patada, W = turbo; son PROPUESTAS)
local function lanzar(nombre) if accion then accion:FireServer(nombre) end end
local bPuno = T.boton(gui, { Size = UDim2.fromOffset(130, 130), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -150, 1, -60), Text = "PUÑO" }, C.rosa, function() lanzar("puno") end)
local bPat = T.boton(gui, { Size = UDim2.fromOffset(110, 110), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -34, 1, -130), Text = "PATADA" }, C.sol, function() lanzar("patada") end); bPat.TextColor3 = C.tinta
local bTur = T.boton(gui, { Size = UDim2.fromOffset(100, 100), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -300, 1, -34), Text = "TURBO" }, C.menta, function() lanzar("turbo") end); bTur.TextColor3 = C.tinta
if not UIS.TouchEnabled then
	for _, b in ipairs({ bPuno, bPat, bTur }) do b.Active = false end
	UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 then lanzar("puno") elseif i.KeyCode == Enum.KeyCode.E then lanzar("patada") elseif i.KeyCode == Enum.KeyCode.W then lanzar("turbo") end
	end)
end

-- Actualizacion desde atributos
local ultimo = {}
local function refrescar()
	local en = math.clamp(plr:GetAttribute("Energia") or 1, 0, 1)
	bEn.set(en, en > 0.5 and C.sol or (en > 0.2 and Color3.fromRGB(255, 150, 40) or C.rosa)); tEnPct.Text = math.floor(en * 100 + 0.5) .. "%"
	for _, d in ipairs({ { "Puntos", tPun }, { "Distancia", tDis }, { "Potencia", tPot } }) do
		local v = plr:GetAttribute(d[1]) or 0
		d[2].Text = (d[1] == "Distancia" and (fmt(v) .. " m")) or (d[1] == "Potencia" and ("+" .. fmt(v))) or fmt(v)
		if ultimo[d[1]] and ultimo[d[1]] ~= v then pop(d[2]) end; ultimo[d[1]] = v
	end
	local m = plr:GetAttribute("ZonaMult") or 1; tMul.Text = "x" .. m
	if ultimo.m and ultimo.m ~= m then pop(tMul) end; ultimo.m = m
	tAro.Text = (plr:GetAttribute("Aros") or 0) .. " / " .. (plr:GetAttribute("ArosTotal") or 0)
	tMas.Text = plr:GetAttribute("Mascota") or "—"; tChip.Text = "x" .. tostring(plr:GetAttribute("MascotaBonus") or 1) .. " ganancias"
end
for _, a in ipairs({ "Energia", "Potencia", "Puntos", "Distancia", "ZonaMult", "Aros", "ArosTotal", "Mascota", "MascotaBonus" }) do plr:GetAttributeChangedSignal(a):Connect(refrescar) end
refrescar()
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000015">
<Properties>
<string name="Name">Inventario</string>
<ProtectedString name="Source"><![CDATA[-- Inventario de «+1 de lanzamiento por segundo»: pestañas MASCOTAS (equipar hasta 3), HUEVOS (abrir con dinero) y ALAS (comprar y
-- equipar). Revelado del huevo con rebote y color de rareza. Formas de eventos en CONTRATO.md (MAS1_Inventario, MAS1_Huevo,
-- MAS1_Accion). La UI NO calcula nada: manda intenciones y pinta lo que diga el servidor. SIN PROBAR EN STUDIO.
local Players, RS, UIS, TweenService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("UserInputService"), game:GetService("TweenService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local M = require(Mas1:WaitForChild("Mascotas"))
local okA, Alas = pcall(function() return require(Mas1:WaitForChild("Alas", 3)) end) -- hito 6: lista de alas con precio y requisitos
if not okA then Alas = nil end
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local C, n = T.col, T.n
local accion, evInv, evHuevo = Red.evento("MAS1_Accion"), Red.evento("MAS1_Inventario"), Red.evento("MAS1_Huevo")

local COLOR = { comun = Color3.fromRGB(190, 190, 200), poco_comun = Color3.fromRGB(110, 210, 120), raro = Color3.fromRGB(80, 160, 255),
	epico = Color3.fromRGB(170, 100, 255), legendario = Color3.fromRGB(255, 190, 40), mitico = Color3.fromRGB(255, 80, 140), robux = Color3.fromRGB(255, 120, 40) }
local NOMBRE = { comun = "Común", poco_comun = "Poco común", raro = "Raro", epico = "Épico", legendario = "Legendario", mitico = "Mítico", robux = "Robux" }
local STAT = { impulso = "Impulso", resistencia = "Resistencia", dinero = "Dinero", exp = "Exp" }

local inv = { mascotas = {}, equipadas = {}, alas = {}, alaEquipada = nil }

local gui = n("ScreenGui", { Name = "Mas1Inventario", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local panel, pestana = nil, "mascotas"
local pintar

local function bonusTexto(p)
	local t = {}
	for _, s in ipairs(M.STATS) do if p.bonus[s] then t[#t + 1] = STAT[s] .. " +" .. p.bonus[s] .. "%" end end
	return table.concat(t, "  ·  ")
end

local function tarjeta(padre, p, cant, x, y, equipada)
	local c = T.panel(padre, { Size = UDim2.fromOffset(250, 150), Position = UDim2.fromOffset(x, y) }, equipada and C.sol or C.morado)
	n("Frame", { Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = COLOR[p.rareza], BorderSizePixel = 0 }, c)
	T.texto(c, { Text = p.nombre, TextSize = 24, TextColor3 = equipada and C.tinta or C.crema, TextStrokeTransparency = equipada and 1 or 0.55, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 14) })
	T.texto(c, { Text = NOMBRE[p.rareza] .. (cant > 1 and ("  x" .. cant) or ""), TextSize = 18, TextColor3 = COLOR[p.rareza], Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 44) })
	T.texto(c, { Text = bonusTexto(p), TextSize = 16, TextWrapped = true, TextColor3 = equipada and C.tinta or C.crema, TextStrokeTransparency = equipada and 1 or 0.55, Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 68) })
	local b = T.boton(c, { Size = UDim2.fromOffset(130, 34), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Text = equipada and "QUITAR" or "EQUIPAR" }, equipada and C.rosa or C.menta, function()
		accion:FireServer(equipada and "desequipar" or "equipar", "mascota", p.id)
	end)
	b.TextSize = 18
	return c
end

local function paginaMascotas(cont)
	local y = 10
	T.texto(cont, { Text = string.format("EQUIPADAS %d / 3", #inv.equipadas), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y) })
	y = y + 36
	local x = 10
	for _, id in ipairs(inv.equipadas) do
		local p = M.get(id)
		if p then tarjeta(cont, p, 1, x, y, true); x = x + 262 end
	end
	if #inv.equipadas == 0 then T.texto(cont, { Text = "Ninguna: equipa mascotas para ganar bonus.", TextSize = 20, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y + 8) }) end
	y = y + 168
	T.texto(cont, { Text = "TUS MASCOTAS", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y) })
	y = y + 36
	local col, hay = 0, false
	for _, p in ipairs(M.LISTA) do
		local cant = inv.mascotas[p.id] or 0
		if cant > 0 then
			hay = true
			tarjeta(cont, p, cant, 10 + col * 262, y, false)
			col = col + 1
			if col == 3 then col, y = 0, y + 162 end
		end
	end
	if not hay then T.texto(cont, { Text = "Aún no tienes mascotas. ¡Abre un huevo!", TextSize = 22, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y) }) end
	cont.CanvasSize = UDim2.fromOffset(0, y + (col > 0 and 170 or 10) + 20)
end

local function paginaHuevos(cont)
	local dinero = plr:GetAttribute("Dinero") or 0
	local y = 10
	T.texto(cont, { Text = "Los huevos cuestan dinero. Más rareza, mejores mascotas.", TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, y) })
	y = y + 36
	for _, r in ipairs({ "comun", "poco_comun", "raro", "epico", "legendario", "mitico" }) do
		local precio = M.PRECIO_HUEVO and M.PRECIO_HUEVO[r] -- lo pone el servidor en el hito 4
		local f = T.panel(cont, { Size = UDim2.new(1, -30, 0, 70), Position = UDim2.fromOffset(10, y) }, C.morado)
		n("Frame", { Size = UDim2.fromOffset(12, 70), BackgroundColor3 = COLOR[r], BorderSizePixel = 0 }, f)
		T.texto(f, { Text = "Huevo " .. string.lower(NOMBRE[r]), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLOR[r], Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromOffset(28, 0) })
		local alcanza = precio and dinero >= precio
		local b = T.boton(f, { Size = UDim2.fromOffset(190, 46), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Text = precio and ("ABRIR · " .. precio) or "ABRIR" },
			alcanza and C.sol or Color3.fromRGB(110, 100, 130), function() accion:FireServer("abrirHuevo", r) end)
		b.TextSize = 22
		y = y + 82
	end
	cont.CanvasSize = UDim2.fromOffset(0, y + 10)
end

local function paginaAlas(cont)
	local y = 10
	local lista = Alas and Alas.LISTA or {}
	if #lista == 0 then
		T.texto(cont, { Text = "Las alas llegan pronto.", TextSize = 24, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, y) })
		return
	end
	for _, a in ipairs(lista) do
		local tiene = table.find(inv.alas, a.id) ~= nil
		local puesta = inv.alaEquipada == a.id
		local f = T.panel(cont, { Size = UDim2.new(1, -30, 0, 84), Position = UDim2.fromOffset(10, y) }, puesta and C.sol or C.morado)
		T.texto(f, { Text = a.nombre, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = puesta and C.tinta or C.crema, TextStrokeTransparency = puesta and 1 or 0.55, Size = UDim2.new(0.55, 0, 0, 36), Position = UDim2.fromOffset(16, 6) })
		T.texto(f, { Text = a.requisito or "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextColor3 = puesta and C.tinta or C.crema, TextStrokeTransparency = puesta and 1 or 0.55, Size = UDim2.new(0.55, 0, 0, 36), Position = UDim2.fromOffset(16, 42) })
		local texto = puesta and "QUITAR" or (tiene and "EQUIPAR" or (a.precio and ("COMPRAR · " .. a.precio) or "BLOQUEADA"))
		local b = T.boton(f, { Size = UDim2.fromOffset(200, 48), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Text = texto },
			puesta and C.rosa or (tiene and C.menta or C.sol), function()
				if puesta then accion:FireServer("desequipar", "ala", a.id)
				elseif tiene then accion:FireServer("equipar", "ala", a.id)
				else accion:FireServer("comprarAla", a.id) end
			end)
		b.TextSize = 20
		y = y + 96
	end
	cont.CanvasSize = UDim2.fromOffset(0, y + 10)
end

pintar = function()
	if not panel then return end
	local cont = panel:FindFirstChild("Contenido")
	if cont then cont:Destroy() end
	cont = n("ScrollingFrame", { Name = "Contenido", Size = UDim2.new(1, -30, 1, -140), Position = UDim2.fromOffset(15, 120), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.fromOffset(0, 600), AutomaticCanvasSize = Enum.AutomaticSize.None }, panel)
	if pestana == "mascotas" then paginaMascotas(cont) elseif pestana == "huevos" then paginaHuevos(cont) else paginaAlas(cont) end
end

local function cerrar() if panel then panel:Destroy(); panel = nil end end

local function abrir()
	if plr:GetAttribute("EnVuelo") == true then return end
	if panel then cerrar() return end
	panel = T.panel(gui, { Size = UDim2.fromOffset(820, 640), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, C.violeta)
	T.texto(panel, { Text = "MASCOTAS Y ALAS", TextSize = 38, TextColor3 = C.sol, Size = UDim2.new(1, -80, 0, 48), Position = UDim2.fromOffset(20, 10), TextXAlignment = Enum.TextXAlignment.Left })
	local x = n("TextButton", { Text = "X", Font = T.fuente, TextSize = 26, TextColor3 = C.crema, BackgroundColor3 = C.rosa, Size = UDim2.fromOffset(46, 46), Position = UDim2.new(1, -58, 0, 10), BorderSizePixel = 0 }, panel)
	n("UICorner", { CornerRadius = UDim.new(1, 0) }, x); n("UIStroke", { Color = C.tinta, Thickness = 4 }, x)
	x.MouseButton1Click:Connect(cerrar)
	for i, par in ipairs({ { "mascotas", "MASCOTAS" }, { "huevos", "HUEVOS" }, { "alas", "ALAS" } }) do
		local activa = pestana == par[1]
		local b = n("TextButton", { Text = par[2], Font = T.fuente, TextSize = 24, TextColor3 = activa and C.tinta or C.crema, BackgroundColor3 = activa and C.sol or C.morado,
			Size = UDim2.fromOffset(150, 44), Position = UDim2.fromOffset(20 + (i - 1) * 160, 66), BorderSizePixel = 0 }, panel)
		n("UICorner", { CornerRadius = UDim.new(0, 12) }, b); n("UIStroke", { Color = C.tinta, Thickness = 4 }, b)
		b.MouseButton1Click:Connect(function() pestana = par[1]; cerrar(); abrir() end)
	end
	pintar()
end

-- boton de la esquina para abrir el inventario (y tecla B)
local btn = T.boton(gui, { Size = UDim2.fromOffset(170, 64), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 20, 1, -20), Text = "MASCOTAS" }, C.violeta, abrir)
local function verBtn() btn.Visible = plr:GetAttribute("EnVuelo") ~= true end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(function() verBtn(); if plr:GetAttribute("EnVuelo") == true then cerrar() end end)
verBtn()
UIS.InputBegan:Connect(function(i, gp) if not gp and i.KeyCode == Enum.KeyCode.B then abrir() end end)

evInv.OnClientEvent:Connect(function(d)
	inv = { mascotas = d.mascotas or {}, equipadas = d.equipadas or {}, alas = d.alas or {}, alaEquipada = d.alaEquipada }
	pintar()
end)
plr:GetAttributeChangedSignal("Dinero"):Connect(function() if panel and pestana == "huevos" then pintar() end end)

-- revelado del huevo: sacude, estalla y muestra la mascota con el color de su rareza
evHuevo.OnClientEvent:Connect(function(d)
	local p = M.get(d.mascotaId)
	if not p then return end
	local fondo = n("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.tinta, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 50 }, gui)
	local huevo = T.texto(fondo, { Text = "🥚", TextSize = 140, Size = UDim2.fromOffset(200, 200), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), ZIndex = 51 })
	task.spawn(function()
		for i = 1, 10 do huevo.Rotation = (i % 2 == 0 and 14 or -14); task.wait(0.07) end
		huevo:Destroy()
		local tarj = T.panel(fondo, { Size = UDim2.fromOffset(420, 300), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), ZIndex = 52 }, COLOR[p.rareza])
		T.texto(tarj, { Text = d.nueva and "¡NUEVA!" or "¡OTRA VEZ!", TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 12), ZIndex = 53 })
		T.texto(tarj, { Text = p.nombre, TextSize = 44, Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 60), ZIndex = 53 })
		T.texto(tarj, { Text = string.upper(NOMBRE[p.rareza]), TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 124), ZIndex = 53 })
		T.texto(tarj, { Text = bonusTexto(p), TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -30, 0, 70), Position = UDim2.fromOffset(15, 172), ZIndex = 53 })
		tarj.Size = UDim2.fromOffset(120, 90)
		TweenService:Create(tarj, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(420, 300) }):Play()
		task.wait(3)
		fondo:Destroy()
	end)
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000016">
<Properties>
<string name="Name">Rebirth</string>
<ProtectedString name="Source"><![CDATA[-- Rebirth y avisos de «+1 de lanzamiento por segundo»: boton REBIRTH (solo en tierra) con un panel de confirmacion que muestra
-- potencia, coste y rebirths; y los avisos de texto del servidor (MAS1_Aviso). El servidor decide: aqui solo se manda "rebirth".
-- Reinicia SOLO la potencia; conserva alas, mascotas, puntos y desbloqueos. Lee atributos Potencia, CosteRebirth, Rebirths, Entreno.
-- SIN PROBAR EN STUDIO.
local Players, RS, TweenService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("TweenService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local C, n = T.col, T.n
local accion, aviso = Red.evento("MAS1_Accion"), Red.evento("MAS1_Aviso")

local gui = n("ScreenGui", { Name = "Mas1Rebirth", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 15 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local function fmt(x)
	local s = tostring(math.floor((x or 0) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return (out:gsub("^%.", ""))
end

-- avisos de texto (arriba, bajo la energia)
local toastActual
aviso.OnClientEvent:Connect(function(texto)
	if toastActual then toastActual:Destroy() end
	local p = T.panel(gui, { Size = UDim2.fromOffset(520, 64), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -90) }, C.rosa)
	toastActual = p
	T.texto(p, { Text = tostring(texto), TextSize = 26, TextWrapped = true, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0) })
	TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 120) }):Play()
	task.delay(3, function()
		if toastActual == p then
			TweenService:Create(p, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 0, -90) }):Play()
			task.delay(0.3, function() if p.Parent then p:Destroy() end if toastActual == p then toastActual = nil end end)
		end
	end)
end)

-- panel de rebirth
local panel
local function cerrar() if panel then panel:Destroy(); panel = nil end end

local function abrir()
	if plr:GetAttribute("EnVuelo") == true then return end
	if panel then cerrar() return end
	local pot, coste, rb = plr:GetAttribute("Potencia") or 0, plr:GetAttribute("CosteRebirth") or 500, plr:GetAttribute("Rebirths") or 0
	local alcanza = pot >= coste
	panel = T.panel(gui, { Size = UDim2.fromOffset(560, 420), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, C.violeta)
	T.texto(panel, { Text = "REBIRTH", TextSize = 52, TextColor3 = C.sol, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 12) })
	T.texto(panel, { Text = string.format("Rebirths: %d", rb), TextSize = 26, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 78) })
	local barra = T.barra(panel, { Size = UDim2.new(1, -60, 0, 44), Position = UDim2.fromOffset(30, 124) })
	barra.set(math.min(pot / coste, 1), alcanza and C.menta or C.sol)
	T.texto(panel, { Text = string.format("Potencia %s / %s", fmt(pot), fmt(coste)), TextSize = 28, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 176) })
	T.texto(panel, { Text = "Reinicia SOLO tu potencia. Conservas alas, mascotas y puntos. Entrenas más rápido y tus alas crecen.",
		TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -60, 0, 80), Position = UDim2.fromOffset(30, 220) })
	local ok = T.boton(panel, { Size = UDim2.fromOffset(250, 66), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.3, 0, 1, -24), Text = alcanza and "¡REBIRTH!" or "FALTA POTENCIA" },
		alcanza and C.menta or Color3.fromRGB(110, 100, 130), function()
			if alcanza then accion:FireServer("rebirth"); cerrar() end
		end)
	T.boton(panel, { Size = UDim2.fromOffset(200, 66), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.76, 0, 1, -24), Text = "CERRAR" }, C.rosa, cerrar)
end

local btn = T.boton(gui, { Size = UDim2.fromOffset(170, 64), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 210, 1, -20), Text = "REBIRTH" }, C.rosa, abrir)
local function ver()
	local vuela = plr:GetAttribute("EnVuelo") == true
	btn.Visible = not vuela
	if vuela then cerrar() end
end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(ver)
ver()
-- si el rebirth se hace, el panel se cierra solo; al subir el contador se anima el boton
plr:GetAttributeChangedSignal("Rebirths"):Connect(function()
	cerrar()
	btn.Size = UDim2.fromOffset(210, 80)
	TweenService:Create(btn, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(170, 64) }):Play()
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000017">
<Properties>
<string name="Name">Resultados</string>
<ProtectedString name="Source"><![CDATA[-- Pantalla de resultados del vuelo de «+1 de lanzamiento por segundo»: aparece al aterrizar (MAS1_Resultado), cuenta hacia arriba
-- la distancia, el multiplicador de zona, el dinero y la exp, y ofrece ¡OTRA VEZ! (lanzar de nuevo). Sustituye al cartel provisional
-- de VueloControl. Datos de CONTRATO.md. SIN PROBAR EN STUDIO.
local Players, RS, TweenService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("TweenService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local accion, resultado = Red.evento("MAS1_Accion"), Red.evento("MAS1_Resultado")

local gui = T.n("ScreenGui", { Name = "Mas1Resultados", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)
local actual -- panel abierto

local function cerrar()
	if actual then actual:Destroy(); actual = nil end
end

local function fila(padre, y, nombre, color)
	local f = T.panel(padre, { Size = UDim2.new(1, -40, 0, 54), Position = UDim2.new(0, 20, 0, y) }, color)
	T.texto(f, { Text = nombre, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.5, -14, 1, 0), Position = UDim2.fromOffset(16, 0) })
	local v = T.texto(f, { Text = "0", TextSize = 32, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.5, -16, 1, 0), Position = UDim2.new(0.5, 0, 0, 0) })
	return v
end

-- cuenta de 0 al valor en 'dur' segundos, con formato opcional
local function contar(etiqueta, valor, dur, formato)
	task.spawn(function()
		local t0 = os.clock()
		while etiqueta.Parent do
			local a = math.min((os.clock() - t0) / dur, 1)
			local x = 1 - (1 - a) * (1 - a) -- frena al final
			etiqueta.Text = formato(math.floor(valor * x + 0.5))
			if a >= 1 then break end
			task.wait()
		end
	end)
end

resultado.OnClientEvent:Connect(function(r)
	cerrar()
	local raiz = T.n("Frame", { Size = UDim2.fromOffset(560, 470), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 1.6), BackgroundTransparency = 1 }, gui)
	actual = raiz
	local p = T.panel(raiz, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0) }, T.col.violeta)
	T.texto(p, { Text = "¡ATERRIZAJE!", TextSize = 50, TextColor3 = T.col.sol, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 12) })
	local d = fila(p, 90, "Distancia", T.col.morado)
	local m = fila(p, 154, "Zona", T.col.cielo)
	local di = fila(p, 218, "Dinero", T.col.menta)
	local ex = fila(p, 282, "Exp", T.col.rosa)
	contar(d, r.distancia or 0, 0.9, function(n) return n .. " m" end)
	m.Text = "x" .. (r.multiplicador or 1)
	contar(di, r.dinero or 0, 1.2, function(n) return "+" .. n end)
	contar(ex, r.exp or 0, 1.2, function(n) return "+" .. n end)
	T.texto(p, { Text = string.format("%d aros  ·  %d golpes  ·  %d cofres", r.aros or 0, r.golpes or 0, r.cofres or 0), TextSize = 22, TextColor3 = T.col.crema, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 346) })
	T.boton(raiz, { Size = UDim2.fromOffset(280, 70), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, -62), Text = "¡OTRA VEZ!" }, T.col.sol, function()
		cerrar()
		accion:FireServer("lanzar")
	end)
	TweenService:Create(raiz, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.45) }):Play()
	task.delay(12, function() if actual == raiz then cerrar() end end)
end)

-- al volver a volar se esconde
plr:GetAttributeChangedSignal("EnVuelo"):Connect(function()
	if plr:GetAttribute("EnVuelo") == true then cerrar() end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000018">
<Properties>
<string name="Name">Tema</string>
<ProtectedString name="Source"><![CDATA[-- Tema de interfaz de «+1 de lanzamiento por segundo»: paneles gruesos con contorno oscuro y sombra dura, colores vivos, tipografia redondeada.
-- Todo por codigo, sin imagenes. SIN PROBAR EN STUDIO.
local TweenService = game:GetService("TweenService")
local T = {}
T.col = {
	tinta = Color3.fromRGB(28, 21, 48), crema = Color3.fromRGB(255, 247, 224), sol = Color3.fromRGB(255, 210, 63), cielo = Color3.fromRGB(78, 200, 255),
	menta = Color3.fromRGB(61, 220, 151), rosa = Color3.fromRGB(255, 93, 143), violeta = Color3.fromRGB(124, 92, 255), morado = Color3.fromRGB(58, 44, 99),
}
T.fuente = Enum.Font.FredokaOne

local function n(clase, props, padre)
	local o = Instance.new(clase); for k, v in pairs(props or {}) do o[k] = v end; if padre then o.Parent = padre end; return o
end
T.n = n

function T.escala(gui)
	local sc = n("UIScale", {}, gui)
	local function aj() local cam = workspace.CurrentCamera; if cam then sc.Scale = math.clamp(cam.ViewportSize.Y / 900, 0.55, 1.4) end end
	aj(); if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(aj) end
end

-- Panel con contorno oscuro (UIStroke 5), esquinas redondeadas y sombra dura debajo
function T.panel(padre, props, color)
	props = props or {}
	local sombra = n("Frame", { Size = props.Size, Position = props.Position, AnchorPoint = props.AnchorPoint, Rotation = props.Rotation or 0, BackgroundColor3 = T.col.tinta, BorderSizePixel = 0 }, padre)
	sombra.Position = props.Position + UDim2.fromOffset(0, 7); n("UICorner", { CornerRadius = UDim.new(0, 18) }, sombra)
	props.BackgroundColor3 = color or T.col.violeta; props.BorderSizePixel = 0
	local p = n("Frame", props, padre)
	n("UICorner", { CornerRadius = UDim.new(0, 18) }, p); n("UIStroke", { Color = T.col.tinta, Thickness = 5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
	p.Destroying:Connect(function() sombra:Destroy() end)
	return p, sombra
end

function T.texto(padre, props)
	props = props or {}; props.BackgroundTransparency = 1; props.Font = props.Font or T.fuente
	props.TextColor3 = props.TextColor3 or T.col.crema; props.TextSize = props.TextSize or 24
	props.TextStrokeColor3 = props.TextStrokeColor3 or T.col.tinta; props.TextStrokeTransparency = props.TextStrokeTransparency or 0.55
	return n("TextLabel", props, padre)
end

function T.barra(padre, props)
	local marco = n("Frame", props, padre); marco.BackgroundColor3 = T.col.morado; marco.BorderSizePixel = 0; marco.ClipsDescendants = true
	n("UICorner", { CornerRadius = UDim.new(0, 18) }, marco); n("UIStroke", { Color = T.col.tinta, Thickness = 5 }, marco)
	local relleno = n("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.col.sol, BorderSizePixel = 0 }, marco)
	n("UICorner", { CornerRadius = UDim.new(0, 14) }, relleno)
	local b = { marco = marco, relleno = relleno }
	function b.set(p, color)
		TweenService:Create(relleno, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp(p, 0, 1), 1) }):Play()
		if color then relleno.BackgroundColor3 = color end
	end
	return b
end

-- Boton redondo grande (movil): llama a alAplastar al pulsarlo y se hunde unos pixeles
function T.boton(padre, props, color, alAplastar)
	local b = n("TextButton", props, padre); b.BackgroundColor3 = color; b.AutoButtonColor = false; b.BorderSizePixel = 0; b.Font = T.fuente
	b.TextColor3 = T.col.crema; b.TextStrokeColor3 = T.col.tinta; b.TextStrokeTransparency = 0.4; b.TextScaled = true
	n("UICorner", { CornerRadius = UDim.new(1, 0) }, b); n("UIStroke", { Color = T.col.tinta, Thickness = 6 }, b)
	b.MouseButton1Down:Connect(function() b.Size = b.Size - UDim2.fromOffset(6, 6); if alAplastar then alAplastar() end end)
	b.MouseButton1Up:Connect(function() b.Size = props.Size end)
	b.MouseLeave:Connect(function() b.Size = props.Size end) -- si el dedo se desliza fuera no queda hundido
	return b
end

return T
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000019">
<Properties>
<string name="Name">VueloControl</string>
<ProtectedString name="Source"><![CDATA[-- Control del vuelo en el cliente de «+1 de lanzamiento por segundo». El cliente mueve su propio personaje (asi responde al instante)
-- con src/Manejo.lua; el servidor (server/Partida.server.lua) lleva la energia, el boost y los puntos, y devuelve atras al que vaya
-- mas rapido de lo permitido. Aqui tambien van la camara de persecucion (se aleja con la velocidad, abre el campo de vision con el
-- boost y se inclina un poco en los giros), un boton LANZAR y un cartel de resultado PROVISIONALES (la interfaz buena la hace
-- Claude nube con MAS1_Resultado y los atributos de CONTRATO.md).
-- Mandos: W o joystick arriba = boost; A/D = a los lados; Espacio o salto = subir; S, Ctrl o joystick abajo = bajar;
-- F o el boton LANZAR = lanzarse (en el suelo). Golpear: clic o los botones del HUD (client/HudVuelo.client.lua). SIN PROBAR EN STUDIO.
local Players, RS, RunService, UIS = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService"), game:GetService("UserInputService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local V = require(Mas1:WaitForChild("Vuelo"))
local Manejo = require(Mas1:WaitForChild("Manejo"))
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local accion = Red.evento("MAS1_Accion")
local C = V.CFG
local cam = workspace.CurrentCamera

-- mandos: el modulo de control de Roblox da el mismo vector con teclado, joystick de movil y mando
local controles
task.spawn(function()
	local ok, pm = pcall(function() return require(plr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")) end)
	if ok and pm then controles = pm:GetControls() end
end)
local ultimoSalto = 0
UIS.JumpRequest:Connect(function() ultimoSalto = os.clock() end) -- Espacio y boton de salto del movil y del mando

local function mandos()
	local mv = controles and controles:GetMoveVector() or Vector3.zero
	return {
		lateral = math.clamp(mv.X, -1, 1),
		boost = mv.Z < -0.5,
		bajar = mv.Z > 0.5 or UIS:IsKeyDown(Enum.KeyCode.LeftControl),
		subir = UIS:IsKeyDown(Enum.KeyCode.Space) or os.clock() - ultimoSalto < 0.25,
	}
end

-- vuelo: el personaje en estado Physics, con una velocidad lineal y una orientacion que se fijan cada fotograma
local vuelo
local esperaFin = false -- aterrizo aqui: no volver a empezar hasta que el servidor cierre el vuelo
local camPos, fov = nil, 70

local function empezar()
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) or hum.Health <= 0 then return end
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	hum.AutoRotate = false
	local att = Instance.new("Attachment")
	att.Name = "Mas1Vuelo"
	att.Parent = hrp
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.VectorVelocity = Vector3.zero
	lv.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = math.huge
	ao.Responsiveness = 30
	ao.CFrame = hrp.CFrame.Rotation
	ao.Parent = hrp
	vuelo = { m = Manejo.nuevo(), att = att, lv = lv, ao = ao, hum = hum, hrp = hrp, boost = false }
	camPos = nil
	cam.CameraType = Enum.CameraType.Scriptable
end

local function terminar()
	if not vuelo then return end
	vuelo.lv:Destroy()
	vuelo.ao:Destroy()
	vuelo.att:Destroy()
	if vuelo.hum.Parent and vuelo.hum.Health > 0 then
		vuelo.hum.AutoRotate = true
		vuelo.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	if vuelo.boost then accion:FireServer("boost", false) end
	vuelo = nil
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
	fov = 70
end

RunService:BindToRenderStep("Mas1Vuelo", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local enVuelo = plr:GetAttribute("EnVuelo") == true
	if not enVuelo then esperaFin = false end
	if enVuelo and not vuelo and not esperaFin then empezar() end
	if not enVuelo and vuelo then terminar() end
	if not vuelo then return end
	if not vuelo.hrp.Parent or vuelo.hum.Health <= 0 then terminar() return end
	local e = mandos()
	if e.boost ~= vuelo.boost then
		vuelo.boost = e.boost
		accion:FireServer("boost", e.boost)
	end
	local info = { planeando = plr:GetAttribute("Planeando") == true, boost = plr:GetAttribute("Boost") == true,
		impulso = plr:GetAttribute("Impulso") or 1 }
	local p = vuelo.hrp.Position
	local m = Manejo.paso(vuelo.m, dt, e, info, p.X, p.Y, C)
	vuelo.lv.VectorVelocity = Vector3.new(m.vx, m.vy, -m.vf)
	-- tumbado hacia delante (como un superheroe), mirando hacia donde va y alabeado en los giros
	local dir = Vector3.new(m.vx * 0.3, m.vy * 0.3, -math.max(m.vf, 1)).Unit
	vuelo.ao.CFrame = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(0, 0, m.alabeo) * CFrame.Angles(math.rad(-75) + m.cabeceo, 0, 0)
	-- camara: detras y por encima, mas lejos cuanto mas rapido
	local objetivo = p + Vector3.new(0, 1.5, 0)
	local deseo = objetivo + Vector3.new(-m.vx * 0.12, 6 + m.vf * 0.02, 15 + m.vf * 0.08)
	camPos = camPos and camPos:Lerp(deseo, 1 - math.exp(-8 * dt)) or deseo
	fov += ((info.boost and 88 or info.planeando and 66 or 74) - fov) * (1 - math.exp(-4 * dt))
	cam.FieldOfView = fov
	cam.CFrame = CFrame.lookAt(camPos, objetivo + Vector3.new(m.vx * 0.2, 0, -16)) * CFrame.Angles(0, 0, m.alabeo * 0.2)
	if info.planeando and p.Y < C.suelo + 3.3 then -- toco el suelo: el servidor cierra el vuelo y paga
		terminar()
		esperaFin = true
	end
end)

-- boton LANZAR y tecla F (PROVISIONAL hasta el cañon de la Pradera)
local gui = T.n("ScreenGui", { Name = "Mas1Lanzar", ResetOnSpawn = false, IgnoreGuiInset = true }, plr:WaitForChild("PlayerGui"))
T.escala(gui)
local function pedirLanzar()
	if plr:GetAttribute("EnVuelo") ~= true then accion:FireServer("lanzar") end
end
local boton = T.boton(gui, { Size = UDim2.fromOffset(260, 100), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40),
	Text = "¡LANZAR!" }, T.col.rosa, pedirLanzar)
local function verBoton() boton.Visible = plr:GetAttribute("EnVuelo") ~= true end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(verBoton)
verBoton()
UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.F then pedirLanzar() end
end)

-- el cartel de resultado vive en client/Resultados.client.lua
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001A">
<Properties>
<string name="Name">Zonas</string>
<ProtectedString name="Source"><![CDATA[-- Cielo y niebla por zona en el cliente de «+1 de lanzamiento por segundo»: al cruzar el arco de cada zona cambian la hora y la
-- Atmosphere (color, densidad) para que cada zona se lea distinta y el carril destaque: dia azul en la Pradera y el Mar de Nubes,
-- atardecer oscuro en la Tormenta, lila en el Cielo alto y noche (con las estrellas del cielo de Roblox) en el Espacio. Solo en este
-- cliente: cada jugador ve su zona. Colores del cielo de mapa-v01 (build_mapa.py). SIN PROBAR EN STUDIO.
local Lighting, TweenService, RunService = game:GetService("Lighting"), game:GetService("TweenService"), game:GetService("RunService")

-- desde (studs hacia -Z), color de la niebla, hora, densidad
local ZONAS = {
	{ 0, Color3.fromRGB(159, 211, 255), 14, 0.25 },
	{ 532, Color3.fromRGB(61, 71, 102), 17.8, 0.38 },
	{ 892, Color3.fromRGB(183, 163, 240), 15.5, 0.25 },
	{ 1252, Color3.fromRGB(13, 16, 36), 0, 0.12 },
}
local atm = Lighting:FindFirstChildOfClass("Atmosphere")
if not atm then
	atm = Instance.new("Atmosphere")
	atm.Parent = Lighting
end
local actual

RunService.Heartbeat:Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local d, z = -cam.CFrame.Position.Z, 1
	for i, zona in ipairs(ZONAS) do
		if d >= zona[1] then z = i end
	end
	if z == actual then return end
	actual = z
	local _, color, hora, densidad = table.unpack(ZONAS[z])
	Lighting.ClockTime = hora -- de golpe: con un tween la hora pasaria por el mediodia
	TweenService:Create(atm, TweenInfo.new(1.5), { Color = color, Decay = color:Lerp(Color3.new(0, 0, 0), 0.35), Density = densidad }):Play()
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
