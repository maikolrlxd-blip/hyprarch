<Item class="ServerScriptService" referent="RBXJ0000017">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBXJ0000016">
<Properties>
<string name="Name">Mas1Servidor</string>
</Properties>
<Item class="Script" referent="RBXJ0000012">
<Properties>
<string name="Name">DemoVisual</string>
<ProtectedString name="Source"><![CDATA[-- SOLO PARA VER LA CAPA VISUAL antes de que exista el juego: si workspace tiene el atributo MAS1_Demo = true, simula un vuelo (energia que baja,
-- puntos y distancia que suben, aros, multiplicadores) y dispara efectos de ejemplo. No es logica de juego. SIN PROBAR EN STUDIO.
local Players, RS = game:GetService("Players"), game:GetService("ReplicatedStorage")
local Red = require(RS:WaitForChild("Mas1"):WaitForChild("Red")) -- los mismos eventos que el juego (server/Partida.server.lua), sin duplicarlos
local Efecto, Accion = Red.evento("MAS1_Efecto"), Red.evento("MAS1_Accion")
while workspace:GetAttribute("MAS1_Demo") ~= true do workspace:GetAttributeChangedSignal("MAS1_Demo"):Wait() end -- sirve activarlo antes o durante el Play

local function raiz(plr) local c = plr.Character; return c and c:FindFirstChild("HumanoidRootPart") end
Accion.OnServerEvent:Connect(function(plr, nombre)
	local r = raiz(plr); if not r then return end
	if nombre == "puno" or nombre == "patada" then Efecto:FireClient(plr, "golpe", r.Position + r.CFrame.LookVector * 4)
	elseif nombre == "turbo" then Efecto:FireClient(plr, "aleteo", r.Position) end
end)

local ZONAS = { 1, 2, 3, 5 }
task.spawn(function()
	local t0 = os.clock()
	while true do
		task.wait(0.25)
		local t = os.clock() - t0; local ciclo = t % 20 -- un "vuelo" de 20 s que se repite
		for _, plr in ipairs(Players:GetPlayers()) do
			plr:SetAttribute("Energia", math.max(0, 1 - ciclo / 18)); plr:SetAttribute("Potencia", 1250 + math.floor(t))
			plr:SetAttribute("Puntos", math.floor(ciclo * 640)); plr:SetAttribute("Distancia", math.floor(ciclo * 47))
			plr:SetAttribute("ZonaMult", ZONAS[math.floor(ciclo / 5) % #ZONAS + 1]); plr:SetAttribute("ArosTotal", 12); plr:SetAttribute("Aros", math.min(12, math.floor(ciclo / 1.7)))
			plr:SetAttribute("Mascota", "Gorrión Miga"); plr:SetAttribute("MascotaBonus", 1.5)
			local r = raiz(plr)
			if r and math.floor(ciclo * 4) % 7 == 0 then Efecto:FireClient(plr, "aro", r.Position + Vector3.new(0, 4, -6)) end
			if r and ciclo < 0.3 then Efecto:FireClient(plr, "lanzamiento", r.Position) end
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000013">
<Properties>
<string name="Name">Guardado</string>
<ProtectedString name="Source"><![CDATA[-- Guardado de «+1 de lanzamiento por segundo» con DataStore: adaptador de Roblox de src/Datos.lua (Lua puro, probado con lupa).
-- Carga tomando el bloqueo de sesion (si otro servidor tiene los datos del jugador, espera a que los suelte o a que su bloqueo
-- caduque), guarda con reintentos y espera creciente, y nunca pisa datos de otra sesion. Solo EN STUDIO, si no hay acceso al
-- DataStore (place sin publicar o sin «Enable Studio Access to API Services»), se juega sin guardar y se avisa en el Output; en un
-- servidor de verdad nunca se juega sin guardar: si no se pueden cargar los datos, el jugador sale con un mensaje (revision de
-- Linux 2.0: una prueba de acceso fallida al arrancar dejaba todo el servidor sin guardar en silencio).
-- Lo usa server/Partida.server.lua (autoguardado cada G.AUTOGUARDADO s, al salir y al cerrar el servidor). SIN PROBAR EN STUDIO.
local DataStoreService, HttpService, RS = game:GetService("DataStoreService"), game:GetService("HttpService"), game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local D = require(Mas1:WaitForChild("Datos"))
local M = require(Mas1:WaitForChild("Mascotas"))
local Alas = require(Mas1:WaitForChild("Alas"))

local G = {}
G.CADUCA = 180 -- s sin refrescar para dar por abandonado un bloqueo (el otro servidor se cayo)
G.AUTOGUARDADO = 60
local SESION = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

local tienda
do
	local ok, t = pcall(function() return DataStoreService:GetDataStore("MAS1_Datos_v1") end)
	if ok then tienda = t end
	-- la prueba de acceso solo en Studio: en un servidor de verdad un fallo pasajero no puede dejar a nadie sin guardar
	if tienda and RunService:IsStudio() and not pcall(function() tienda:GetAsync("prueba_de_acceso") end) then tienda = nil end
	if not tienda then
		if RunService:IsStudio() then
			warn("[MAS1 guardado] Studio sin acceso al DataStore: se juega SIN GUARDAR (place sin publicar o sin acceso a las API)")
		else
			warn("[MAS1 guardado] Servidor sin DataStore: no se dejara jugar a nadie (sus datos no se podrian guardar)")
		end
	end
end
G.sinGuardar = tienda == nil and RunService:IsStudio() -- solo Studio juega sin guardar
G.activo = tienda ~= nil

local function reintentar(f)
	local espera = 1
	for intento = 1, 5 do
		local ok, r = pcall(f)
		if ok then return true, r end
		warn(string.format("[MAS1 guardado] intento %d fallido: %s", intento, tostring(r)))
		if intento < 5 then
			task.wait(espera)
			espera *= 2
		end
	end
	return false
end

-- Carga los datos de plr, limpios, tomando el bloqueo. Devuelve los datos, o nil y el motivo ("bloqueado", "error" o "se fue").
function G.cargar(plr)
	if not tienda then
		if G.sinGuardar then return D.limpiar(nil, M, Alas) end
		return nil, "error"
	end
	local clave = "j_" .. plr.UserId
	for _ = 1, 8 do -- si acaba de cambiar de servidor, el otro aun puede tener el bloqueo: se espera a que lo suelte
		local bloqueado = false
		local ok, guardado = reintentar(function()
			return tienda:UpdateAsync(clave, function(viejo)
				local tomado, nuevo = D.tomar(viejo, SESION, os.time(), G.CADUCA)
				bloqueado = not tomado
				return nuevo -- nil: no se escribe nada
			end)
		end)
		if not ok then return nil, "error" end
		if not bloqueado then return D.limpiar(guardado and guardado.dato, M, Alas) end
		if not plr.Parent then return nil, "se fue" end
		task.wait(6)
	end
	return nil, "bloqueado"
end

-- Guarda dato (soltar = al salir). Devuelve dos cosas: si el DataStore respondio y si se escribio (false = otra sesion tiene el
-- bloqueo: este servidor ya no debe seguir con el jugador).
function G.guardar(plr, dato, soltar)
	if not tienda then return G.sinGuardar, G.sinGuardar end
	local escrito = false
	local ok = reintentar(function()
		return tienda:UpdateAsync("j_" .. plr.UserId, function(viejo)
			local puede, nuevo = D.escribir(viejo, SESION, dato, os.time(), soltar)
			escrito = puede
			return nuevo
		end)
	end)
	return ok, escrito
end

return G
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBXJ0000014">
<Properties>
<string name="Name">Lobby</string>
<ProtectedString name="Source"><![CDATA[-- Lobby de «+1 de lanzamiento por segundo» (PROVISIONAL, hecho con piezas hasta importar la Pradera de Codex): plaza de salida, el
-- CAÑON con su plataforma de lanzamiento (MAS1_Canon, que lee Partida.server.lua), zonas de entrenamiento (MAS1_AFK y MAS1_Entreno),
-- el punto de aparicion y carteles. Todo en Workspace.MAS1_Lobby. El vuelo sale hacia -Z; el lobby ocupa Z de +24 a -172, sobre
-- la misma altura del carril (techo en Y = 0). SIN PROBAR EN STUDIO.
local Lighting = game:GetService("Lighting")
local viejo = workspace:FindFirstChild("MAS1_Lobby")
if viejo then viejo:Destroy() end
local lobby = Instance.new("Folder")
lobby.Name = "MAS1_Lobby"

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local CRE, TIN, SOL, CIE, MEN, ROS, VIO = rgb(255, 247, 224), rgb(28, 21, 48), rgb(255, 210, 63), rgb(78, 200, 255), rgb(61, 220, 151), rgb(255, 93, 143), rgb(124, 92, 255)

local function parte(nombre, tam, cf, color, material, opciones)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = nombre, tam, cf, color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in pairs(opciones or {}) do p[k] = v end
	p.Parent = lobby
	return p
end

local function cartel(texto, pos, ancho, color) -- tablero con letras, mirando a +Z (hacia quien aparece en la plaza); no se montan de lado
	local alto = math.max(ancho * 0.22, 3)
	local p = parte("Cartel", Vector3.new(ancho, alto, 0.6), CFrame.new(pos), TIN, nil, { CanCollide = false, CanQuery = false })
	local g = Instance.new("SurfaceGui")
	g.Face, g.SizingMode, g.PixelsPerStud = Enum.NormalId.Back, Enum.SurfaceGuiSizingMode.PixelsPerStud, 50
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Size, t.BackgroundTransparency, t.Text = UDim2.fromScale(1, 1), 1, texto
	t.Font, t.TextScaled, t.TextColor3 = Enum.Font.FredokaOne, true, color or SOL
	t.TextStrokeColor3, t.TextStrokeTransparency = TIN, 0.5
	t.Parent = g
end

-- suelo de toda la plaza (justo por debajo del techo del carril para no pelear con el mapa donde ya haya suelo)
parte("Suelo", Vector3.new(70, 2, 196), CFrame.new(0, -1.05, -74), rgb(120, 205, 110), Enum.Material.Grass)
for _, x in ipairs({ -33, 33 }) do
	parte("Borde", Vector3.new(2, 1.2, 196), CFrame.new(x, 0.1, -74), CRE, nil, { CanCollide = true })
end
-- franjas guia hacia el cañon y el carril
for z = 0, -170, -20 do
	parte("Franja", Vector3.new(3, 0.1, 8), CFrame.new(0, 0.02, z), CRE, nil, { CanCollide = false, CanQuery = false })
end

-- CAÑON apuntando a -Z, con la plataforma MAS1_Canon delante (de donde sale el jugador). Es el «Cañón pajarero» de Codex
-- (ReplicatedStorage.MAS1_Equipo.Canon: mide 3,8 x 5,7 x 4,8 studs, aquí x3) y, si no está, el provisional de piezas
local cz = -22
local ESCALA_CANON = 3
local equipo = game:GetService("ReplicatedStorage"):FindFirstChild("MAS1_Equipo")
local plantillaCanon = equipo and equipo:FindFirstChild("Canon")
if plantillaCanon then
	local canon = plantillaCanon:Clone()
	canon.Name = "CanonPajarero"
	canon:ScaleTo(ESCALA_CANON)
	canon:PivotTo(CFrame.new(0, 0, cz)) -- el pivote es el centro del suelo bajo el cañón, con la boca hacia -Z
	for _, d in ipairs(canon:GetDescendants()) do
		if d:IsA("BasePart") then d.Anchored = true end
	end
	canon.Parent = lobby
else
	parte("CanonBase", Vector3.new(14, 3, 14), CFrame.new(0, 1.5, cz), rgb(150, 70, 60))
	parte("CanonRueda", Vector3.new(3, 8, 8), CFrame.new(-7.5, 4, cz), TIN, nil, { Shape = Enum.PartType.Cylinder })
	parte("CanonRueda", Vector3.new(3, 8, 8), CFrame.new(7.5, 4, cz), TIN, nil, { Shape = Enum.PartType.Cylinder })
	local tubo = parte("CanonTubo", Vector3.new(7, 7, 18), CFrame.new(0, 7, cz) * CFrame.Angles(math.rad(28), 0, 0), ROS)
	parte("CanonAro", Vector3.new(8.5, 8.5, 2.2), tubo.CFrame * CFrame.new(0, 0, -9), SOL)
	parte("CanonAro", Vector3.new(8.5, 8.5, 2.2), tubo.CFrame * CFrame.new(0, 0, 5), SOL)
	parte("CanonBoca", Vector3.new(5, 5, 0.6), tubo.CFrame * CFrame.new(0, 0, -9.6), TIN)
end
local plat = parte("MAS1_Canon", Vector3.new(10, 1, 10), CFrame.new(0, 0.5, cz - 16), CIE, Enum.Material.Neon)
cartel("¡CAÑÓN!", Vector3.new(0, 16, cz + 4), 14, SOL)

-- el aviso del cañon: se acerca el jugador y pulsa E / toca (el cliente manda "lanzar")
local pp = Instance.new("ProximityPrompt")
pp.ActionText, pp.ObjectText, pp.HoldDuration, pp.MaxActivationDistance, pp.RequiresLineOfSight = "LANZARSE", "Cañón", 0, 14, false
pp.Parent = plat

-- arco de entrada y cartel del juego
for _, x in ipairs({ -14, 14 }) do parte("ArcoPilar", Vector3.new(3, 22, 3), CFrame.new(x, 11, -4), VIO) end
parte("ArcoDintel", Vector3.new(34, 4, 3), CFrame.new(0, 22, -4), VIO)
cartel("+1 DE LANZAMIENTO", Vector3.new(0, 26.5, -3.5), 30, SOL)

-- zonas de entrenamiento (las lee Partida.server.lua por el nombre)
local afk = parte("MAS1_AFK", Vector3.new(16, 0.4, 16), CFrame.new(-20, 0.2, -62), CIE, Enum.Material.Neon, { CanCollide = false })
local entreno = parte("MAS1_Entreno", Vector3.new(16, 0.4, 16), CFrame.new(20, 0.2, -62), rgb(255, 157, 0), Enum.Material.Neon, { CanCollide = false })
cartel("ZONA AFK  x1,5", Vector3.new(-20, 7, -70), 14, CIE)
cartel("ENTRENA CORRIENDO  x2", Vector3.new(20, 7, -70), 16, rgb(255, 157, 0))

-- puestos: huevos (B) y rebirth, solo decorativos; el menu lo abre el boton o la tecla
for _, d in ipairs({ { "HUEVOS Y MASCOTAS (B)", -20, MEN }, { "REBIRTH", 20, ROS } }) do
	parte("Puesto", Vector3.new(10, 5, 6), CFrame.new(d[2], 2.5, -100), d[3])
	parte("PuestoTecho", Vector3.new(12, 1, 8), CFrame.new(d[2], 7, -100), TIN)
	cartel(d[1], Vector3.new(d[2], 11, -96.5), 18, d[3])
end

-- vida en la plaza (cola del director, 05/11: «farolas, banderines, arboles de bloques»). Todo decorativo y fuera del camino central
-- (x = 0), del cañon (z -16 a -28), de la plataforma (z -33 a -43), de las zonas de entreno (|x| 12 a 28, z -54 a -70) y de los
-- puestos (|x| 14 a 26, z -96 a -104): farolas en x = ±9, banderines colgando entre ellas por encima del camino y arboles en x = ±30.
-- Solo chocan los postes y los troncos. SIN PROBAR EN STUDIO.
local MADERA, HOJA, HOJA2, FAROL = rgb(122, 84, 52), rgb(76, 175, 80), rgb(56, 142, 60), rgb(255, 226, 160)
local SIN_CHOQUE = { CanCollide = false, CanQuery = false }
for _, z in ipairs({ 6, -10, -46, -62, -78, -94, -110, -126, -142, -158 }) do
	for _, x in ipairs({ -9, 9 }) do
		parte("FarolaBase", Vector3.new(1.4, 0.6, 1.4), CFrame.new(x, 0.3, z), TIN)
		parte("FarolaPoste", Vector3.new(9, 0.5, 0.5), CFrame.new(x, 4.5, z) * CFrame.Angles(0, 0, math.rad(90)), TIN, nil,
			{ Shape = Enum.PartType.Cylinder })
		local farol = parte("Farol", Vector3.new(1.3, 1.6, 1.3), CFrame.new(x, 9.6, z), FAROL, Enum.Material.Neon, SIN_CHOQUE)
		parte("FarolTecho", Vector3.new(1.8, 0.4, 1.8), CFrame.new(x, 10.6, z), TIN, nil, SIN_CHOQUE)
		local luz = Instance.new("PointLight")
		luz.Range, luz.Brightness, luz.Color, luz.Shadows = 16, 1.2, FAROL, false
		luz.Parent = farol
	end
end
local COLORES_BANDERIN = { SOL, ROS, CIE, MEN, VIO }
for k, z in ipairs({ 6, -46, -78, -110, -142 }) do -- de farola a farola, con caida en el medio
	local n, previo = 11, nil
	for i = 0, n - 1 do
		local u = i / (n - 1)
		local punto = Vector3.new(-8.4 + 16.8 * u, 8.9 - 1.4 * (1 - (2 * u - 1) ^ 2), z)
		if previo then
			parte("Cuerda", Vector3.new(0.08, 0.08, (punto - previo).Magnitude), CFrame.lookAt((punto + previo) / 2, punto), CRE, nil, SIN_CHOQUE)
		end
		parte("Banderin", Vector3.new(0.9, 0.9, 0.08), CFrame.new(punto - Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(45)),
			COLORES_BANDERIN[(i + k) % #COLORES_BANDERIN + 1], nil, SIN_CHOQUE)
		previo = punto
	end
end
local function arbol(x, z, s) -- tronco y dos cubos de copa, como los de la Pradera
	parte("Tronco", Vector3.new(1.4, 4.5, 1.4) * s, CFrame.new(x, 2.25 * s, z), MADERA)
	parte("Copa", Vector3.new(5, 3.6, 5) * s, CFrame.new(x, 6.1 * s, z), HOJA, nil, SIN_CHOQUE)
	parte("Copa", Vector3.new(3.4, 2.4, 3.4) * s, CFrame.new(x + 0.3 * s, 8.4 * s, z - 0.2 * s), HOJA2, nil, SIN_CHOQUE)
end
for _, z in ipairs({ 16, -14, -40, -86, -116, -136, -156 }) do
	arbol(-30, z, 1 + (z * 7 % 3) * 0.12)
	arbol(30, z + 6, 1 + (z * 5 % 3) * 0.12)
end

-- punto de aparicion en la plaza, mirando al cañon; se apaga el de la place de prueba (estaba en el Mar de Nubes)
for _, s in ipairs(workspace:GetDescendants()) do
	if s:IsA("SpawnLocation") and s.Parent ~= lobby then s.Enabled = false end
end
local sp = Instance.new("SpawnLocation")
sp.Size, sp.CFrame, sp.Anchored, sp.Duration, sp.Neutral = Vector3.new(10, 1, 10), CFrame.new(0, 0.5, 14), true, 0, true
sp.Transparency, sp.Color, sp.Material = 0.4, MEN, Enum.Material.Neon
sp.Parent = lobby

lobby.Parent = workspace
Lighting.Brightness = math.max(Lighting.Brightness, 2)
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBXJ0000015">
<Properties>
<string name="Name">Partida</string>
<ProtectedString name="Source"><![CDATA[-- Partida de «+1 de lanzamiento por segundo» en el servidor: adaptador de Roblox de src/Partida.lua y src/Encuentros.lua (Lua puro,
-- probados con lupa). El cliente mueve su personaje y manda intenciones por MAS1_Accion. Aqui se lanza, se llevan la energia, el
-- boost, la distancia y los puntos, se valida cada paso (si va mas rapido de lo permitido o se sale de los limites, se le devuelve
-- atras), se cuentan los aros del mapa (Models «Aro» con su pieza «Centro»), los golpes a los enemigos y los cofres que huyen, y al
-- aterrizar se pagan el dinero y la exp y se manda MAS1_Resultado. Los enemigos y los cofres son anclas invisibles en
-- Workspace.MAS1_Entidades (atributos Tipo, Vivo y Dueno); los dibuja el cliente (client/Entidades.client.lua).
-- En tierra se entrena (+1 potencia/s, mas en las zonas MAS1_AFK y MAS1_Entreno del mapa) y se puede hacer rebirth; el bonus del
-- vuelo combina las mascotas equipadas y las alas (src/Alas.lua, que escalan con los rebirths). El inventario (src/Inventario.lua:
-- huevos, mascotas equipadas, alas) va a la interfaz por MAS1_Inventario y MAS1_Huevo, y los fallos por MAS1_Aviso.
-- Los datos se cargan y guardan con server/Guardado.lua (DataStore con bloqueo de sesion); hasta que cargan, el jugador no actua.
-- Las alas se desbloquean solas al cumplir su requisito (Alas.desbloqueada). Atributos y eventos en CONTRATO.md. SIN PROBAR EN STUDIO.
local Players, RS, RunService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local V = require(Mas1:WaitForChild("Vuelo"))
local P = require(Mas1:WaitForChild("Partida"))
local E = require(Mas1:WaitForChild("Encuentros"))
local M = require(Mas1:WaitForChild("Mascotas"))
local Alas = require(Mas1:WaitForChild("Alas"))
local I = require(Mas1:WaitForChild("Inventario"))
local D = require(Mas1:WaitForChild("Datos"))
local Mis = require(Mas1:WaitForChild("Misiones"))
local G = require(script.Parent:WaitForChild("Guardado"))
local Red = require(Mas1:WaitForChild("Red"))
local accion, efecto, resultado = Red.evento("MAS1_Accion"), Red.evento("MAS1_Efecto"), Red.evento("MAS1_Resultado")
local avisoEv, inventarioEv, huevoEv = Red.evento("MAS1_Aviso"), Red.evento("MAS1_Inventario"), Red.evento("MAS1_Huevo")
local orbeEv = Red.evento("MAS1_Orbe") -- orbes «+1» cogidos (indices de Encuentros.colocarOrbes): el cliente los esconde
local PRODUCTO_FENIX = nil -- id del producto de Robux del fenix: SIN CONFIGURAR (no se ha creado ningun producto ni precio)

local INICIALES = { Potencia = 0, Dinero = 0, Exp = 0, Rebirths = 0, Cofres = 0, Lanzamientos = 0, Puntos = 0, Distancia = 0,
	ZonaMult = 1, Aros = 0, ArosTotal = 0, Energia = 1, EnergiaMax = 0, Impulso = 1, EnVuelo = false, Planeando = false, Boost = false,
	Mascota = "—", MascotaBonus = 1, Alas = "", Entreno = 1, CosteRebirth = V.costeRebirth(0) }
local MENSAJES_POR_SEGUNDO = 30
local VOLVER_AL_LOBBY = 3 -- segundos tras aterrizar hasta volver al spawn del lobby (MAS1_Lobby)
local jugadores = {} -- [plr] = { s = sesion de Partida, msgs, desde, hud, cofre = ancla del cofre, potencia, entreno }

local function aviso(plr, texto)
	avisoEv:FireClient(plr, texto)
end

-- inventario: a la interfaz con la forma acordada, y la mascota principal y su bonus de dinero al HUD
local function mandarInventario(plr, j)
	inventarioEv:FireClient(plr, I.copia(j.inv))
	local p = I.principal(M, j.inv)
	plr:SetAttribute("Mascota", p and p.nombre or "—")
	plr:SetAttribute("MascotaBonus", math.floor(M.multiplicadores(j.inv.equipadas).dinero * 100 + 0.5) / 100)
	plr:SetAttribute("Alas", j.inv.alaEquipada or "")
	plr:SetAttribute("MascotasEq", table.concat(j.inv.equipadas, ",")) -- ids equipados («gorrion,aguila»): client/Seguidores.client.lua
end

local function tabla(v)
	return { x = v.X, y = v.Y, z = v.Z }
end

local function v3(t)
	return Vector3.new(t.x, t.y, t.z)
end

local function raiz(plr)
	local c = plr.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h and h.Health > 0 then return c:FindFirstChild("HumanoidRootPart"), h end
	return nil
end

-- ---------------------------------------------------------------- mundo: aros del mapa y enemigos repartidos por zona
local entidades = Instance.new("Folder")
entidades.Name = "MAS1_Entidades"
entidades.Parent = workspace
local mundo = { aros = {}, enemigos = {}, orbes = E.colocarOrbes() }

for _, m in ipairs(workspace:GetDescendants()) do
	local c = m:IsA("Model") and m.Name == "Aro" and m:FindFirstChild("Centro")
	if c then
		local suma, n = 0, 0 -- radio: la distancia media de los bloques del aro a su centro
		for _, p in ipairs(m:GetChildren()) do
			if p:IsA("BasePart") and p ~= c then
				suma += (p.Position - c.Position).Magnitude
				n += 1
			end
		end
		mundo.aros[#mundo.aros + 1] = { centro = tabla(c.Position), radio = n > 0 and suma / n or 8 }
	end
end
table.sort(mundo.aros, function(a, b) return a.centro.z > b.centro.z end) -- en el orden del vuelo

local function ancla(nombre, pos, atributos)
	local p = Instance.new("Part")
	p.Name = nombre
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	for k, v in pairs(atributos) do p:SetAttribute(k, v) end
	p.Parent = entidades
	return p
end

local azar = Random.new(30)
mundo.enemigos = E.colocarEnemigos(mundo.aros, function() return azar:NextNumber() end)
for _, en in ipairs(mundo.enemigos) do
	en.ancla = ancla("Enemigo", v3(en.pos), { Tipo = en.tipo, Vivo = true })
end

-- zonas de entrenamiento del mapa: partes llamadas MAS1_AFK (x1,5 aunque no te muevas) y MAS1_Entreno (x2 corriendo)
local zonasEntreno = {}
local function registrarZona(p)
	if p:IsA("BasePart") and (p.Name == "MAS1_AFK" or p.Name == "MAS1_Entreno") then
		zonasEntreno[#zonasEntreno + 1] = { parte = p, tipo = p.Name == "MAS1_AFK" and "afk" or "entreno" }
	end
end
for _, p in ipairs(workspace:GetDescendants()) do registrarZona(p) end
workspace.DescendantAdded:Connect(registrarZona) -- el lobby (server/Lobby.server.lua) las crea al arrancar, quiza despues

local function zonaDe(pos)
	for _, z in ipairs(zonasEntreno) do
		local rel, s = z.parte.CFrame:PointToObjectSpace(pos), z.parte.Size
		if math.abs(rel.X) <= s.X / 2 and math.abs(rel.Z) <= s.Z / 2 and rel.Y >= -2 and rel.Y <= s.Y / 2 + 8 then return z.tipo end
	end
	return nil
end

local function golpeado(i)
	local en = mundo.enemigos[i]
	en.ancla:SetAttribute("Vivo", false)
	efecto:FireAllClients("golpe", en.ancla.Position)
	task.delay(E.CFG.reaparicion, function()
		en.vivo = true
		en.ancla:SetAttribute("Vivo", true)
	end)
end

-- ---------------------------------------------------------------- jugadores: datos, alas que se desbloquean y guardado
local function revisarAlas(plr, j) -- hito 6: iniciales en el 3.er lanzamiento, roboticas con 3 dias seguidos, avanzadas con 10 cofres
	local progreso = { lanzamientos = plr:GetAttribute("Lanzamientos") or 0, diasSeguidos = j.dias.diasSeguidos,
		cofres = plr:GetAttribute("Cofres") or 0 }
	local nuevas = false
	for _, a in ipairs(Alas.LISTA) do
		if not I.tieneAla(j.inv, a.id) and Alas.desbloqueada(a.id, progreso) then
			I.darAla(j.inv, a.id)
			if not j.inv.alaEquipada then I.equiparAla(j.inv, a.id) end -- las primeras se ponen solas
			aviso(plr, "¡Nuevas alas: " .. a.nombre .. "!")
			nuevas = true
		end
	end
	if nuevas then mandarInventario(plr, j) end
end

local function aplicar(plr, j, d)
	j.potencia = d.potencia
	j.inv = d.inventario
	j.dias = { diasSeguidos = d.diasSeguidos, ultimoDia = d.ultimoDia }
	plr:SetAttribute("Potencia", math.floor(d.potencia))
	plr:SetAttribute("Dinero", d.dinero)
	plr:SetAttribute("Exp", d.exp)
	plr:SetAttribute("Rebirths", d.rebirths)
	plr:SetAttribute("CosteRebirth", V.costeRebirth(d.rebirths))
	plr:SetAttribute("Cofres", d.cofres)
	plr:SetAttribute("Lanzamientos", d.lanzamientos)
	plr:SetAttribute("DiasSeguidos", d.diasSeguidos)
	mandarInventario(plr, j)
	revisarAlas(plr, j)
end

local function datosDe(plr, j)
	return { version = D.VERSION, potencia = j.potencia, dinero = plr:GetAttribute("Dinero") or 0, exp = plr:GetAttribute("Exp") or 0,
		rebirths = plr:GetAttribute("Rebirths") or 0, cofres = plr:GetAttribute("Cofres") or 0,
		lanzamientos = plr:GetAttribute("Lanzamientos") or 0, diasSeguidos = j.dias.diasSeguidos, ultimoDia = j.dias.ultimoDia,
		inventario = I.copia(j.inv) }
end

local function alEntrar(plr)
	for k, v in pairs(INICIALES) do
		if plr:GetAttribute(k) == nil then plr:SetAttribute(k, v) end
	end
	plr:SetAttribute("ArosTotal", #mundo.aros)
	local j = { s = P.nueva(V, E), msgs = 0, desde = 0, hud = 0, potencia = 0, entreno = 0, inv = I.nuevo(), cargado = false, misiones = Mis.nuevo(math.random),
		dias = { diasSeguidos = 0, ultimoDia = -1 } }
	jugadores[plr] = j
	plr:SetAttribute("Misiones", Mis.codificar(j.misiones))
	plr:GetAttributeChangedSignal("Potencia"):Connect(function() -- cambiada a mano (en Studio, para probar): se adopta
		local v = plr:GetAttribute("Potencia")
		if j.cargado and type(v) == "number" and math.abs(v - math.floor(j.potencia)) >= 1 then j.potencia = v end
	end)
	plr.CharacterAdded:Connect(function() mandarInventario(plr, j) end) -- para cuando los scripts del cliente ya escuchan
	task.spawn(function()
		local d, motivo = G.cargar(plr)
		if not plr.Parent or jugadores[plr] ~= j then return end
		if not d then -- mejor no jugar que jugar con datos vacios y pisar los buenos al guardar
			plr:Kick(motivo == "bloqueado" and "Tus datos siguen abiertos en otro servidor. Vuelve a entrar en un momento."
				or "No se pudieron cargar tus datos. Vuelve a entrar en un momento.")
			return
		end
		D.registrarDia(d, math.floor(os.time() / 86400))
		aplicar(plr, j, d)
		j.cargado = true
	end)
end
Players.PlayerAdded:Connect(alEntrar)
for _, plr in ipairs(Players:GetPlayers()) do alEntrar(plr) end

local enCurso = 0 -- guardados en marcha: al cerrar el servidor se espera a todos, tambien a los de jugadores que ya salieron

local function guardar(plr, j, soltar)
	if not j.cargado then return end
	enCurso += 1
	local ok, escrito = G.guardar(plr, datosDe(plr, j), soltar)
	enCurso -= 1
	if ok and not escrito and not soltar then -- otra sesion se quedo sus datos: este servidor ya no puede seguir con el
		j.cargado = false
		plr:Kick("Tus datos se abrieron en otro servidor.")
	end
end

local function despedir(plr, j) -- guardar y soltar el bloqueo una sola vez (al salir o al cerrar el servidor)
	if j.saliendo then return end
	j.saliendo = true
	guardar(plr, j, true)
end

task.spawn(function() -- autoguardado
	while true do
		task.wait(G.AUTOGUARDADO)
		for plr, j in pairs(jugadores) do
			if not j.saliendo then task.spawn(guardar, plr, j, false) end
		end
	end
end)

game:BindToClose(function() -- al cerrar el servidor: guardar y soltar a todos (Roblox espera hasta 30 s)
	for plr, j in pairs(jugadores) do task.spawn(despedir, plr, j) end
	task.wait() -- que arranquen
	local t0 = os.clock()
	while enCurso > 0 and os.clock() - t0 < 25 do task.wait(0.2) end
end)

local function quitarCofre(j)
	if j.cofre then
		j.cofre:Destroy()
		j.cofre = nil
	end
end

Players.PlayerRemoving:Connect(function(plr)
	local j = jugadores[plr]
	if not j then return end
	quitarCofre(j)
	jugadores[plr] = nil
	despedir(plr, j) -- guarda y suelta el bloqueo
end)

local function bonusDe(plr, j) -- mascotas equipadas por las alas equipadas, que escalan con los rebirths
	return Alas.combinar(M.multiplicadores(j.inv.equipadas), Alas.bonus(j.inv.alaEquipada, plr:GetAttribute("Rebirths") or 0))
end

local azarHuevos = Random.new()

-- intenciones del inventario (en tierra): abrir huevos, equipar y desequipar mascotas y alas, comprar alas
local function inventario(plr, j, nombre, a, b)
	if P.enVuelo(j.s) then
		aviso(plr, "Eso se hace en tierra")
		return
	end
	local ok, x, p, nueva
	if nombre == "abrirHuevo" and type(a) == "string" then
		ok, x, p, nueva = I.abrirHuevo(M, j.inv, plr:GetAttribute("Dinero") or 0, a, function() return azarHuevos:NextNumber() end)
		if ok then
			plr:SetAttribute("Dinero", x)
			huevoEv:FireClient(plr, { rareza = a, mascotaId = p.id, nueva = nueva })
		end
	elseif nombre == "equipar" and a == "mascota" and type(b) == "string" then
		ok, x = I.equipar(M, j.inv, b)
	elseif nombre == "desequipar" and a == "mascota" and type(b) == "string" then
		ok, x = I.desequipar(j.inv, b)
	elseif nombre == "equipar" and a == "ala" and type(b) == "string" then
		ok, x = I.equiparAla(j.inv, b)
	elseif nombre == "desequipar" and a == "ala" then
		ok, x = I.desequiparAla(j.inv)
	elseif nombre == "comprarAla" and type(a) == "string" then
		ok, x = I.comprarAla(Alas, j.inv, plr:GetAttribute("Dinero") or 0, a)
		if ok then plr:SetAttribute("Dinero", x) end
	elseif nombre == "inventario" then
		ok = true
	else
		return
	end
	if ok then mandarInventario(plr, j) elseif type(x) == "string" then aviso(plr, x) end
end

if PRODUCTO_FENIX then -- fenix solo con Robux: al cobrar el producto se da la mascota (hito 5 lo guardara)
	game:GetService("MarketplaceService").ProcessReceipt = function(recibo)
		local plr = Players:GetPlayerByUserId(recibo.PlayerId)
		local j = plr and jugadores[plr]
		if not j or recibo.ProductId ~= PRODUCTO_FENIX then return Enum.ProductPurchaseDecision.NotProcessedYet end
		I.darFenix(j.inv)
		mandarInventario(plr, j)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

local function rebirth(plr, j)
	if P.enVuelo(j.s) then return end
	local r = plr:GetAttribute("Rebirths") or 0
	local coste = V.costeRebirth(r)
	if j.potencia < coste then
		aviso(plr, string.format("Te falta potencia para el rebirth: %d / %d", math.floor(j.potencia), coste))
		return
	end
	j.potencia = 0
	plr:SetAttribute("Potencia", 0)
	plr:SetAttribute("Rebirths", r + 1)
	plr:SetAttribute("CosteRebirth", V.costeRebirth(r + 1))
	local hrp = raiz(plr)
	if hrp then efecto:FireAllClients("rebirth", hrp.Position) end
end

local function cerrarVuelo(plr, j, hrp)
	quitarCofre(j)
	plr:SetAttribute("EnVuelo", false)
	plr:SetAttribute("Planeando", false)
	if plr:GetAttribute("Boost") then
		plr:SetAttribute("Boost", false)
		if hrp then efecto:FireAllClients("estela", nil, hrp, false) end
	end
end

local function lanzar(plr, j)
	local hrp, hum = raiz(plr)
	if not hrp or P.enVuelo(j.s) or hum.Sit or hum.FloorMaterial == Enum.Material.Air then return end -- solo desde el suelo
	local canon = workspace:FindFirstChild("MAS1_Canon", true) -- el cañon de la Pradera cuando este; si no, desde donde esta
	local base = (canon and canon:IsA("BasePart")) and canon.Position or hrp.Position
	local pos = base + Vector3.new(0, 4, 0)
	hrp.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))
	hrp.AssemblyLinearVelocity = Vector3.zero
	local b = bonusDe(plr, j)
	P.lanzar(j.s, tabla(pos), j.potencia, b)
	j.nVuelo = (j.nVuelo or 0) + 1 -- para que la vuelta al lobby de un vuelo viejo no saque al jugador de uno nuevo
	plr:SetAttribute("Lanzamientos", (plr:GetAttribute("Lanzamientos") or 0) + 1)
	plr:SetAttribute("Entreno", 0)
	revisarAlas(plr, j)
	quitarCofre(j)
	if j.s.cofre then j.cofre = ancla("Cofre", v3(j.s.cofre.pos), { Tipo = "cofre", Dueno = plr.UserId }) end
	plr:SetAttribute("Impulso", b.impulso)
	plr:SetAttribute("EnergiaMax", j.s.v.energiaMax)
	plr:SetAttribute("Energia", 1)
	plr:SetAttribute("Puntos", 0)
	plr:SetAttribute("Distancia", 0)
	plr:SetAttribute("Aros", 0)
	plr:SetAttribute("Orbes", 0)
	plr:SetAttribute("ArosTotal", #mundo.aros)
	plr:SetAttribute("Planeando", false)
	plr:SetAttribute("Boost", false)
	plr:SetAttribute("EnVuelo", true)
	efecto:FireAllClients("lanzamiento", pos)
end

accion.OnServerEvent:Connect(function(plr, nombre, valor, extra)
	local j = jugadores[plr]
	if not j or not j.cargado or type(nombre) ~= "string" then return end -- hasta que cargan sus datos, nada
	local ahora = os.clock()
	if ahora - j.desde > 1 then j.desde, j.msgs = ahora, 0 end
	j.msgs += 1
	if j.msgs > MENSAJES_POR_SEGUNDO then return end
	if nombre == "lanzar" then
		lanzar(plr, j)
		return
	elseif nombre == "rebirth" then
		rebirth(plr, j)
		return
	elseif nombre == "abrirHuevo" or nombre == "equipar" or nombre == "desequipar" or nombre == "comprarAla" or nombre == "inventario" then
		inventario(plr, j, nombre, valor, extra)
		return
	end
	local fx, i = P.intencion(j.s, nombre, valor, mundo)
	if i then
		golpeado(i)
		j.combo = ((j.comboHasta or 0) > os.clock() and j.combo or 0) + 1 -- los golpes tambien suman al combo
		j.comboHasta = os.clock() + 1.5
		plr:SetAttribute("Combo", j.combo)
	elseif fx == "golpe" then -- golpe al aire: solo el efecto
		local hrp = raiz(plr)
		if hrp then efecto:FireAllClients("golpe", hrp.Position + Vector3.new(0, 0, -5)) end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	for plr, j in pairs(jugadores) do
		if not P.enVuelo(j.s) then -- en tierra: entrenar (+1/s, mas en las zonas AFK y de entrenamiento y con los rebirths)
			if not j.cargado then continue end
			j.entreno += dt
			if j.entreno >= 0.25 then
				local hrp, hum = raiz(plr)
				if hrp then
					local ritmo = V.ritmoEntreno(plr:GetAttribute("Rebirths") or 0, zonaDe(hrp.Position), hum.MoveDirection.Magnitude > 0.1)
					j.potencia += ritmo * j.entreno
					plr:SetAttribute("Potencia", math.floor(j.potencia))
					plr:SetAttribute("Entreno", ritmo)
				end
				j.entreno = 0
			end
			continue
		end
		local hrp = raiz(plr)
		if not hrp then -- murio o se quedo sin personaje: el vuelo no paga
			P.cancelar(j.s)
			cerrarVuelo(plr, j, nil)
			continue
		end
		local r = P.tick(j.s, dt, tabla(hrp.Position), mundo)
		if r.corregir then -- diagnostico para las pruebas: cada correccion sale en el Output con el control que la provoco
			warn(string.format("[MAS1 vuelo] correccion %d de %s (%s) a los %.1f s", j.s.violaciones, plr.Name, tostring(r.motivo), j.s.t))
			plr:SetAttribute("Correcciones", j.s.violaciones)
			hrp.CFrame = CFrame.new(r.corregir.x, r.corregir.y, r.corregir.z) * hrp.CFrame.Rotation
		end
		if r.aros then
			for _, i in ipairs(r.aros) do efecto:FireClient(plr, "aro", v3(mundo.aros[i].centro)) end
			plr:SetAttribute("Aros", j.s.v.aros)
		end
		local sumaCombo = (r.aros and #r.aros or 0) + (r.orbes and #r.orbes or 0) + (r.cofreAtrapado and 1 or 0)
		if r.orbes then -- cada orbe, +1 de potencia al momento
			j.potencia += #r.orbes
			plr:SetAttribute("Potencia", math.floor(j.potencia))
			plr:SetAttribute("Orbes", j.s.v.orbes or 0)
			orbeEv:FireClient(plr, r.orbes)
		end
		if sumaCombo > 0 then -- combo: aros, orbes y cofres seguidos (el HUD de Linux 2.0 lo pinta)
			j.combo = ((j.comboHasta or 0) > os.clock() and j.combo or 0) + sumaCombo
			j.comboHasta = os.clock() + 1.5
			plr:SetAttribute("Combo", j.combo)
		elseif (j.comboHasta or 0) < os.clock() and (plr:GetAttribute("Combo") or 0) > 0 then
			plr:SetAttribute("Combo", 0)
		end
		if r.cofreAtrapado then
			efecto:FireClient(plr, "aro", v3(r.cofreAtrapado))
			plr:SetAttribute("Cofres", (plr:GetAttribute("Cofres") or 0) + 1)
			quitarCofre(j)
			revisarAlas(plr, j)
		end
		if r.cofre then
			if not j.cofre then j.cofre = ancla("Cofre", v3(r.cofre), { Tipo = "cofre", Dueno = plr.UserId }) end
			j.cofre.Position = v3(r.cofre)
		end
		if plr:GetAttribute("Boost") ~= r.boost then
			plr:SetAttribute("Boost", r.boost)
			efecto:FireAllClients("estela", nil, hrp, r.boost)
		end
		plr:SetAttribute("Planeando", r.planeando)
		j.hud += dt
		if j.hud >= 0.1 or r.aterrizaje then -- el HUD no necesita 60 cambios por segundo
			j.hud = 0
			plr:SetAttribute("Energia", math.floor(r.energia * 1000) / 1000)
			plr:SetAttribute("Distancia", math.floor(r.distancia))
			plr:SetAttribute("ZonaMult", r.mult)
			plr:SetAttribute("Puntos", r.puntos)
		end
		if r.aterrizaje then
			local res = r.aterrizaje
			plr:SetAttribute("Dinero", (plr:GetAttribute("Dinero") or 0) + res.dinero)
			plr:SetAttribute("Exp", (plr:GetAttribute("Exp") or 0) + res.exp)
			cerrarVuelo(plr, j, hrp)
			local premio, hechas = Mis.registrar(j.misiones, { distancia = res.distancia, aros = res.aros, golpes = res.golpes, cofres = res.cofres, orbes = res.orbes }, math.random)
			if premio > 0 then
				plr:SetAttribute("Dinero", (plr:GetAttribute("Dinero") or 0) + premio)
				aviso(plr, string.format("¡Misión cumplida! +%d de dinero", premio))
			end
			plr:SetAttribute("Misiones", Mis.codificar(j.misiones))
			resultado:FireClient(plr, { distancia = math.floor(res.distancia), aros = res.aros, golpes = res.golpes, cofres = res.cofres,
				orbes = res.orbes, multiplicador = res.multiplicador, dinero = res.dinero, exp = res.exp, tiempo = res.tiempo })
			-- de vuelta al lobby (prueba del 31/10: te quedabas al final del carril). Unos segundos para ver el aterrizaje; los
			-- resultados siguen en pantalla y «¡OTRA VEZ!» lanza desde el cañon igual
			local n = j.nVuelo
			task.delay(VOLVER_AL_LOBBY, function()
				if jugadores[plr] ~= j or j.nVuelo ~= n or P.enVuelo(j.s) then return end
				local raizAhora = raiz(plr)
				local lobby = workspace:FindFirstChild("MAS1_Lobby")
				local sp = lobby and lobby:FindFirstChildWhichIsA("SpawnLocation", true)
				if raizAhora and sp then
					raizAhora.AssemblyLinearVelocity = Vector3.zero
					raizAhora.CFrame = sp.CFrame + Vector3.new(0, 4, 0)
				end
			end)
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBXJ000002A">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBXJ0000029">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBXJ0000028">
<Properties>
<string name="Name">Mas1Cliente</string>
</Properties>
<Item class="LocalScript" referent="RBXJ0000018">
<Properties>
<string name="Name">AnimaSeguidores</string>
<ProtectedString name="Source"><![CDATA[-- Animacion de las mallas de mascotas y alas que pone client/Seguidores.client.lua (modelos «Mas1Mascota_<id>» y «Mas1Alas» del
-- Workspace, sacados de ReplicatedStorage.MAS1_Modelos) con los clips DE VERDAD de Blender: src/ClipsHuesos.lua, generado por
-- mas1-arte/tools/clips_a_lua.py, guarda el Bone.Transform de cada hueso animado (15 fotogramas por segundo), ya pasado a los ejes
-- de los huesos de Roblox (no son los de Blender), y aqui se pone interpolando. Sin publicar una Animation por clip. Maikol (01/11):
-- con el aleteo inventado «las alas solo se mueven adelante y atras, abrazando al jugador»; ahora es el Flap de Blender (recoger ->
-- extender -> impulsar). Comprobado en Studio: Roblox compone CFrame * Transform, como supone clips_a_lua.py.
-- Mascotas: Fly siempre. Alas del jugador: Flap en vuelo (mas rapido con turbo), Glide al planear y, en tierra, Glide despacio (alas
-- abiertas, no pegadas al cuerpo). Los modelos de piezas provisionales no tienen huesos: no se tocan.
local Players, RS, RunService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local Clips = require(Mas1:WaitForChild("Clips"))
local CLIPS = require(Mas1:WaitForChild("ClipsHuesos"))
local cache = setmetatable({}, { __mode = "k" }) -- [modelo] = { id, huesos = {nombre = Bone}, clips = {clip = preparado} }

local function duenoDe(m) -- las alas van pegadas a la espalda de su jugador
	local p = m:GetPivot().Position
	for _, plr in ipairs(Players:GetPlayers()) do
		local c = plr.Character
		local t = c and (c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart"))
		if t and (t.Position - p).Magnitude < 6 then return plr end
	end
end

local function aplicar(c, clip, t, escala) -- en bucle; los huesos sin datos en el clip vuelven a reposo
	Clips.aplicar(c.huesos, c.clips[clip], t, escala, true)
end

RunService.RenderStepped:Connect(function()
	local reloj = os.clock()
	for _, m in ipairs(workspace:GetChildren()) do
		local mascota = m.Name:sub(1, 12) == "Mas1Mascota_"
		if m:IsA("Model") and (mascota or m.Name == "Mas1Alas") then
			local c = cache[m]
			local dueno = not mascota and duenoDe(m) or nil
			local id = mascota and m.Name:sub(13) or (dueno and dueno:GetAttribute("Alas")) or nil
			if not c or c.id ~= id then
				c = { id = id, huesos = Clips.huesos(m), clips = id and Clips.preparar(CLIPS[id]), fase = math.random() * 3 }
				cache[m] = c
			end
			if c.clips and next(c.huesos) then
				local escala = m:GetScale()
				if mascota then
					aplicar(c, "Fly", reloj + c.fase, escala)
				else
					local vuela = dueno and dueno:GetAttribute("EnVuelo") == true
					if vuela and dueno:GetAttribute("Planeando") then
						aplicar(c, "Glide", reloj, escala)
					elseif vuela then
						aplicar(c, "Flap", reloj * (dueno:GetAttribute("Boost") and 1.6 or 1), escala)
					else
						aplicar(c, "Glide", reloj * 0.5, escala)
					end
				end
			end
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000019">
<Properties>
<string name="Name">Ayuda</string>
<ProtectedString name="Source"><![CDATA[-- Ayuda de mandos de «+1 de lanzamiento por segundo»: un jugador nuevo no sabe que A/D mueven ni que W da boost. Muestra una tira
-- de mandos arriba (teclado o movil) durante los primeros vuelos de la sesion y un consejo en tierra antes del primer lanzamiento.
-- Sin imagenes. SIN PROBAR EN STUDIO.
local Players, UIS = game:GetService("Players"), game:GetService("UserInputService")
local plr = Players.LocalPlayer
local T = require(script.Parent:WaitForChild("Tema"))
local C = T.col

local gui = T.n("ScreenGui", { Name = "Mas1Ayuda", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local movil = UIS.TouchEnabled and not UIS.KeyboardEnabled
local MANDOS = movil
	and { { "JOYSTICK", "mover y boost" }, { "SALTO", "subir" }, { "PUÑO / PATADA", "golpear" } }
	or { { "A / D", "a los lados" }, { "W", "boost" }, { "ESPACIO / S", "subir / bajar" }, { "CLIC", "puño" }, { "E", "patada" } }

-- tira de mandos durante el vuelo
local ancho = #MANDOS * 170
local tira = T.panel(gui, { Size = UDim2.fromOffset(ancho, 78), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Visible = false }, C.tinta)
for i, m in ipairs(MANDOS) do
	T.texto(tira, { Text = m[1], TextSize = 24, TextColor3 = C.sol, Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset((i - 1) * 170, 8) })
	T.texto(tira, { Text = m[2], TextSize = 18, Size = UDim2.fromOffset(170, 26), Position = UDim2.fromOffset((i - 1) * 170, 40) })
end

-- consejo en tierra
local consejo = T.panel(gui, { Size = UDim2.fromOffset(560, 70), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -130), Visible = false }, C.cielo)
T.texto(consejo, { Text = movil and "Toca ¡LANZAR! para salir volando" or "Pulsa F o ¡LANZAR! para salir volando", TextSize = 26, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromScale(1, 1) })

local vuelos = 0
local function refrescar()
	local vuela = plr:GetAttribute("EnVuelo") == true
	tira.Visible = vuela and vuelos <= 3
	consejo.Visible = (not vuela) and vuelos == 0
end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(function()
	if plr:GetAttribute("EnVuelo") == true then
		vuelos = vuelos + 1
		refrescar()
		local este = vuelos
		task.delay(12, function() if vuelos == este then tira.Visible = false end end) -- se esconde solo a los 12 s
	else
		refrescar()
	end
end)
refrescar()
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001A">
<Properties>
<string name="Name">Canon</string>
<ProtectedString name="Source"><![CDATA[-- Cañon del lobby: al activar el aviso del cañon (E, toque o mando) pide el lanzamiento al servidor; y cuando alguien sale disparado
-- (efecto "lanzamiento" junto al cañon) el «Cañón pajarero» de Codex hace su retroceso: el clip Launch_recoil de Blender, en
-- src/ClipsEquipo.lua. Sus piezas estan ancladas y unidas a RootPart con Motor6D (asi las monto el 3D Importer): mientras dura el clip,
-- en este cliente, se apagan los Motor6D de las piezas que se mueven y cada una va a raiz * D * C0 * C1:Inverse(); al acabar vuelven
-- a su sitio y se encienden. El retroceso SIN PROBAR EN STUDIO (05/11: sin permiso de pantalla para el Studio nuevo).
local PPS, Players, RS, RunService = game:GetService("ProximityPromptService"), game:GetService("Players"), game:GetService("ReplicatedStorage"),
	game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local Red = require(Mas1:WaitForChild("Red"))
local Clips = require(Mas1:WaitForChild("Clips"))
local accion = Red.evento("MAS1_Accion")
local efecto = Red.evento("MAS1_Efecto")
local plr = Players.LocalPlayer
PPS.PromptTriggered:Connect(function(prompt, jugador)
	if jugador == plr and prompt.Parent and prompt.Parent.Name == "MAS1_Canon" and plr:GetAttribute("EnVuelo") ~= true then
		accion:FireServer("lanzar")
	end
end)

local moduloEquipo = Mas1:FindFirstChild("ClipsEquipo")
local equipo = moduloEquipo and require(moduloEquipo)
local clipsCanon = equipo and Clips.preparar(equipo.clips.Canon)
local RETROCESO = clipsCanon and clipsCanon.Launch_recoil
local PIEZAS = equipo and equipo.piezas.Canon or {}
local CERCA_CANON = 60 -- studs: un lanzamiento a esta distancia del cañon sale de el
local enMarcha = false

local function retroceso(canon)
	local raiz = canon.PrimaryPart
	if not raiz or enMarcha then return end
	local mover = {} -- { motor, pieza, reposo (respecto a la raiz), fotogramas }
	for _, m in ipairs(canon:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 == raiz and m.Part1 then
			local f = RETROCESO.huesos[PIEZAS[m.Part1.Name] or ""]
			if f then mover[#mover + 1] = { m = m, p = m.Part1, reposo = m.C0 * m.C1:Inverse(), f = f } end
		end
	end
	if #mover == 0 then return end
	enMarcha = true
	local escala = canon:GetScale()
	for _, x in ipairs(mover) do x.m.Enabled = false end
	local t0 = os.clock()
	local con
	con = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local fase = math.min(t / RETROCESO.dur, 1) * (RETROCESO.n - 1)
		local i = math.floor(fase)
		local a = fase - i
		for _, x in ipairs(mover) do
			local d = x.f[i + 1]:Lerp(x.f[math.min(i + 2, RETROCESO.n)], a)
			x.p.CFrame = raiz.CFrame * (d - d.Position + d.Position * escala) * x.reposo
		end
		if t >= RETROCESO.dur then
			con:Disconnect()
			for _, x in ipairs(mover) do
				x.p.CFrame = raiz.CFrame * x.reposo
				x.m.Enabled = true
			end
			enMarcha = false
		end
	end)
end

efecto.OnClientEvent:Connect(function(tipo, pos)
	if tipo ~= "lanzamiento" or not RETROCESO or typeof(pos) ~= "Vector3" then return end
	local lobby = workspace:FindFirstChild("MAS1_Lobby")
	local canon = lobby and lobby:FindFirstChild("CanonPajarero")
	if canon and canon.PrimaryPart and (canon.PrimaryPart.Position - pos).Magnitude < CERCA_CANON then retroceso(canon) end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001B">
<Properties>
<string name="Name">Efectos</string>
<ProtectedString name="Source"><![CDATA[-- Dibuja los efectos de src/Efectos.lua con ParticleEmitter. El servidor (o el juego) dispara RemoteEvent MAS1_Efecto:
--   FireClient(plr, "aro", Vector3)           -> rafaga en un punto
--   FireClient(plr, "estela", nil, parteOModelo, true/false) -> activa/desactiva un efecto continuo pegado a una parte
-- SIN PROBAR EN STUDIO.
local RS, Debris = game:GetService("ReplicatedStorage"), game:GetService("Debris")
local E = require(RS:WaitForChild("Mas1"):WaitForChild("Efectos"))
local R = RS:WaitForChild("MAS1_Efecto")

local function rgb(h) h = h:gsub("#", ""); return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16)) end
local function emisor(spec, padre)
	local pe = Instance.new("ParticleEmitter"); pe.Rate = spec.rate or 0
	pe.Lifetime = NumberRange.new(spec.life[1], spec.life[2]); pe.Speed = NumberRange.new(spec.speed[1], spec.speed[2])
	pe.SpreadAngle = Vector2.new(spec.spread, spec.spread); pe.Acceleration = Vector3.new(spec.accel[1], spec.accel[2], spec.accel[3]); pe.Drag = 2
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, spec.size[1]), NumberSequenceKeypoint.new(1, spec.size[2]) })
	local ks = {}
	for i, c in ipairs(spec.colors) do ks[#ks + 1] = ColorSequenceKeypoint.new((i - 1) / math.max(1, #spec.colors - 1), rgb(c)) end
	pe.Color = ColorSequence.new(ks); pe.LightEmission = spec.light or 0.3
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = padre; return pe
end

local continuos = {} -- [parte] = {tipo = emisor}
R.OnClientEvent:Connect(function(tipo, pos, parte, activo)
	local spec = E.TIPOS[tipo]; if not spec then return end
	if parte then -- efecto continuo pegado a una parte
		local p = parte:IsA("Model") and (parte.PrimaryPart or parte:FindFirstChildWhichIsA("BasePart")) or parte
		if not p then return end
		continuos[p] = continuos[p] or {}
		if activo == false then if continuos[p][tipo] then continuos[p][tipo]:Destroy(); continuos[p][tipo] = nil end
		elseif not continuos[p][tipo] then continuos[p][tipo] = emisor(spec, p) end
		return
	end
	local ancla = Instance.new("Part"); ancla.Anchored = true; ancla.CanCollide = false; ancla.CanQuery = false; ancla.Transparency = 1
	ancla.Size = Vector3.new(0.2, 0.2, 0.2); ancla.Position = pos; ancla.Parent = workspace
	local pe = emisor(spec, ancla); pe:Emit(spec.count or 20); Debris:AddItem(ancla, spec.life[2] + 0.5)
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001C">
<Properties>
<string name="Name">Entidades</string>
<ProtectedString name="Source"><![CDATA[-- Enemigos y cofres de «+1 de lanzamiento por segundo» vistos en el cliente. El servidor solo pone anclas invisibles en
-- Workspace.MAS1_Entidades (atributos Tipo, Vivo y, en los cofres, Dueno); aqui cada una se dibuja, se mueve suave y se anima: los
-- enemigos flotan con cara enfadada mirando a +Z (por donde llega el jugador) y encogen al ser golpeados; el cofre de cada jugador
-- (solo lo ve el) aletea mientras huye. Los enemigos usan las mallas voxel de mas1-arte/enemigos-v02 si estan en
-- ReplicatedStorage.MAS1_Enemigos (assets/MAS1_Enemigos.rbxmx), con sus clips de Blender (src/ClipsEnemigos.lua): Idle en bucle con
-- parpadeos (Blink) y Defeat al derribarlos, antes de encoger. Si no estan, y para el cofre, piezas provisionales con esos colores.
local Players, RS, RunService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService")
local plr = Players.LocalPlayer
if not game:IsLoaded() then game.Loaded:Wait() end -- con todo replicado, las mallas y sus clips ya estan si existen
local Mas1 = RS:WaitForChild("Mas1")
local Clips = require(Mas1:WaitForChild("Clips"))
local moduloClips = Mas1:FindFirstChild("ClipsEnemigos")
local CLIPS = moduloClips and require(moduloClips) or {}
local MALLAS = RS:FindFirstChild("MAS1_Enemigos")
local ESCALA_MALLA = 2.2 -- las mallas miden de 2 a 4,5 studs: asi quedan como las piezas de antes (unos 9)
local GIRO_MALLA = CFrame.Angles(0, math.pi, 0) -- el frente de la malla es su -Z; el enemigo mira a +Z, al jugador que llega
local RETRASO_ENCOGER = 0.6 -- s: con malla, al derribarlo se ve un momento su Defeat antes de encoger
local CERCA = 320 -- studs: mas lejos no se anima (no se aprecia y ahorra trabajo)
local anclas = workspace:WaitForChild("MAS1_Entidades")
local vista = Instance.new("Folder")
vista.Name = "MAS1_EntidadesVista"
vista.Parent = workspace

local function rgb(h)
	h = h:gsub("#", "")
	return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16))
end

local function pieza(m, forma, tam, cf, color, neon, transp)
	local p = forma == "Wedge" and Instance.new("WedgePart") or Instance.new("Part")
	if forma ~= "Wedge" then p.Shape = Enum.PartType[forma] end
	p.Size, p.CFrame, p.Color = tam, cf, rgb(color)
	p.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
	p.Transparency = transp or 0
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, not neon
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = m
	return p
end

local GIRO = CFrame.Angles(0, 0, math.rad(90)) -- un cilindro de Roblox va a lo largo de X: asi queda de pie

local function cara(m, y, z, s) -- ojos pequeños con brillo y cejas enfadadas, mirando a +Z
	for _, x in ipairs({ -0.6, 0.6 }) do
		pieza(m, "Block", Vector3.new(0.45, 0.65, 0.2) * s, CFrame.new(x * s, y, z), "#1d1626")
		pieza(m, "Block", Vector3.new(0.18, 0.18, 0.22) * s, CFrame.new((x + 0.1) * s, y + 0.15 * s, z + 0.02), "#ffffff")
		pieza(m, "Block", Vector3.new(0.75, 0.18, 0.2) * s, CFrame.new(x * s, y + 0.62 * s, z) * CFrame.Angles(0, 0, x > 0 and 0.45 or -0.45), "#1d1626")
	end
	pieza(m, "Block", Vector3.new(0.9, 0.18, 0.2) * s, CFrame.new(0, y - 0.6 * s, z), "#1d1626") -- morro gruñon
end

local MODELOS = {
	nube = function(m)
		pieza(m, "Ball", Vector3.one * 4.6, CFrame.new(), "#f4f6ff")
		pieza(m, "Ball", Vector3.one * 3.4, CFrame.new(-2.6, -0.5, 0), "#e8ebfb")
		pieza(m, "Ball", Vector3.one * 3.4, CFrame.new(2.6, -0.5, 0), "#e8ebfb")
		cara(m, 0.2, 2.25, 1.3)
	end,
	nubarron = function(m)
		pieza(m, "Ball", Vector3.one * 4.8, CFrame.new(), "#7a86a8")
		pieza(m, "Ball", Vector3.one * 3.6, CFrame.new(-2.7, -0.5, 0), "#56607f")
		pieza(m, "Ball", Vector3.one * 3.6, CFrame.new(2.7, -0.5, 0), "#56607f")
		pieza(m, "Block", Vector3.new(0.6, 2.4, 0.4), CFrame.new(-0.3, -3.2, 0) * CFrame.Angles(0, 0, 0.5), "#ffd23f", true)
		pieza(m, "Block", Vector3.new(0.6, 2.4, 0.4), CFrame.new(0.2, -4.9, 0) * CFrame.Angles(0, 0, -0.5), "#ffd23f", true)
		cara(m, 0.2, 2.35, 1.3)
	end,
	globo = function(m)
		pieza(m, "Ball", Vector3.one * 4.4, CFrame.new(), "#ff5d6c")
		pieza(m, "Ball", Vector3.one * 0.7, CFrame.new(0, -2.3, 0), "#e04a58")
		pieza(m, "Cylinder", Vector3.new(3, 0.12, 0.12), CFrame.new(0, -4, 0) * GIRO, "#ffffff")
		cara(m, 0.3, 2.1, 1.2)
	end,
	cometa = function(m)
		pieza(m, "Block", Vector3.new(4, 4, 0.4), CFrame.Angles(0, 0, math.rad(45)), "#ff6b5a")
		pieza(m, "Block", Vector3.new(2.2, 2.2, 0.44), CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.rad(45)), "#ffd23f")
		for k, c in ipairs({ "#ff6b5a", "#ffd23f", "#ff6b5a" }) do
			pieza(m, "Block", Vector3.one * 0.7, CFrame.new((k % 2 == 0) and 0.4 or -0.3, -2.6 - k, 0) * CFrame.Angles(0, 0, 0.4 * k), c)
		end
		cara(m, -0.2, 0.3, 1.0)
	end,
	ovni = function(m)
		pieza(m, "Cylinder", Vector3.new(1.2, 7, 7), GIRO, "#7c5cff")
		pieza(m, "Ball", Vector3.one * 2.8, CFrame.new(0, 0.9, 0), "#bdeaff", false, 0.35)
		pieza(m, "Ball", Vector3.one * 1.7, CFrame.new(0, 1.0, 0), "#6cd36c")
		for k = 0, 5 do
			local a = k * math.pi / 3
			pieza(m, "Ball", Vector3.one * 0.6, CFrame.new(math.cos(a) * 3.2, -0.1, math.sin(a) * 3.2), "#ffe14d", true)
		end
		cara(m, 1.05, 0.85, 0.55)
	end,
	meteorito = function(m)
		pieza(m, "Block", Vector3.new(3.6, 3.2, 3.4), CFrame.Angles(0.4, 0.6, 0.2), "#4a4359")
		pieza(m, "Block", Vector3.new(2.6, 2.8, 2.6), CFrame.new(0.6, 0.4, -0.5) * CFrame.Angles(-0.3, 0.2, 0.5), "#605670")
		pieza(m, "Wedge", Vector3.new(1.2, 2.6, 3.4), CFrame.new(-0.5, 1.6, -2.4) * CFrame.Angles(0.6, 0, 0), "#ff9d00", true)
		pieza(m, "Wedge", Vector3.new(0.9, 2.0, 2.6), CFrame.new(0.7, 1.4, -2.2) * CFrame.Angles(0.8, 0, 0), "#ff3d00", true)
		cara(m, 0.1, 2.05, 1.1)
	end,
	cofre = function(m)
		pieza(m, "Block", Vector3.new(3.4, 2.2, 2.4), CFrame.new(), "#8a5a34")
		pieza(m, "Block", Vector3.new(3.5, 0.8, 2.5), CFrame.new(0, 1.45, 0), "#a8703f")
		pieza(m, "Block", Vector3.new(0.5, 3.1, 2.6), CFrame.new(0, 0.4, 0), "#ffc42e")
		pieza(m, "Block", Vector3.new(0.7, 0.8, 0.3), CFrame.new(0, 0.6, 1.3), "#ffd23f", true)
		for _, s in ipairs({ -1, 1 }) do -- alas que aletean (las mueve el bucle de abajo)
			local ala = pieza(m, "Wedge", Vector3.new(0.3, 1.8, 3.2), CFrame.new(s * 2.4, 0.6, 0) * CFrame.Angles(0, 0, s * 0.3), "#ffffff")
			ala.Name = s < 0 and "AlaIzq" or "AlaDer"
		end
	end,
}

-- [ancla] = { m, pos (suavizada), fase, alas, escala (1 = vivo), tam, giro, partes, huesos y clips (con malla), golpe, parpadeo }
local vistos = {}

local function crear(a)
	local tipo = a:GetAttribute("Tipo") or ""
	local malla = tipo ~= "cofre" and MALLAS and MALLAS:FindFirstChild(tipo)
	if (not malla and not MODELOS[tipo]) or vistos[a] then return end
	if tipo == "cofre" and a:GetAttribute("Dueno") ~= plr.UserId then return end -- cada uno ve solo su cofre
	local m
	if malla then
		m = malla:Clone()
	else
		m = Instance.new("Model")
		MODELOS[tipo](m)
		m.WorldPivot = CFrame.new() -- las piezas se hacen alrededor del origen: PivotTo y ScaleTo trabajan desde ahi
	end
	m.Name = tipo
	local partes = {}
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
			partes[#partes + 1] = p
		end
	end
	m.Parent = vista
	local alas = {}
	for _, n in ipairs({ "AlaIzq", "AlaDer" }) do
		local p = m:FindFirstChild(n)
		if p then alas[#alas + 1] = { p = p, base = p.CFrame, s = n == "AlaIzq" and -1 or 1 } end
	end
	vistos[a] = {
		m = m, pos = a.Position, fase = math.random() * 6.28, alas = alas, escala = 1, partes = partes,
		tam = malla and ESCALA_MALLA or 1, giro = malla and GIRO_MALLA or CFrame.identity,
		huesos = malla and Clips.huesos(m), clips = malla and Clips.preparar(CLIPS[tipo]),
		parpadeo = os.clock() + 1 + math.random() * 3,
	}
end

local function quitar(a)
	local v = vistos[a]
	if v then
		v.m:Destroy()
		vistos[a] = nil
	end
end

for _, a in ipairs(anclas:GetChildren()) do crear(a) end
anclas.ChildAdded:Connect(crear)
anclas.ChildRemoved:Connect(quitar)

local camara = workspace.CurrentCamera

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	local ojo = camara.CFrame.Position
	for a, v in pairs(vistos) do
		v.pos = v.pos:Lerp(a.Position, 1 - math.exp(-12 * dt)) -- los cofres se mueven: suave aunque el servidor mande a saltos
		local vivo = a:GetAttribute("Vivo") ~= false
		if vivo then v.golpe = nil elseif not v.golpe then v.golpe = t end -- golpe = cuando lo derribaron
		-- golpeado: encoge hasta desaparecer y vuelve al reaparecer
		local objetivo = (vivo or (v.huesos and t - v.golpe < RETRASO_ENCOGER)) and 1 or 0.05
		v.escala += (objetivo - v.escala) * (1 - math.exp(-10 * dt))
		local cf = CFrame.new(v.pos + Vector3.new(0, math.sin(t * 2 + v.fase) * 0.6, 0)) * CFrame.Angles(0, math.sin(t + v.fase) * 0.15, 0)
		local escala = math.max(0.05, v.escala) * v.tam
		if math.abs(v.m:GetScale() - escala) > 0.01 then v.m:ScaleTo(escala) end
		v.m:PivotTo(cf * v.giro)
		for _, ala in ipairs(v.alas) do
			ala.p.CFrame = cf * ala.base * CFrame.Angles(0, 0, ala.s * math.sin(t * 14) * 0.6)
		end
		if v.clips and (v.pos - ojo).Magnitude < CERCA then
			local e = v.m:GetScale()
			if v.golpe then
				Clips.aplicar(v.huesos, v.clips.Defeat, t - v.golpe, e, false)
			else
				Clips.aplicar(v.huesos, v.clips.Idle, t + v.fase, e, true)
				local parpado = v.clips.Blink
				if parpado and t >= v.parpadeo then
					Clips.aplicar(v.huesos, parpado, t - v.parpadeo, e, false, true)
					if t - v.parpadeo > parpado.dur then v.parpadeo = t + 2 + math.random() * 3 end
				end
			end
		end
		for _, p in ipairs(v.partes) do
			p.LocalTransparencyModifier = v.escala < 0.08 and 1 or 0
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001D">
<Properties>
<string name="Name">HudVuelo</string>
<ProtectedString name="Source"><![CDATA[-- HUD de vuelo de «+1 de lanzamiento por segundo». Lee atributos del jugador local (los pone el juego o DemoVisual.server.lua):
-- Energia (0-1), Potencia, Puntos, Distancia (m), ZonaMult, Aros, ArosTotal, Mascota (nombre), MascotaBonus (numero). SIN PROBAR EN STUDIO.
local Players, RS, UIS = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local plr = Players.LocalPlayer
local T = require(script.Parent:WaitForChild("Tema"))
local C, n = T.col, T.n
local accion = RS:WaitForChild("MAS1_Accion", 3) -- RemoteEvent opcional (puno / patada / turbo)

local gui = n("ScreenGui", { Name = "Mas1Hud", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local function fmt(x) -- 12480 -> "12.480"
	local s = tostring(math.floor(x + 0.5)); local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return (out:gsub("^%.", ""))
end
local function pop(label) -- pequeno rebote al cambiar un numero
	label.TextSize = label:GetAttribute("base") * 1.25
	TweenService:Create(label, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = label:GetAttribute("base") }):Play()
end
local function numero(padre, texto, color) -- etiqueta pequeña + número grande; devuelve el número
	T.texto(padre, { Text = string.upper(texto), TextSize = 17, Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(14, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color or C.crema })
	local l = T.texto(padre, { Text = "0", TextSize = 42, Size = UDim2.new(1, -24, 0, 46), Position = UDim2.fromOffset(14, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color or C.crema })
	l:SetAttribute("base", 42); return l
end

-- Energia (arriba al centro)
local pEn = T.panel(gui, { Size = UDim2.fromOffset(620, 84), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 18) }, C.crema)
T.texto(pEn, { Text = "ENERGÍA", TextSize = 20, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromOffset(200, 24), Position = UDim2.fromOffset(18, 6), TextXAlignment = Enum.TextXAlignment.Left })
local tEnPct = T.texto(pEn, { Text = "100%", TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromOffset(120, 28), Position = UDim2.new(1, -138, 0, 4), TextXAlignment = Enum.TextXAlignment.Right })
local bEn = T.barra(pEn, { Size = UDim2.new(1, -36, 0, 30), Position = UDim2.fromOffset(18, 40) })

local pPun = T.panel(gui, { Size = UDim2.fromOffset(300, 84), Position = UDim2.fromOffset(24, 18) }, C.rosa)
local tPun = numero(pPun, "puntos del vuelo")
local pDis = T.panel(gui, { Size = UDim2.fromOffset(300, 84), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 18) }, C.cielo)
local tDis = numero(pDis, "distancia", C.tinta); tDis.TextXAlignment = Enum.TextXAlignment.Right
local pPot = T.panel(gui, { Size = UDim2.fromOffset(250, 84), Position = UDim2.fromOffset(24, 122) }, C.menta)
local tPot = numero(pPot, "potencia")
local pAro = T.panel(gui, { Size = UDim2.fromOffset(250, 84), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 122) }, C.crema)
local tAro = numero(pAro, "aros", C.tinta)

-- Multiplicador de zona (centro, inclinado)
local pMul = T.panel(gui, { Size = UDim2.fromOffset(200, 96), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 114), Rotation = -3 }, C.sol)
T.texto(pMul, { Text = "ZONA", TextSize = 17, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 6) })
local tMul = T.texto(pMul, { Text = "x1", TextSize = 58, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 24) }); tMul:SetAttribute("base", 58)

-- Combo (a la derecha del centro): xN con rebote mientras haya racha de aros, orbes, cofres y golpes
local pCombo = T.panel(gui, { Size = UDim2.fromOffset(170, 96), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 230, 0, 120), Rotation = 4, Visible = false }, C.rosa)
T.texto(pCombo, { Text = "COMBO", TextSize = 17, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 6) })
local tCombo = T.texto(pCombo, { Text = "x0", TextSize = 56, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 24) }); tCombo:SetAttribute("base", 56)

-- Mascota (abajo a la izquierda)
local pMas = T.panel(gui, { Size = UDim2.fromOffset(280, 92), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -34) }, C.crema)
T.texto(pMas, { Text = "MASCOTA", TextSize = 16, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(14, 6), TextXAlignment = Enum.TextXAlignment.Left })
local tMas = T.texto(pMas, { Text = "—", TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, -24, 0, 32), Position = UDim2.fromOffset(14, 22), TextXAlignment = Enum.TextXAlignment.Left })
local chip = T.panel(pMas, { Size = UDim2.fromOffset(150, 28), Position = UDim2.fromOffset(14, 56) }, C.menta); chip.UIStroke.Thickness = 3
local tChip = T.texto(chip, { Text = "x1 ganancias", TextSize = 18, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.fromScale(1, 1) })

-- Botones (movil y escritorio; en escritorio: clic = puño, E = patada; W es boost mantenido; son PROPUESTAS)
local function lanzar(nombre) if accion then accion:FireServer(nombre) end end
local bPuno = T.boton(gui, { Size = UDim2.fromOffset(130, 130), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -150, 1, -60), Text = "PUÑO" }, C.rosa, function() lanzar("puno") end)
local bPat = T.boton(gui, { Size = UDim2.fromOffset(110, 110), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -34, 1, -130), Text = "PATADA" }, C.sol, function() lanzar("patada") end); bPat.TextColor3 = C.tinta
local bTur = T.boton(gui, { Size = UDim2.fromOffset(100, 100), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -300, 1, -34), Text = "TURBO" }, C.menta, function() lanzar("turbo") end); bTur.TextColor3 = C.tinta
if not UIS.TouchEnabled then
	for _, b in ipairs({ bPuno, bPat, bTur }) do b.Active = false end
	local focoDesde = 0 -- el clic que da el foco a la ventana no es un golpe
	UIS.WindowFocused:Connect(function() focoDesde = os.clock() end)
	UIS.InputBegan:Connect(function(i, gp)
		if gp or plr:GetAttribute("EnVuelo") ~= true then return end -- solo se golpea volando
		if i.UserInputType == Enum.UserInputType.MouseButton1 and os.clock() - focoDesde < 0.4 then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 then lanzar("puno") elseif i.KeyCode == Enum.KeyCode.E then lanzar("patada") end
	end)
end

-- Actualizacion desde atributos
local ultimo = {}
local function refrescar()
	local en = math.clamp(plr:GetAttribute("Energia") or 1, 0, 1)
	bEn.set(en, en > 0.5 and C.sol or (en > 0.2 and Color3.fromRGB(255, 150, 40) or C.rosa)); tEnPct.Text = math.floor(en * 100 + 0.5) .. "%"
	for _, d in ipairs({ { "Puntos", tPun }, { "Distancia", tDis }, { "Potencia", tPot } }) do
		local v = plr:GetAttribute(d[1]) or 0
		d[2].Text = (d[1] == "Distancia" and (fmt(v) .. " m")) or (d[1] == "Potencia" and ("+" .. fmt(v))) or fmt(v)
		if ultimo[d[1]] and ultimo[d[1]] ~= v then pop(d[2]) end; ultimo[d[1]] = v
	end
	local m = plr:GetAttribute("ZonaMult") or 1; tMul.Text = "x" .. m
	if ultimo.m and ultimo.m ~= m then pop(tMul) end; ultimo.m = m
	local combo = plr:GetAttribute("Combo") or 0
	pCombo.Visible = combo >= 2 and plr:GetAttribute("EnVuelo") == true
	tCombo.Text = "x" .. combo
	tCombo.TextColor3 = combo >= 20 and C.sol or (combo >= 10 and C.cielo or C.crema)
	if ultimo.combo and ultimo.combo ~= combo and combo > 0 then pop(tCombo) end; ultimo.combo = combo
	tAro.Text = (plr:GetAttribute("Aros") or 0) .. " / " .. (plr:GetAttribute("ArosTotal") or 0)
	tMas.Text = plr:GetAttribute("Mascota") or "—"; tChip.Text = "x" .. tostring(plr:GetAttribute("MascotaBonus") or 1) .. " ganancias"
end
for _, a in ipairs({ "Energia", "Potencia", "Puntos", "Distancia", "ZonaMult", "Aros", "ArosTotal", "Mascota", "MascotaBonus", "Combo", "EnVuelo" }) do plr:GetAttributeChangedSignal(a):Connect(refrescar) end
refrescar()
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001E">
<Properties>
<string name="Name">Inventario</string>
<ProtectedString name="Source"><![CDATA[-- Inventario de «+1 de lanzamiento por segundo»: pestañas MASCOTAS (equipar hasta 3), HUEVOS (abrir con dinero) y ALAS (comprar y
-- equipar). Revelado del huevo con rebote y color de rareza. Formas de eventos en CONTRATO.md (MAS1_Inventario, MAS1_Huevo,
-- MAS1_Accion). La UI NO calcula nada: manda intenciones y pinta lo que diga el servidor. SIN PROBAR EN STUDIO.
local Players, RS, UIS, TweenService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("UserInputService"), game:GetService("TweenService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local M = require(Mas1:WaitForChild("Mascotas"))
local okA, Alas = pcall(function() return require(Mas1:WaitForChild("Alas", 3)) end) -- hito 6: lista de alas con precio y requisitos
if not okA then Alas = nil end
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local C, n = T.col, T.n
local accion, evInv, evHuevo = Red.evento("MAS1_Accion"), Red.evento("MAS1_Inventario"), Red.evento("MAS1_Huevo")

local COLOR = { comun = Color3.fromRGB(190, 190, 200), poco_comun = Color3.fromRGB(110, 210, 120), raro = Color3.fromRGB(80, 160, 255),
	epico = Color3.fromRGB(170, 100, 255), legendario = Color3.fromRGB(255, 190, 40), mitico = Color3.fromRGB(255, 80, 140), robux = Color3.fromRGB(255, 120, 40) }
local NOMBRE = { comun = "Común", poco_comun = "Poco común", raro = "Raro", epico = "Épico", legendario = "Legendario", mitico = "Mítico", robux = "Robux" }
local STAT = { impulso = "Impulso", resistencia = "Resistencia", dinero = "Dinero", exp = "Exp" }

local inv = { mascotas = {}, equipadas = {}, alas = {}, alaEquipada = nil }

local gui = n("ScreenGui", { Name = "Mas1Inventario", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local panel, pestana = nil, "mascotas"
local pintar

local function bonusTexto(p)
	local t = {}
	for _, s in ipairs(M.STATS) do if p.bonus[s] then t[#t + 1] = STAT[s] .. " +" .. p.bonus[s] .. "%" end end
	return table.concat(t, "  ·  ")
end

local function tarjeta(padre, p, cant, x, y, equipada)
	local c = T.panel(padre, { Size = UDim2.fromOffset(250, 150), Position = UDim2.fromOffset(x, y) }, equipada and C.sol or C.morado)
	n("Frame", { Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = COLOR[p.rareza], BorderSizePixel = 0 }, c)
	T.texto(c, { Text = p.nombre, TextSize = 24, TextColor3 = equipada and C.tinta or C.crema, TextStrokeTransparency = equipada and 1 or 0.55, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 14) })
	T.texto(c, { Text = NOMBRE[p.rareza] .. (cant > 1 and ("  x" .. cant) or ""), TextSize = 18, TextColor3 = COLOR[p.rareza], Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 44) })
	T.texto(c, { Text = bonusTexto(p), TextSize = 16, TextWrapped = true, TextColor3 = equipada and C.tinta or C.crema, TextStrokeTransparency = equipada and 1 or 0.55, Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 68) })
	local b = T.boton(c, { Size = UDim2.fromOffset(130, 34), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Text = equipada and "QUITAR" or "EQUIPAR" }, equipada and C.rosa or C.menta, function()
		accion:FireServer(equipada and "desequipar" or "equipar", "mascota", p.id)
	end)
	b.TextSize = 18
	return c
end

local function paginaMascotas(cont)
	local y = 10
	T.texto(cont, { Text = string.format("EQUIPADAS %d / 3", #inv.equipadas), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y) })
	y = y + 36
	local x = 10
	for _, id in ipairs(inv.equipadas) do
		local p = M.get(id)
		if p then tarjeta(cont, p, 1, x, y, true); x = x + 262 end
	end
	if #inv.equipadas == 0 then T.texto(cont, { Text = "Ninguna: equipa mascotas para ganar bonus.", TextSize = 20, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y + 8) }) end
	y = y + 168
	T.texto(cont, { Text = "TUS MASCOTAS", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y) })
	y = y + 36
	local col, hay = 0, false
	for _, p in ipairs(M.LISTA) do
		local cant = inv.mascotas[p.id] or 0
		if cant > 0 then
			hay = true
			tarjeta(cont, p, cant, 10 + col * 262, y, false)
			col = col + 1
			if col == 3 then col, y = 0, y + 162 end
		end
	end
	if not hay then T.texto(cont, { Text = "Aún no tienes mascotas. ¡Abre un huevo!", TextSize = 22, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, y) }) end
	cont.CanvasSize = UDim2.fromOffset(0, y + (col > 0 and 170 or 10) + 20)
end

local function paginaHuevos(cont)
	local dinero = plr:GetAttribute("Dinero") or 0
	local y = 10
	T.texto(cont, { Text = "Los huevos cuestan dinero. Más rareza, mejores mascotas.", TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, y) })
	y = y + 36
	for _, r in ipairs({ "comun", "poco_comun", "raro", "epico", "legendario", "mitico" }) do
		local precio = M.PRECIO_HUEVO and M.PRECIO_HUEVO[r] -- lo pone el servidor en el hito 4
		local f = T.panel(cont, { Size = UDim2.new(1, -30, 0, 70), Position = UDim2.fromOffset(10, y) }, C.morado)
		n("Frame", { Size = UDim2.fromOffset(12, 70), BackgroundColor3 = COLOR[r], BorderSizePixel = 0 }, f)
		T.texto(f, { Text = "Huevo " .. string.lower(NOMBRE[r]), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLOR[r], Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromOffset(28, 0) })
		local alcanza = precio and dinero >= precio
		local b = T.boton(f, { Size = UDim2.fromOffset(190, 46), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Text = precio and ("ABRIR · " .. precio) or "ABRIR" },
			alcanza and C.sol or Color3.fromRGB(110, 100, 130), function() accion:FireServer("abrirHuevo", r) end)
		b.TextSize = 22
		y = y + 82
	end
	cont.CanvasSize = UDim2.fromOffset(0, y + 10)
end

local function paginaAlas(cont)
	local y = 10
	local lista = Alas and Alas.LISTA or {}
	if #lista == 0 then
		T.texto(cont, { Text = "Las alas llegan pronto.", TextSize = 24, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, y) })
		return
	end
	for _, a in ipairs(lista) do
		local tiene = table.find(inv.alas, a.id) ~= nil
		local puesta = inv.alaEquipada == a.id
		local f = T.panel(cont, { Size = UDim2.new(1, -30, 0, 84), Position = UDim2.fromOffset(10, y) }, puesta and C.sol or C.morado)
		T.texto(f, { Text = a.nombre, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = puesta and C.tinta or C.crema, TextStrokeTransparency = puesta and 1 or 0.55, Size = UDim2.new(0.55, 0, 0, 36), Position = UDim2.fromOffset(16, 6) })
		T.texto(f, { Text = a.requisito or "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextColor3 = puesta and C.tinta or C.crema, TextStrokeTransparency = puesta and 1 or 0.55, Size = UDim2.new(0.55, 0, 0, 36), Position = UDim2.fromOffset(16, 42) })
		local texto = puesta and "QUITAR" or (tiene and "EQUIPAR" or (a.precio and ("COMPRAR · " .. a.precio) or "BLOQUEADA"))
		local b = T.boton(f, { Size = UDim2.fromOffset(200, 48), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Text = texto },
			puesta and C.rosa or (tiene and C.menta or C.sol), function()
				if puesta then accion:FireServer("desequipar", "ala", a.id)
				elseif tiene then accion:FireServer("equipar", "ala", a.id)
				else accion:FireServer("comprarAla", a.id) end
			end)
		b.TextSize = 20
		y = y + 96
	end
	cont.CanvasSize = UDim2.fromOffset(0, y + 10)
end

pintar = function()
	if not panel then return end
	local cont = panel:FindFirstChild("Contenido")
	if cont then cont:Destroy() end
	cont = n("ScrollingFrame", { Name = "Contenido", Size = UDim2.new(1, -30, 1, -140), Position = UDim2.fromOffset(15, 120), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.fromOffset(0, 600), AutomaticCanvasSize = Enum.AutomaticSize.None }, panel)
	if pestana == "mascotas" then paginaMascotas(cont) elseif pestana == "huevos" then paginaHuevos(cont) else paginaAlas(cont) end
end

local function cerrar() if panel then panel:Destroy(); panel = nil end end

local function abrir()
	if plr:GetAttribute("EnVuelo") == true then return end
	if panel then cerrar() return end
	panel = T.panel(gui, { Size = UDim2.fromOffset(820, 640), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, C.violeta)
	T.texto(panel, { Text = "MASCOTAS Y ALAS", TextSize = 38, TextColor3 = C.sol, Size = UDim2.new(1, -80, 0, 48), Position = UDim2.fromOffset(20, 10), TextXAlignment = Enum.TextXAlignment.Left })
	local x = n("TextButton", { Text = "X", Font = T.fuente, TextSize = 26, TextColor3 = C.crema, BackgroundColor3 = C.rosa, Size = UDim2.fromOffset(46, 46), Position = UDim2.new(1, -58, 0, 10), BorderSizePixel = 0 }, panel)
	n("UICorner", { CornerRadius = UDim.new(1, 0) }, x); n("UIStroke", { Color = C.tinta, Thickness = 4 }, x)
	x.MouseButton1Click:Connect(cerrar)
	for i, par in ipairs({ { "mascotas", "MASCOTAS" }, { "huevos", "HUEVOS" }, { "alas", "ALAS" } }) do
		local activa = pestana == par[1]
		local b = n("TextButton", { Text = par[2], Font = T.fuente, TextSize = 24, TextColor3 = activa and C.tinta or C.crema, BackgroundColor3 = activa and C.sol or C.morado,
			Size = UDim2.fromOffset(150, 44), Position = UDim2.fromOffset(20 + (i - 1) * 160, 66), BorderSizePixel = 0 }, panel)
		n("UICorner", { CornerRadius = UDim.new(0, 12) }, b); n("UIStroke", { Color = C.tinta, Thickness = 4 }, b)
		b.MouseButton1Click:Connect(function() pestana = par[1]; cerrar(); abrir() end)
	end
	pintar()
end

-- boton de la esquina para abrir el inventario (y tecla B)
local btn = T.boton(gui, { Size = UDim2.fromOffset(170, 64), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 20, 1, -20), Text = "MASCOTAS" }, C.violeta, abrir)
local function verBtn() btn.Visible = plr:GetAttribute("EnVuelo") ~= true end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(function() verBtn(); if plr:GetAttribute("EnVuelo") == true then cerrar() end end)
verBtn()
UIS.InputBegan:Connect(function(i, gp) if not gp and i.KeyCode == Enum.KeyCode.B then abrir() end end)

evInv.OnClientEvent:Connect(function(d)
	inv = { mascotas = d.mascotas or {}, equipadas = d.equipadas or {}, alas = d.alas or {}, alaEquipada = d.alaEquipada }
	pintar()
end)
plr:GetAttributeChangedSignal("Dinero"):Connect(function() if panel and pestana == "huevos" then pintar() end end)

-- revelado del huevo: sacude, estalla y muestra la mascota con el color de su rareza
evHuevo.OnClientEvent:Connect(function(d)
	local p = M.get(d.mascotaId)
	if not p then return end
	local fondo = n("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.tinta, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 50 }, gui)
	local huevo = T.texto(fondo, { Text = "🥚", TextSize = 140, Size = UDim2.fromOffset(200, 200), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), ZIndex = 51 })
	task.spawn(function()
		for i = 1, 10 do huevo.Rotation = (i % 2 == 0 and 14 or -14); task.wait(0.07) end
		huevo:Destroy()
		local tarj = T.panel(fondo, { Size = UDim2.fromOffset(420, 300), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), ZIndex = 52 }, COLOR[p.rareza])
		T.texto(tarj, { Text = d.nueva and "¡NUEVA!" or "¡OTRA VEZ!", TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 12), ZIndex = 53 })
		T.texto(tarj, { Text = p.nombre, TextSize = 44, Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 60), ZIndex = 53 })
		T.texto(tarj, { Text = string.upper(NOMBRE[p.rareza]), TextSize = 28, TextColor3 = C.tinta, TextStrokeTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 124), ZIndex = 53 })
		T.texto(tarj, { Text = bonusTexto(p), TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -30, 0, 70), Position = UDim2.fromOffset(15, 172), ZIndex = 53 })
		tarj.Size = UDim2.fromOffset(120, 90)
		TweenService:Create(tarj, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(420, 300) }):Play()
		task.wait(3)
		fondo:Destroy()
	end)
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ000001F">
<Properties>
<string name="Name">Misiones</string>
<ProtectedString name="Source"><![CDATA[-- Panel de misiones de «+1 de lanzamiento por segundo»: 3 misiones de la sesion con barra de progreso, a la izquierda, solo en tierra.
-- Lee el atributo Misiones ("texto|progreso|meta|premio;..."), que escribe el servidor al aterrizar. SIN PROBAR EN STUDIO.
local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local T = require(script.Parent:WaitForChild("Tema"))
local C = T.col

local gui = T.n("ScreenGui", { Name = "Mas1Misiones", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 4 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)
local panel = T.panel(gui, { Size = UDim2.fromOffset(300, 252), Position = UDim2.fromOffset(24, 236) }, C.morado)
T.texto(panel, { Text = "MISIONES", TextSize = 24, TextColor3 = C.sol, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 6) })
local filas = {}
for i = 1, 3 do
	local y = 46 + (i - 1) * 68
	local t = T.texto(panel, { Text = "", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(12, y) })
	local b = T.barra(panel, { Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, y + 26) })
	filas[i] = { t = t, b = b }
end

local function pintar()
	local s = plr:GetAttribute("Misiones") or ""
	local i = 0
	for texto, prog, meta, premio in string.gmatch(s, "([^|;]+)|(%d+)|(%d+)|(%d+)") do
		i = i + 1
		local f = filas[i]
		if not f then break end
		f.t.Text = string.format("%s  %s/%s  ·  +%s", texto, prog, meta, premio)
		f.b.set(tonumber(prog) / tonumber(meta), tonumber(prog) / tonumber(meta) >= 1 and C.menta or C.cielo)
	end
end
plr:GetAttributeChangedSignal("Misiones"):Connect(pintar)
pintar()
local function ver() panel.Visible = plr:GetAttribute("EnVuelo") ~= true end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(ver)
ver()
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000020">
<Properties>
<string name="Name">Orbes</string>
<ProtectedString name="Source"><![CDATA[-- Orbes «+1» de «+1 de lanzamiento por segundo» vistos en el cliente: los mismos que genera el servidor (Encuentros.colocarOrbes,
-- con semilla fija), como bolas Neon doradas que giran y flotan. Al cogerlos (MAS1_Orbe, indices que manda el servidor) encogen
-- y desaparecen; en cada lanzamiento vuelven todos. Cada uno da +1 de potencia (lo suma el servidor). SIN PROBAR EN STUDIO.
local Players, RS, RunService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local E = require(Mas1:WaitForChild("Encuentros"))
local Red = require(Mas1:WaitForChild("Red"))
local orbeEv = Red.evento("MAS1_Orbe")

local carpeta = Instance.new("Folder")
carpeta.Name = "MAS1_Orbes"
carpeta.Parent = workspace
local orbes = {}
for i, o in ipairs(E.colocarOrbes()) do
	local p = Instance.new("Part")
	p.Shape, p.Size, p.Material = Enum.PartType.Ball, Vector3.new(1.8, 1.8, 1.8), Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 214, 64)
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Position = Vector3.new(o.pos.x, o.pos.y, o.pos.z)
	p.Parent = carpeta
	orbes[i] = { p = p, base = p.Position, fase = i * 0.7, vivo = true, escala = 1 }
end

orbeEv.OnClientEvent:Connect(function(indices)
	for _, i in ipairs(indices) do
		if orbes[i] then orbes[i].vivo = false end
	end
end)

plr:GetAttributeChangedSignal("EnVuelo"):Connect(function()
	if plr:GetAttribute("EnVuelo") == true then -- cada vuelo, todos otra vez
		for _, o in ipairs(orbes) do o.vivo = true end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	local cam, t = workspace.CurrentCamera, os.clock()
	local cz = cam and cam.CFrame.Position.Z or 0
	for _, o in ipairs(orbes) do
		if math.abs(o.base.Z - cz) < 260 then -- solo los cercanos: el resto no se ve
			o.escala += ((o.vivo and 1 or 0) - o.escala) * (1 - math.exp(-14 * dt))
			o.p.Transparency = o.escala < 0.05 and 1 or 0
			o.p.Size = Vector3.one * 1.8 * math.max(0.05, o.escala) * (1 + 0.12 * math.sin(t * 6 + o.fase))
			o.p.Position = o.base + Vector3.new(0, math.sin(t * 2 + o.fase) * 0.4, 0)
		end
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000021">
<Properties>
<string name="Name">Rebirth</string>
<ProtectedString name="Source"><![CDATA[-- Rebirth y avisos de «+1 de lanzamiento por segundo»: boton REBIRTH (solo en tierra) con un panel de confirmacion que muestra
-- potencia, coste y rebirths; y los avisos de texto del servidor (MAS1_Aviso). El servidor decide: aqui solo se manda "rebirth".
-- Reinicia SOLO la potencia; conserva alas, mascotas, puntos y desbloqueos. Lee atributos Potencia, CosteRebirth, Rebirths, Entreno.
-- SIN PROBAR EN STUDIO.
local Players, RS, TweenService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("TweenService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local C, n = T.col, T.n
local accion, aviso = Red.evento("MAS1_Accion"), Red.evento("MAS1_Aviso")

local gui = n("ScreenGui", { Name = "Mas1Rebirth", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 15 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)

local function fmt(x)
	local s = tostring(math.floor((x or 0) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return (out:gsub("^%.", ""))
end

-- avisos de texto (arriba, bajo la energia)
local toastActual
aviso.OnClientEvent:Connect(function(texto)
	if toastActual then toastActual:Destroy() end
	local p = T.panel(gui, { Size = UDim2.fromOffset(520, 64), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -90) }, C.rosa)
	toastActual = p
	T.texto(p, { Text = tostring(texto), TextSize = 26, TextWrapped = true, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0) })
	TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 120) }):Play()
	task.delay(3, function()
		if toastActual == p then
			TweenService:Create(p, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 0, -90) }):Play()
			task.delay(0.3, function() if p.Parent then p:Destroy() end if toastActual == p then toastActual = nil end end)
		end
	end)
end)

-- panel de rebirth
local panel
local function cerrar() if panel then panel:Destroy(); panel = nil end end

local function abrir()
	if plr:GetAttribute("EnVuelo") == true then return end
	if panel then cerrar() return end
	local pot, coste, rb = plr:GetAttribute("Potencia") or 0, plr:GetAttribute("CosteRebirth") or 500, plr:GetAttribute("Rebirths") or 0
	local alcanza = pot >= coste
	panel = T.panel(gui, { Size = UDim2.fromOffset(560, 420), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, C.violeta)
	T.texto(panel, { Text = "REBIRTH", TextSize = 52, TextColor3 = C.sol, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 12) })
	T.texto(panel, { Text = string.format("Rebirths: %d", rb), TextSize = 26, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 78) })
	local barra = T.barra(panel, { Size = UDim2.new(1, -60, 0, 44), Position = UDim2.fromOffset(30, 124) })
	barra.set(math.min(pot / coste, 1), alcanza and C.menta or C.sol)
	T.texto(panel, { Text = string.format("Potencia %s / %s", fmt(pot), fmt(coste)), TextSize = 28, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 176) })
	T.texto(panel, { Text = "Reinicia SOLO tu potencia. Conservas alas, mascotas y puntos. Entrenas más rápido y tus alas crecen.",
		TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -60, 0, 80), Position = UDim2.fromOffset(30, 220) })
	local ok = T.boton(panel, { Size = UDim2.fromOffset(250, 66), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.3, 0, 1, -24), Text = alcanza and "¡REBIRTH!" or "FALTA POTENCIA" },
		alcanza and C.menta or Color3.fromRGB(110, 100, 130), function()
			if alcanza then accion:FireServer("rebirth"); cerrar() end
		end)
	T.boton(panel, { Size = UDim2.fromOffset(200, 66), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.76, 0, 1, -24), Text = "CERRAR" }, C.rosa, cerrar)
end

local btn = T.boton(gui, { Size = UDim2.fromOffset(170, 64), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 210, 1, -20), Text = "REBIRTH" }, C.rosa, abrir)
local function ver()
	local vuela = plr:GetAttribute("EnVuelo") == true
	btn.Visible = not vuela
	if vuela then cerrar() end
end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(ver)
ver()
-- si el rebirth se hace, el panel se cierra solo; al subir el contador se anima el boton
plr:GetAttributeChangedSignal("Rebirths"):Connect(function()
	cerrar()
	btn.Size = UDim2.fromOffset(210, 80)
	TweenService:Create(btn, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(170, 64) }):Play()
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000022">
<Properties>
<string name="Name">Resultados</string>
<ProtectedString name="Source"><![CDATA[-- Pantalla de resultados del vuelo de «+1 de lanzamiento por segundo»: aparece al aterrizar (MAS1_Resultado), cuenta hacia arriba
-- la distancia, el multiplicador de zona, el dinero y la exp, y ofrece ¡OTRA VEZ! (lanzar de nuevo). Sustituye al cartel provisional
-- de VueloControl. Datos de CONTRATO.md. SIN PROBAR EN STUDIO.
local Players, RS, TweenService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("TweenService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local accion, resultado = Red.evento("MAS1_Accion"), Red.evento("MAS1_Resultado")

local gui = T.n("ScreenGui", { Name = "Mas1Resultados", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20 }, plr:WaitForChild("PlayerGui"))
T.escala(gui)
local actual -- panel abierto

local function cerrar()
	if actual then actual:Destroy(); actual = nil end
end

local function fila(padre, y, nombre, color)
	local f = T.panel(padre, { Size = UDim2.new(1, -40, 0, 54), Position = UDim2.new(0, 20, 0, y) }, color)
	T.texto(f, { Text = nombre, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.5, -14, 1, 0), Position = UDim2.fromOffset(16, 0) })
	local v = T.texto(f, { Text = "0", TextSize = 32, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.5, -16, 1, 0), Position = UDim2.new(0.5, 0, 0, 0) })
	return v
end

-- cuenta de 0 al valor en 'dur' segundos, con formato opcional
local function contar(etiqueta, valor, dur, formato)
	task.spawn(function()
		local t0 = os.clock()
		while etiqueta.Parent do
			local a = math.min((os.clock() - t0) / dur, 1)
			local x = 1 - (1 - a) * (1 - a) -- frena al final
			etiqueta.Text = formato(math.floor(valor * x + 0.5))
			if a >= 1 then break end
			task.wait()
		end
	end)
end

resultado.OnClientEvent:Connect(function(r)
	cerrar()
	local raiz = T.n("Frame", { Size = UDim2.fromOffset(560, 470), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 1.6), BackgroundTransparency = 1 }, gui)
	actual = raiz
	local p = T.panel(raiz, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0) }, T.col.violeta)
	T.texto(p, { Text = "¡ATERRIZAJE!", TextSize = 50, TextColor3 = T.col.sol, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 12) })
	local d = fila(p, 90, "Distancia", T.col.morado)
	local m = fila(p, 154, "Zona", T.col.cielo)
	local di = fila(p, 218, "Dinero", T.col.menta)
	local ex = fila(p, 282, "Exp", T.col.rosa)
	contar(d, r.distancia or 0, 0.9, function(n) return n .. " m" end)
	m.Text = "x" .. (r.multiplicador or 1)
	contar(di, r.dinero or 0, 1.2, function(n) return "+" .. n end)
	contar(ex, r.exp or 0, 1.2, function(n) return "+" .. n end)
	T.texto(p, { Text = string.format("%d aros · %d orbes · %d golpes · %d cofres", r.aros or 0, r.orbes or 0, r.golpes or 0, r.cofres or 0), TextSize = 22, TextColor3 = T.col.crema, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 346) })
	T.boton(raiz, { Size = UDim2.fromOffset(280, 70), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, -62), Text = "¡OTRA VEZ!" }, T.col.sol, function()
		cerrar()
		accion:FireServer("lanzar")
	end)
	TweenService:Create(raiz, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.45) }):Play()
	task.delay(30, function() if actual == raiz then cerrar() end end)
end)

-- al volver a volar se esconde
plr:GetAttributeChangedSignal("EnVuelo"):Connect(function()
	if plr:GetAttribute("EnVuelo") == true then cerrar() end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000023">
<Properties>
<string name="Name">Seguidores</string>
<ProtectedString name="Source"><![CDATA[-- Mascotas que te siguen y alas puestas de «+1 de lanzamiento por segundo» (todo en el cliente, para todos los jugadores).
-- Lee los atributos del jugador: MascotasEq (ids separados por coma, hasta 3) y Alas (id equipado). Si existen las mallas importadas en
-- ReplicatedStorage.MAS1_Modelos.Mascotas.<id> / .Alas.<id>, las usa; si no, dibuja piezas provisionales con el color de su rareza.
-- Las mascotas flotan alrededor y detras, con balanceo; en vuelo se acercan y se agrupan. SIN PROBAR EN STUDIO.
local Players, RS, RunService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService")
local Mas1 = RS:WaitForChild("Mas1")
local M = require(Mas1:WaitForChild("Mascotas"))
local COLOR = { comun = Color3.fromRGB(190, 190, 200), poco_comun = Color3.fromRGB(110, 210, 120), raro = Color3.fromRGB(80, 160, 255),
	epico = Color3.fromRGB(170, 100, 255), legendario = Color3.fromRGB(255, 190, 40), mitico = Color3.fromRGB(255, 80, 140), robux = Color3.fromRGB(255, 120, 40) }
local ALAS_COLOR = { iniciales = Color3.fromRGB(245, 235, 210), roboticas = Color3.fromRGB(235, 240, 250), avanzadas = Color3.fromRGB(32, 36, 70) }
-- centro del soporte de cada ala (la placa o el bloque que va a la espalda) respecto a su pivote, en studs hacia atras, medido en los
-- .blend: Back_mount de las iniciales, bloque central de las roboticas y placa con gema de las avanzadas. Ese centro se pone en la
-- superficie de la espalda, asi el soporte queda medio metido en el torso (Maikol, 01/11: «mas pegado al cuerpo, la mitad dentro»)
local SOPORTE_ALAS = { iniciales = -0.01, roboticas = 0, avanzadas = 0.27 }

local function modelos(carpeta, id)
	local m = RS:FindFirstChild("MAS1_Modelos")
	local c = m and m:FindFirstChild(carpeta)
	return c and c:FindFirstChild(id)
end

local TAM_MAX = 5 -- studs: lado mayor maximo de una mascota puesta
local estado = {} -- [plr] = { mascotas = {{id, modelo}}, alas = modelo, idAlas, clave }

local function pieza(tam, color, forma)
	local p = Instance.new("Part")
	p.Size, p.Color, p.Material = tam, color, Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = true, false, false, false, true
	if forma then p.Shape = forma end
	return p
end

local function nuevaMascota(id)
	local d = M.get(id)
	local plantilla = modelos("Mascotas", id)
	local m
	if plantilla then
		m = plantilla:Clone()
		local mayor = math.max(m:GetExtentsSize().X, m:GetExtentsSize().Y, m:GetExtentsSize().Z)
		if mayor > TAM_MAX then m:ScaleTo(m:GetScale() * TAM_MAX / mayor) end -- las altas (aguila, grifo) tapaban al jugador
	else -- provisional: bola con ojos y el color de la rareza
		m = Instance.new("Model")
		local cuerpo = pieza(Vector3.new(2.2, 2.2, 2.2), COLOR[d and d.rareza or "comun"], Enum.PartType.Ball)
		cuerpo.Name = "Cuerpo"
		cuerpo.Parent = m
		for _, dx in ipairs({ -0.5, 0.5 }) do
			local o = pieza(Vector3.new(0.35, 0.35, 0.2), Color3.fromRGB(28, 21, 48))
			o.CFrame = CFrame.new(dx, 0.3, -1.05)
			o.Parent = m
			o:SetAttribute("rel", true)
		end
		m.PrimaryPart = cuerpo
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = true, false, false, false, true end
	end
	m.Name = "Mas1Mascota_" .. id
	m.Parent = workspace
	return m
end

local function nuevasAlas(id)
	local plantilla = modelos("Alas", id)
	local m
	if plantilla then
		m = plantilla:Clone()
	else -- provisional: dos alas de cuña
		m = Instance.new("Model")
		local c = ALAS_COLOR[id] or Color3.fromRGB(240, 240, 240)
		for i, lado in ipairs({ -1, 1 }) do
			local a = pieza(Vector3.new(0.3, 4, 3), c)
			a.Name = i == 1 and "AlaI" or "AlaD"
			a.Parent = m
		end
		m.PrimaryPart = m:FindFirstChildWhichIsA("BasePart")
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = true, false, false, false, true end
	end
	m.Name = "Mas1Alas"
	m.Parent = workspace
	return m
end

local function limpiar(plr)
	local e = estado[plr]
	if not e then return end
	for _, x in ipairs(e.mascotas) do x.modelo:Destroy() end
	if e.alas then e.alas:Destroy() end
	estado[plr] = nil
end

local function sincronizar(plr)
	local clave = (plr:GetAttribute("MascotasEq") or "") .. "|" .. (plr:GetAttribute("Alas") or "")
	local e = estado[plr]
	if e and e.clave == clave then return end
	limpiar(plr)
	e = { mascotas = {}, clave = clave, idAlas = plr:GetAttribute("Alas") or "" }
	for id in string.gmatch(plr:GetAttribute("MascotasEq") or "", "[^,]+") do
		if #e.mascotas < M.MAX_EQUIPADAS and M.get(id) then e.mascotas[#e.mascotas + 1] = { id = id, modelo = nuevaMascota(id) } end
	end
	if e.idAlas ~= "" then e.alas = nuevasAlas(e.idAlas) end
	estado[plr] = e
end

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for _, plr in ipairs(Players:GetPlayers()) do
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then limpiar(plr) continue end
		sincronizar(plr)
		local e = estado[plr]
		if not e then continue end
		local vuela = plr:GetAttribute("EnVuelo") == true
		local boost = plr:GetAttribute("Boost") == true
		-- mascotas: cada una tiene su propia posicion relativa al jugador (en un marco que solo gira en horizontal, para no heredar la
		-- postura tumbada del vuelo) que persigue su sitio con un muelle suave y un vaivén propio: asi no copian al jugador.
		local n = #e.mascotas
		local pos0 = hrp.Position
		local mira = hrp.CFrame.LookVector
		local marco = vuela and CFrame.new(pos0) or CFrame.lookAt(pos0, pos0 + Vector3.new(mira.X, 0, mira.Z).Unit)
		for i, x in ipairs(e.mascotas) do
			local lado = (i - (n + 1) / 2) -- -1, 0, 1 con tres
			local ph = i * 2.1
			local objetivo
			if vuela then -- a los lados y un poco por delante, para que se vean de perfil desde la camara
				objetivo = Vector3.new(lado * 9 + (lado == 0 and 0 or 0), (lado == 0 and 5.5 or 1.5) + math.sin(t * 2.4 + ph) * 0.8, -5 + math.sin(t * 1.3 + ph) * 1.5)
			else -- en tierra: delante del jugador, en arco, mirandole
				objetivo = Vector3.new(lado * 5.5 + math.sin(t * 0.7 + ph) * 1.2, 3 + math.sin(t * 2 + ph) * 0.6, -6 + math.cos(t * 0.6 + ph) * 1.2)
			end
			x.rel = x.rel or objetivo
			local k = vuela and (boost and 6 or 4) or 3
			x.rel = x.rel:Lerp(objetivo, 1 - math.exp(-k * dt))
			local mundo = marco:PointToWorldSpace(x.rel)
			local dir
			if vuela then -- de perfil hacia fuera y hacia delante
				dir = Vector3.new(lado * 0.8, 0, -1).Unit
				if lado == 0 then dir = Vector3.new(0.5, 0, -1).Unit end
			else
				dir = Vector3.new(pos0.X - mundo.X, 0, pos0.Z - mundo.Z)
				dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
			end
			local velLado = (x.rel - objetivo).X
			local cf = CFrame.lookAt(mundo, mundo + dir) * CFrame.Angles(0, 0, math.clamp(velLado * 0.08, -0.4, 0.4)) -- se inclina al desplazarse
			x.modelo:PivotTo(x.ultimo and x.ultimo:Lerp(cf, 1 - math.exp(-12 * dt)) or cf)
			x.ultimo = x.modelo:GetPivot()
		end
		-- alas: pegadas a la espalda; aletean al volar
		if e.alas then
			local torso = plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso") or hrp
			local abre = vuela and (0.35 + (boost and 0.35 or 0.15) * math.sin(t * (boost and 14 or 7))) or 0.15 + 0.03 * math.sin(t * 1.5)
			local base = torso.CFrame * CFrame.new(0, 0.4, torso.Size.Z / 2 - (SOPORTE_ALAS[e.idAlas] or -0.2))
			if e.alas.PrimaryPart and #e.alas:GetChildren() == 2 and not modelos("Alas", e.idAlas) then
				local ai, ad = e.alas:FindFirstChild("AlaI"), e.alas:FindFirstChild("AlaD")
				if ai then ai.CFrame = base * CFrame.new(-2, 0, 0) * CFrame.Angles(0, 0, -abre) end
				if ad then ad.CFrame = base * CFrame.new(2, 0, 0) * CFrame.Angles(0, 0, abre) end
			else
				e.alas:PivotTo(base)
			end
		end
	end
end)

Players.PlayerRemoving:Connect(limpiar)
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000024">
<Properties>
<string name="Name">Sonidos</string>
<ProtectedString name="Source"><![CDATA[-- Sonido de «+1 de lanzamiento por segundo» en el cliente: engancha los eventos del juego (efectos, orbes, huevos, avisos, atributos) y
-- reproduce los ids de src/Sonidos.lua (vacios hasta subir los WAV: sin id no suena nada). SIN PROBAR EN STUDIO.
local Players, RS, SoundService = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("SoundService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local S = require(Mas1:WaitForChild("Sonidos"))
local Red = require(Mas1:WaitForChild("Red"))

local function sonar(nombre, tono)
	local id = S[nombre]
	if type(id) ~= "string" or id == "" then return end
	local s = Instance.new("Sound")
	s.SoundId, s.Volume = id, (S.volumen and S.volumen[nombre]) or 0.7
	if tono then s.PlaybackSpeed = tono end
	s.Parent = SoundService
	s.Ended:Connect(function() s:Destroy() end)
	s:Play()
	task.delay(5, function() if s.Parent then s:Destroy() end end)
end

Red.evento("MAS1_Efecto").OnClientEvent:Connect(function(nombre)
	if nombre == "lanzamiento" or nombre == "aro" or nombre == "golpe" or nombre == "rebirth" then sonar(nombre) end
end)
Red.evento("MAS1_Orbe").OnClientEvent:Connect(function() sonar("orbe", 0.95 + math.random() * 0.2) end)
Red.evento("MAS1_Aviso").OnClientEvent:Connect(function() sonar("error") end)
Red.evento("MAS1_Resultado").OnClientEvent:Connect(function() sonar("aterrizaje") end)
Red.evento("MAS1_Huevo").OnClientEvent:Connect(function(d)
	sonar("huevo_agita")
	task.delay(0.7, function() sonar(d and (d.rareza == "mitico" or d.rareza == "legendario") and "mitico" or "huevo_abre") end)
end)
plr:GetAttributeChangedSignal("Boost"):Connect(function() if plr:GetAttribute("Boost") == true then sonar("boost") end end)
plr:GetAttributeChangedSignal("Cofres"):Connect(function() sonar("cofre") end)
local ultimoCombo = 0
plr:GetAttributeChangedSignal("Combo"):Connect(function()
	local c = plr:GetAttribute("Combo") or 0
	if c > ultimoCombo and c % 5 == 0 then sonar("combo", 1 + math.min(c, 30) / 60) end
	ultimoCombo = c
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXJ0000025">
<Properties>
<string name="Name">Tema</string>
<ProtectedString name="Source"><![CDATA[-- Tema de interfaz de «+1 de lanzamiento por segundo»: paneles gruesos con contorno oscuro y sombra dura, colores vivos, tipografia redondeada.
-- Todo por codigo, sin imagenes. SIN PROBAR EN STUDIO.
local TweenService = game:GetService("TweenService")
local T = {}
T.col = {
	tinta = Color3.fromRGB(28, 21, 48), crema = Color3.fromRGB(255, 247, 224), sol = Color3.fromRGB(255, 210, 63), cielo = Color3.fromRGB(78, 200, 255),
	menta = Color3.fromRGB(61, 220, 151), rosa = Color3.fromRGB(255, 93, 143), violeta = Color3.fromRGB(124, 92, 255), morado = Color3.fromRGB(58, 44, 99),
}
T.fuente = Enum.Font.FredokaOne

local function n(clase, props, padre)
	local o = Instance.new(clase); for k, v in pairs(props or {}) do o[k] = v end; if padre then o.Parent = padre end; return o
end
T.n = n

function T.escala(gui)
	local sc = n("UIScale", {}, gui)
	local function aj() local cam = workspace.CurrentCamera; if cam then sc.Scale = math.clamp(cam.ViewportSize.Y / 900, 0.55, 1.4) end end
	aj(); if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(aj) end
end

-- Panel con contorno oscuro (UIStroke 5), esquinas redondeadas y sombra dura debajo
function T.panel(padre, props, color)
	props = props or {}
	local sombra = n("Frame", { Size = props.Size, Position = props.Position, AnchorPoint = props.AnchorPoint, Rotation = props.Rotation or 0, BackgroundColor3 = T.col.tinta, BorderSizePixel = 0 }, padre)
	sombra.Position = props.Position + UDim2.fromOffset(0, 7); n("UICorner", { CornerRadius = UDim.new(0, 18) }, sombra)
	props.BackgroundColor3 = color or T.col.violeta; props.BorderSizePixel = 0
	local p = n("Frame", props, padre)
	n("UICorner", { CornerRadius = UDim.new(0, 18) }, p); n("UIStroke", { Color = T.col.tinta, Thickness = 5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
	p.Destroying:Connect(function() sombra:Destroy() end)
	return p, sombra
end

function T.texto(padre, props)
	props = props or {}; props.BackgroundTransparency = 1; props.Font = props.Font or T.fuente
	props.TextColor3 = props.TextColor3 or T.col.crema; props.TextSize = props.TextSize or 24
	props.TextStrokeColor3 = props.TextStrokeColor3 or T.col.tinta; props.TextStrokeTransparency = props.TextStrokeTransparency or 0.55
	return n("TextLabel", props, padre)
end

function T.barra(padre, props)
	local marco = n("Frame", props, padre); marco.BackgroundColor3 = T.col.morado; marco.BorderSizePixel = 0; marco.ClipsDescendants = true
	n("UICorner", { CornerRadius = UDim.new(0, 18) }, marco); n("UIStroke", { Color = T.col.tinta, Thickness = 5 }, marco)
	local relleno = n("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.col.sol, BorderSizePixel = 0 }, marco)
	n("UICorner", { CornerRadius = UDim.new(0, 14) }, relleno)
	local b = { marco = marco, relleno = relleno }
	function b.set(p, color)
		TweenService:Create(relleno, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp(p, 0, 1), 1) }):Play()
		if color then relleno.BackgroundColor3 = color end
	end
	return b
end

-- Boton redondo grande (movil): llama a alAplastar al pulsarlo y se hunde unos pixeles
function T.boton(padre, props, color, alAplastar)
	local b = n("TextButton", props, padre); b.BackgroundColor3 = color; b.AutoButtonColor = false; b.BorderSizePixel = 0; b.Font = T.fuente
	b.TextColor3 = T.col.crema; b.TextStrokeColor3 = T.col.tinta; b.TextStrokeTransparency = 0.4; b.TextScaled = true
	n("UICorner", { CornerRadius = UDim.new(1, 0) }, b); n("UIStroke", { Color = T.col.tinta, Thickness = 6 }, b)
	b.MouseButton1Down:Connect(function() b.Size = b.Size - UDim2.fromOffset(6, 6); if alAplastar then alAplastar() end end)
	b.MouseButton1Up:Connect(function() b.Size = props.Size end)
	b.MouseLeave:Connect(function() b.Size = props.Size end) -- si el dedo se desliza fuera no queda hundido
	return b
end

return T
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000026">
<Properties>
<string name="Name">VueloControl</string>
<ProtectedString name="Source"><![CDATA[-- Control del vuelo en el cliente de «+1 de lanzamiento por segundo». El cliente mueve su propio personaje (asi responde al instante)
-- con src/Manejo.lua; el servidor (server/Partida.server.lua) lleva la energia, el boost y los puntos, y devuelve atras al que vaya
-- mas rapido de lo permitido. Aqui tambien van la camara de persecucion (se aleja con la velocidad, abre el campo de vision con el
-- boost y se inclina un poco en los giros), un boton LANZAR y un cartel de resultado PROVISIONALES (la interfaz buena la hace
-- Claude nube con MAS1_Resultado y los atributos de CONTRATO.md).
-- Mandos: W o joystick arriba = boost; A/D = a los lados; Espacio o salto = subir; S, Ctrl o joystick abajo = bajar;
-- F o el boton LANZAR = lanzarse (en el suelo). Golpear: clic o los botones del HUD (client/HudVuelo.client.lua). SIN PROBAR EN STUDIO.
local Players, RS, RunService, UIS = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("RunService"), game:GetService("UserInputService")
local plr = Players.LocalPlayer
local Mas1 = RS:WaitForChild("Mas1")
local V = require(Mas1:WaitForChild("Vuelo"))
local Manejo = require(Mas1:WaitForChild("Manejo"))
local Red = require(Mas1:WaitForChild("Red"))
local T = require(script.Parent:WaitForChild("Tema"))
local accion = Red.evento("MAS1_Accion")
local C = V.CFG
local cam = workspace.CurrentCamera

-- mandos: el modulo de control de Roblox da el mismo vector con teclado, joystick de movil y mando
local controles
task.spawn(function()
	local ok, pm = pcall(function() return require(plr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")) end)
	if ok and pm then controles = pm:GetControls() end
end)
local ultimoSalto = 0
UIS.JumpRequest:Connect(function() ultimoSalto = os.clock() end) -- Espacio y boton de salto del movil y del mando

local function tecla(...)
	for _, k in ipairs({ ... }) do
		if UIS:IsKeyDown(k) then return true end
	end
	return false
end

local function mandos()
	-- teclado leido directamente (en estado Physics el modulo de control puede dar el vector a cero) y, si no hay teclas, el
	-- joystick del movil o el mando
	local K = Enum.KeyCode
	local mv = controles and controles:GetMoveVector() or Vector3.zero
	local lateral = (tecla(K.D, K.Right) and 1 or 0) - (tecla(K.A, K.Left) and 1 or 0)
	if lateral == 0 then lateral = math.clamp(mv.X, -1, 1) end
	return {
		lateral = lateral,
		boost = tecla(K.W, K.Up) or mv.Z < -0.5,
		bajar = tecla(K.S, K.Down, K.LeftControl) or mv.Z > 0.5,
		subir = tecla(K.Space) or os.clock() - ultimoSalto < 0.25,
	}
end

-- lineas de viento: una lamina invisible delante de la camara suelta rayas blancas que pasan a los lados; mas cuanto mas rapido
local lamina = Instance.new("Part")
lamina.Name, lamina.Anchored, lamina.CanCollide, lamina.CanQuery, lamina.CanTouch = "Mas1Viento", true, false, false, false
lamina.Transparency, lamina.Size = 1, Vector3.new(46, 26, 1)
lamina.Parent = workspace.CurrentCamera
local rayas = Instance.new("ParticleEmitter")
rayas.EmissionDirection = Enum.NormalId.Back
rayas.Lifetime = NumberRange.new(0.25, 0.4)
rayas.Speed = NumberRange.new(90, 130)
rayas.Size = NumberSequence.new(0.07)
rayas.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) })
rayas.LightEmission, rayas.Rate, rayas.Squash = 1, 0, NumberSequence.new(-6) -- Squash negativo: rayas estiradas
rayas.Parent = lamina

function viento(vf, boost)
	lamina.CFrame = workspace.CurrentCamera.CFrame * CFrame.new(0, 0, -30)
	rayas.Rate = vf > 20 and (boost and 160 or vf * 1.2) or 0
end

-- vuelo: el personaje en estado Physics, con una velocidad lineal y una orientacion que se fijan cada fotograma
local vuelo
local esperaFin = false -- aterrizo aqui: no volver a empezar hasta que el servidor cierre el vuelo
local camPos, fov = nil, 70

local function empezar()
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) or hum.Health <= 0 then return end
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	hum.AutoRotate = false
	local att = Instance.new("Attachment")
	att.Name = "Mas1Vuelo"
	att.Parent = hrp
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.VectorVelocity = Vector3.zero
	lv.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = math.huge
	ao.Responsiveness = 30
	ao.CFrame = hrp.CFrame.Rotation
	ao.Parent = hrp
	vuelo = { m = Manejo.nuevo(), att = att, lv = lv, ao = ao, hum = hum, hrp = hrp, boost = false }
	camPos = nil
	cam.CameraType = Enum.CameraType.Scriptable
end

local function terminar()
	if not vuelo then return end
	vuelo.lv:Destroy()
	vuelo.ao:Destroy()
	vuelo.att:Destroy()
	if vuelo.hum.Parent and vuelo.hum.Health > 0 then
		vuelo.hum.AutoRotate = true
		vuelo.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	if vuelo.boost then accion:FireServer("boost", false) end
	vuelo = nil
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
	fov = 70
end

RunService:BindToRenderStep("Mas1Vuelo", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local enVuelo = plr:GetAttribute("EnVuelo") == true
	if not enVuelo then esperaFin = false end
	if enVuelo and not vuelo and not esperaFin then empezar() end
	if not enVuelo and vuelo then terminar() end
	if not vuelo then return end
	if not vuelo.hrp.Parent or vuelo.hum.Health <= 0 then terminar() return end
	local e = mandos()
	if e.boost ~= vuelo.boost then
		vuelo.boost = e.boost
		accion:FireServer("boost", e.boost)
	end
	local info = { planeando = plr:GetAttribute("Planeando") == true, boost = plr:GetAttribute("Boost") == true,
		impulso = plr:GetAttribute("Impulso") or 1 }
	local p = vuelo.hrp.Position
	local m = Manejo.paso(vuelo.m, dt, e, info, p.X, p.Y, C, p.Z)
	vuelo.lv.VectorVelocity = Vector3.new(m.vx, m.vy, -m.vf)
	-- tumbado hacia delante (como un superheroe), mirando hacia donde va y alabeado en los giros
	local dir = Vector3.new(m.vx * 0.3, m.vy * 0.3, -math.max(m.vf, 1)).Unit
	vuelo.ao.CFrame = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(0, 0, m.alabeo) * CFrame.Angles(math.rad(-65) + m.cabeceo, 0, 0)
	-- camara: detras y por encima, mas lejos cuanto mas rapido
	local objetivo = p + Vector3.new(0, 1.5, 0)
	local deseo = objetivo + Vector3.new(-m.vx * 0.12 + 3, 3 + m.vf * 0.01, 13 + m.vf * 0.06) -- baja y algo de lado: se ve el cuerpo tumbado
	camPos = camPos and camPos:Lerp(deseo, 1 - math.exp(-8 * dt)) or deseo
	fov += ((info.boost and 96 or info.planeando and 68 or 78) - fov) * (1 - math.exp(-4 * dt))
	if info.boost then camPos += Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * 0.35 end -- vibracion con el boost
	viento(m.vf, info.boost)
	cam.FieldOfView = fov
	cam.CFrame = CFrame.lookAt(camPos, objetivo + Vector3.new(m.vx * 0.2, 0, -16)) * CFrame.Angles(0, 0, m.alabeo * 0.35)
	if info.planeando and p.Y < C.suelo + 3.3 then -- toco el suelo: el servidor cierra el vuelo y paga
		terminar()
		esperaFin = true
	end
end)

-- boton LANZAR y tecla F (PROVISIONAL hasta el cañon de la Pradera)
local gui = T.n("ScreenGui", { Name = "Mas1Lanzar", ResetOnSpawn = false, IgnoreGuiInset = true }, plr:WaitForChild("PlayerGui"))
T.escala(gui)
local function pedirLanzar()
	if plr:GetAttribute("EnVuelo") ~= true then accion:FireServer("lanzar") end
end
local boton = T.boton(gui, { Size = UDim2.fromOffset(260, 100), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40),
	Text = "¡LANZAR!" }, T.col.rosa, pedirLanzar)
local function verBoton() boton.Visible = plr:GetAttribute("EnVuelo") ~= true end
plr:GetAttributeChangedSignal("EnVuelo"):Connect(verBoton)
verBoton()
UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.F then pedirLanzar() end
end)

-- el cartel de resultado vive en client/Resultados.client.lua
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXJ0000027">
<Properties>
<string name="Name">Zonas</string>
<ProtectedString name="Source"><![CDATA[-- Cielo y niebla por zona en el cliente de «+1 de lanzamiento por segundo»: al cruzar el arco de cada zona cambian la hora y la
-- Atmosphere (color, densidad) para que cada zona se lea distinta y el carril destaque: dia azul en la Pradera y el Mar de Nubes,
-- atardecer oscuro en la Tormenta, lila en el Cielo alto y noche (con las estrellas del cielo de Roblox) en el Espacio. Solo en este
-- cliente: cada jugador ve su zona. Colores del cielo de mapa-v01 (build_mapa.py). Donde empieza cada zona sale de Vuelo.CFG.zonas
-- (zonas largas desde el 31/10): aqui solo el cielo de cada multiplicador.
local Lighting, TweenService, RunService = game:GetService("Lighting"), game:GetService("TweenService"), game:GetService("RunService")
local V = require(game:GetService("ReplicatedStorage"):WaitForChild("Mas1"):WaitForChild("Vuelo"))

-- color de la niebla, hora, densidad por multiplicador de zona (x1 a x3: dia azul)
local DIA = { Color3.fromRGB(159, 211, 255), 14, 0.25 }
local CIELO = {
	[4] = { Color3.fromRGB(61, 71, 102), 17.8, 0.38 },
	[5] = { Color3.fromRGB(183, 163, 240), 15.5, 0.25 },
	[6] = { Color3.fromRGB(13, 16, 36), 0, 0.12 },
}
local ZONAS = {} -- desde (studs hacia -Z), color, hora, densidad
for _, z in ipairs(V.CFG.zonas) do
	local c = CIELO[z[2]] or DIA
	ZONAS[#ZONAS + 1] = { z[1], c[1], c[2], c[3] }
end
local atm = Lighting:FindFirstChildOfClass("Atmosphere")
if not atm then
	atm = Instance.new("Atmosphere")
	atm.Parent = Lighting
end
local actual

RunService.Heartbeat:Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local d, z = -cam.CFrame.Position.Z, 1
	for i, zona in ipairs(ZONAS) do
		if d >= zona[1] then z = i end
	end
	if z == actual then return end
	actual = z
	local _, color, hora, densidad = table.unpack(ZONAS[z])
	Lighting.ClockTime = hora -- de golpe: con un tween la hora pasaria por el mediodia
	TweenService:Create(atm, TweenInfo.new(1.5), { Color = color, Decay = color:Lerp(Color3.new(0, 0, 0), 0.35), Density = densidad }):Play()
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
