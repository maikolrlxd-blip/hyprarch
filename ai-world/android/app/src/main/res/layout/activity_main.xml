<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0418">

    <!-- Menu y modo independiente: paginas locales de la app, con acceso al puente nativo -->
    <WebView
        android:id="@+id/local"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Mundo servido por la PC: contenido externo, SIN puente nativo -->
    <WebView
        android:id="@+id/remote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
