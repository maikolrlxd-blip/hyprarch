test('muzzle start stop and idempotent cleanup', function()
    local at = Instance.new('Attachment'); at.Parent = scene
    local controller = FX.Muzzle(at)
    assert(count(at,'ParticleEmitter') == 1)
    local fire = at:FindFirstChild('LutoQuemadoVisual')
    local light = at:FindFirstChild('LutoMuzzleLuz')
    assert(not fire.Enabled and light.Brightness == 0)
    controller.SetActive(true); assert(fire.Enabled and light.Brightness > 0)
    controller.SetActive(false); assert(not fire.Enabled and light.Brightness == 0)
    controller.Destroy(); controller.Destroy(); controller.SetActive(true)
    assert(#at.children == 0)
end)
