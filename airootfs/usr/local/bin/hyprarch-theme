#!/usr/bin/env bash
# hyprarch-theme — cambia la paleta de colores de todo el escritorio.
#
# Uso:  hyprarch-theme [menu|verde|rojo|custom|toggle|actual]
#   menu    (por defecto) menú interactivo con fzf
#   verde   "Modo Verde Dominante"
#   rojo    "Modo Rojo Dominante"
#   custom  vuelve a aplicar tu paleta personalizada (HEX)
#   toggle  alterna entre verde y rojo
#   actual  vuelve a generar los archivos del tema actual
#
# Genera estos archivos a partir de la paleta (los demás archivos de
# configuración solo los importan, así que no hace falta editarlos a mano):
#   ~/.config/hypr/colors.lua   ~/.config/waybar/colors.css
#   ~/.config/kitty/colors.conf ~/.config/fuzzel/fuzzel.ini
#   ~/.config/mako/config       ~/.config/gtk-{3,4}.0/gtk.css
set -u

THEMES_DIR="${HYPRARCH_THEMES:-/usr/share/hyprarch/themes}"
CFG="$HOME/.config"
DATA="$CFG/hyprarch"
CUSTOM="$DATA/custom.env"
CURRENT="$DATA/current"

mkdir -p "$DATA" "$CFG/hypr" "$CFG/waybar" "$CFG/kitty" "$CFG/fuzzel" \
         "$CFG/mako" "$CFG/gtk-3.0" "$CFG/gtk-4.0"

# ---------- utilidades ----------
hex_ok() { [[ $1 =~ ^#?[0-9a-fA-F]{6}$ ]]; }
norm()   { local h=${1#\#}; printf '%s' "${h,,}"; }
rgb()    { printf '%d, %d, %d' "$((16#${1:0:2}))" "$((16#${1:2:2}))" "$((16#${1:4:2}))"; }

# Escritura atómica: se escribe en un temporal del mismo directorio y se publica con mv,
# así Hyprland/Waybar nunca leen un archivo a medio escribir.
put() {
  local dest=$1 tmp
  tmp=$(mktemp "${dest}.XXXXXX") || return 1
  if cat > "$tmp" && mv -f "$tmp" "$dest"; then return 0; else rm -f "$tmp"; return 1; fi
}

load_theme() {
  local f v
  case $1 in
    custom) f=$CUSTOM ;;
    *)      f="$THEMES_DIR/$1.env" ;;
  esac
  if [[ ! -f $f ]]; then echo "Tema no encontrado: $1" >&2; return 1; fi
  unset NAME BG SURFACE SURFACE2 FG DIM ACCENT ACCENT2 OK ALERT WARN WALL
  # shellcheck disable=SC1090
  . "$f" || return 1
  [[ -n ${NAME:-} ]] || { echo "Tema sin nombre: $1" >&2; return 1; }
  WARN=${WARN:-ffb300}
  for v in BG SURFACE SURFACE2 FG DIM ACCENT ACCENT2 OK ALERT WARN; do
    hex_ok "${!v:-}" || { echo "HEX inválido en $v del tema: $1" >&2; return 1; }
    printf -v "$v" '%s' "$(norm "${!v}")"
  done
}

# ---------- generadores ----------
render_hypr() {
  put "$CFG/hypr/colors.lua" <<EOF
-- Generado por hyprarch-theme (${NAME}). No editar a mano.
return {
    accent   = "rgba(${ACCENT}ee)",
    accent2  = "rgba(${ACCENT2}ee)",
    inactive = "rgba(${SURFACE2}aa)",
    glow     = "rgba(${ACCENT}55)",
    shadow   = "rgba(000000b0)",
}
EOF
}

render_waybar() {
  put "$CFG/waybar/colors.css" <<EOF
/* Generado por hyprarch-theme (${NAME}). No editar a mano. */
@define-color bg       rgba($(rgb "$BG"), 0.78);
@define-color surface  rgba($(rgb "$SURFACE"), 0.92);
@define-color surface2 #${SURFACE2};
@define-color fg       #${FG};
@define-color dim      #${DIM};
@define-color accent   #${ACCENT};
@define-color accent2  #${ACCENT2};
@define-color ok       #${OK};
@define-color alert    #${ALERT};
@define-color warn     #${WARN:-ffb300};
EOF
}

render_kitty() {
  put "$CFG/kitty/colors.conf" <<EOF
# Generado por hyprarch-theme (${NAME}). No editar a mano.
foreground            #${FG}
background            #${BG}
selection_foreground  #${BG}
selection_background  #${ACCENT}
cursor                #${ACCENT}
cursor_text_color     #${BG}
url_color             #${ACCENT}
active_border_color   #${ACCENT}
inactive_border_color #${SURFACE2}

color0  #${SURFACE2}
color8  #${DIM}
color1  #${ALERT}
color9  #${ALERT}
color2  #${OK}
color10 #${OK}
color3  #f5e642
color11 #f5e642
color4  #5aa9ff
color12 #5aa9ff
color5  #d070ff
color13 #d070ff
color6  #2de2e6
color14 #2de2e6
color7  #${FG}
color15 #ffffff
EOF
}

render_fuzzel() {
  put "$CFG/fuzzel/fuzzel.ini" <<EOF
# Generado por hyprarch-theme (${NAME}). No editar a mano.
[main]
font=JetBrainsMono Nerd Font:size=12
prompt="❯ "
width=42
lines=12
horizontal-pad=22
vertical-pad=16
inner-pad=10

[colors]
background=${BG}e6
text=${FG}ff
prompt=${ACCENT}ff
placeholder=${DIM}ff
input=${FG}ff
match=${ACCENT}ff
selection=${SURFACE2}ff
selection-text=${FG}ff
selection-match=${ACCENT}ff
border=${ACCENT}ff

[border]
width=2
radius=14
EOF
}

render_mako() {
  put "$CFG/mako/config" <<EOF
# Generado por hyprarch-theme (${NAME}). No editar a mano.
font=JetBrainsMono Nerd Font 11
background-color=#${BG}ee
text-color=#${FG}
border-color=#${ACCENT}
progress-color=over #${ACCENT}55
border-size=2
border-radius=14
padding=14
margin=14
width=380
height=220
anchor=top-right
default-timeout=5000

[urgency=critical]
border-color=#${ALERT}
default-timeout=0
EOF
}

render_gtk() {
  local css
  css="/* Generado por hyprarch-theme (${NAME}). No editar a mano. */
@define-color accent_color #${ACCENT};
@define-color accent_bg_color #${ACCENT};
@define-color accent_fg_color #${BG};
@define-color window_bg_color #${BG};
@define-color window_fg_color #${FG};
@define-color view_bg_color #${SURFACE};
@define-color view_fg_color #${FG};
@define-color headerbar_bg_color #${SURFACE};
@define-color headerbar_fg_color #${FG};
@define-color sidebar_bg_color #${SURFACE};
@define-color card_bg_color #${SURFACE2};
@define-color popover_bg_color #${SURFACE};
@define-color destructive_bg_color #${ALERT};
@define-color success_bg_color #${OK};
@define-color theme_bg_color #${BG};
@define-color theme_fg_color #${FG};
@define-color theme_base_color #${SURFACE};
@define-color theme_text_color #${FG};
@define-color theme_selected_bg_color #${ACCENT};
@define-color theme_selected_fg_color #${BG};
"
  printf '%s' "$css" | put "$CFG/gtk-3.0/gtk.css" || return 1
  printf '%s' "$css" | put "$CFG/gtk-4.0/gtk.css"
}

render_hyprlock() {
  put "$CFG/hypr/hyprlock.conf" <<EOF
# Generado por hyprarch-theme (${NAME}). No editar a mano.
general {
    hide_cursor = true
    ignore_empty_input = true
    immediate_render = true
}

background {
    monitor =
    path = /usr/share/backgrounds/hyprarch-${WALL:-verde}.jpg
    blur_passes = 2
    blur_size = 5
    brightness = 0.65
    vibrancy = 0.2
}

# Marco de cristal
shape {
    monitor =
    size = 520, 360
    color = rgba(${BG}cc)
    rounding = 26
    border_size = 2
    border_color = rgba(${ACCENT}ee) rgba(${ACCENT2}ee) 45deg
    position = 0, 0
    halign = center
    valign = center
}

# Hora
label {
    monitor =
    text = cmd[update:1000] echo "\$(date +'%H:%M')"
    color = rgba(${ACCENT}ff)
    font_size = 92
    font_family = JetBrainsMono Nerd Font ExtraBold
    position = 0, 105
    halign = center
    valign = center
}

# Fecha
label {
    monitor =
    text = cmd[update:60000] echo "\$(date +'%A, %d de %B')"
    color = rgba(${FG}ff)
    font_size = 18
    font_family = JetBrainsMono Nerd Font
    position = 0, 30
    halign = center
    valign = center
}

label {
    monitor =
    text = Hola, \$USER
    color = rgba(${DIM}ff)
    font_size = 15
    font_family = JetBrainsMono Nerd Font
    position = 0, -22
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 360, 54
    outline_thickness = 3
    dots_size = 0.25
    dots_spacing = 0.2
    inner_color = rgba(${BG}ff)
    outer_color = rgba(${ACCENT}ee) rgba(${ACCENT2}ee) 45deg
    check_color = rgba(${OK}ff)
    fail_color = rgba(${ALERT}ff)
    font_color = rgba(${FG}ff)
    font_family = JetBrainsMono Nerd Font
    fade_on_empty = false
    rounding = 16
    placeholder_text = <i>Contraseña...</i>
    fail_text = <i>\$FAIL (\$ATTEMPTS)</i>
    position = 0, -100
    halign = center
    valign = center
}
EOF
}

render_wallpaper() {
  printf '/usr/share/backgrounds/hyprarch-%s.jpg\n' "${WALL:-verde}" | put "$DATA/wallpaper"
}

reload_all() {
  [[ -n ${HYPRARCH_NO_RELOAD:-} ]] && return 0
  command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1
  pkill -SIGUSR2 waybar 2>/dev/null
  pkill -SIGUSR1 kitty 2>/dev/null
  command -v makoctl >/dev/null 2>&1 && makoctl reload >/dev/null 2>&1
  # setsid -f: el fondo debe sobrevivir al cierre de la terminal del menú
  [[ -x $CFG/hypr/scripts/wallpaper.sh ]] && setsid -f "$CFG/hypr/scripts/wallpaper.sh" 9>&- >/dev/null 2>&1 < /dev/null
  command -v notify-send >/dev/null 2>&1 && notify-send -t 3000 "Tema aplicado" "$NAME"
  return 0
}

apply() (
  # un solo cambio de tema a la vez
  if command -v flock >/dev/null 2>&1; then exec 9>"$DATA/.lock" || return 1; flock 9 || return 1; fi
  if [[ $1 == custom && $# == 3 ]]; then
    load_theme verde || return 1
    put "$CUSTOM" <<EOF || return 1
NAME="Personalizado (#${2})"
BG=${BG}
SURFACE=${SURFACE}
SURFACE2=${SURFACE2}
FG=${FG}
DIM=${DIM}
ACCENT=${2}
ACCENT2=${3}
OK=39ff14
ALERT=ff1f4b
WARN=${WARN:-ffb300}
WALL=verde
EOF
  fi
  load_theme "$1" || return 1
  render_hypr && render_waybar && render_kitty && render_fuzzel \
    && render_mako && render_gtk && render_hyprlock && render_wallpaper \
    || { echo "Error generando los archivos del tema: no se aplicó." >&2; return 1; }
  printf '%s\n' "$1" | put "$CURRENT" || return 1
  reload_all
)

# ---------- personalizado ----------
custom_flow() {
  local a b
  echo
  a=$(hyprarch-pick --input --title "Color de acento (HEX)" --placeholder "ej. 00ffaa") || return 0
  [[ -z $a ]] && return 0
  if ! hex_ok "$a"; then notify-send "Color inválido" "Se esperan 6 dígitos hexadecimales (ej. 00ffaa)"; return 0; fi
  b=$(hyprarch-pick --input --title "Acento secundario (HEX)" --placeholder "ej. ff1f4b (Esc = carmesí)") || b=ff1f4b
  b=${b:-ff1f4b}
  if ! hex_ok "$b"; then notify-send "Color inválido" "Se esperan 6 dígitos hexadecimales (ej. ff1f4b)"; return 0; fi
  a=$(norm "$a"); b=$(norm "$b")

  apply custom "$a" "$b"
}

# ---------- menú ----------
menu() {
  local cur sel
  cur=$(cat "$CURRENT" 2>/dev/null || echo verde)
  load_theme "$cur" >/dev/null 2>&1 || load_theme verde

  # Menú animado (hyprarch-pick): rueda curva con cuadritos de color. Sin terminal, sin fzf.
  sel=$(printf '%s\n' \
      $'verde\tVerde dominante\t#39ff14\tneón clásico' \
      $'rojo\tRojo dominante\t#ff1f4b\tcarmesí' \
      $'gamer\tModo gamer\t#00e5ff\tcian y violeta arcade' \
      $'cine\tModo cine\t#ffb347\támbar sobre negro' \
      $'estudio\tModo estudio\t#4fd1c5\tcalma y foco' \
      $'trabajo\tModo trabajo\t#5ec2ff\tclaro y productivo' \
      $'custom\tColor personalizado\t\tescribí un HEX' \
      $'toggle\tAlternar verde / rojo\t\t' |
    hyprarch-pick --layout wheel --title "Colores del sistema" --select "$cur" \
        --placeholder "Tema actual: ${cur}") || return 0

  case $sel in
    verde|rojo|gamer|cine|estudio|trabajo) apply "$sel" ;;
    custom) custom_flow ;;
    toggle) toggle ;;
    *) ;;
  esac
}

toggle() {
  local cur; cur=$(cat "$CURRENT" 2>/dev/null || echo verde)
  if [[ $cur == verde ]]; then apply rojo; else apply verde; fi
}

case "${1:-menu}" in
  menu)    menu ;;
  verde)   apply verde ;;
  rojo)    apply rojo ;;
  custom)  apply custom ;;
  toggle)  toggle ;;
  actual)  apply "$(cat "$CURRENT" 2>/dev/null || echo verde)" ;;
  *) echo "Uso: hyprarch-theme [menu|verde|rojo|custom|toggle|actual]" >&2; exit 1 ;;
esac
