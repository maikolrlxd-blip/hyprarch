STATE_FILE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "hyprarch-buddy", "state.json")
EXPIRE = {"done": 8.0, "error": 8.0, "working": 300.0, "thinking": 300.0, "waiting": 300.0}   # igual que claude-presence


def status():
    """Estado de la IA leyendo el archivo que escribe claude-presence: sin lanzar ningún programa (un archivo pequeño)."""
    try:
        with open(STATE_FILE, encoding="utf-8") as fh:
            s = json.load(fh)
        st = s.get("state")
        if st not in MOODS:
            return "idle"
        return "idle" if time.time() - float(s.get("ts") or 0) > EXPIRE.get(st, 1e9) else st
    except Exception:
        return "idle"


def lite_profile():
    """Perfil ligero de hyprarch (equipos modestos): menos cuadros por segundo y sin adornos caros."""
    try:
        cfg = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        return open(os.path.join(cfg, "hyprarch", "perf.effective")).read().strip() == "lite"
    except OSError:
        return False


LITE = lite_profile()
IDLE_MS = 200 if LITE else 100                     # reposo: 5 o ~12 cuadros por segundo (el parpadeo y el balanceo siguen suaves)
OPEN_MS = 100 if LITE else 50                       # desplegada y quieta: ~15 o 30 cuadros por segundo


def run(*cmd):
    try:
        pr = subprocess.Popen(list(cmd), start_new_session=True, stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        threading.Thread(target=pr.wait, daemon=True).start()
    except OSError:
        pass


AI_CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hyprarch", "ai.conf")
PROV_NAMES = {"claude": "Claude", "codex": "Codex", "gemini": "Gemini", "ollama": "Ollama"}


def ai_conf():
    """(IA elegida, su comando) tal como los guarda hyprarch-ai en ai.conf (líneas AI=... y AI_CMD=...)."""
    import shlex
    pid, cmd = "claude", ""
    try:
        for line in open(AI_CONF, encoding="utf-8").read().splitlines():
            k, _, v = line.partition("=")
            v = " ".join(shlex.split(v)) if v.strip() else ""
            if k == "AI":
                pid = v or pid
            elif k == "AI_CMD":
                cmd = v
    except (OSError, ValueError):
        pass
    return pid, cmd


def set_ai(pid):
    import shlex
    cmd = "ollama run llama3.2" if pid == "ollama" else ""
    os.makedirs(os.path.dirname(AI_CONF), exist_ok=True)
    with open(AI_CONF, "w", encoding="utf-8") as fh:
        fh.write("AI=%s\nAI_CMD=%s\n" % (shlex.quote(pid), shlex.quote(cmd)))


POS_FILE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "hyprarch-buddy", "island-pos.json")


def load_pos():
    try:
        x, y = json.load(open(POS_FILE, encoding="utf-8"))
        return float(x), float(y)
    except (OSError, ValueError, TypeError):
        return None


def save_pos(pos):
    try:
        os.makedirs(os.path.dirname(POS_FILE), exist_ok=True)
        json.dump(list(pos), open(POS_FILE, "w", encoding="utf-8"))
    except OSError:
        pass


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=None)
        self.win = None
        self.canvas = None
        self.exp_box = None
        self.cmp_box = None
        self.cmp_label = None
        self.say = None
        self.last_tick = time.monotonic()
        self.vel = 0.0
        self.panel = None
        self.cur_ms = 16
        self.region_dirty = True
        self.gen = 0                   # número de la consulta en curso
        self.provs = []                # IAs instaladas (para el botón que las cambia)
        self.pbtn = None
        self.at_home = True            # ¿la pastilla está en su hueco de la barra? (si arrastras el cuadro, se oculta)
        self.cur = (0, 0)
        self.d0 = (0, 0)
        self.last_press = 0.0
        self.chatting = False          # ¿hay conversación a la vista?
        self.working = False           # ¿la IA está respondiendo?
        self.proc = None
        self.sid = None                # sesión de Claude para seguir la conversación
        self.entry = self.view = self.buf = self.head = self.scroll = self.send_btn = self.exp_size = None
        self.provider = ai_conf()[0]

    def tick(self):
        now = time.monotonic()
        dt = min(0.05, now - self.last_tick)
        self.last_tick = now
        deh = ST["eh_t"] - ST["eh"]
        if abs(deh) > 0.4:                                                    # el panel crece/encoge suave al empezar la charla
            ST["eh"] += deh * min(1.0, dt * 13.0)
            if int(ST["eh"]) != self.exp_size:
                self.exp_size = int(ST["eh"])
                self.exp_box.set_size_request(EW, self.exp_size)
            self.region_dirty = True
        elif deh:
            ST["eh"] = ST["eh_t"]
            self.exp_size = int(ST["eh"])
            self.exp_box.set_size_request(EW, self.exp_size)
        k, tgt = ST["k"], ST["target"]
        self.vel += (300.0 * (tgt - k) - 21.0 * self.vel) * dt          # muelle amortiguado: rebota un poco
        ST["k"] = max(-0.06, min(1.12, k + self.vel * dt))
        kk = max(0.0, min(1.0, ST["k"]))
        self.exp_box.set_opacity(max(0.0, (kk - 0.6) / 0.4))
        self.exp_box.set_sensitive(kk > 0.9)
        self.exp_box.set_visible(kk > 0.4)
        busy = abs(tgt - ST["k"]) > 0.003 or abs(self.vel) > 0.02 or abs(deh) > 0.4   # solo se anima a pleno ritmo mientras se mueve
        if self.at_home:                                                       # con el cuadro suelto la pastilla no se dibuja
            self.canvas.queue_draw()
        if kk > 0.01 or busy:
            self.panel.set_visible(True)
            self.panel.queue_draw()
        elif self.panel.get_visible():
            self.panel.set_visible(False)
        if busy or self.region_dirty:
            self.update_region()
            self.region_dirty = busy
        want = 16 if busy else (OPEN_MS if kk > 0.5 else IDLE_MS)
        if want != self.cur_ms:
            self.cur_ms = want
            GLib.timeout_add(want, self.tick)
            return False                                                       # este temporizador termina; sigue el nuevo
        return True

    def pill_rect(self, W):
        """La pastilla fija: vive en su hueco del centro de la barra y nunca se mueve ni tapa nada."""
        return (W - CW) / 2, 0, CW, CH

    def panel_rect(self, W):
        """El panel desplegado: cae justo debajo de la barra, centrado."""
        k = max(0.0, ST["k"])
        w, h = lerp(CW, EW, k), lerp(0, ST["eh"], k)
        return (W - w) / 2, CH + GAP, w, h

    def update_region(self):
        surf = self.win.get_surface()
        if surf is None:
            return
        px, py, pw, ph = self.pill_rect(WIN_W)
        reg = cairo.Region(cairo.RectangleInt(int(px) - 2, 0, int(pw) + 4, int(ph) + 4) if self.at_home else cairo.RectangleInt(0, 0, 0, 0))
        qx, qy, qw, qh = self.panel_rect(WIN_W)
        if qh > 4:
            reg.union(cairo.RectangleInt(int(qx) - 3, int(qy) - 2, int(qw) + 6, int(qh) + 6))
        surf.set_input_region(reg)

    def body(self, cr, x, y, w, h, radius, col, wash, hover=False, flush=False):
        """Fondo de la isla: sombra con profundidad, negro con luz arriba, brillo de color abajo a la derecha y borde fino.
        flush=True: esquinas de arriba rectas (cuelga del borde de la pantalla)."""
        shape = brrect if flush else rrect
        for i in range(2 if LITE else 6, 0, -1):
            cr.set_source_rgba(0, 0, 0, 0.05 if not LITE else 0.12)
            shape(cr, x - i * 1.1, y + (0 if flush else 2) + i * 0.0, w + i * 2.2, h + i * 1.1, radius + i)
            cr.fill()
        shape(cr, x, y, w, h, radius)
        cr.set_source_rgba(0.03, 0.045, 0.068, 0.985)
        cr.fill_preserve()
        cr.save()
        cr.clip()
        g = cairo.RadialGradient(x + w * 0.88, y + h * 1.3, 3, x + w * 0.88, y + h * 1.3, max(w, h) * 0.75)
        g.add_color_stop_rgba(0, col[0], col[1], col[2], wash)
        g.add_color_stop_rgba(1, col[0], col[1], col[2], 0)
        cr.set_source(g)
        cr.paint()
        lg = cairo.LinearGradient(0, y, 0, y + h * 0.55)
        lg.add_color_stop_rgba(0, 1, 1, 1, 0.075)
        lg.add_color_stop_rgba(1, 1, 1, 1, 0)
        cr.set_source(lg)
        cr.paint()
        cr.restore()
        shape(cr, x + 0.5, y - 1 if flush else y + 0.5, w - 1, h - 0.5 if flush else h - 1, radius)
        cr.set_source_rgba(1, 1, 1, 0.11 + (0.10 if hover else 0))
        cr.set_line_width(1)
        cr.stroke()

    def face_at(self, cr, fx, fy, r, t, col):
        gl = cairo.RadialGradient(fx, fy, r * 0.3, fx, fy, r * 1.8)
        gl.add_color_stop_rgba(0, col[0], col[1], col[2], 0.20 + 0.07 * math.sin(t * 2))
        gl.add_color_stop_rgba(1, col[0], col[1], col[2], 0)
        cr.set_source(gl)
        cr.arc(fx, fy, r * 1.8, 0, 2 * math.pi)
        cr.fill()
        draw_face(cr, fx, fy, r, t, ST["mood"], ST["look"], squash=max(-0.25, min(0.25, self.vel * 0.012)))

    def draw_pill(self, _a, cr, W, H):
        """La pastilla (lienzo pequeño: es lo único que se repinta en reposo)."""
        if not self.at_home:
            return
        t = time.monotonic() - ST["t0"]
        kk = max(0.0, min(1.0, ST["k"]))
        col = MOODS.get(ST["mood"], MOODS["idle"])[0]
        px = (W - CW) / 2
        self.body(cr, px, 0, CW, CH, 18, col, 0.18, hover=ST["hover"] and kk < 0.5, flush=True)
        self.face_at(cr, px + 22, CH / 2 + 1, 9, t, col)

    def draw_panel(self, _a, cr, W, H):
        """El panel desplegado: solo se dibuja mientras está abierto o moviéndose."""
        t = time.monotonic() - ST["t0"]
        kk = max(0.0, min(1.0, ST["k"]))
        col = MOODS.get(ST["mood"], MOODS["idle"])[0]
        k = max(0.0, ST["k"])
        w, h = lerp(CW, EW, k), lerp(0, ST["eh"], k)
        if h <= 6:
            return
        qx, qy = (W - w) / 2, PANEL_PAD
        self.body(cr, qx, qy, w, h, 26, col, 0.26)
        if kk > 0.45 and self.chatting:
            ca = max(0.0, (kk - 0.45) / 0.55)
            cx0, cy0, cw0, ch0 = qx + 12, qy + HEAD_H, w - 24, h - HEAD_H - INPUT_H - 10
            if self.chatting:
                self.face_at(cr, qx + 30, qy + HEAD_H / 2 + 1, 10, t, col)      # en conversación: Hyro pequeño en el encabezado
            rrect(cr, cx0, cy0, cw0, ch0, 18)                       # tarjeta con borde fino, como en Coucou
            cr.set_source_rgba(1, 1, 1, 0.045 * ca)
            cr.fill_preserve()
            cr.set_source_rgba(1, 1, 1, 0.07 * ca)
            cr.set_line_width(1)
            cr.stroke()
            cr.save()
            rrect(cr, cx0, cy0, cw0, ch0, 18)
            cr.clip()
            wg = cairo.RadialGradient(cx0 + cw0 * 0.5, cy0 + ch0 * 1.3, 4, cx0 + cw0 * 0.5, cy0 + ch0 * 1.3, 240)
            wg.add_color_stop_rgba(0, col[0], col[1], col[2], (0.14 if self.chatting else 0.40) * ca)   # lavado de color según el estado
            wg.add_color_stop_rgba(1, col[0], col[1], col[2], 0)
            cr.set_source(wg)
            cr.paint()
            cr.restore()
            if not self.chatting:
                self.face_at(cr, cx0 + 46, cy0 + ch0 / 2, 27, t, col)       # Hyro grande en la tarjeta (solo sin conversación)

    def expand(self):
        if ST["target"] < 0.5:
            ST["phrase"] = random.choice(PHRASES)
            self.say.set_text(ST["phrase"])
            ST["target"] = 1.0
            if self.custom:                                                # abre donde lo dejaste la última vez
                self.at_home = False
                self.cmp_box.set_visible(False)
                self.place(*self.clamp(*self.custom))
            self.region_dirty = True
            ST["last_act"] = time.monotonic()
            play("menu-open.wav")
            # Al abrirla (clic o atajo) toma el teclado un instante para poder escribir ya; luego pasa a «a demanda»:
            # el teclado va a lo último donde hiciste clic, así que al pulsar fuera deja de escribir ahí.
            LS.set_keyboard_mode(self.win, LS.KeyboardMode.EXCLUSIVE)
            GLib.timeout_add(160, lambda: (self.entry.grab_focus(), False)[1])
            GLib.timeout_add(450, self.release_keyboard)
        else:
            LS.set_keyboard_mode(self.win, LS.KeyboardMode.EXCLUSIVE)
            self.entry.grab_focus()
            GLib.timeout_add(450, self.release_keyboard)

    def release_keyboard(self):
        if ST["target"] > 0.5:
            LS.set_keyboard_mode(self.win, LS.KeyboardMode.ON_DEMAND)
        return False

    def collapse(self):
        if ST["target"] > 0.5:
            ST["target"] = 0.0
            play("menu-select.wav")
            LS.set_keyboard_mode(self.win, LS.KeyboardMode.NONE)
            if not self.at_home:
                GLib.timeout_add(420, self.go_home)

    # ---------- mover el cuadro a donde quieras (se arrastra desde los puntitos o el encabezado) ----------
    def place(self, x, y):
        self.cur = (x, y)
        LS.set_margin(self.win, LS.Edge.LEFT, int(x))
        LS.set_margin(self.win, LS.Edge.TOP, int(y))

    def clamp(self, x, y):
        x = max(-(WIN_W - EW) / 2, min(self.sw - (WIN_W + EW) / 2, x))
        y = max(-(CH + GAP), min(self.sh - (CH + GAP) - ST["eh_t"] - 6, y))        # el cuadro entero (con su cuadro de texto) siempre cabe en pantalla
        return x, y

    def make_draggable(self, w):
        g = Gtk.GestureDrag()
        g.set_button(1)
        g.connect("drag-begin", lambda *_a: self.drag_begin())
        g.connect("drag-update", lambda _g, ox, oy: self.drag_move(ox, oy))
        g.connect("drag-end", lambda *_a: self.drag_end())
        w.add_controller(g)

    def drag_begin(self):
        self.d0 = self.cur
        now = time.monotonic()
        if now - self.last_press < 0.4:                                    # doble clic: de vuelta a su sitio (sin gestos extra que roben el arrastre)
            self.reset_pos()
            self.d0 = self.cur
        self.last_press = now

    def drag_move(self, ox, oy):
        if abs(ox) < 6 and abs(oy) < 6 and self.at_home:                  # un clic suelto no es un arrastre
            return
        x, y = self.clamp(self.d0[0] + ox, self.d0[1] + oy)
        self.at_home = False
        self.cmp_box.set_visible(False)
        self.place(x, y)

    def drag_end(self):
        if self.at_home:                                                   # no hubo arrastre
            return
        self.custom = self.cur
        save_pos(self.custom)

    def reset_pos(self):
        self.custom = None
        try:
            os.remove(POS_FILE)
        except OSError:
            pass
        self.place(*self.home)
        self.at_home = True
        self.cmp_box.set_visible(True)
        self.region_dirty = True

    def go_home(self):
        """Tras recoger el panel, la pastilla vuelve a su hueco de la barra."""
        if ST["target"] < 0.5:
            self.place(*self.home)
            self.at_home = True
            self.cmp_box.set_visible(True)
            self.region_dirty = True
        return False

    def toggle(self):                                                          # atajo de teclado (SIGUSR1)
        self.collapse() if ST["target"] > 0.5 else self.expand()
        return True

    # ---------- la conversación vive dentro de la isla ----------
    def show_chat(self, on):
        self.chatting = on
        self.head.set_visible(on)
        self.scroll.set_visible(on)
        if on:
            self.fit()
        else:
            ST["eh_t"] = float(EH)

    def fit(self):
        """El cuadro crece con el texto (hasta un tope; después se desplaza) y vuelve a achicarse con «Nueva»."""
        if not self.chatting:
            return False
        _mn, nat, _a, _b = self.view.measure(Gtk.Orientation.VERTICAL, EW - 24)
        want = HEAD_H + nat + INPUT_H + 14
        ST["eh_t"] = float(max(150, min(EH_CHAT, want)))
        if not self.at_home:                                                # si crece estando suelto, que no se salga por abajo
            self.place(*self.clamp(*self.cur))
        return False

    def append(self, text, tag, gen=None):
        if gen is not None and gen != self.gen:                              # texto de una consulta que ya se canceló
            return False
        end = self.buf.get_end_iter()
        self.buf.insert_with_tags_by_name(end, text, tag)
        self.fit()
        GLib.idle_add(lambda: (self.view.scroll_mark_onscreen(self.buf.get_mark("fin")), False)[1])
        return False

    def send(self, *_a):
        q = self.entry.get_text().strip()
        if not q or self.working:
            return
        self.entry.set_text("")
        self.gen += 1                                                       # cada pregunta tiene su número: lo que llegue de una anterior se descarta
        gen = self.gen
        self.show_chat(True)
        if self.buf.get_char_count():
            self.append("\n", "ai", gen)
        self.append(q + "\n", "me", gen)
        self.working = True
        self.send_btn.set_sensitive(False)
        ST.update(mood="thinking", label=MOODS["thinking"][1], last_act=time.monotonic())
        self.cmp_label.set_text(ST["label"])
        pid, acmd = ai_conf()
        threading.Thread(target=self.worker, args=(q, gen, pid, acmd, self.sid), daemon=True).start()

    @staticmethod
    def stop_proc(proc):
        """Termina la IA y todo lo que lanzó (su grupo); si no hace caso en 2 s, a la fuerza."""
        if proc is None or proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            return

        def hard():
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
            return False
        GLib.timeout_add(2000, hard)

    def set_sid(self, sid, gen):
        if gen == self.gen:
            self.sid = sid
        return False

    def worker(self, q, gen, pid, acmd, sid):
        """Pregunta a la IA elegida y pasa su respuesta a la isla a medida que llega (Claude: palabra a palabra)."""
        env = dict(os.environ)
        env["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + env.get("PATH", "")
        if q.startswith("-"):                                               # que la pregunta nunca se lea como una opción del programa
            q = " " + q
        tail, gotten, rc, proc = [], False, 1, None
        try:
            if pid == "claude":
                cmd = ["claude", "-p", q, "--output-format", "stream-json", "--include-partial-messages", "--verbose"]
                if sid:
                    cmd += ["--resume", sid]
            elif pid == "codex":
                cmd = ["codex", "exec", "--skip-git-repo-check", q]
            elif pid == "gemini":
                cmd = ["gemini", "-p", q]
            elif pid == "ollama":
                cmd = ["ollama", "run", (acmd.split() or ["", "", "llama3.2"])[-1], q]
            else:
                GLib.idle_add(self.append, "Esta IA no tiene modo de una pasada. Elige Claude, Codex, Gemini u Ollama.\n", "err", gen)
                return
            proc = subprocess.Popen(cmd, cwd=os.path.expanduser("~"), env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True, encoding="utf-8", errors="replace", bufsize=1,
                                    start_new_session=True)
            self.proc = proc
            if gen != self.gen:                                             # «Nueva» llegó justo antes de que arrancara
                self.stop_proc(proc)
            for line in proc.stdout:
                if gen != self.gen:
                    break
                if pid != "claude":
                    gotten = True
                    GLib.idle_add(self.append, line, "ai", gen)
                    continue
                try:
                    ev = json.loads(line)
                except ValueError:
                    tail = (tail + [line.rstrip()])[-6:]                    # lo que no es JSON suele ser un error de la herramienta
                    continue
                if not isinstance(ev, dict):
                    continue
                if ev.get("session_id"):
                    GLib.idle_add(self.set_sid, ev["session_id"], gen)
                t = ev.get("type")
                if t == "stream_event":
                    e = ev.get("event") or {}
                    et = e.get("type")
                    if et == "content_block_start" and (e.get("content_block") or {}).get("type") == "tool_use":
                        GLib.idle_add(self.append, "· " + str(e["content_block"].get("name", "herramienta")) + "…\n", "dim", gen)
                    elif et == "content_block_delta" and (e.get("delta") or {}).get("type") == "text_delta":
                        txt = e["delta"].get("text", "")
                        gotten = gotten or bool(txt)
                        GLib.idle_add(self.append, txt, "ai", gen)
                elif t == "result":
                    if ev.get("is_error") or not gotten:
                        GLib.idle_add(self.append, str(ev.get("result") or "Sin respuesta."), "err" if ev.get("is_error") else "ai", gen)
                        gotten = True
            try:
                rc = proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.stop_proc(proc)
                rc = 1
            if rc != 0 and not gotten and tail:
                GLib.idle_add(self.append, "\n".join(tail) + "\n", "err", gen)
            elif rc != 0 and not gotten:
                GLib.idle_add(self.append, "La IA terminó con un error (código %s).\n" % rc, "err", gen)
        except Exception as exc:                                            # nada de lo que pase aquí debe dejar el chat bloqueado
            GLib.idle_add(self.append, "No pude hablar con la IA (%s).\n" % exc, "err", gen)
            rc = 1
        finally:
            self.stop_proc(proc)
            GLib.idle_add(self.finish, rc, gen)

    def finish(self, rc, gen):
        if gen != self.gen:                                                 # una conversación anterior que ya se canceló
            return False
        self.proc = None
        self.working = False
        self.send_btn.set_sensitive(True)
        self.append("\n", "ai", gen)
        m = "done" if rc == 0 else "error"
        ST.update(mood=m, label=MOODS[m][1], last_act=time.monotonic())
        if m == "done":
            ST["done_t"] = time.monotonic() - ST["t0"]
        self.cmp_label.set_text(ST["label"])
        if ST["target"] > 0.5:
            self.entry.grab_focus()
        return False

    def new_chat(self, *_a):
        self.gen += 1                                                       # lo que traiga la consulta anterior ya no cuenta
        self.stop_proc(self.proc)
        self.proc = None
        self.working = False
        self.send_btn.set_sensitive(True)
        self.sid = None
        self.buf.set_text("")
        self.buf.move_mark(self.buf.get_mark("fin"), self.buf.get_end_iter())
        ST.update(mood="idle", label=MOODS["idle"][1])
        self.cmp_label.set_text(ST["label"])
        self.show_chat(False)
        self.entry.grab_focus()

    def pick_provider(self, *_a):
        """Pasa a la siguiente IA instalada (un solo botón: caben todas aunque el cuadro sea pequeño)."""
        if len(self.provs) < 2:
            return
        pid = self.provs[(self.provs.index(self.provider) + 1) % len(self.provs)] if self.provider in self.provs else self.provs[0]
        set_ai(pid)
        self.provider = pid
        self.gen += 1
        self.stop_proc(self.proc)
        self.working = False
        self.send_btn.set_sensitive(True)
        self.sid = None
        self.pbtn.set_label(PROV_NAMES.get(pid, pid))
        self.entry.set_placeholder_text("Escríbele a %s…" % PROV_NAMES.get(pid, pid))
        self.entry.grab_focus()

    def quit_clean(self, *_a):
        self.stop_proc(self.proc)
        try:
            os.remove(READY_FILE)
        except OSError:
            pass
        self.quit()
        return False

    def act(self, *cmd):
        self.collapse()
        GLib.timeout_add(190, lambda: (run(*cmd), False)[1])          # primero se recoge, luego sale lo elegido

    def do_activate(self):
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=self)
        self.win = win
        win.set_default_size(WIN_W, WIN_H)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        mon = Gdk.Display.get_default().get_monitors().get_item(0).get_geometry()
        self.sw, self.sh = mon.width, mon.height
        self.home = ((self.sw - WIN_W) // 2, TOP)                    # casa: centrada arriba (hueco de la barra)
        self.custom = load_pos()                                     # sitio al que la persona arrastró el cuadro (si lo hizo)
        LS.set_anchor(win, LS.Edge.TOP, True)
        LS.set_anchor(win, LS.Edge.LEFT, True)                       # se coloca con márgenes: así se puede mover a cualquier sitio
        self.place(*self.home)
        LS.set_exclusive_zone(win, -1)
        LS.set_namespace(win, "hyprarch-island")
        LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)

        ov = Gtk.Overlay()
        base = Gtk.Box()                                   # fondo transparente del tamaño de la ventana
        base.set_size_request(WIN_W, WIN_H)
        ov.set_child(base)
        # DOS lienzos: la pastilla (pequeña, siempre) y el panel (solo cuando está desplegado). En reposo solo se repinta la pastilla.
        canvas = Gtk.DrawingArea()
        canvas.set_content_width(CW + 28)
        canvas.set_content_height(CH + 14)
        canvas.set_halign(Gtk.Align.CENTER)
        canvas.set_valign(Gtk.Align.START)
        canvas.set_draw_func(self.draw_pill)
        self.canvas = canvas
        panel = Gtk.DrawingArea()
        panel.set_content_width(EW + 40)
        panel.set_content_height(EH_CHAT + PANEL_PAD + 30)
        panel.set_halign(Gtk.Align.CENTER)
        panel.set_valign(Gtk.Align.START)
        panel.set_margin_top(CH + GAP - PANEL_PAD)
        panel.set_draw_func(self.draw_panel)
        panel.set_can_target(False)
        panel.set_visible(False)
        self.panel = panel
        ov.add_overlay(panel)
        ov.add_overlay(canvas)

        cmp_box = Gtk.Box()
        cmp_box.set_halign(Gtk.Align.CENTER)
        cmp_box.set_valign(Gtk.Align.START)
        cmp_box.set_size_request(CW, CH)
        self.cmp_label = Gtk.Label(label=ST["label"], xalign=0.0)
        self.cmp_label.add_css_class("cmp")
        self.cmp_label.set_margin_start(40)
        self.cmp_label.set_hexpand(True)
        cmp_box.append(self.cmp_label)
        cmp_box.set_can_target(False)
        self.cmp_box = cmp_box
        ov.add_overlay(cmp_box)

        exp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        exp.set_halign(Gtk.Align.CENTER)
        exp.set_valign(Gtk.Align.START)
        exp.set_margin_top(CH + GAP)                   # debajo de la pastilla
        exp.set_size_request(EW, EH)
        self.exp_size = EH
        head = Gtk.Box(spacing=6)                      # encabezado: las IAs a elegir (pastillas) y acciones discretas
        head.set_size_request(-1, HEAD_H)
        head.set_margin_start(52)                      # a la izquierda queda sitio para Hyro pequeño
        head.set_margin_end(14)
        head.set_visible(False)
        self.head = head
        self.make_draggable(head)
        import shutil
        extra = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "")
        self.provs = [pid for pid in PROV_NAMES if shutil.which(pid, path=extra)]
        pb = Gtk.Button(label=PROV_NAMES.get(self.provider, self.provider))       # un solo botón: pasa a la siguiente IA instalada
        pb.add_css_class("pill")
        pb.add_css_class("sel")
        pb.set_valign(Gtk.Align.CENTER)
        pb.set_tooltip_text("Cambiar de IA")
        pb.connect("clicked", self.pick_provider)
        self.pbtn = pb
        head.append(pb)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        head.append(spacer)
        for label, tip, handler in (("Nueva", "Empezar una conversación nueva", self.new_chat),
                                    ("Historial", "Conversaciones anteriores", lambda *_a: self.act("hyprarch-ai", "history"))):
            b = Gtk.Button(label=label)
            b.add_css_class("pill")
            b.set_valign(Gtk.Align.CENTER)
            b.set_tooltip_text(tip)
            b.connect("clicked", handler)
            head.append(b)
        xb = Gtk.Button(label="×")
        xb.add_css_class("x")
        xb.set_valign(Gtk.Align.CENTER)
        xb.set_margin_start(2)
        xb.connect("clicked", lambda _b: self.collapse())
        head.append(xb)
        exp.append(head)

        body = Gtk.Overlay()                           # cuerpo: saludo (sin conversación) o respuesta (con conversación)
        body.set_vexpand(True)
        body.set_margin_start(12)
        body.set_margin_end(12)
        body.set_child(Gtk.Box())
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        titles.set_margin_start(92)
        titles.set_valign(Gtk.Align.CENTER)
        nm = Gtk.Label(label=NAME.upper(), xalign=0.0)
        nm.add_css_class("name")
        self.say = Gtk.Label(label=ST["phrase"], xalign=0.0)
        self.say.add_css_class("say")
        titles.append(nm)
        titles.append(self.say)
        view = Gtk.TextView()
        view.add_css_class("chat")
        view.set_editable(False)
        view.set_cursor_visible(False)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.set_left_margin(16)
        view.set_right_margin(16)
        view.set_top_margin(12)
        view.set_bottom_margin(12)
        self.view = view
        self.buf = view.get_buffer()
        self.buf.create_mark("fin", self.buf.get_end_iter(), False)
        self.buf.create_tag("me", foreground="#5ef2c8", weight=700)
        self.buf.create_tag("ai", foreground="#dfe9ed")
        self.buf.create_tag("dim", foreground="#7f929b", scale=0.9)
        self.buf.create_tag("err", foreground="#ff7a8a")
        sw = Gtk.ScrolledWindow()
        sw.add_css_class("reply")
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_child(view)
        sw.set_visible(False)
        self.scroll = sw
        body.add_overlay(sw)
        exp.append(body)

        row = Gtk.Box(spacing=8)                       # el cuadro para escribir (siempre visible, abajo)
        row.set_size_request(-1, INPUT_H)
        row.set_margin_start(14)
        row.set_margin_end(14)
        row.set_margin_bottom(7)
        row.set_valign(Gtk.Align.END)
        entry = Gtk.Entry()
        entry.add_css_class("in")
        entry.set_hexpand(True)
        entry.set_valign(Gtk.Align.CENTER)
        entry.set_placeholder_text("Escríbele a %s…" % PROV_NAMES.get(self.provider, self.provider))
        entry.connect("activate", self.send)
        self.entry = entry
        sb = Gtk.Button(label="↑")
        sb.add_css_class("send")
        sb.set_valign(Gtk.Align.CENTER)
        sb.set_tooltip_text("Enviar")
        sb.connect("clicked", self.send)
        self.send_btn = sb
        grip = Gtk.DrawingArea()                      # los puntitos para arrastrar el cuadro a donde quieras
        grip.set_content_width(14)
        grip.set_content_height(30)
        grip.set_valign(Gtk.Align.CENTER)
        grip.set_tooltip_text("Arrastra para mover")
        grip.set_cursor(Gdk.Cursor.new_from_name("grab", None))
        def draw_grip(_a, cr, w, h):
            cr.set_source_rgba(1, 1, 1, 0.30)
            for gx in (4, 10):
                for gy in (7, 15, 23):
                    cr.arc(gx, gy, 1.5, 0, 2 * math.pi)
                    cr.fill()
        grip.set_draw_func(draw_grip)
        self.make_draggable(grip)
        row.append(grip)
        row.append(entry)
        row.append(sb)
        exp.append(row)
        exp.set_opacity(0.0)
        exp.set_visible(False)
        self.exp_box = exp
        ov.add_overlay(exp)
        win.set_child(ov)

        click = Gtk.GestureClick()
        click.set_button(1)
        # clic en la pastilla = abrir/cerrar el panel (un clic en el panel no lo cierra)
        click.connect("released", lambda _g, _n, _x, y: (self.collapse() if ST["target"] > 0.5 else self.expand()) if y < CH + 4 else None)
        canvas.add_controller(click)
        mo = Gtk.EventControllerMotion()
        mo.connect("enter", lambda *_a: ST.update(hover=True, last_act=time.monotonic()))
        mo.connect("leave", lambda *_a: ST.update(hover=False))
        canvas.add_controller(mo)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_a: (self.collapse(), True)[1] if kv == Gdk.KEY_Escape else False)
        win.add_controller(keys)

        win.present()
        if os.environ.get("HYPRARCH_ISLAND_OPEN"):                      # solo para pruebas: arranca ya expandida
            GLib.timeout_add(600, lambda: (self.expand(), False)[1])
        GLib.timeout_add(16, self.tick)
        self.region_dirty = True
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.toggle)    # atajo: hyprarch-ai avisa con SIGUSR1
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.quit_clean)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.quit_clean)
        try:
            with open(READY_FILE, "w") as fh:
                fh.write(str(os.getpid()))
            atexit.register(lambda: os.path.exists(READY_FILE) and os.remove(READY_FILE))
        except OSError:
            pass
        GLib.timeout_add(1000, self.poll_status)
        GLib.timeout_add(1500, self.maybe_wink)

    def maybe_wink(self):
        if random.random() < 0.28 and ST["mood"] == "idle":
            ST["wink_t"] = time.monotonic() - ST["t0"]
        return True

    def poll_status(self):
        if self.working:                                  # mientras responde desde la isla, el ánimo lo manda ella
            return True
        m = status()
        if m != ST["mood"]:
            if m == "done":
                ST["done_t"] = time.monotonic() - ST["t0"]
            ST["mood"] = m
            ST["label"] = MOODS[m][1]
            self.cmp_label.set_text(ST["label"])
            if m != "idle":
                ST["last_act"] = time.monotonic()
        return True


if __name__ == "__main__":
    App().run([])
