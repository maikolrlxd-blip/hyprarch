#!/usr/bin/env bash
# hyprarch-welcome — asistente de PRIMER INICIO: te pregunta tus preferencias con los menús animados de hyprarch.
#
#   hyprarch-welcome           corre solo la primera vez (si ya lo hiciste, no hace nada)
#   hyprarch-welcome --force   lo vuelve a abrir cuando quieras (también desde el menú de Hyro)
#
# Pregunta, en este orden: IDIOMA (más de 80, se aplica en el momento y el resto del asistente ya sale en ese idioma) ·
# colores · estilo visual · robotito (aspecto y nombre) · IA · animación de entrada y sonido · rendimiento.
# Todo queda en ~/.config/hyprarch/ y se puede cambiar después. Primera opción: "Usar lo recomendado" (sin preguntas).
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/hyprarch"
DONE="$CFG/first-run-done"
mkdir -p "$CFG"
[[ ${1:-} == --force || ! -e $DONE ]] || exit 0
command -v hyprarch-pick >/dev/null 2>&1 || exit 0

T() { hyprarch-i18n "$1" "${2:-$1}"; }                          # texto traducido al idioma elegido
ask_game() { hyprarch-pick --layout orbit --title "$1"; }      # opciones de juego: una debajo de la otra
ask_list() { hyprarch-pick --layout wheel --title "$1" --placeholder "${2:-$(T ui.search)}"; }

# 0) idioma: lo primero, para que todo lo demás ya salga en tu idioma
command -v hyprarch-lang >/dev/null 2>&1 && hyprarch-lang pick

mode=$(printf '%s\n' \
  "recomendado"$'\t'"$(T w.rec)"$'\t\t'"$(T w.rec.d)"$'\thappy' \
  "mi-gusto"$'\t'"$(T w.custom)"$'\t\t'"$(T w.custom.d)"$'\twink' |
  ask_game "$(T w.welcome)") || mode=recomendado

if [[ $mode == mi-gusto ]]; then
  # 1) color: el que elijas es el color del sistema y también el de tu robot
  t=$(printf '%s\n' \
      $'fresco\tFresco\t#5ef2c8\tmenta / mint' \
      $'verde\tVerde neón\t#39ff14\tneon green' \
      $'rojo\tRojo carmesí\t#ff1f4b\tcrimson' \
      $'cine\tÁmbar cine\t#ffb347\tamber' \
      $'estudio\tVerde agua\t#4fd1c5\taqua' \
      $'trabajo\tCeleste\t#5ec2ff\tsky' \
      $'gamer\tCian gamer\t#00e5ff\tcyan' |
    ask_list "$(T w.color)") && hyprarch-theme "$t" >/dev/null 2>&1

  # 2) estilo visual
  s=$(printf '%s\n' \
      $'fresh\tFresh\t\tglass · soft shadows' \
      $'dinamico\tDynamic\t\tbouncy' \
      $'3d\t3D\t\tfloating layers' \
      $'sutil\tSubtle\t\tshort and discreet' \
      $'neumo\tSoft relief\t\tneumorphism' \
      $'cyber\tCyberpunk\t\tcut corners' \
      $'stark\tHologram\t\treactor' |
    ask_list "$(T w.style)") && printf '%s\n' "$s" > "$CFG/style"

  # 3) el robotito: aspecto y nombre
  m=$(printf '%s\n' \
      $'elite\tElite\t\tangular helmet, light visor\thappy' \
      $'cute\tClassic\t\tfriendly and round\twink' |
    ask_game "$(T w.robot)") && printf '%s\n' "$m" > "$CFG/mascot"
  n=$(hyprarch-pick --input --title "$(T w.name)" --placeholder "Hyro") && printf 'NAME=%s\n' "$n" > "$CFG/buddy.conf"

  # 4) la IA
  command -v hyprarch-ai >/dev/null 2>&1 && hyprarch-ai setup-only >/dev/null 2>&1

  # 5) animación de entrada y sonido
  i=$(printf '%s\n' \
      $'on\tIntro + sound\t\t\thappy' \
      $'mute\tIntro, no sound\t\t\twink' \
      $'off\tNo intro\t\t\tserious' |
    ask_game "$(T w.intro)") && printf '%s\n' "$i" > "$CFG/intro"

  # 6) rendimiento
  p=$(printf '%s\n' \
      $'auto\tAuto\t\t\thappy' \
      $'lite\tLite\t\t\tsleepy' \
      $'full\tFull\t\t\tsurprised' |
    ask_game "$(T w.perf)") && printf '%s\n' "$p" > "$CFG/perf"
else
  hyprarch-theme fresco >/dev/null 2>&1
fi

command -v hyprarch-perf >/dev/null 2>&1 && hyprarch-perf auto >/dev/null 2>&1
touch "$DONE"
# el personajito del escritorio recoge el nombre y el aspecto nuevos
if pgrep -f "claude-presence daemon" >/dev/null 2>&1; then
  pkill -f "claude-presence daemon" 2>/dev/null
  setsid -f env GSK_RENDERER=cairo LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so claude-presence daemon >/dev/null 2>&1
fi
command -v notify-send >/dev/null 2>&1 && notify-send -t 6000 "$(T w.done.title)" "$(T w.done.msg)"
