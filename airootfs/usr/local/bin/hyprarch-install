#!/usr/bin/env bash
# hyprarch-install — instala hyprarch en un disco (UEFI o BIOS clásico). BORRA TODO el disco elegido.
#
#   hyprarch-install                      muestra los discos y te guía
#   hyprarch-install --disk /dev/sda --user maria
#
# Opciones:
#   --disk DISCO          disco donde instalar (se borra por completo)
#   --user NOMBRE         usuario que se crea (por defecto: te lo pregunta)
#   --hostname NOMBRE     nombre del equipo (por defecto: hyprarch)
#   --password-file ARCH  lee la contraseña del usuario de un archivo (si no, la pide dos veces)
#   --autologin           entra solo a la sesión, sin pedir usuario (cómodo en una VM)
#   --sudo-nopasswd       sudo sin contraseña (solo para equipos de prueba)
#   --ssh-key ARCH        (desarrollo) agrega una llave pública SSH y habilita sshd solo con llave
#   --yes                 no pide confirmación (peligroso: úsalo solo en automatizaciones)
#   -h, --help            esta ayuda
#
# Qué hace: particiona (EFI 1 GiB + raíz ext4), instala Arch con los paquetes de hyprarch
# (/usr/share/hyprarch/packages.txt), copia la configuración de esta sesión, crea tu usuario,
# configura idioma/hora/teclado de esta sesión y deja systemd-boot listo.
# Necesita internet (descarga los paquetes). Detecta solo si el equipo arrancó en UEFI (systemd-boot, partición EFI de 1 GiB)
# o en BIOS clásico (GRUB, partición «BIOS boot» de 1 MiB en un disco GPT): en los dos casos el disco queda con tabla GPT.
set -euo pipefail

say()  { printf '\n\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }
trap 'printf "\033[1;31mFalló en la línea %s. Instalación INCOMPLETA: no hay reanudación; para intentarlo otra vez se vuelve a formatear el disco.\033[0m\n" "$LINENO" >&2' ERR
OWN_MNT=0
cleanup() {   # desmonta solo lo que montó este instalador
  local rc=$?
  trap - EXIT
  if (( OWN_MNT )); then umount -R /mnt 2>/dev/null || warn "no pude desmontar /mnt"; fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

DISK=""; USERNAME=""; HOSTNAME_="hyprarch"; PASS_FILE=""; SSH_KEY=""
YES=0; AUTOLOGIN=0; SUDO_NOPASS=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --disk)          DISK=${2:?falta el disco}; shift 2 ;;
    --user)          USERNAME=${2:?falta el usuario}; shift 2 ;;
    --hostname)      HOSTNAME_=${2:?falta el nombre}; shift 2 ;;
    --password-file) PASS_FILE=${2:?falta el archivo}; shift 2 ;;
    --ssh-key)       SSH_KEY=${2:?falta el archivo}; shift 2 ;;
    --autologin)     AUTOLOGIN=1; shift ;;
    --sudo-nopasswd) SUDO_NOPASS=1; shift ;;
    --yes)           YES=1; shift ;;
    -h|--help)       sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)               die "opción desconocida: $1 (probá --help)" ;;
  esac
done

(( YES == 0 )) || [[ -n $DISK ]] || die "--yes exige indicar --disk explícitamente."
[[ $EUID -eq 0 ]] || die "ejecutalo como administrador: sudo hyprarch-install"
if [[ -d /sys/firmware/efi ]]; then BOOT_MODE=uefi; else BOOT_MODE=bios; fi
[[ -r /usr/share/hyprarch/packages.txt ]] || die "falta /usr/share/hyprarch/packages.txt (¿ISO muy vieja?)."
for c in sgdisk pacstrap genfstab arch-chroot mkfs.ext4 lsblk findmnt wipefs partprobe udevadm blkid pacman-key mount umount mountpoint flock timedatectl; do
  command -v "$c" >/dev/null || die "falta el comando $c"
done
[[ $BOOT_MODE == bios ]] || command -v mkfs.fat >/dev/null || die "falta el comando mkfs.fat"
ping -c1 -W3 archlinux.org >/dev/null 2>&1 || ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 || die "no hay internet (SUPER+N abre el menú de red)."

# ---------- elegir el disco ----------
exec 9>/run/hyprarch-install.lock
flock -n 9 || die "ya hay otro instalador ejecutándose."
mountpoint -q /mnt && die "/mnt ya está ocupado: desmontalo antes de instalar."
check_disk() {   # se ejecuta al elegir y otra vez JUSTO antes de borrar; ante la duda, NO borra
  local src kind parents mounts
  src=$(findmnt -rn -M /run/archiso/bootmnt -o SOURCE) || die "no pude identificar el medio desde el que arrancaste: no se borrará nada."
  kind=$(lsblk -dnro TYPE "$src") || die "no pude consultar el medio live: no se borrará nada."
  case $kind in
    rom) ;;   # ISO en unidad óptica: el destino exige TYPE=disk
    disk|part)
      parents=$(lsblk -srnpo NAME "$src") || die "no pude identificar los dispositivos del medio live: no se borrará nada."
      if grep -Fxq -- "$DISK" <<< "$parents"; then die "$DISK contiene el sistema desde el que arrancaste: no se puede borrar."; fi ;;
    *) die "origen live no soportado ($kind): no se borrará nada." ;;
  esac
  mounts=$(lsblk -nr -o MOUNTPOINTS "$DISK") || die "no pude comprobar los montajes de $DISK: no se borrará nada."
  [[ -z ${mounts//[[:space:]]/} ]] || die "$DISK tiene particiones montadas o swap activo. Desmontalas antes."
}
if [[ -z $DISK ]]; then
  say "Discos disponibles"
  lsblk -dno NAME,SIZE,MODEL,TRAN | grep -v '^loop\|^sr' || true
  read -rp $'\nDisco donde instalar (ej. /dev/sda o /dev/nvme0n1): ' DISK
fi
[[ -b $DISK ]] || die "$DISK no es un disco."
DISK=$(readlink -f -- "$DISK") || die "no pude resolver $DISK."   # /dev/disk/by-id/... -> /dev/sdX
[[ $(lsblk -dno TYPE "$DISK") == disk ]] || die "$DISK no es un disco entero (usá /dev/sda, no /dev/sda1)."
check_disk
SIZE_GB=$(( $(lsblk -bdno SIZE "$DISK") / 1073741824 ))
(( SIZE_GB >= 20 )) || die "$DISK es muy chico (${SIZE_GB} GB). Hacen falta al menos 20 GB."

# ---------- usuario ----------
if [[ -z $USERNAME ]]; then read -rp "Nombre de usuario (minúsculas, sin espacios): " USERNAME; fi
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || die "nombre de usuario inválido: '$USERNAME'."
case $USERNAME in root|bin|daemon|mail|ftp|http|nobody|sys|adm|games|man|lp|uucp|systemd-*|dbus|polkitd|avahi|git|sddm) die "nombre de usuario reservado: '$USERNAME'." ;; esac
[[ $HOSTNAME_ =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] || die "nombre de equipo inválido: '$HOSTNAME_'."
if [[ -n $PASS_FILE ]]; then
  [[ -r $PASS_FILE ]] || die "no puedo leer $PASS_FILE"
  PASSWORD=$(head -n1 "$PASS_FILE")
else
  while :; do
    read -rsp "Contraseña de $USERNAME: " PASSWORD; echo
    read -rsp "Repetila: " PASSWORD2; echo
    [[ -n $PASSWORD && $PASSWORD == "$PASSWORD2" ]] && break
    warn "no coinciden o está vacía, probá de nuevo."
  done
fi
[[ -n $PASSWORD ]] || die "la contraseña no puede estar vacía."
[[ -z $SSH_KEY || -r $SSH_KEY ]] || die "no puedo leer la llave $SSH_KEY"

# ---------- confirmar ----------
echo
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MODEL,SERIAL,WWN "$DISK"
echo
warn "SE BORRARÁ TODO EL CONTENIDO de $DISK (${SIZE_GB} GB). No se puede deshacer."
if (( YES == 0 )); then
  read -rp "Para continuar escribí exactamente la ruta del disco ($DISK): " ANS
  [[ $ANS == "$DISK" ]] || die "cancelado, no se tocó nada."
fi

part() { [[ $DISK =~ [0-9]$ ]] && echo "${DISK}p$1" || echo "${DISK}$1"; }
ESP=$(part 1); ROOT=$(part 2)

# lo que se hereda de esta sesión (idioma, teclado, hora)
LOCALE=$(. /etc/locale.conf 2>/dev/null && echo "${LANG:-es_AR.UTF-8}") || LOCALE="es_AR.UTF-8"
KEYMAP=$(. /etc/vconsole.conf 2>/dev/null && echo "${KEYMAP:-la-latin1}") || KEYMAP="la-latin1"
TZ_LINK=$(readlink -f /etc/localtime 2>/dev/null || true); TZ_LINK=${TZ_LINK#/usr/share/zoneinfo/}
[[ -n $TZ_LINK && -e /usr/share/zoneinfo/$TZ_LINK ]] || TZ_LINK="UTC"
if ! [[ $LOCALE =~ ^[a-z]{2,3}_[A-Z]{2}\.UTF-8$ && -r /usr/share/i18n/locales/${LOCALE%%.*} ]]; then
  warn "el idioma '$LOCALE' no lo soporta el instalador: se usará en_US.UTF-8 (después se cambia con SUPER+L)."
  LOCALE="en_US.UTF-8"
fi

# ---------- comprobaciones previas: TODO lo que pueda fallar se prueba ANTES de borrar ----------
say "Comprobando el equipo antes de tocar el disco"
timedatectl set-ntp true 2>/dev/null || true
for _ in $(seq 1 30); do [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == yes ]] && break; sleep 1; done
(( $(date +%Y) >= 2025 )) || die "el reloj del equipo está mal ($(date +%F)); las firmas de los paquetes fallarían."
pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinux >/dev/null 2>&1 || die "no pude preparar las llaves de paquetes."
check_disk      # revalidar justo antes de borrar

# ---------- particionar ----------
say "Particionando $DISK"
wipefs -af "$DISK" >/dev/null
sgdisk --zap-all "$DISK" >/dev/null
if [[ $BOOT_MODE == uefi ]]; then
  sgdisk -n1:0:+1G -t1:ef00 -c1:ESP -n2:0:0 -t2:8300 -c2:hyprarch "$DISK" >/dev/null
else   # BIOS clásico: GRUB necesita una partición «BIOS boot» (sin formato) al principio del disco GPT
  sgdisk -n1:0:+1M -t1:ef02 -c1:biosboot -n2:0:0 -t2:8300 -c2:hyprarch "$DISK" >/dev/null
fi
partprobe "$DISK"; udevadm settle; sleep 1
[[ $BOOT_MODE == uefi ]] && mkfs.fat -F32 -n ESP "$ESP" >/dev/null
mkfs.ext4 -F -q -L hyprarch "$ROOT"
mount "$ROOT" /mnt
OWN_MNT=1
mkdir -p /mnt/boot
[[ $BOOT_MODE == uefi ]] && mount "$ESP" /mnt/boot

# ---------- sistema base ----------
say "Instalando paquetes (puede tardar varios minutos)"
mapfile -t PKGS < <(grep -vE '^\s*(#|$)' /usr/share/hyprarch/packages.txt)
[[ $BOOT_MODE == bios ]] && PKGS+=(grub)
pacstrap -K /mnt base linux linux-firmware intel-ucode amd-ucode sudo "${PKGS[@]}"
genfstab -U /mnt >> /mnt/etc/fstab

# ---------- configuración de hyprarch ----------
say "Copiando la configuración de hyprarch"
cp -a /usr/local/. /mnt/usr/local/
rm -f /mnt/usr/local/bin/live-setup
mkdir -p /mnt/usr/share/backgrounds
cp -a /usr/share/hyprarch /mnt/usr/share/
cp -a /usr/share/backgrounds/hyprarch-* /mnt/usr/share/backgrounds/ 2>/dev/null || true
cp -a /etc/skel/. /mnt/etc/skel/
mkdir -p /mnt/etc/modprobe.d /mnt/etc/wireplumber
cp -a /etc/modprobe.d/hyprarch-audio.conf /mnt/etc/modprobe.d/ 2>/dev/null || true
cp -a /etc/wireplumber/. /mnt/etc/wireplumber/ 2>/dev/null || true
cp -a /etc/issue /mnt/etc/issue 2>/dev/null || true

# PipeWire para todos los usuarios (igual que en la ISO)
mkdir -p /mnt/etc/systemd/user/sockets.target.wants /mnt/etc/systemd/user/default.target.wants
ln -sf /usr/lib/systemd/user/pipewire.socket       /mnt/etc/systemd/user/sockets.target.wants/pipewire.socket
ln -sf /usr/lib/systemd/user/pipewire-pulse.socket /mnt/etc/systemd/user/sockets.target.wants/pipewire-pulse.socket
ln -sf /usr/lib/systemd/user/wireplumber.service   /mnt/etc/systemd/user/default.target.wants/wireplumber.service

# ---------- sistema: idioma, hora, nombre ----------
say "Configurando el sistema"
echo "$HOSTNAME_" > /mnt/etc/hostname
printf 'LANG=%s\n' "$LOCALE" > /mnt/etc/locale.conf
printf 'KEYMAP=%s\n' "$KEYMAP" > /mnt/etc/vconsole.conf
printf 'en_US.UTF-8 UTF-8\n%s UTF-8\n' "$LOCALE" > /mnt/etc/locale.gen
ln -sf "/usr/share/zoneinfo/$TZ_LINK" /mnt/etc/localtime
arch-chroot /mnt locale-gen >/dev/null
arch-chroot /mnt systemctl enable NetworkManager systemd-resolved systemd-timesyncd bluetooth upower power-profiles-daemon cups.socket >/dev/null 2>&1
arch-chroot /mnt hwclock --systohc || warn "no pude actualizar el reloj de hardware"

# ---------- usuario ----------
arch-chroot /mnt useradd -m -G wheel,audio,video,input,storage -s /bin/bash "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASSWORD" | arch-chroot /mnt chpasswd
arch-chroot /mnt passwd -l root >/dev/null
mkdir -p /mnt/etc/sudoers.d
if (( SUDO_NOPASS )); then echo '%wheel ALL=(ALL:ALL) NOPASSWD: ALL' > /mnt/etc/sudoers.d/10-wheel
else echo '%wheel ALL=(ALL:ALL) ALL' > /mnt/etc/sudoers.d/10-wheel; fi
chmod 440 /mnt/etc/sudoers.d/10-wheel
unset PASSWORD PASSWORD2

if (( AUTOLOGIN )); then
  mkdir -p /mnt/etc/systemd/system/getty@tty1.service.d
  printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --noreset --noclear --autologin %s - ${TERM}\n' "$USERNAME" \
    > /mnt/etc/systemd/system/getty@tty1.service.d/autologin.conf
fi

if [[ -n $SSH_KEY ]]; then
  warn "Modo desarrollo: se habilita SSH (solo con llave) para $USERNAME."
  install -d -m 700 "/mnt/home/$USERNAME/.ssh"
  install -m 600 "$SSH_KEY" "/mnt/home/$USERNAME/.ssh/authorized_keys"
  arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/.ssh"
  mkdir -p /mnt/etc/ssh/sshd_config.d
  printf 'PasswordAuthentication no\nPermitRootLogin no\nPubkeyAuthentication yes\n' > /mnt/etc/ssh/sshd_config.d/20-hyprarch-dev.conf
  arch-chroot /mnt systemctl enable sshd >/dev/null 2>&1
fi

# ---------- arranque ----------
say "Instalando el gestor de arranque ($BOOT_MODE)"
ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
if [[ $BOOT_MODE == uefi ]]; then
  arch-chroot /mnt bootctl install >/dev/null
  printf 'default hyprarch.conf\ntimeout 3\nconsole-mode max\neditor no\n' > /mnt/boot/loader/loader.conf
  cat > /mnt/boot/loader/entries/hyprarch.conf <<EOF
title   hyprarch
linux   /vmlinuz-linux
initrd  /intel-ucode.img
initrd  /amd-ucode.img
initrd  /initramfs-linux.img
options root=UUID=$ROOT_UUID rw quiet loglevel=3
EOF
else
  sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"/; s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/' /mnt/etc/default/grub
  arch-chroot /mnt grub-install --target=i386-pc --recheck "$DISK" >/dev/null 2>&1 || die "no pude instalar GRUB en $DISK."
  arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || die "no pude generar la configuración de GRUB."
fi
# arch-chroot deja /etc/resolv.conf montado; el enlace definitivo va al final
ln -sf ../run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

if [[ $BOOT_MODE == uefi ]]; then BOOT_FILES="vmlinuz-linux initramfs-linux.img intel-ucode.img amd-ucode.img loader/loader.conf loader/entries/hyprarch.conf"
else BOOT_FILES="vmlinuz-linux initramfs-linux.img grub/grub.cfg grub/i386-pc/core.img"; fi
for f in $BOOT_FILES; do
  [[ -s /mnt/boot/$f ]] || die "falta el archivo de arranque /boot/$f: la instalación no arrancaría."
done
sync
# pacstrap deja un gpg-agent (llaves de pacman) con /mnt ocupado: se cierra antes de desmontar
arch-chroot /mnt gpgconf --kill all >/dev/null 2>&1 || true
pkill -x gpg-agent 2>/dev/null || true
sleep 1
umount -R /mnt || { warn "/mnt sigue ocupado; reintentando"; fuser -km /mnt >/dev/null 2>&1 || true; sleep 2; umount -R /mnt; }
OWN_MNT=0
say "Listo. hyprarch quedó instalado en $DISK (usuario: $USERNAME)."
echo "Apagá el equipo, sacá el USB (o el medio de instalación) y arrancá desde el disco."
