#!/usr/bin/env python3
"""hyprarch-buddy — el personajito que vive en el escritorio: la cara de las IAs de la casa.

Uso:
  hyprarch-buddy daemon                          superposición animada en pantalla (Wayland, GTK4 + layer-shell)
  hyprarch-buddy set <estado> [texto] [--ia X]   estados: idle thinking working done error waiting
                                                 (--ia indica qué IA lo manda: claude, codex, ...)
  hyprarch-buddy tool [--ia X]                   lee por stdin el JSON de un hook de Claude Code (PreToolUse)
  hyprarch-buddy status                          JSON para el módulo de Waybar (custom/buddy)
  hyprarch-buddy log [N]                         últimas N novedades (actividad reciente de las IAs)
  hyprarch-buddy render-sheet <png>              (desarrollo) dibuja todos los estados en una imagen

El nombre se elige en ~/.config/hyprarch/buddy.conf (NAME=...; por defecto "Buddy").
El estado vive en  ~/.cache/hyprarch-buddy/state.json  y la actividad en  log.jsonl . Quien quiera
mover al personajito solo tiene que escribir ahí (los hooks de Claude Code lo hacen solos).
Clic: abre el chat con la IA elegida. Clic derecho: menú (hablar, cambiar de IA, actividad, colores, silencio).
"""
import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "hyprarch-buddy"
STATE_FILE = STATE_DIR / "state.json"
LOG_FILE = STATE_DIR / "log.jsonl"
CONF_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hyprarch" / "buddy.conf"
STATES = ("idle", "thinking", "working", "done", "error", "waiting")


def buddy_name():
    """Nombre del personajito (buddy.conf, línea NAME=...). Por defecto "Hyro"."""
    try:
        for line in CONF_FILE.read_text(encoding="utf-8").splitlines():
            m = re.match(r"""^\s*NAME\s*=\s*['"]?([^'"#\n]{1,24}?)['"]?\s*$""", line)
            if m and m.group(1).strip():
                return m.group(1).strip()
    except Exception:
        pass
    return "Hyro"


OVERLAY_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hyprarch-overlay.pid"


def overlay_active():
    """True si un menú/animación a pantalla completa (hyprarch-pick, hyprarch-intro) está abierto: trae su propio
    personajito y solo puede haber uno a la vez. El archivo guarda el PID; si ese proceso ya no existe, se ignora."""
    try:
        pid = int(OVERLAY_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def clean_agent(v):
    """Nombre corto de la IA que manda el aviso (solo letras, números, guion y punto)."""
    return v[:24] if isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,24}", v) else ""
ICONS = {"idle": "", "thinking": "", "working": "", "done": "", "error": "", "waiting": ""}

# ----------------------------------------------------------------------------- estado


MAX_TEXT = 200          # el texto del globo se limita al recibirlo
EXPIRE = {"done": 8.0, "error": 8.0, "working": 300.0, "thinking": 300.0, "waiting": 300.0}


def _num(v):
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return False
    try:
        return math.isfinite(v)
    except OverflowError:       # un entero enorme no se puede convertir a float
        return False


def read_state():
    """Lee el estado y lo NORMALIZA: ante cualquier valor raro devuelve el estado seguro (idle)."""
    safe = {"state": "idle", "text": "", "ts": 0.0, "follow": False, "agent": ""}
    try:
        s = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return safe
    if not isinstance(s, dict) or s.get("state") not in STATES:
        return safe
    text = s.get("text")
    ts = s.get("ts")
    return {"state": s["state"], "text": text[:MAX_TEXT] if isinstance(text, str) else "",
            "ts": float(ts) if _num(ts) else 0.0, "follow": s.get("follow") is True,
            "agent": clean_agent(s.get("agent"))}


def effective_state(s):
    """Estado que realmente se muestra: lo que lleva mucho tiempo sin actualizarse vuelve a reposo.
    Lo usan tanto el daemon como Waybar, para que nunca se contradigan."""
    st, age = s["state"], time.time() - s["ts"]
    return "idle" if age > EXPIRE.get(st, 1e9) else st


def write_state(state, text="", **extra):
    """Escritura atómica con un temporal exclusivo por proceso (varios hooks pueden escribir a la vez)."""
    import tempfile

    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    if "agent" in extra:
        extra["agent"] = clean_agent(extra["agent"])
    data = {"state": state, "text": str(text)[:MAX_TEXT], "ts": time.time(), **extra}
    fd, tmp = tempfile.mkstemp(dir=STATE_FILE.parent, prefix=".state-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, STATE_FILE)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    # actividad reciente: solo lo que cuenta algo (no cada "pensando")
    if state in ("working", "done", "error", "waiting") and data["text"]:
        append_log(data)


def append_log(data):
    """Agrega una línea al registro de actividad y lo mantiene corto (últimas ~150 novedades)."""
    try:
        line = json.dumps({"ts": data["ts"], "state": data["state"], "agent": data.get("agent", ""),
                           "text": data["text"]}, ensure_ascii=False) + "\n"
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)
        if LOG_FILE.stat().st_size > 48_000:
            lines = LOG_FILE.read_text(encoding="utf-8").splitlines()[-150:]
            tmp = LOG_FILE.with_suffix(".tmp")
            tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
            os.replace(tmp, LOG_FILE)
    except Exception:
        pass            # el registro es un extra: nunca debe romper un aviso


def read_log(n=12):
    """Últimas n novedades (más nuevas primero), ya formateadas para mostrar."""
    out = []
    try:
        lines = LOG_FILE.read_text(encoding="utf-8").splitlines()[-max(1, n):]
    except Exception:
        return out
    icon = {"working": "", "done": "", "error": "", "waiting": ""}
    for line in reversed(lines):
        try:
            e = json.loads(line)
            hhmm = time.strftime("%H:%M", time.localtime(float(e["ts"])))
            who = f"[{e['agent']}] " if e.get("agent") else ""
            out.append(f"{hhmm}  {icon.get(e['state'], ' ')} {who}{e['text']}")
        except Exception:
            continue
    return out


def describe_tool(payload):
    """Convierte el JSON de un hook de Claude Code en una frase corta en español."""
    payload = payload if isinstance(payload, dict) else {}
    tool = payload.get("tool_name", "") or ""
    inp = payload.get("tool_input")
    inp = inp if isinstance(inp, dict) else {}
    short = lambda s, n=46: (s if len(s) <= n else s[: n - 1] + "…")
    base = lambda p: os.path.basename(str(p).replace("\\", "/"))
    if tool in ("Bash", "PowerShell"):
        lines = str(inp.get("command") or "").strip().splitlines()
        return f"Ejecutando: {short(lines[0] if lines else '')}"
    if tool in ("Edit", "Write", "NotebookEdit"):
        return f"Editando {short(base(inp.get('file_path', '')))}"
    if tool == "Read":
        return f"Leyendo {short(base(inp.get('file_path', '')))}"
    if tool in ("Grep", "Glob"):
        return f"Buscando {short(str(inp.get('pattern', '')))}"
    if tool in ("WebSearch", "WebFetch"):
        return f"Buscando en la web: {short(str(inp.get('query', inp.get('url', ''))))}"
    if tool == "Agent":
        return "Delegando en un subagente"
    return f"Usando {tool}" if tool else "Trabajando"


# ----------------------------------------------------------------------------- paleta


def load_palette():
    """Lee los colores del tema activo (verde/rojo/personalizado)."""
    pal = dict(ACCENT="39ff14", ACCENT2="ff1f4b", OK="39ff14", ALERT="ff1f4b", BG="0a0c0b", SURFACE="111513", FG="d7ffe3", DIM="5f7367")
    try:
        cur = (Path.home() / ".config/hyprarch/current").read_text().strip() or "fresco"
        f = Path.home() / ".config/hyprarch/custom.env" if cur == "custom" else Path(f"/usr/share/hyprarch/themes/{cur}.env")
        for line in f.read_text().splitlines():
            m = re.match(r'^([A-Z0-9_]+)=("?)([^"#]*)\2', line.strip())
            if m:
                pal[m.group(1)] = m.group(3).strip()
    except Exception:
        pass
    # Solo se aceptan colores de 6 dígitos hexadecimales; cualquier otro valor conserva el color por defecto.
    default = dict(ACCENT="39ff14", ACCENT2="ff1f4b", OK="39ff14", ALERT="ff1f4b", BG="0a0c0b", SURFACE="111513", FG="d7ffe3", DIM="5f7367")
    out = {}
    for k, d in default.items():
        v = str(pal.get(k, d)).strip().lstrip("#")
        v = v if re.fullmatch(r"[0-9a-fA-F]{6}", v) else d
        out[k] = tuple(int(v[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return out


# ----------------------------------------------------------------------------- dibujo (Cairo)


def rrect(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def shade(c, k):
    return tuple(max(0.0, min(1.0, v * k)) for v in c)


try:
    MASCOT = (Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hyprarch" / "mascot").read_text().strip().lower()
except OSError:
    MASCOT = "elite"
if MASCOT not in ("elite", "cute"):
    MASCOT = "elite"


def _poly(cr, pts):
    cr.move_to(*pts[0])
    for p in pts[1:]:
        cr.line_to(*p)
    cr.close_path()


EXPRESSIONS = ("happy", "wave", "sleepy", "dizzy", "wink", "serious", "surprised")


def draw_mascot_elite(cr, x, y, state, t, pal, look=(0.0, 0.0), scale=1.0, facing=1, mood=None, tilt=0.0, hop=0.0):
    """Guardián de élite: casco angular, visor con ojos de luz, anillo holográfico orbitando y núcleo con propulsor.
    Los pies (x, y) quedan en el suelo; la cabeza flota ~96 px más arriba.
    `mood` pone una CARA (happy, wave, sleepy, dizzy, wink, serious, surprised) sin cambiar el estado; `tilt` lo inclina
    (radianes) y `hop` lo hace saltar (px)."""
    import cairo

    A, A2, AL, BG, SF, FG = pal["ACCENT"], pal["ACCENT2"], pal["ALERT"], pal["BG"], pal["SURFACE"], pal["FG"]
    m = mood if mood in EXPRESSIONS else None
    col = {"error": AL, "waiting": (1.0, 0.70, 0.0)}.get(state, A)
    hot = tuple(min(1.0, c * 0.45 + 0.55) for c in col)                      # versión casi blanca del color (brillo del visor)
    bob = (math.sin(t * 1.8) * 3.0 + (math.sin(t * 9) * 1.2 if state == "working" else 0.0)
           - (abs(math.sin(t * 5)) * 9.0 if state == "done" else 0.0))
    shake = math.sin(t * 47) * 2.6 if state == "error" else 0.0
    lx, ly = max(-1.0, min(1.0, look[0])), max(-1.0, min(1.0, look[1]))
    cr.save()
    cr.translate(x + shake, y - hop)
    cr.rotate(tilt * facing)                                                  # se inclina desde los pies
    cr.scale(scale * facing, scale)
    hy = -98 + bob                                                            # centro de la cabeza

    # sombra en el suelo y aura
    cr.save()
    cr.scale(1, 0.22)
    cr.arc(0, 0, 34 + bob * 0.4, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgba(0, 0, 0, 0.35)
    cr.fill()
    aura = cairo.RadialGradient(0, hy, 8, 0, hy, 78)
    aura.add_color_stop_rgba(0, *col, 0.30)
    aura.add_color_stop_rgba(1, *col, 0.0)
    cr.set_source(aura)
    cr.arc(0, hy, 78, 0, 2 * math.pi)
    cr.fill()

    # anillo holográfico: mitad de atrás (antes de la cabeza)
    def ring(front):
        cr.save()
        cr.translate(0, hy + 6)
        cr.scale(1, 0.26)
        cr.arc(0, 0, 54, 0 if front else math.pi, math.pi if front else 2 * math.pi)
        cr.restore()
        cr.set_source_rgba(*col, 0.85 if front else 0.35)
        cr.set_line_width(1.6 if front else 1.0)
        cr.stroke()
        for k in range(3):
            ang = t * 1.5 + k * 2.094
            if (math.sin(ang) > 0) == front:
                px, py = math.cos(ang) * 54, hy + 6 + math.sin(ang) * 54 * 0.26
                cr.set_source_rgba(*hot, 0.95)
                cr.arc(px, py, 2.6 if front else 1.8, 0, 2 * math.pi)
                cr.fill()
    ring(False)

    # propulsor y núcleo (debajo de la cabeza)
    flame = 14 + 6 * math.sin(t * 22) + (8 if state == "working" else 0)
    fg = cairo.LinearGradient(0, hy + 52, 0, hy + 52 + flame)
    fg.add_color_stop_rgba(0, *hot, 0.95)
    fg.add_color_stop_rgba(0.5, *col, 0.55)
    fg.add_color_stop_rgba(1, *col, 0.0)
    _poly(cr, [(-7, hy + 52), (7, hy + 52), (0, hy + 52 + flame)])
    cr.set_source(fg)
    cr.fill()
    for rad, al in ((12, 0.15), (9, 0.30), (6, 1.0)):                        # núcleo hexagonal que late
        pul = 1 + 0.12 * math.sin(t * 4)
        cr.new_sub_path()
        for k in range(6):
            a_ = math.pi / 6 + k * math.pi / 3
            (cr.move_to if k == 0 else cr.line_to)(math.cos(a_) * rad * pul, hy + 44 + math.sin(a_) * rad * pul * 0.9)
        cr.close_path()
        cr.set_source_rgba(*(hot if rad == 6 else col), al)
        cr.fill()

    # aletas del casco
    # una sola cuchilla afilada barrida hacia atrás (dos aletas parecían orejas de gato: demasiado simpático)
    for pts, al in (([(8, hy - 35), (40, hy - 66), (24, hy - 27)], 0.95), ([(-30, hy - 4), (-40, hy + 6), (-30, hy + 14)], 0.55)):
        _poly(cr, pts)
        cr.set_source_rgba(*col, al)
        cr.fill()

    # casco angular con degradado y borde de luz
    helmet = [(-30, hy - 6), (-22, hy - 28), (-6, hy - 35), (12, hy - 35), (27, hy - 24), (33, hy - 3), (27, hy + 20),
              (11, hy + 30), (-14, hy + 30), (-29, hy + 17)]
    hg = cairo.LinearGradient(-30, hy - 35, 30, hy + 30)
    hg.add_color_stop_rgba(0, *[c * 0.55 + b * 0.45 for c, b in zip(col, SF)], 1.0)
    hg.add_color_stop_rgba(0.45, *[c * 0.12 + b * 0.88 for c, b in zip(col, SF)], 1.0)
    hg.add_color_stop_rgba(1, *BG, 1.0)
    _poly(cr, helmet)
    cr.set_source(hg)
    cr.fill_preserve()
    cr.set_source_rgba(*col, 0.95)
    cr.set_line_width(1.8)
    cr.stroke()
    cr.set_source_rgba(*hot, 0.55)                                           # reflejo en el borde superior izquierdo
    cr.set_line_width(1.2)
    cr.move_to(-22, hy - 28)
    cr.line_to(-6, hy - 35)
    cr.line_to(12, hy - 35)
    cr.stroke()
    cr.set_source_rgba(*col, 0.35)                                           # placa interior
    cr.set_line_width(0.9)
    cr.move_to(-20, hy + 22)
    cr.line_to(-8, hy + 26)
    cr.line_to(10, hy + 26)
    cr.stroke()

    # visor
    visor = [(-25, hy - 9), (26, hy - 14), (29, hy + 3), (-21, hy + 9)]
    _poly(cr, visor)
    cr.set_source_rgba(*BG, 0.96)
    cr.fill_preserve()
    cr.set_source_rgba(*col, 0.8)
    cr.set_line_width(1.2)
    cr.stroke()
    cr.save()
    _poly(cr, visor)
    cr.clip()
    blink = 1.0 if (t % 4.3) < 0.11 else 0.0
    ex_off = lx * 5
    ey = hy - 2 + ly * 2
    if m:                                                                    # CARAS: reemplazan a los ojos normales
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for ex in (-11, 11):
            exx = ex + ex_off
            cr.set_source_rgba(*hot, 0.95)
            cr.set_line_width(2.6)
            if m in ("happy", "wave"):                                       # ojos sonrientes ^ ^
                cr.new_sub_path()
                cr.arc(exx, ey + 4, 5.5, math.pi * 1.12, math.pi * 1.88)
                cr.stroke()
            elif m == "sleepy":                                              # párpados que caen y se abren un poco
                lid = 0.5 + 0.5 * math.sin(t * 1.1)
                cr.move_to(exx - 5.5, ey)
                cr.line_to(exx + 5.5, ey + 1 + lid * 1.8)
                cr.stroke()
            elif m == "dizzy":                                               # espirales
                cr.new_sub_path()
                for k in range(26):
                    ang = k * 0.62 + t * 9
                    r_ = 0.5 + k * 0.22
                    (cr.move_to if k == 0 else cr.line_to)(exx + math.cos(ang) * r_, ey + math.sin(ang) * r_)
                cr.set_line_width(1.6)
                cr.stroke()
            elif m == "wink":
                if ex < 0:
                    _poly(cr, [(exx - 6, ey - 4), (exx + 6, ey - 5), (exx + 7, ey + 4), (exx - 5, ey + 5)])
                    cr.fill()
                else:
                    cr.move_to(exx - 5, ey + 1)
                    cr.line_to(exx + 5.5, ey - 1)
                    cr.stroke()
            elif m == "serious":                                             # cejas bajas: ojos rasgados
                sgn = 1 if ex < 0 else -1
                _poly(cr, [(exx - 6, ey - 2 - 2.6 * sgn), (exx + 6, ey - 2 + 2.6 * sgn), (exx + 6, ey + 3 + 2 * sgn), (exx - 6, ey + 3 - 2 * sgn)])
                cr.fill()
            elif m == "surprised":                                           # ojos grandes redondos
                cr.new_sub_path()
                cr.arc(exx, ey, 5.8 + 0.6 * math.sin(t * 12), 0, 2 * math.pi)
                cr.set_line_width(2.4)
                cr.stroke()
                cr.new_sub_path()
                cr.arc(exx + lx * 1.5, ey, 1.8, 0, 2 * math.pi)
                cr.fill()
        eyes_a = 0.0
    elif state == "thinking":                                                # barrido de escaneo
        sx = math.sin(t * 3.2) * 20
        g = cairo.LinearGradient(sx - 8, 0, sx + 8, 0)
        g.add_color_stop_rgba(0, *col, 0.0)
        g.add_color_stop_rgba(0.5, *hot, 0.95)
        g.add_color_stop_rgba(1, *col, 0.0)
        cr.set_source(g)
        cr.rectangle(sx - 8, hy - 16, 16, 30)
        cr.fill()
        eyes_a = 0.35
    elif state == "working":                                                 # flujo de datos
        for k in range(8):
            hgt = 3 + (math.sin(t * 14 + k * 1.9) + 1) * 4
            cr.set_source_rgba(*hot, 0.9)
            cr.rectangle(-20 + k * 6, hy - 2 - hgt / 2, 3.5, hgt)
            cr.fill()
        eyes_a = 0.0
    else:
        eyes_a = 1.0
    if eyes_a > 0:
        for ex in (-11, 11):
            if state == "error":                                             # ojos en X
                cr.set_source_rgba(*hot, 0.95)
                cr.set_line_width(2.2)
                for s_ in (1, -1):
                    cr.move_to(ex + ex_off - 5, ey - 5 * s_)
                    cr.line_to(ex + ex_off + 5, ey + 5 * s_)
                cr.stroke()
            else:
                h_ = (7 if state != "done" else 11) * (1 - 0.9 * blink)
                if state == "waiting":
                    h_ *= 0.6 + 0.4 * math.sin(t * 5) ** 2
                _poly(cr, [(ex + ex_off - 6, ey - h_ / 2 - 1), (ex + ex_off + 6, ey - h_ / 2 - 2), (ex + ex_off + 7, ey + h_ / 2 + 1),
                           (ex + ex_off - 5, ey + h_ / 2 + 2)])
                cr.set_source_rgba(*hot, eyes_a)
                cr.fill()
    # brillo diagonal del cristal
    cr.set_source_rgba(1, 1, 1, 0.10)
    _poly(cr, [(-25, hy - 9), (-4, hy - 11), (-14, hy + 8), (-21, hy + 9)])
    cr.fill()
    cr.restore()
    cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    if m == "sleepy":                                                        # zzz que suben y se desvanecen
        for k in range(3):
            ph = ((t * 0.55 + k / 3) % 1.0)
            cr.set_font_size(11 + 7 * ph)
            cr.set_source_rgba(*hot, (1 - ph) * 0.9)
            cr.move_to(26 + ph * 14, hy - 26 - ph * 34)
            cr.show_text("z")
    elif m == "dizzy":                                                       # estrellitas que giran sobre la cabeza
        for k in range(3):
            ang = t * 4 + k * 2.094
            cr.set_source_rgba(*hot, 0.95)
            cr.arc(math.cos(ang) * 30, hy - 44 + math.sin(ang) * 7, 2.6, 0, 2 * math.pi)
            cr.fill()
    elif m == "surprised":
        cr.set_font_size(26)
        cr.set_source_rgba(*hot, 0.95)
        cr.move_to(30, hy - 38 + math.sin(t * 14) * 1.5)
        cr.show_text("!")
    elif m == "wave":                                                        # una mano que saluda
        ang = math.sin(t * 7) * 0.55
        cr.save()
        cr.translate(-34, hy + 10)
        cr.rotate(-1.0 + ang)
        cr.set_source_rgba(*col, 0.9)
        cr.set_line_width(3)
        cr.move_to(0, 0)
        cr.line_to(0, -26)
        cr.stroke()
        cr.arc(0, -30, 5, 0, 2 * math.pi)
        cr.fill()
        cr.restore()
    if state == "waiting":                                                   # signo de pregunta ámbar sobre la cabeza
        cr.set_font_size(20)
        cr.set_source_rgba(*col, 0.95)
        cr.move_to(22, hy - 40 + math.sin(t * 6) * 2)
        cr.show_text("?")
    if state == "done":                                                      # onda de energía al terminar
        k = (t * 1.3) % 1.0
        cr.set_source_rgba(*hot, (1 - k) * 0.6)
        cr.set_line_width(2.0 * (1 - k) + 0.5)
        cr.new_sub_path()
        cr.arc(0, hy, 36 + k * 46, 0, 2 * math.pi)
        cr.stroke()
    if state == "error" and int(t * 20) % 5 == 0:                            # glitch cromático
        for dx, c_ in ((-3, A2), (3, (0.1, 0.9, 1.0))):
            cr.save()
            cr.translate(dx, 0)
            _poly(cr, helmet)
            cr.set_source_rgba(*c_, 0.35)
            cr.set_line_width(1.5)
            cr.stroke()
            cr.restore()
    ring(True)                                                               # mitad delantera del anillo
    cr.restore()


def draw_mascot(cr, x, y, state, t, pal, look=(0.0, 0.0), scale=1.0, facing=1, mood=None, tilt=0.0, hop=0.0):
    """Dibuja a Hyro con el centro de los pies en (x, y). t = segundos.
    Estilo del personaje: ~/.config/hyprarch/mascot  (elite por defecto · cute = el robotito redondo original).
    mood/tilt/hop (solo elite): cara, inclinación y salto para darle personalidad en los menús."""
    if MASCOT == "elite":
        return draw_mascot_elite(cr, x, y, state, t, pal, look, scale, facing, mood, tilt, hop)
    import cairo

    A, A2, OK, AL = pal["ACCENT"], pal["ACCENT2"], pal["OK"], pal["ALERT"]
    bob = {"idle": math.sin(t * 2.0) * 2.0, "thinking": math.sin(t * 3.0) * 3.0, "working": math.sin(t * 9.0) * 1.6,
           "done": -abs(math.sin(t * 5.0)) * 10.0, "error": 0.0, "waiting": math.sin(t * 4.0) * 2.5}[state]
    shake = math.sin(t * 40) * 3.0 if state == "error" else 0.0
    cr.save()
    cr.translate(x + shake, y)
    cr.scale(scale * facing, scale)
    # leve inclinación en el sentido del movimiento (flota, no camina)
    cr.translate(0, -50)
    cr.rotate(max(-1.0, min(1.0, look[0])) * 0.10 * facing)
    cr.translate(0, 50)

    # sombra en el "suelo": más chica y tenue cuanto más alto flota
    cr.save()
    cr.scale(1, 0.26)
    cr.arc(0, 0, 30 + bob * 0.5, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgba(0, 0, 0, 0.30)
    cr.fill()

    # cuerpo (flotando ~20 px sobre el suelo)
    by = -80 + bob * 1.6

    # propulsor: resplandor y chispas debajo del cuerpo
    pulse_h = 0.5 + 0.5 * math.sin(t * 7.0)
    hy = by + 60
    cr.save()
    cr.translate(0, hy)
    cr.scale(1, 0.5)
    rg_h = cairo.RadialGradient(0, 0, 1, 0, 0, 26 + 5 * pulse_h)
    rg_h.add_color_stop_rgba(0, *shade(A, 1.1), 0.85)
    rg_h.add_color_stop_rgba(1, *A, 0.0)
    cr.set_source(rg_h)
    cr.arc(0, 0, 28 + 5 * pulse_h, 0, 2 * math.pi)
    cr.fill()
    cr.restore()
    for i in range(3):
        ph = (t * 1.6 + i / 3.0) % 1.0
        cr.arc((i - 1) * 9 + math.sin(t * 5 + i) * 2, hy + 4 + ph * 22, 2.4 * (1 - ph), 0, 2 * math.pi)
        cr.set_source_rgba(*A, 0.8 * (1 - ph))
        cr.fill()
    body = {"error": AL, "done": OK}.get(state, A)
    grad = cairo.LinearGradient(0, by, 0, by + 56)
    grad.add_color_stop_rgb(0, *shade(body, 1.18))
    grad.add_color_stop_rgb(1, *shade(body, 0.72))
    rrect(cr, -32, by, 64, 56, 20)
    cr.set_source(grad)
    cr.fill_preserve()
    cr.set_source_rgba(0, 0, 0, 0.55)
    cr.set_line_width(2.4)
    cr.stroke()
    # brillo
    rrect(cr, -24, by + 5, 30, 8, 4)
    cr.set_source_rgba(1, 1, 1, 0.30)
    cr.fill()

    # pantalla/cara oscura
    rrect(cr, -25, by + 12, 50, 32, 12)
    cr.set_source_rgba(0.03, 0.04, 0.04, 0.92)
    cr.fill()

    # ojos
    blink = 0.12 if (t % 4.0) < 0.12 else 1.0
    lx, ly = look
    for ex in (-11, 11):
        eh = (13 if state != "done" else 5) * blink
        cr.save()
        cr.translate(ex, by + 27)
        cr.scale(1, max(eh / 13, 0.12))
        cr.arc(0, 0, 6.2, 0, 2 * math.pi)
        cr.restore()
        glow = {"error": AL, "done": OK}.get(state, A)
        cr.set_source_rgb(*glow)
        cr.fill()
        if state not in ("done",) and blink > 0.5:
            cr.arc(ex + lx * 2.2, by + 27 + ly * 2.2, 2.0, 0, 2 * math.pi)
            cr.set_source_rgb(0.02, 0.03, 0.03)
            cr.fill()

    # boca
    cr.set_line_width(2.4)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_source_rgb(*shade(body, 1.1))
    my = by + 38
    if state == "done":
        cr.arc(0, my - 4, 7, 0.15 * math.pi, 0.85 * math.pi)
    elif state == "error":
        cr.move_to(-6, my + 1)
        for i in range(1, 5):
            cr.line_to(-6 + i * 3, my + (-1 if i % 2 else 1))
    elif state == "waiting":
        cr.arc(0, my, 2.6, 0, 2 * math.pi)
    elif state == "thinking":
        cr.move_to(-4, my)
        cr.line_to(4, my)
    else:
        cr.arc(0, my - 3, 5, 0.2 * math.pi, 0.8 * math.pi)
    cr.stroke()

    # antena
    ax = math.sin(t * 2.5) * 2
    cr.set_source_rgb(*shade(A, 0.55))
    cr.set_line_width(3)
    cr.move_to(0, by)
    cr.curve_to(ax, by - 8, ax * 1.5, by - 12, ax * 2, by - 16)
    cr.stroke()
    pulse = 0.5 + 0.5 * math.sin(t * {"idle": 2, "thinking": 6, "working": 10, "done": 4, "error": 14, "waiting": 5}[state])
    tip = {"error": AL, "done": OK, "thinking": A2}.get(state, A)
    rg = cairo.RadialGradient(ax * 2, by - 18, 1, ax * 2, by - 18, 12 + 6 * pulse)
    rg.add_color_stop_rgba(0, *tip, 0.95)
    rg.add_color_stop_rgba(1, *tip, 0.0)
    cr.set_source(rg)
    cr.arc(ax * 2, by - 18, 14 + 6 * pulse, 0, 2 * math.pi)
    cr.fill()
    cr.arc(ax * 2, by - 18, 4.2, 0, 2 * math.pi)
    cr.set_source_rgb(*shade(tip, 1.2))
    cr.fill()

    # portátil cuando trabaja / piensa
    if state in ("working", "thinking"):
        # portátil flotando delante de la parte baja del cuerpo (no tapa la cara)
        rrect(cr, -21, by + 60, 42, 5, 2)
        cr.set_source_rgb(*shade(A, 0.4))
        cr.fill()
        rrect(cr, -15, by + 45, 30, 15, 3)
        cr.set_source_rgba(0.02, 0.05, 0.03, 0.97)
        cr.fill_preserve()
        cr.set_source_rgb(*A)
        cr.set_line_width(1.4)
        cr.stroke()
        for i in range(3):
            w = 6 + ((int(t * 6) + i * 3) % 4) * 4
            cr.move_to(-11, by + 49 + i * 4)
            cr.line_to(-11 + w, by + 49 + i * 4)
            cr.set_source_rgba(*A, 0.9)
            cr.set_line_width(1.6)
            cr.stroke()

    # símbolos flotantes por estado
    cr.set_font_size(20)
    if state == "thinking":
        for i in range(3):
            a = 0.25 + 0.75 * max(0.0, math.sin(t * 5 - i * 0.9))
            cr.arc(-14 + i * 14, by - 36 - math.sin(t * 5 - i * 0.9) * 3, 3.6, 0, 2 * math.pi)
            cr.set_source_rgba(*A2, a)
            cr.fill()
    elif state == "waiting":
        cr.select_font_face("monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_source_rgba(*A2, 0.55 + 0.45 * math.sin(t * 6))
        cr.move_to(26, by - 6)
        cr.show_text("?")
    elif state == "error":
        cr.select_font_face("monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_source_rgb(*AL)
        cr.move_to(26, by - 4)
        cr.show_text("!")
    elif state == "done":
        for i in range(6):
            ang = t * 3 + i * math.pi / 3
            r = 40 + 6 * math.sin(t * 6 + i)
            px, py = math.cos(ang) * r, by + 14 + math.sin(ang) * r * 0.7
            cr.arc(px, py, 2.6, 0, 2 * math.pi)
            cr.set_source_rgba(*(OK if i % 2 else A2), 0.9)
            cr.fill()
    cr.restore()


_FIT_CACHE = {}


def _fit_text(cr, text, avail):
    """Recorta con '…' por búsqueda binaria (no carácter a carácter) y recuerda el resultado."""
    key = (text, int(avail))
    hit = _FIT_CACHE.get(key)
    if hit:
        return hit
    width = cr.text_extents(text).x_advance
    if width <= avail:
        res = (text, width)
    else:
        lo, hi = 1, len(text)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if cr.text_extents(text[:mid] + "…").x_advance <= avail:
                lo = mid
            else:
                hi = mid - 1
        cut = text[:lo] + "…"
        res = (cut, cr.text_extents(cut).x_advance)
    if len(_FIT_CACHE) > 64:
        _FIT_CACHE.clear()
    _FIT_CACHE[key] = res
    return res


def draw_bubble(cr, x, y, text, pal, alpha=1.0, max_w=360, side="left"):
    """Globo de texto con la cola apuntando hacia (x, y) (arriba del personajito)."""
    import cairo

    if not text or alpha <= 0.01:
        return
    cr.save()
    cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(14)
    text, tw = _fit_text(cr, text[:MAX_TEXT], max_w - 28)
    w = min(tw + 28, max_w)
    h = 34
    bx, by = (x - w + 34 if side == "left" else x - 34), y - h - 14
    A, BG, FG = pal["ACCENT"], pal["BG"], pal["FG"]
    rrect(cr, bx, by, w, h, 12)
    cr.set_source_rgba(*BG, 0.94 * alpha)
    cr.fill_preserve()
    cr.set_source_rgba(*A, alpha)
    cr.set_line_width(2)
    cr.stroke()
    cr.move_to(x - 4, by + h - 1)
    cr.line_to(x + 8, by + h + 12)
    cr.line_to(x + 16, by + h - 1)
    cr.set_source_rgba(*BG, 0.94 * alpha)
    cr.fill_preserve()
    cr.set_source_rgba(*A, alpha)
    cr.stroke()
    cr.set_source_rgba(*FG, alpha)
    cr.move_to(bx + 14, by + 22)
    cr.show_text(text)
    cr.restore()


def render_sheet(out):
    import cairo

    pal = load_palette()
    names = list(STATES)
    cell_w, cell_h = 230, 230
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, cell_w * len(names), cell_h)
    cr = cairo.Context(surf)
    cr.set_source_rgb(0.04, 0.06, 0.05)
    cr.paint()
    texts = {"idle": "", "thinking": "Pensando…", "working": "Editando hyprland.lua", "done": "¡Listo!", "error": "Algo falló", "waiting": "¿Seguimos?"}
    for i, st in enumerate(names):
        x = i * cell_w + cell_w / 2
        draw_mascot(cr, x, 190, st, 1.37, pal, look=(0.6, 0.2), scale=1.15)
        draw_bubble(cr, x + 10, 78, texts[st], pal)
        cr.set_source_rgb(*pal["DIM"])
        cr.select_font_face("monospace")
        cr.set_font_size(12)
        cr.move_to(i * cell_w + 10, 18)
        cr.show_text(st)
    surf.write_to_png(out)
    print(out)


# ----------------------------------------------------------------------------- Waybar


def cmd_status():
    s = read_state()
    st = effective_state(s)
    text = (s.get("text") if st == s["state"] else "") or {"idle": "Claude en reposo", "done": "Listo", "error": "Error"}.get(st, "")
    print(json.dumps({"text": f"{ICONS[st]} Claude", "class": st, "tooltip": text}, ensure_ascii=False))


# ----------------------------------------------------------------------------- superposición (GTK4 + layer-shell)


def hypr_json(*args):
    try:
        out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=1).stdout
        return json.loads(out)
    except Exception:
        return None


def palette_files():
    """Archivos que definen la paleta activa (para detectar cambios de tema)."""
    home = Path.home()
    files = [home / ".config/hyprarch/current"]
    try:
        cur = files[0].read_text().strip() or "fresco"
    except Exception:
        cur = "verde"
    files.append(home / ".config/hyprarch/custom.env" if cur == "custom" else Path(f"/usr/share/hyprarch/themes/{cur}.env"))
    return files


def palette_signature():
    sig = []
    for f in palette_files():
        try:
            sig.append(f.stat().st_mtime)
        except OSError:
            sig.append(0.0)
    return tuple(sig)


def run_daemon():
    """Superposición liviana: una ventanita (440x270) que se desplaza con los márgenes de layer-shell."""
    # sin layer-shell precargado GTK abriría una ventana normal a pantalla completa: se relanza con el entorno correcto
    if "gtk4-layer-shell" not in os.environ.get("LD_PRELOAD", ""):
        env = dict(os.environ)
        env["LD_PRELOAD"] = (env.get("LD_PRELOAD", "") + " /usr/lib/libgtk4-layer-shell.so").strip()
        env["GSK_RENDERER"] = "cairo"
        try:
            os.execvpe(sys.executable, [sys.executable] + sys.argv, env)
        except OSError:
            pass
    # UNA sola presencia a la vez: si ya hay un personajito vivo, esta copia se retira (así nunca se ven dos Hyros,
    # aunque se lance el demonio dos veces). El bloqueo lo suelta el sistema solo cuando el proceso termina.
    import fcntl
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "claude-presence.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    run_daemon._lock = lock
    import threading

    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import GLib, Gtk, Gtk4LayerShell as LS
    import cairo

    BOX_W, BOX_H = 440, 270          # tamaño de la ventanita
    FEET = (360, 250)                # dónde pisa el personajito dentro de la ventanita
    BUBBLE_SECONDS = 8.0             # el globo se esconde solo pasado este tiempo sin novedades

    app = Gtk.Application(application_id="local.hyprarch.claudepresence")
    S = {"x": 0.0, "y": 0.0, "tx": 0.0, "ty": 0.0, "facing": 1, "look": (0.0, 0.0), "t0": time.time(),
         "raw": read_state(), "state": "idle", "text": "", "bubble": 0.0, "mtime": 0.0,
         "lx": FEET[0], "ly": FEET[1], "ml": -1, "mt": -1, "n": 0, "follow": False,
         "pal": load_palette(), "palsig": palette_signature(), "hover": False, "rgn": None, "vis": 1.0}
    # Resultados de hyprctl: los consulta un hilo aparte para no bloquear nunca el dibujo.
    H = {"cur": None, "mon": {"org": (0, 0), "size": (1280, 800)}}
    debug = bool(os.environ.get("CLAUDE_PRESENCE_DEBUG"))

    def poller():
        last_mon = 0.0
        while True:
            now = time.time()
            if S["follow"]:
                cur = hypr_json("cursorpos")
                if isinstance(cur, dict):
                    H["cur"] = cur
            else:
                H["cur"] = None
            if now - last_mon > 1.0:
                last_mon = now
                mons = hypr_json("monitors")
                if isinstance(mons, list) and mons:
                    m = next((x for x in mons if x.get("focused")), mons[0])
                    sc = float(m.get("scale") or 1.0) or 1.0
                    H["mon"] = {"org": (float(m.get("x", 0)), float(m.get("y", 0))),
                                "size": (float(m.get("width", 1280)) / sc, float(m.get("height", 800)) / sc),
                                "name": m.get("name")}
            time.sleep(0.16)

    threading.Thread(target=poller, daemon=True).start()

    def on_activate(app):
        win = Gtk.ApplicationWindow(application=app)
        win.set_decorated(False)
        win.set_default_size(BOX_W, BOX_H)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_anchor(win, LS.Edge.TOP, True)
        LS.set_anchor(win, LS.Edge.LEFT, True)
        LS.set_margin(win, LS.Edge.TOP, 0)
        LS.set_margin(win, LS.Edge.LEFT, 0)
        LS.set_exclusive_zone(win, -1)
        LS.set_namespace(win, "claude-presence")
        LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
        area = Gtk.DrawingArea()
        area.set_content_width(BOX_W)
        area.set_content_height(BOX_H)
        win.set_child(area)

        css = Gtk.CssProvider()
        css.load_from_data(b"window, window.background { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(win.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def draw(_a, cr, w, h):
            try:
                t = time.time() - S["t0"]
                cr.set_operator(cairo.OPERATOR_CLEAR)
                cr.paint()
                cr.set_operator(cairo.OPERATOR_OVER)
                if S["vis"] < 0.01:          # un menú a pantalla completa trae su propio personajito: solo puede haber uno
                    return
                cr.push_group()
                draw_mascot(cr, S["lx"], S["ly"], S["state"], t, S["pal"], look=S["look"], scale=1.0, facing=S["facing"])
                # el globo se abre hacia el lado con más sitio y nunca más ancho que la ventanita
                bx = S["lx"] + 8
                side = "right" if bx < w / 2 else "left"
                room = (w - bx + 34) if side == "right" else (bx + 34)
                draw_bubble(cr, bx, S["ly"] - 100, S["text"], S["pal"], alpha=S["bubble"], side=side,
                            max_w=max(120, min(360, room - 2)))
                cr.pop_group_to_source()
                cr.paint_with_alpha(S["vis"])
            except Exception as e:           # un error de dibujo no debe matar el overlay
                if debug:
                    print("error de dibujo:", repr(e), flush=True)

        area.set_draw_func(draw)

        def clamp(p, size):
            w, h = size
            # arriba hace falta sitio para el globo (~148 px) y la antena
            return (max(40.0, min(w - 40.0, p[0])), max(170.0, min(h - 16.0, p[1])))

        # --- clics: solo el cuerpo del personajito recibe el mouse; el resto de la ventanita es transparente al clic
        def set_hit_region(force=False):
            surf = win.get_surface()
            if not surf:
                return
            x = int(max(0, S["lx"] - 42))
            y = int(max(0, S["ly"] - 96))
            key = (x // 3, y // 3, S["vis"] < 0.05)
            if not force and key == S["rgn"]:
                return
            S["rgn"] = key
            if S["vis"] < 0.05:                 # oculto: nada recibe clics
                surf.set_input_region(cairo.Region())
                return
            r = cairo.RectangleInt(x, y, 84, 104)
            surf.set_input_region(cairo.Region(r))

        menu = {"p": None}

        def open_menu():
            """Abre el menú animado (hyprarch-menu) junto al personajito. Hereda el entorno: necesita layer-shell."""
            p = menu["p"]
            if p is not None and p.poll() is None:          # ya está abierto: se cierra
                p.terminate()
                menu["p"] = None
                return
            try:
                menu["p"] = subprocess.Popen(["hyprarch-menu", "--anchor", f"{S['x']:.0f},{S['y']:.0f}"], start_new_session=True,
                                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                if debug:
                    print("no se pudo abrir el menú:", repr(e), flush=True)

        # clic = chat flotante · doble clic = pantalla completa · clic derecho = el menú del sistema
        pending = {"id": 0}

        def open_chat(mode):
            try:
                # el chat sale encima del personajito: se le pasa dónde está ahora
                env = dict(os.environ, HYPRARCH_ANCHOR=f"{max(0, S['x']):.0f},{max(0, S['y']):.0f}")
                subprocess.Popen(["hyprarch-ai", "open", mode], start_new_session=True, env=env,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                if debug:
                    print("no se pudo abrir el chat:", repr(e), flush=True)

        def left_released(_g, n_press, _x, _y):
            if pending["id"]:                       # un clic previo esperaba a ver si venía otro
                GLib.source_remove(pending["id"])
                pending["id"] = 0
            if n_press >= 2:
                open_chat("full")
                return

            def single():
                pending["id"] = 0
                open_chat("float")
                return False
            pending["id"] = GLib.timeout_add(280, single)

        click = Gtk.GestureClick()
        click.set_button(1)
        click.connect("released", left_released)
        area.add_controller(click)
        rclick = Gtk.GestureClick()
        rclick.set_button(3)
        rclick.connect("released", lambda *_: open_menu())
        area.add_controller(rclick)
        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_: S.update(hover=True))
        motion.connect("leave", lambda *_: S.update(hover=False))
        area.add_controller(motion)

        def tick():
            try:
                now = time.time()
                # --- ¿hay un menú a pantalla completa con su propio personajito? entonces este se desvanece (y vuelve al cerrar)
                # con la isla activa (~/.config/hyprarch/island), Hyro vive arriba y el de la esquina se esconde
                if now - S.get("island_t", 0) > 2.0:
                    S["island_t"] = now
                    S["island"] = os.path.exists(os.path.join(os.path.expanduser("~"), ".config", "hyprarch", "island"))
                S["vis"] += ((0.0 if (overlay_active() or S.get("island")) else 1.0) - S["vis"]) * 0.35
                if S["vis"] > 0.995:
                    S["vis"] = 1.0
                # --- estado (archivo) -------------------------------------------------
                try:
                    m = STATE_FILE.stat().st_mtime
                except OSError:
                    m = 0.0
                if m != S["mtime"]:
                    S["mtime"] = m
                    S["raw"] = read_state()
                    if debug:
                        print("estado ->", S["raw"]["state"], repr(S["raw"]["text"]), flush=True)
                raw = S["raw"]
                eff = effective_state(raw)
                S["state"] = eff
                S["text"] = raw["text"] if eff == raw["state"] else ""
                S["follow"] = bool(raw["follow"]) and eff in ("working", "thinking")

                # --- tema: si cambia la paleta, se recarga sin reiniciar -----------------
                if S["n"] % 30 == 0:
                    sig = palette_signature()
                    if sig != S["palsig"]:
                        S["palsig"], S["pal"] = sig, load_palette()

                # --- monitor: la ventanita debe estar en el mismo que se usa para los cálculos ---
                mon = H["mon"]
                if S["n"] % 30 == 0 and mon.get("name"):
                    try:
                        mons = win.get_display().get_monitors()
                        for i in range(mons.get_n_items()):
                            gm = mons.get_item(i)
                            if gm.get_connector() == mon["name"]:
                                if LS.get_monitor(win) != gm:
                                    LS.set_monitor(win, gm)
                                break
                    except Exception as e:
                        if debug:
                            print("no se pudo fijar el monitor:", repr(e), flush=True)

                # --- hacia dónde ir ------------------------------------------------------
                size, org = mon["size"], mon["org"]
                rest = (size[0] - 90, size[1] - 24)
                target = rest
                cur = H["cur"]
                if S["follow"] and cur:
                    # el cursor de hyprctl es global: se pasa a coordenadas del monitor activo
                    target = clamp((float(cur.get("x", 0)) - org[0] - 60, float(cur.get("y", 0)) - org[1] + 70), size)
                S["tx"], S["ty"] = target
                if S["x"] == 0 and S["y"] == 0:
                    S["x"], S["y"] = S["tx"], S["ty"]
                dx, dy = S["tx"] - S["x"], S["ty"] - S["y"]
                S["x"] += dx * 0.12
                S["y"] += dy * 0.12
                if abs(dx) > 6:
                    S["facing"] = 1 if dx > 0 else -1
                S["look"] = (max(-1, min(1, dx / 120)), max(-1, min(1, dy / 120)))

                # --- globo: aparece con cada novedad y se esconde solo --------------------
                fresh = (now - raw["ts"]) < BUBBLE_SECONDS
                want = 1.0 if (S["text"] and eff != "idle" and fresh) else 0.0
                if S["hover"] and not want:
                    S["text"], want = "Clic: ¿qué hacemos?", 1.0
                S["bubble"] += (want - S["bubble"]) * 0.2

                # --- la ventanita sigue al personajito con márgenes de layer-shell ---------
                ml = int(max(0, min(S["x"] - FEET[0], size[0] - BOX_W)))
                mt = int(max(0, min(S["y"] - FEET[1], size[1] - BOX_H)))
                if ml != S["ml"]:
                    LS.set_margin(win, LS.Edge.LEFT, ml)
                    S["ml"] = ml
                if mt != S["mt"]:
                    LS.set_margin(win, LS.Edge.TOP, mt)
                    S["mt"] = mt
                S["lx"], S["ly"] = S["x"] - ml, S["y"] - mt
                set_hit_region()

                # dónde está ahora (para que las ventanas que salen de él, como las aprobaciones, aparezcan encima);
                # solo se escribe si se movió más de ~6 px y como mucho dos veces por segundo
                if now - S.get("pos_t", 0) > 0.5 and (abs(S["x"] - S.get("pos_x", -99)) > 6 or abs(S["y"] - S.get("pos_y", -99)) > 6):
                    S["pos_t"], S["pos_x"], S["pos_y"] = now, S["x"], S["y"]
                    try:
                        pf = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "claude-presence.pos")
                        with open(pf + ".tmp", "w") as fh:
                            fh.write("%d,%d\n" % (S["x"], S["y"]))
                        os.replace(pf + ".tmp", pf)
                    except OSError:
                        pass

                S["n"] += 1
                if debug and S["n"] % 30 == 0:
                    print("tick", S["n"], eff, "pos=(%.0f,%.0f)" % (S["x"], S["y"]), "margenes=(%d,%d)" % (ml, mt), flush=True)
                # ahorro de CPU (equipos modestos): a pleno ritmo solo cuando hay algo que mostrar; en reposo ~15 cuadros/s
                # (el vaivén sigue suave) y escondido casi nada
                busy = (S["state"] != "idle" or S["bubble"] > 0.02 or S["hover"] or abs(dx) > 0.5 or abs(dy) > 0.5
                        or S["vis"] < 0.995)
                every = 1 if busy else 2
                if S["vis"] < 0.01:
                    every = 30
                if S["n"] % every == 0:
                    area.queue_draw()
            except Exception as e:
                # nunca devolver una excepción: GLib quitaría el temporizador y el overlay quedaría congelado
                if debug:
                    print("error en tick:", repr(e), flush=True)
            return True

        GLib.timeout_add(33, tick)
        win.present()

        # fuera del personajito los clics atraviesan la ventanita (región vacía hasta que se sepa dónde está)
        def pass_clicks(*_):
            surf = win.get_surface()
            if surf:
                surf.set_input_region(cairo.Region())
                S["rgn"] = None
        win.connect("realize", pass_clicks)
        pass_clicks()

    app.connect("activate", on_activate)
    app.run(None)


# ----------------------------------------------------------------------------- CLI


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "set":
        st = argv[2] if len(argv) > 2 else "idle"
        # --seguir: el personajito acompaña al cursor (para cuando Claude maneja el mouse de verdad)
        text = " ".join(a for a in argv[3:] if a != "--seguir")
        write_state(st if st in STATES else "idle", text, follow=("--seguir" in argv))
    elif cmd == "tool":
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except Exception:
            payload = {}
        write_state("working", describe_tool(payload))
    elif cmd == "status":
        cmd_status()
    elif cmd == "daemon":
        run_daemon()
    elif cmd == "render-sheet":
        render_sheet(argv[2] if len(argv) > 2 else "sheet.png")
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        pass
