#!/usr/bin/env python3
"""claude-presence — la presencia de Claude en el escritorio (personajito "Claudito").

Uso:
  claude-presence daemon                 superposición animada en pantalla (Wayland, GTK4 + layer-shell)
  claude-presence set <estado> [texto]   estados: idle thinking working done error waiting
  claude-presence tool                   lee por stdin el JSON de un hook de Claude Code (PreToolUse)
  claude-presence status                 JSON para el módulo de Waybar (custom/claude)
  claude-presence render-sheet <png>     (desarrollo) dibuja todos los estados en una imagen

El estado vive en  ~/.cache/claude-presence/state.json . Quien quiera mover al
personajito solo tiene que escribir ahí (los hooks de Claude Code lo hacen solos).
"""
import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

STATE_FILE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "claude-presence" / "state.json"
STATES = ("idle", "thinking", "working", "done", "error", "waiting")
ICONS = {"idle": "", "thinking": "", "working": "", "done": "", "error": "", "waiting": ""}

# ----------------------------------------------------------------------------- estado


MAX_TEXT = 200          # el texto del globo se limita al recibirlo
EXPIRE = {"done": 8.0, "error": 8.0, "working": 300.0, "thinking": 300.0, "waiting": 300.0}


def _num(v):
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return False
    try:
        return math.isfinite(v)
    except OverflowError:       # un entero enorme no se puede convertir a float
        return False


def read_state():
    """Lee el estado y lo NORMALIZA: ante cualquier valor raro devuelve el estado seguro (idle)."""
    safe = {"state": "idle", "text": "", "ts": 0.0, "follow": False}
    try:
        s = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return safe
    if not isinstance(s, dict) or s.get("state") not in STATES:
        return safe
    text = s.get("text")
    ts = s.get("ts")
    return {"state": s["state"], "text": text[:MAX_TEXT] if isinstance(text, str) else "",
            "ts": float(ts) if _num(ts) else 0.0, "follow": s.get("follow") is True}


def effective_state(s):
    """Estado que realmente se muestra: lo que lleva mucho tiempo sin actualizarse vuelve a reposo.
    Lo usan tanto el daemon como Waybar, para que nunca se contradigan."""
    st, age = s["state"], time.time() - s["ts"]
    return "idle" if age > EXPIRE.get(st, 1e9) else st


def write_state(state, text="", **extra):
    """Escritura atómica con un temporal exclusivo por proceso (varios hooks pueden escribir a la vez)."""
    import tempfile

    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    data = {"state": state, "text": str(text)[:MAX_TEXT], "ts": time.time(), **extra}
    fd, tmp = tempfile.mkstemp(dir=STATE_FILE.parent, prefix=".state-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, STATE_FILE)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def describe_tool(payload):
    """Convierte el JSON de un hook de Claude Code en una frase corta en español."""
    payload = payload if isinstance(payload, dict) else {}
    tool = payload.get("tool_name", "") or ""
    inp = payload.get("tool_input")
    inp = inp if isinstance(inp, dict) else {}
    short = lambda s, n=46: (s if len(s) <= n else s[: n - 1] + "…")
    base = lambda p: os.path.basename(str(p).replace("\\", "/"))
    if tool in ("Bash", "PowerShell"):
        lines = str(inp.get("command") or "").strip().splitlines()
        return f"Ejecutando: {short(lines[0] if lines else '')}"
    if tool in ("Edit", "Write", "NotebookEdit"):
        return f"Editando {short(base(inp.get('file_path', '')))}"
    if tool == "Read":
        return f"Leyendo {short(base(inp.get('file_path', '')))}"
    if tool in ("Grep", "Glob"):
        return f"Buscando {short(str(inp.get('pattern', '')))}"
    if tool in ("WebSearch", "WebFetch"):
        return f"Buscando en la web: {short(str(inp.get('query', inp.get('url', ''))))}"
    if tool == "Agent":
        return "Delegando en un subagente"
    return f"Usando {tool}" if tool else "Trabajando"


# ----------------------------------------------------------------------------- paleta


def load_palette():
    """Lee los colores del tema activo (verde/rojo/personalizado)."""
    pal = dict(ACCENT="39ff14", ACCENT2="ff1f4b", OK="39ff14", ALERT="ff1f4b", BG="0a0c0b", SURFACE="111513", FG="d7ffe3", DIM="5f7367")
    try:
        cur = (Path.home() / ".config/hyprarch/current").read_text().strip() or "verde"
        f = Path.home() / ".config/hyprarch/custom.env" if cur == "custom" else Path(f"/usr/share/hyprarch/themes/{cur}.env")
        for line in f.read_text().splitlines():
            m = re.match(r'^([A-Z0-9_]+)=("?)([^"#]*)\2', line.strip())
            if m:
                pal[m.group(1)] = m.group(3).strip()
    except Exception:
        pass
    # Solo se aceptan colores de 6 dígitos hexadecimales; cualquier otro valor conserva el color por defecto.
    default = dict(ACCENT="39ff14", ACCENT2="ff1f4b", OK="39ff14", ALERT="ff1f4b", BG="0a0c0b", SURFACE="111513", FG="d7ffe3", DIM="5f7367")
    out = {}
    for k, d in default.items():
        v = str(pal.get(k, d)).strip().lstrip("#")
        v = v if re.fullmatch(r"[0-9a-fA-F]{6}", v) else d
        out[k] = tuple(int(v[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return out


# ----------------------------------------------------------------------------- dibujo (Cairo)


def rrect(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def shade(c, k):
    return tuple(max(0.0, min(1.0, v * k)) for v in c)


def draw_mascot(cr, x, y, state, t, pal, look=(0.0, 0.0), scale=1.0, facing=1):
    """Dibuja a Claudito con el centro de los pies en (x, y). t = segundos."""
    import cairo

    A, A2, OK, AL = pal["ACCENT"], pal["ACCENT2"], pal["OK"], pal["ALERT"]
    bob = {"idle": math.sin(t * 2.0) * 2.0, "thinking": math.sin(t * 3.0) * 3.0, "working": math.sin(t * 9.0) * 1.6,
           "done": -abs(math.sin(t * 5.0)) * 10.0, "error": 0.0, "waiting": math.sin(t * 4.0) * 2.5}[state]
    shake = math.sin(t * 40) * 3.0 if state == "error" else 0.0
    cr.save()
    cr.translate(x + shake, y)
    cr.scale(scale * facing, scale)
    # leve inclinación en el sentido del movimiento (flota, no camina)
    cr.translate(0, -50)
    cr.rotate(max(-1.0, min(1.0, look[0])) * 0.10 * facing)
    cr.translate(0, 50)

    # sombra en el "suelo": más chica y tenue cuanto más alto flota
    cr.save()
    cr.scale(1, 0.26)
    cr.arc(0, 0, 30 + bob * 0.5, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgba(0, 0, 0, 0.30)
    cr.fill()

    # cuerpo (flotando ~20 px sobre el suelo)
    by = -80 + bob * 1.6

    # propulsor: resplandor y chispas debajo del cuerpo
    pulse_h = 0.5 + 0.5 * math.sin(t * 7.0)
    hy = by + 60
    cr.save()
    cr.translate(0, hy)
    cr.scale(1, 0.5)
    rg_h = cairo.RadialGradient(0, 0, 1, 0, 0, 26 + 5 * pulse_h)
    rg_h.add_color_stop_rgba(0, *shade(A, 1.1), 0.85)
    rg_h.add_color_stop_rgba(1, *A, 0.0)
    cr.set_source(rg_h)
    cr.arc(0, 0, 28 + 5 * pulse_h, 0, 2 * math.pi)
    cr.fill()
    cr.restore()
    for i in range(3):
        ph = (t * 1.6 + i / 3.0) % 1.0
        cr.arc((i - 1) * 9 + math.sin(t * 5 + i) * 2, hy + 4 + ph * 22, 2.4 * (1 - ph), 0, 2 * math.pi)
        cr.set_source_rgba(*A, 0.8 * (1 - ph))
        cr.fill()
    body = {"error": AL, "done": OK}.get(state, A)
    grad = cairo.LinearGradient(0, by, 0, by + 56)
    grad.add_color_stop_rgb(0, *shade(body, 1.18))
    grad.add_color_stop_rgb(1, *shade(body, 0.72))
    rrect(cr, -32, by, 64, 56, 20)
    cr.set_source(grad)
    cr.fill_preserve()
    cr.set_source_rgba(0, 0, 0, 0.55)
    cr.set_line_width(2.4)
    cr.stroke()
    # brillo
    rrect(cr, -24, by + 5, 30, 8, 4)
    cr.set_source_rgba(1, 1, 1, 0.30)
    cr.fill()

    # pantalla/cara oscura
    rrect(cr, -25, by + 12, 50, 32, 12)
    cr.set_source_rgba(0.03, 0.04, 0.04, 0.92)
    cr.fill()

    # ojos
    blink = 0.12 if (t % 4.0) < 0.12 else 1.0
    lx, ly = look
    for ex in (-11, 11):
        eh = (13 if state != "done" else 5) * blink
        cr.save()
        cr.translate(ex, by + 27)
        cr.scale(1, max(eh / 13, 0.12))
        cr.arc(0, 0, 6.2, 0, 2 * math.pi)
        cr.restore()
        glow = {"error": AL, "done": OK}.get(state, A)
        cr.set_source_rgb(*glow)
        cr.fill()
        if state not in ("done",) and blink > 0.5:
            cr.arc(ex + lx * 2.2, by + 27 + ly * 2.2, 2.0, 0, 2 * math.pi)
            cr.set_source_rgb(0.02, 0.03, 0.03)
            cr.fill()

    # boca
    cr.set_line_width(2.4)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_source_rgb(*shade(body, 1.1))
    my = by + 38
    if state == "done":
        cr.arc(0, my - 4, 7, 0.15 * math.pi, 0.85 * math.pi)
    elif state == "error":
        cr.move_to(-6, my + 1)
        for i in range(1, 5):
            cr.line_to(-6 + i * 3, my + (-1 if i % 2 else 1))
    elif state == "waiting":
        cr.arc(0, my, 2.6, 0, 2 * math.pi)
    elif state == "thinking":
        cr.move_to(-4, my)
        cr.line_to(4, my)
    else:
        cr.arc(0, my - 3, 5, 0.2 * math.pi, 0.8 * math.pi)
    cr.stroke()

    # antena
    ax = math.sin(t * 2.5) * 2
    cr.set_source_rgb(*shade(A, 0.55))
    cr.set_line_width(3)
    cr.move_to(0, by)
    cr.curve_to(ax, by - 8, ax * 1.5, by - 12, ax * 2, by - 16)
    cr.stroke()
    pulse = 0.5 + 0.5 * math.sin(t * {"idle": 2, "thinking": 6, "working": 10, "done": 4, "error": 14, "waiting": 5}[state])
    tip = {"error": AL, "done": OK, "thinking": A2}.get(state, A)
    rg = cairo.RadialGradient(ax * 2, by - 18, 1, ax * 2, by - 18, 12 + 6 * pulse)
    rg.add_color_stop_rgba(0, *tip, 0.95)
    rg.add_color_stop_rgba(1, *tip, 0.0)
    cr.set_source(rg)
    cr.arc(ax * 2, by - 18, 14 + 6 * pulse, 0, 2 * math.pi)
    cr.fill()
    cr.arc(ax * 2, by - 18, 4.2, 0, 2 * math.pi)
    cr.set_source_rgb(*shade(tip, 1.2))
    cr.fill()

    # portátil cuando trabaja / piensa
    if state in ("working", "thinking"):
        # portátil flotando delante de la parte baja del cuerpo (no tapa la cara)
        rrect(cr, -21, by + 60, 42, 5, 2)
        cr.set_source_rgb(*shade(A, 0.4))
        cr.fill()
        rrect(cr, -15, by + 45, 30, 15, 3)
        cr.set_source_rgba(0.02, 0.05, 0.03, 0.97)
        cr.fill_preserve()
        cr.set_source_rgb(*A)
        cr.set_line_width(1.4)
        cr.stroke()
        for i in range(3):
            w = 6 + ((int(t * 6) + i * 3) % 4) * 4
            cr.move_to(-11, by + 49 + i * 4)
            cr.line_to(-11 + w, by + 49 + i * 4)
            cr.set_source_rgba(*A, 0.9)
            cr.set_line_width(1.6)
            cr.stroke()

    # símbolos flotantes por estado
    cr.set_font_size(20)
    if state == "thinking":
        for i in range(3):
            a = 0.25 + 0.75 * max(0.0, math.sin(t * 5 - i * 0.9))
            cr.arc(-14 + i * 14, by - 36 - math.sin(t * 5 - i * 0.9) * 3, 3.6, 0, 2 * math.pi)
            cr.set_source_rgba(*A2, a)
            cr.fill()
    elif state == "waiting":
        cr.select_font_face("monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_source_rgba(*A2, 0.55 + 0.45 * math.sin(t * 6))
        cr.move_to(26, by - 6)
        cr.show_text("?")
    elif state == "error":
        cr.select_font_face("monospace", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_source_rgb(*AL)
        cr.move_to(26, by - 4)
        cr.show_text("!")
    elif state == "done":
        for i in range(6):
            ang = t * 3 + i * math.pi / 3
            r = 40 + 6 * math.sin(t * 6 + i)
            px, py = math.cos(ang) * r, by + 14 + math.sin(ang) * r * 0.7
            cr.arc(px, py, 2.6, 0, 2 * math.pi)
            cr.set_source_rgba(*(OK if i % 2 else A2), 0.9)
            cr.fill()
    cr.restore()


_FIT_CACHE = {}


def _fit_text(cr, text, avail):
    """Recorta con '…' por búsqueda binaria (no carácter a carácter) y recuerda el resultado."""
    key = (text, int(avail))
    hit = _FIT_CACHE.get(key)
    if hit:
        return hit
    width = cr.text_extents(text).x_advance
    if width <= avail:
        res = (text, width)
    else:
        lo, hi = 1, len(text)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if cr.text_extents(text[:mid] + "…").x_advance <= avail:
                lo = mid
            else:
                hi = mid - 1
        cut = text[:lo] + "…"
        res = (cut, cr.text_extents(cut).x_advance)
    if len(_FIT_CACHE) > 64:
        _FIT_CACHE.clear()
    _FIT_CACHE[key] = res
    return res


def draw_bubble(cr, x, y, text, pal, alpha=1.0, max_w=360, side="left"):
    """Globo de texto con la cola apuntando hacia (x, y) (arriba del personajito)."""
    import cairo

    if not text or alpha <= 0.01:
        return
    cr.save()
    cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(14)
    text, tw = _fit_text(cr, text[:MAX_TEXT], max_w - 28)
    w = min(tw + 28, max_w)
    h = 34
    bx, by = (x - w + 34 if side == "left" else x - 34), y - h - 14
    A, BG, FG = pal["ACCENT"], pal["BG"], pal["FG"]
    rrect(cr, bx, by, w, h, 12)
    cr.set_source_rgba(*BG, 0.94 * alpha)
    cr.fill_preserve()
    cr.set_source_rgba(*A, alpha)
    cr.set_line_width(2)
    cr.stroke()
    cr.move_to(x - 4, by + h - 1)
    cr.line_to(x + 8, by + h + 12)
    cr.line_to(x + 16, by + h - 1)
    cr.set_source_rgba(*BG, 0.94 * alpha)
    cr.fill_preserve()
    cr.set_source_rgba(*A, alpha)
    cr.stroke()
    cr.set_source_rgba(*FG, alpha)
    cr.move_to(bx + 14, by + 22)
    cr.show_text(text)
    cr.restore()


def render_sheet(out):
    import cairo

    pal = load_palette()
    names = list(STATES)
    cell_w, cell_h = 230, 230
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, cell_w * len(names), cell_h)
    cr = cairo.Context(surf)
    cr.set_source_rgb(0.04, 0.06, 0.05)
    cr.paint()
    texts = {"idle": "", "thinking": "Pensando…", "working": "Editando hyprland.lua", "done": "¡Listo!", "error": "Algo falló", "waiting": "¿Seguimos?"}
    for i, st in enumerate(names):
        x = i * cell_w + cell_w / 2
        draw_mascot(cr, x, 190, st, 1.37, pal, look=(0.6, 0.2), scale=1.15)
        draw_bubble(cr, x + 10, 78, texts[st], pal)
        cr.set_source_rgb(*pal["DIM"])
        cr.select_font_face("monospace")
        cr.set_font_size(12)
        cr.move_to(i * cell_w + 10, 18)
        cr.show_text(st)
    surf.write_to_png(out)
    print(out)


# ----------------------------------------------------------------------------- Waybar


def cmd_status():
    s = read_state()
    st = effective_state(s)
    text = (s.get("text") if st == s["state"] else "") or {"idle": "Claude en reposo", "done": "Listo", "error": "Error"}.get(st, "")
    print(json.dumps({"text": f"{ICONS[st]} Claude", "class": st, "tooltip": text}, ensure_ascii=False))


# ----------------------------------------------------------------------------- superposición (GTK4 + layer-shell)


def hypr_json(*args):
    try:
        out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=1).stdout
        return json.loads(out)
    except Exception:
        return None


def palette_files():
    """Archivos que definen la paleta activa (para detectar cambios de tema)."""
    home = Path.home()
    files = [home / ".config/hyprarch/current"]
    try:
        cur = files[0].read_text().strip() or "verde"
    except Exception:
        cur = "verde"
    files.append(home / ".config/hyprarch/custom.env" if cur == "custom" else Path(f"/usr/share/hyprarch/themes/{cur}.env"))
    return files


def palette_signature():
    sig = []
    for f in palette_files():
        try:
            sig.append(f.stat().st_mtime)
        except OSError:
            sig.append(0.0)
    return tuple(sig)


def run_daemon():
    """Superposición liviana: una ventanita (440x270) que se desplaza con los márgenes de layer-shell."""
    import threading

    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import GLib, Gtk, Gtk4LayerShell as LS
    import cairo

    BOX_W, BOX_H = 440, 270          # tamaño de la ventanita
    FEET = (360, 250)                # dónde pisa el personajito dentro de la ventanita
    BUBBLE_SECONDS = 8.0             # el globo se esconde solo pasado este tiempo sin novedades

    app = Gtk.Application(application_id="local.hyprarch.claudepresence")
    S = {"x": 0.0, "y": 0.0, "tx": 0.0, "ty": 0.0, "facing": 1, "look": (0.0, 0.0), "t0": time.time(),
         "raw": read_state(), "state": "idle", "text": "", "bubble": 0.0, "mtime": 0.0,
         "lx": FEET[0], "ly": FEET[1], "ml": -1, "mt": -1, "n": 0, "follow": False,
         "pal": load_palette(), "palsig": palette_signature()}
    # Resultados de hyprctl: los consulta un hilo aparte para no bloquear nunca el dibujo.
    H = {"cur": None, "mon": {"org": (0, 0), "size": (1280, 800)}}
    debug = bool(os.environ.get("CLAUDE_PRESENCE_DEBUG"))

    def poller():
        last_mon = 0.0
        while True:
            now = time.time()
            if S["follow"]:
                cur = hypr_json("cursorpos")
                if isinstance(cur, dict):
                    H["cur"] = cur
            else:
                H["cur"] = None
            if now - last_mon > 1.0:
                last_mon = now
                mons = hypr_json("monitors")
                if isinstance(mons, list) and mons:
                    m = next((x for x in mons if x.get("focused")), mons[0])
                    sc = float(m.get("scale") or 1.0) or 1.0
                    H["mon"] = {"org": (float(m.get("x", 0)), float(m.get("y", 0))),
                                "size": (float(m.get("width", 1280)) / sc, float(m.get("height", 800)) / sc),
                                "name": m.get("name")}
            time.sleep(0.16)

    threading.Thread(target=poller, daemon=True).start()

    def on_activate(app):
        win = Gtk.ApplicationWindow(application=app)
        win.set_decorated(False)
        win.set_default_size(BOX_W, BOX_H)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_anchor(win, LS.Edge.TOP, True)
        LS.set_anchor(win, LS.Edge.LEFT, True)
        LS.set_margin(win, LS.Edge.TOP, 0)
        LS.set_margin(win, LS.Edge.LEFT, 0)
        LS.set_exclusive_zone(win, -1)
        LS.set_namespace(win, "claude-presence")
        LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
        area = Gtk.DrawingArea()
        area.set_content_width(BOX_W)
        area.set_content_height(BOX_H)
        win.set_child(area)

        css = Gtk.CssProvider()
        css.load_from_data(b"window, window.background { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(win.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def draw(_a, cr, w, h):
            try:
                t = time.time() - S["t0"]
                cr.set_operator(cairo.OPERATOR_CLEAR)
                cr.paint()
                cr.set_operator(cairo.OPERATOR_OVER)
                draw_mascot(cr, S["lx"], S["ly"], S["state"], t, S["pal"], look=S["look"], scale=1.0, facing=S["facing"])
                # el globo se abre hacia el lado con más sitio y nunca más ancho que la ventanita
                bx = S["lx"] + 8
                side = "right" if bx < w / 2 else "left"
                room = (w - bx + 34) if side == "right" else (bx + 34)
                draw_bubble(cr, bx, S["ly"] - 100, S["text"], S["pal"], alpha=S["bubble"], side=side,
                            max_w=max(120, min(360, room - 2)))
            except Exception as e:           # un error de dibujo no debe matar el overlay
                if debug:
                    print("error de dibujo:", repr(e), flush=True)

        area.set_draw_func(draw)

        def clamp(p, size):
            w, h = size
            # arriba hace falta sitio para el globo (~148 px) y la antena
            return (max(40.0, min(w - 40.0, p[0])), max(170.0, min(h - 16.0, p[1])))

        def tick():
            try:
                now = time.time()
                # --- estado (archivo) -------------------------------------------------
                try:
                    m = STATE_FILE.stat().st_mtime
                except OSError:
                    m = 0.0
                if m != S["mtime"]:
                    S["mtime"] = m
                    S["raw"] = read_state()
                    if debug:
                        print("estado ->", S["raw"]["state"], repr(S["raw"]["text"]), flush=True)
                raw = S["raw"]
                eff = effective_state(raw)
                S["state"] = eff
                S["text"] = raw["text"] if eff == raw["state"] else ""
                S["follow"] = bool(raw["follow"]) and eff in ("working", "thinking")

                # --- tema: si cambia la paleta, se recarga sin reiniciar -----------------
                if S["n"] % 30 == 0:
                    sig = palette_signature()
                    if sig != S["palsig"]:
                        S["palsig"], S["pal"] = sig, load_palette()

                # --- monitor: la ventanita debe estar en el mismo que se usa para los cálculos ---
                mon = H["mon"]
                if S["n"] % 30 == 0 and mon.get("name"):
                    try:
                        mons = win.get_display().get_monitors()
                        for i in range(mons.get_n_items()):
                            gm = mons.get_item(i)
                            if gm.get_connector() == mon["name"]:
                                if LS.get_monitor(win) != gm:
                                    LS.set_monitor(win, gm)
                                break
                    except Exception as e:
                        if debug:
                            print("no se pudo fijar el monitor:", repr(e), flush=True)

                # --- hacia dónde ir ------------------------------------------------------
                size, org = mon["size"], mon["org"]
                rest = (size[0] - 90, size[1] - 24)
                target = rest
                cur = H["cur"]
                if S["follow"] and cur:
                    # el cursor de hyprctl es global: se pasa a coordenadas del monitor activo
                    target = clamp((float(cur.get("x", 0)) - org[0] - 60, float(cur.get("y", 0)) - org[1] + 70), size)
                S["tx"], S["ty"] = target
                if S["x"] == 0 and S["y"] == 0:
                    S["x"], S["y"] = S["tx"], S["ty"]
                dx, dy = S["tx"] - S["x"], S["ty"] - S["y"]
                S["x"] += dx * 0.12
                S["y"] += dy * 0.12
                if abs(dx) > 6:
                    S["facing"] = 1 if dx > 0 else -1
                S["look"] = (max(-1, min(1, dx / 120)), max(-1, min(1, dy / 120)))

                # --- globo: aparece con cada novedad y se esconde solo --------------------
                fresh = (now - raw["ts"]) < BUBBLE_SECONDS
                want = 1.0 if (S["text"] and eff != "idle" and fresh) else 0.0
                S["bubble"] += (want - S["bubble"]) * 0.2

                # --- la ventanita sigue al personajito con márgenes de layer-shell ---------
                ml = int(max(0, min(S["x"] - FEET[0], size[0] - BOX_W)))
                mt = int(max(0, min(S["y"] - FEET[1], size[1] - BOX_H)))
                if ml != S["ml"]:
                    LS.set_margin(win, LS.Edge.LEFT, ml)
                    S["ml"] = ml
                if mt != S["mt"]:
                    LS.set_margin(win, LS.Edge.TOP, mt)
                    S["mt"] = mt
                S["lx"], S["ly"] = S["x"] - ml, S["y"] - mt

                S["n"] += 1
                if debug and S["n"] % 30 == 0:
                    print("tick", S["n"], eff, "pos=(%.0f,%.0f)" % (S["x"], S["y"]), "margenes=(%d,%d)" % (ml, mt), flush=True)
                area.queue_draw()
            except Exception as e:
                # nunca devolver una excepción: GLib quitaría el temporizador y el overlay quedaría congelado
                if debug:
                    print("error en tick:", repr(e), flush=True)
            return True

        GLib.timeout_add(33, tick)
        win.present()

        # los clics atraviesan la ventanita
        def pass_clicks(*_):
            surf = win.get_surface()
            if surf:
                surf.set_input_region(cairo.Region())
        win.connect("realize", pass_clicks)
        pass_clicks()

    app.connect("activate", on_activate)
    app.run(None)


# ----------------------------------------------------------------------------- CLI


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "set":
        st = argv[2] if len(argv) > 2 else "idle"
        # --seguir: el personajito acompaña al cursor (para cuando Claude maneja el mouse de verdad)
        text = " ".join(a for a in argv[3:] if a != "--seguir")
        write_state(st if st in STATES else "idle", text, follow=("--seguir" in argv))
    elif cmd == "tool":
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except Exception:
            payload = {}
        write_state("working", describe_tool(payload))
    elif cmd == "status":
        cmd_status()
    elif cmd == "daemon":
        run_daemon()
    elif cmd == "render-sheet":
        render_sheet(argv[2] if len(argv) > 2 else "sheet.png")
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        pass
