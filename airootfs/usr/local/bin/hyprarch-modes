#!/usr/bin/env python3
"""hyprarch-modes — ventana para configurar los modos (gamer, cine, estudio, trabajo).

A la izquierda eliges el modo; a la derecha lo configuras: qué hace, su tema y su fondo, y las aplicaciones que se abren.
Todo se guarda con `hyprarch-mode` (la misma herramienta que usan los atajos y las IAs), así que lo que cambies aquí vale en todas partes.
"""
import os
import shlex
import shutil
import subprocess
import sys
import threading

os.environ.pop("LD_PRELOAD", None)       # ventana normal: no necesita layer-shell (y las apps que lance no deben heredarlo)
os.environ.setdefault("GSK_RENDERER", "cairo")

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

GLib.set_prgname("hyprarch-modes")       # la clase de la ventana (reglas de Hyprland)
GLib.set_application_name("Modos")

THEMES = "/usr/share/hyprarch/themes"
BACKS = "/usr/share/backgrounds"

MODES = {
    "gamer": ("Gamer", "#00e5ff", "Para jugar sin interrupciones",
              ["Máximo rendimiento del equipo (si lo permite)", "Sin avisos que te corten la partida",
               "No se bloquea ni se suspende la pantalla", "Menos efectos visuales para ir más fluido"]),
    "cine": ("Cine", "#ffb347", "Para ver películas y series",
             ["Sin avisos mientras ves algo", "No se bloquea ni se suspende la pantalla", "Ventanas sin bordes ni huecos, animaciones suaves"]),
    "estudio": ("Estudio", "#4fd1c5", "Para concentrarte",
                ["Sin avisos que te distraigan", "Te recuerda descansar 10 minutos cada 50", "Tema sereno y animaciones calmadas"]),
    "trabajo": ("Trabajo", "#5ec2ff", "Para el día a día de oficina",
                ["Consumo equilibrado", "Avisos activos", "Interfaz sobria y rápida"]),
}
ORDER = ["gamer", "cine", "estudio", "trabajo"]

CSS = """
