.pill { background: #123c33; color: #5ef2c8; border-radius: 9px; padding: 1px 8px; font-size: 11px; }
.warn-pill { background: #3a2c0c; color: #ffb347; border-radius: 9px; padding: 1px 8px; font-size: 11px; }
.title-big { font-size: 28px; font-weight: 700; }
