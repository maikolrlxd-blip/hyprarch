#!/usr/bin/env python3
"""hyprarch-pick — el selector VIVO de hyprarch (reemplaza a fuzzel/fzf/dmenu en TODO el sistema).

Lee ítems por la entrada estándar, uno por línea:   id<TAB>etiqueta<TAB>ícono<TAB>subtítulo
  · ícono: un glifo (Nerd Font) o la ruta a una imagen (.png/.svg); opcional
  · subtítulo: texto tenue; opcional
y escribe en la salida estándar el `id` elegido (código 0). Esc o clic en el vacío: cancela (código 1).

Tres presentaciones, ninguna es una lista dentro de un recuadro:
  --layout orbit     los botones flotan en órbita alrededor del personajito, que mira el mouse y reacciona (pocas opciones)
  --layout wheel     rueda curva en 3D con buscador: lo elegido queda grande al centro y el resto se curva y se desvanece
  --layout bubbles   campo de burbujas flotantes con efecto lupa y buscador (lanzador de aplicaciones)
Opciones: --title T  --placeholder T  --no-search  --select ID
Siempre vivo: partículas, respiración, imán hacia el mouse, ondas al hacer clic, sonidos suaves, y el estilo
(dinamico/3d/sutil/cyber/neumo) de ~/.config/hyprarch/style.
"""
import importlib.machinery
import importlib.util
import math
import os
import random
import sys
import time
import unicodedata
from pathlib import Path


def _load(name, modname):
    for base in ("/usr/local/bin", str(Path(__file__).resolve().parent)):
        p = Path(base) / name
        if p.exists():
            loader = importlib.machinery.SourceFileLoader(modname, str(p))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    return None


U = _load("hyprarch-menu", "hyprarch_menu_mod")
if U is None:
    raise SystemExit("hyprarch-pick: falta hyprarch-menu (comparten estilo y utilidades)")
BUDDY = _load("hyprarch-buddy", "buddy_mod") or _load("claude-presence", "buddy_mod")
clamp, spring, ease_out_strong, rrect, glow_rrect, draw_text, mix = (
    U.clamp, U.spring, U.ease_out_strong, U.rrect, U.glow_rrect, U.draw_text, U.mix)
DANGER = ("apagar", "reiniciar", "cerrar sesi", "salir", "suspender", "borrar", "eliminar")


def norm(s):
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if not unicodedata.combining(c))


def parse_items(text):
    items = []
    for line in text.splitlines():
        if not line.strip():
            continue
        f = line.split("\t")
        items.append(dict(id=f[0], label=(f[1] if len(f) > 1 and f[1] else f[0]), icon=(f[2] if len(f) > 2 else ""),
                          sub=(f[3] if len(f) > 3 else ""), mood=(f[4].strip() if len(f) > 4 else "")))
    return items


def filtered(items, q):
    toks = norm(q).split()
    if not toks:
        return list(range(len(items)))
    return [i for i, it in enumerate(items) if all(t in norm(it["label"] + " " + it["sub"] + " " + it["id"]) for t in toks)]


# ----------------------------------------------------------------------------- ícono / texto


_icons = {}


def ensure_env():
    """Los menús necesitan layer-shell precargado y render por Cairo: si falta, se relanza solo con el entorno correcto
    (así cualquier script puede llamar a hyprarch-pick sin preocuparse; stdin se conserva)."""
    if "gtk4-layer-shell" not in os.environ.get("LD_PRELOAD", ""):
        env = dict(os.environ)
        env["LD_PRELOAD"] = (env.get("LD_PRELOAD", "") + " /usr/lib/libgtk4-layer-shell.so").strip()
        env["GSK_RENDERER"] = "cairo"
        os.execvpe(sys.executable, [sys.executable] + sys.argv, env)


def draw_icon(cr, it, cx, cy, size, col, alpha, pal):
    ic = it["icon"]
    if len(ic) == 7 and ic[0] == "#" and all(c in "0123456789abcdefABCDEF" for c in ic[1:]):      # cuadrito de color (temas)
        sw = tuple(int(ic[i:i + 2], 16) / 255 for i in (1, 3, 5))
        cr.new_sub_path()
        cr.arc(cx, cy, size * 0.46, 0, 2 * math.pi)
        cr.set_source_rgba(*sw, alpha)
        cr.fill()
        cr.new_sub_path()
        cr.arc(cx, cy, size * 0.46, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.55 * alpha)
        cr.set_line_width(1.5)
        cr.stroke()
        return
    if ic.startswith("/"):
        pb = _icons.get((ic, int(size)), 0)
        if pb == 0:
            try:
                import gi

                gi.require_version("GdkPixbuf", "2.0")
                from gi.repository import GdkPixbuf

                pb = GdkPixbuf.Pixbuf.new_from_file_at_size(ic, int(size), int(size))
            except Exception:
                pb = None
            _icons[(ic, int(size))] = pb
        if pb is not None:
            try:
                import gi

                gi.require_version("Gdk", "4.0")
                from gi.repository import Gdk

                Gdk.cairo_set_source_pixbuf(cr, pb, cx - pb.get_width() / 2, cy - pb.get_height() / 2)
                cr.paint_with_alpha(alpha)
                return
            except Exception:
                pass
        ic = ""
    if ic:
        draw_text(cr, ic, cx, cy + size * 0.32, size * 0.82, col, alpha, center=True)
    else:
        cr.set_source_rgba(*mix(pal["SURFACE2"], pal["ACCENT"], 0.35), alpha * 0.9)
        if U.FRESH:                                   # fresco: cuadrado suave (como un ícono de app), no un círculo
            rrect(cr, cx - size * 0.48, cy - size * 0.48, size * 0.96, size * 0.96, size * 0.28)
        else:
            cr.arc(cx, cy, size * 0.48, 0, 2 * math.pi)
        cr.fill()
        draw_text(cr, (it["label"][:1] or "?").upper(), cx, cy + size * 0.2, size * 0.5, pal["FG"], alpha, bold=True, center=True)


def clip_text(cr, s, size, maxw):
    import cairo

    cr.select_font_face(U.FONT, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(size)
    if cr.text_extents(s).x_advance <= maxw:
        return s
    while len(s) > 1 and cr.text_extents(s + "…").x_advance > maxw:
        s = s[:-1]
    return s + "…"


def text_w(cr, s, size):
    cr.select_font_face(U.FONT)
    cr.set_font_size(size)
    return cr.text_extents(s).x_advance


# ----------------------------------------------------------------------------- objetivos de posición (cada presentación)


def grid_cols(n):
    return min(6, max(3, int(math.ceil(math.sqrt(max(1, min(n, 48)) * 1.5)))))


def targets(w, h, S):
    """Para cada ítem visible: (x, y, escala, alfa, radio). Las posiciones reales se acercan a esto con suavidad."""
    lay, idx, t = S["layout"], S["idx"], S["t"]
    out = {}
    cx, cy = w / 2, h / 2
    px, py = S["ptr"]
    n = len(idx)
    if lay == "input":
        return out
    if lay == "row":                                    # fresco: fila relajada de tarjetas de cristal con vaivén desfasado
        size, gap = 112, 24
        total = n * size + max(0, n - 1) * gap
        x0 = cx - total / 2 + size / 2
        for k, i in enumerate(idx):
            out[i] = (x0 + k * (size + gap), cy + 70 + math.sin(t * 1.1 + k * 1.4) * 5, 1.0, 1.0, size / 2)
        return out
    if lay == "grid":                                   # fresco: cuadrícula limpia de íconos
        cols = grid_cols(n)
        cw, ch = 132, 124
        first = S["scroll"] * cols
        shown = idx[first:first + cols * 4]
        rows = int(math.ceil(len(shown) / cols))
        x0 = cx - (cols - 1) * cw / 2
        y0 = cy - (rows - 1) * ch / 2 + 44
        for k, i in enumerate(shown):
            r, c = divmod(k, cols)
            out[i] = (x0 + c * cw, y0 + r * ch + math.sin(t * 0.9 + k * 0.8) * 2.0, 1.0, 1.0, 46)
        return out
    if lay == "orbit":
        R = min(w, h) * 0.285
        base = -math.pi / 2 + S["drift"]
        for k, i in enumerate(idx):
            ang = base + 2 * math.pi * k / max(1, n)
            x, y = cx + math.cos(ang) * R * 1.15, cy + 30 + math.sin(ang) * R * 0.95
            breathe = math.sin(t * 1.3 + k * 1.1) * 5
            x += math.cos(ang) * breathe
            y += math.sin(ang) * breathe
            d = math.hypot(px - x, py - y)
            pull = clamp(1 - d / 240) ** 2 * 18                       # imán: se acerca al mouse
            if d > 1:
                x += (px - x) / d * pull
                y += (py - y) / d * pull
            out[i] = (x, y, 1.0, 1.0, 54)
    elif lay == "wheel":
        row_h = 58
        rad = row_h * 3.4
        selk = S["selk"]
        for k, i in enumerate(idx):
            d = k - selk
            if abs(d) > 3.6:
                continue
            th = clamp(d * 0.40, -1.45, 1.45)
            y = cy + 36 + math.sin(th) * rad
            sc = math.cos(th) ** 1.1
            x = cx + 90 - abs(d) * 14 + (math.sin(t * 1.1 + k) * 2.0)
            out[i] = (x, y, sc, clamp(sc * 1.15), 0)
    else:                                                              # bubbles
        cols = max(3, int(math.ceil(math.sqrt(max(1, min(n, 60)) * 1.7))))
        cell = 118
        first = S["scroll"] * cols
        shown = idx[first:first + cols * 5]
        rows = int(math.ceil(len(shown) / cols))
        x0 = cx - (cols - 1) * cell / 2 - cell / 4
        y0 = cy - (rows - 1) * cell * 0.87 / 2 + 36
        for k, i in enumerate(shown):
            r, c = divmod(k, cols)
            x = x0 + c * cell + (cell / 2 if r % 2 else 0)
            y = y0 + r * cell * 0.87
            x += math.sin(t * 0.9 + k * 1.7) * 4
            y += math.cos(t * 0.8 + k * 1.3) * 4
            d = math.hypot(px - x, py - y)
            lens = math.exp(-((d / 150) ** 2))                         # lupa: se agranda bajo el cursor y empuja a las vecinas
            if d > 1:
                x += (x - px) / d * lens * 26
                y += (y - py) / d * lens * 26
            out[i] = (x, y, 1.0 + 0.55 * lens, 1.0, 40)
    return out


# ----------------------------------------------------------------------------- dibujo


def paint_orb(cr, x, y, rad, pal, a, sel, hv, col, t):
    """Esfera / botón redondo según el estilo."""
    import cairo

    A2, SF, SF2, BG, FG = pal["ACCENT2"], pal["SURFACE"], pal["SURFACE2"], pal["BG"], pal["FG"]
    if U.FRESH:                                                          # esfera de cristal clara con brillo, órbita fina al apuntar
        s_ = 1.0 if sel else hv
        if s_ > 0.01:
            for k, al in ((rad * 0.55, 0.06), (rad * 0.28, 0.10)):             # halo suave de color (no neón)
                cr.new_sub_path()
                cr.arc(x, y + 4, rad + k, 0, 2 * math.pi)
                cr.set_source_rgba(*col, al * a * s_)
                cr.fill()
        g = cairo.RadialGradient(x - rad * 0.3, y - rad * 0.45, rad * 0.05, x, y, rad)
        if sel:
            g.add_color_stop_rgba(0, *mix(col, (1, 1, 1), 0.45), 0.97 * a)
            g.add_color_stop_rgba(1, *mix(col, A2, 0.55), 0.90 * a)
        else:
            g.add_color_stop_rgba(0, 1, 1, 1, (0.20 + 0.10 * hv) * a)
            g.add_color_stop_rgba(0.6, *mix(SF2, col, 0.18 * hv), 0.35 * a)
            g.add_color_stop_rgba(1, *mix(SF, BG, 0.5), 0.55 * a)
        cr.new_sub_path()
        cr.arc(x, y, rad, 0, 2 * math.pi)
        cr.set_source(g)
        cr.fill()
        cr.new_sub_path()
        cr.arc(x, y, rad, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, (0.18 + 0.30 * s_) * a)
        cr.set_line_width(1.0)
        cr.stroke()
        cr.new_sub_path()                                                    # reflejo de vidrio arriba-izquierda
        cr.arc(x - rad * 0.30, y - rad * 0.44, rad * 0.34, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, (0.16 if sel else 0.10) * a)
        cr.fill()
        if s_ > 0.05:                                                        # órbita fina con un nodo, microdetalle
            cr.new_sub_path()
            cr.arc(x, y, rad + 9, 0, 2 * math.pi)
            cr.set_source_rgba(*col, 0.35 * a * s_)
            cr.set_line_width(0.9)
            cr.stroke()
            ang = t * 1.6
            cr.new_sub_path()
            cr.arc(x + math.cos(ang) * (rad + 9), y + math.sin(ang) * (rad + 9), 2.4, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.95 * a * s_)
            cr.fill()
        return
    if U.STARK:                                                          # holograma JARVIS: anillos finos que giran + marcas de escala
        s_ = 1.0 if sel else hv
        cr.new_sub_path()
        cr.arc(x, y, rad, 0, 2 * math.pi)
        cr.set_source_rgba(*mix(SF, col, 0.5), (0.20 if sel else 0.06 + 0.12 * hv) * a)
        cr.fill()
        cr.new_sub_path()
        cr.arc(x, y, rad, 0, 2 * math.pi)
        cr.set_source_rgba(*col, a * (0.95 if sel else 0.35 + 0.5 * hv))
        cr.set_line_width(1.5)
        cr.stroke()
        cr.save()
        cr.set_dash([7, 5], t * 26 * (2.2 if sel else 1.0))
        cr.new_sub_path()
        cr.arc(x, y, rad + 7, 0, 2 * math.pi)
        cr.set_source_rgba(*col, a * (0.30 + 0.55 * s_))
        cr.set_line_width(1.0)
        cr.stroke()
        cr.restore()
        cr.set_source_rgba(*col, a * (0.30 + 0.4 * s_))
        cr.set_line_width(1.0)
        for k in range(36):                                              # marcas de escala por dentro del anillo
            ang = k * math.pi / 18
            r0 = rad - (8 if k % 3 == 0 else 5)
            cr.move_to(x + math.cos(ang) * r0, y + math.sin(ang) * r0)
            cr.line_to(x + math.cos(ang) * (rad - 2), y + math.sin(ang) * (rad - 2))
        cr.stroke()
        if sel or hv > 0.2:                                              # arco brillante que gira
            ang0 = t * (3.2 if sel else 1.6)
            cr.new_sub_path()
            cr.arc(x, y, rad + 12, ang0, ang0 + 1.15)
            cr.set_source_rgba(*col, a * 0.95)
            cr.set_line_width(3.0)
            cr.stroke()
            for rr, al in ((rad * 0.9, 0.05), (rad * 0.6, 0.10)):
                cr.new_sub_path()
                cr.arc(x, y, rr, 0, 2 * math.pi)
                cr.set_source_rgba(*col, al * a)
                cr.fill()
        return
    if U.CYBER:                                                          # hexágono con brillo
        def hexa(r):
            cr.new_sub_path()
            for k in range(6):
                ang = math.pi / 6 + k * math.pi / 3
                (cr.move_to if k == 0 else cr.line_to)(x + math.cos(ang) * r, y + math.sin(ang) * r)
            cr.close_path()
        if sel or hv > 0.01:
            for k, al in ((16, 0.05), (9, 0.09), (4, 0.16)):
                hexa(rad + k)
                cr.set_source_rgba(*col, al * a * (1 if sel else hv))
                cr.fill()
        hexa(rad)
        cr.set_source_rgba(*(mix(SF, col, 0.55) if sel else mix(SF, col, 0.10 * hv)), 0.92 * a)
        cr.fill_preserve()
        cr.set_source_rgba(*col, a * (0.95 if sel else 0.3 + 0.5 * hv))
        cr.set_line_width(1.5)
        cr.stroke()
        hexa(rad * 0.82)
        cr.set_source_rgba(*col, 0.25 * a)
        cr.set_line_width(0.8)
        cr.stroke()
        return
    if U.NEUMO:
        base = mix(SF2, FG, 0.06)
        if sel:
            cr.arc(x, y, rad, 0, 2 * math.pi)
            cr.set_source_rgba(*mix(base, (0, 0, 0), 0.38), 0.98 * a)
            cr.fill()
            ig = cairo.LinearGradient(x - rad, y - rad, x + rad * 0.4, y + rad)
            ig.add_color_stop_rgba(0, 0, 0, 0, 0.55 * a)
            ig.add_color_stop_rgba(1, 0, 0, 0, 0.0)
            cr.arc(x, y, rad, 0, 2 * math.pi)
            cr.set_source(ig)
            cr.fill()
            for rr, al in ((rad * 0.20, 0.10), (rad * 0.12, 0.2), (rad * 0.06, 1.0)):
                cr.set_source_rgba(*col, al * a)
                cr.arc(x + rad * 0.62, y - rad * 0.62, rr, 0, 2 * math.pi)
                cr.fill()
        else:
            lift = 5 - 2 * hv
            for k, al in ((lift * 2.2, 0.16), (lift * 1.4, 0.22), (lift * 0.7, 0.3)):
                cr.arc(x + k * 0.8, y + k * 0.9, rad, 0, 2 * math.pi)
                cr.set_source_rgba(0, 0, 0, al * a)
                cr.fill()
            for k, al in ((lift * 1.3, 0.035), (lift * 0.7, 0.06)):
                cr.arc(x - k * 0.7, y - k * 0.7, rad, 0, 2 * math.pi)
                cr.set_source_rgba(*FG, al * a)
                cr.fill()
            g = cairo.LinearGradient(x - rad, y - rad, x + rad * 0.7, y + rad)
            g.add_color_stop_rgba(0, *mix(base, FG, 0.09 + 0.05 * hv), 0.98 * a)
            g.add_color_stop_rgba(1, *mix(base, (0, 0, 0), 0.25), 0.98 * a)
            cr.arc(x, y, rad, 0, 2 * math.pi)
            cr.set_source(g)
            cr.fill()
        return
    # vidrio brillante (dinamico / 3d / sutil)
    if sel or hv > 0.01:
        for k, al in ((rad * 0.75, 0.05), (rad * 0.45, 0.09), (rad * 0.2, 0.16)):
            cr.arc(x, y, rad + k, 0, 2 * math.pi)
            cr.set_source_rgba(*col, al * a * (1.0 if sel else hv))
            cr.fill()
    g = cairo.RadialGradient(x - rad * 0.35, y - rad * 0.4, rad * 0.1, x, y, rad)
    if sel:
        g.add_color_stop_rgba(0, *mix(col, (1, 1, 1), 0.35), 0.98 * a)
        g.add_color_stop_rgba(1, *mix(col, A2, 0.45), 0.95 * a)
    else:
        g.add_color_stop_rgba(0, *mix(SF2, col, 0.20 + 0.25 * hv), 0.95 * a)
        g.add_color_stop_rgba(1, *mix(SF, BG, 0.4), 0.95 * a)
    cr.arc(x, y, rad, 0, 2 * math.pi)
    cr.set_source(g)
    cr.fill()
    cr.arc(x, y, rad, 0, 2 * math.pi)
    cr.set_source_rgba(*col, a * (0.9 if sel else 0.25 + 0.5 * hv))
    cr.set_line_width(1.4)
    cr.stroke()
    cr.arc(x - rad * 0.28, y - rad * 0.42, rad * 0.36, 0, 2 * math.pi)       # brillo de vidrio
    cr.set_source_rgba(1, 1, 1, 0.10 * a)
    cr.fill()


def draw_life(cr, w, h, S, pal, op):
    """Atmósfera viva: resplandores que respiran y partículas que suben con paralaje del mouse."""
    import cairo

    A, A2 = pal["ACCENT"], pal["ACCENT2"]
    t = S["t"]
    px, py = S["ptr"]
    for k, (col, fx, fy, rr) in enumerate(((A, 0.28, 0.55, 0.50), (A2, 0.74, 0.40, 0.42))):
        bx = w * fx + math.sin(t * 0.25 + k * 2) * 60 - (px - w / 2) * 0.03
        by = h * fy + math.cos(t * 0.21 + k) * 50 - (py - h / 2) * 0.03
        g = cairo.RadialGradient(bx, by, 0, bx, by, h * rr)
        g.add_color_stop_rgba(0, *col, 0.10 * op)
        g.add_color_stop_rgba(1, *col, 0.0)
        cr.set_source(g)
        cr.rectangle(0, 0, w, h)
        cr.fill()
    for (fx, fy0, sp, sz, ph, depth) in (S["parts"][:22] if U.FRESH else S["parts"]):          # fresh: menos partículas, más limpio
        y = (fy0 - t * sp * 0.05) % 1.15 - 0.075
        x = fx + math.sin(t * 0.6 + ph) * 0.02
        al = (0.15 + 0.35 * (0.5 + 0.5 * math.sin(t * 1.6 + ph))) * op * math.sin(clamp(y + 0.05, 0, 1) * math.pi)
        X, Y = x * w - (px - w / 2) * 0.02 * depth, y * h - (py - h / 2) * 0.02 * depth
        cr.set_source_rgba(*A, al * 0.35)
        cr.arc(X, Y, sz * 3.2, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, al)
        cr.arc(X, Y, sz, 0, 2 * math.pi)
        cr.fill()


def draw_reactor(cr, cx, cy, R, pal, t, a):
    """Reactor arc: anillos concéntricos que giran en sentidos opuestos, segmentos y un núcleo que late."""
    import cairo

    A = pal["ACCENT"]
    core = cairo.RadialGradient(cx, cy, 0, cx, cy, R * 0.55)
    pulse = 0.75 + 0.25 * math.sin(t * 2.4)
    core.add_color_stop_rgba(0, 1, 1, 1, 0.55 * pulse * a)
    core.add_color_stop_rgba(0.35, *A, 0.40 * pulse * a)
    core.add_color_stop_rgba(1, *A, 0.0)
    cr.set_source(core)
    cr.new_sub_path()
    cr.arc(cx, cy, R * 0.55, 0, 2 * math.pi)
    cr.fill()
    cr.set_source_rgba(*A, 0.55 * a)
    for rr, lw, dash, speed in ((R, 1.4, [10, 6], 14), (R * 0.84, 1.0, [3, 5], -22), (R * 0.66, 2.2, [26, 10], 9), (R * 0.46, 1.2, None, 0)):
        cr.save()
        if dash:
            cr.set_dash(dash, t * speed)
        cr.set_line_width(lw)
        cr.new_sub_path()
        cr.arc(cx, cy, rr, 0, 2 * math.pi)
        cr.stroke()
        cr.restore()
    for k in range(10):                                                  # segmentos trapezoidales del anillo interior
        ang = t * 0.35 + k * math.pi / 5
        a0, a1 = ang - 0.16, ang + 0.16
        cr.new_sub_path()
        cr.arc(cx, cy, R * 0.56, a0, a1)
        cr.arc_negative(cx, cy, R * 0.38, a1, a0)
        cr.close_path()
        cr.set_source_rgba(*A, 0.28 * a)
        cr.fill_preserve()
        cr.set_source_rgba(*A, 0.8 * a)
        cr.set_line_width(1.0)
        cr.stroke()
    cr.set_source_rgba(*A, 0.35 * a)                                      # cruz de mira y lectura
    cr.set_line_width(0.8)
    for dx, dy in ((1, 0), (0, 1)):
        cr.move_to(cx - dx * R * 1.15, cy - dy * R * 1.15)
        cr.line_to(cx + dx * R * 1.15, cy + dy * R * 1.15)
    cr.stroke()
    draw_text(cr, f"CORE {int(97 + 3 * math.sin(t))}%  ·  ARC STABLE", cx, cy + R * 1.32, 9, A, 0.8 * a, center=True)


# Cara del robot según la opción (el color SIEMPRE es el del tema: las caras no lo cambian)
MOOD_BY_ID = {"continue": "happy", "lock": "serious", "suspend": "sleepy", "reboot": "dizzy", "poweroff": "surprised",
              "exit": "wave", "recomendado": "happy", "mi-gusto": "wink"}


def draw_buddy(cr, w, h, S, pal_full, x, y, scale):
    if BUDDY is None:
        return
    t = S["t"]
    state, mood, tilt, hop = "idle", None, 0.0, 0.0
    it = S["items"][S["sel"]] if 0 <= S["sel"] < len(S["items"]) else None
    if S["closing"] is not None:
        state, mood = "done", "happy"
    elif S["layout"] == "game" and it is not None:
        mood = it.get("mood") or MOOD_BY_ID.get(it["id"])
    elif it is not None and any(k in it["label"].lower() for k in DANGER):
        state = "waiting"
    elif S["query"]:
        state = "thinking"
    if mood:                                                  # cada cara se mueve a su manera
        tilt = {"dizzy": math.sin(t * 4.2) * 0.11, "sleepy": 0.07 + math.sin(t * 0.9) * 0.05,
                "happy": math.sin(t * 3.0) * 0.035, "wink": 0.05, "wave": -0.04 + math.sin(t * 2.0) * 0.02,
                "serious": 0.0, "surprised": 0.0}.get(mood, 0.0)
        age = t - S.get("kick", -9.0)                         # al cambiar de opción el robot da un saltito
        hop = (16 if mood == "surprised" else 11) * math.exp(-age * 6.5) * abs(math.sin(age * 13)) if age < 1.2 else 0.0
        if mood == "happy":
            hop += abs(math.sin(t * 3.0)) * 4
    x += math.sin(t * 0.8) * 7 * scale / 2.5                   # se mece un poquito de lado a lado
    px, py = S["ptr"]
    look = (clamp((px - x) / 320, -1, 1), clamp((py - (y - 60 * scale)) / 320, -1, 1))
    try:
        BUDDY.draw_mascot(cr, x, y, state, t, pal_full, look=look, scale=scale, facing=1, mood=mood, tilt=tilt, hop=hop * scale / 2.5)
    except TypeError:
        BUDDY.draw_mascot(cr, x, y, state, t, pal_full, look=look, scale=scale, facing=1)
    except Exception:
        pass


def wrap_text(cr, text, size, maxw):
    """Parte un texto en líneas que entren en maxw píxeles."""
    cr.select_font_face(U.FONT)
    cr.set_font_size(size)
    lines, cur = [], ""
    for word in text.split():
        trial = (cur + " " + word).strip()
        if cr.text_extents(trial).x_advance <= maxw or not cur:
            cur = trial
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    return lines[:4]


GAME_ROW = 66


def game_pos(w, h, n):
    """Posición (x, y) de cada opción del menú estilo videojuego: columna a la izquierda, centrada en vertical."""
    top = h * 0.52 - (n * GAME_ROW) / 2 + 30
    return [(w * 0.085, top + k * GAME_ROW) for k in range(n)]


def keycap(cr, x, y, label, text, pal, a):
    """Ayuda de teclas como en los juegos: tecla redondeada + acción."""
    cr.select_font_face(U.FONT)
    cr.set_font_size(11)
    kw = cr.text_extents(label).x_advance + 18
    rrect(cr, x, y - 17, kw, 24, 7)
    cr.set_source_rgba(1, 1, 1, 0.09 * a)
    cr.fill_preserve()
    cr.set_source_rgba(1, 1, 1, 0.32 * a)
    cr.set_line_width(1.0)
    cr.stroke()
    draw_text(cr, label, x + kw / 2, y, 11, pal["FG"], a, bold=True, center=True)
    draw_text(cr, text, x + kw + 10, y, 12, pal["DIM"], a)
    return kw + 18 + text_w(cr, text, 12) + 22


def draw_game(cr, w, h, S, pal, pal_full, op, pop):
    """Menú principal estilo videojuego, versión PC: opciones grandes a la izquierda, escena a la derecha."""
    import cairo

    A, A2, BG, FG, DIM = pal["ACCENT"], pal["ACCENT2"], pal["BG"], pal["FG"], pal["DIM"]
    t = S["t"]
    px, py = S["ptr"]
    # fondo: oscuro a la izquierda (se lee el texto), el color del tema a la derecha
    g = cairo.LinearGradient(0, 0, w, 0)
    g.add_color_stop_rgba(0, *mix(BG, (0, 0, 0), 0.45), 0.95 * op)
    g.add_color_stop_rgba(0.50, *BG, 0.84 * op)
    g.add_color_stop_rgba(1, *mix(BG, A, 0.12), 0.66 * op)
    cr.set_source(g)
    cr.paint()
    # suelo en perspectiva (el mundo del escritorio)
    vx, vy = w * 0.70, h * 0.60
    cr.set_line_width(1.0)
    for i in range(-14, 15):
        cr.set_source_rgba(*A, 0.15 * op * (1 - abs(i) / 16))
        cr.move_to(vx + i * 6, vy)
        cr.line_to(vx + i * w * 0.085, h)
        cr.stroke()
    for k in range(12):
        f = (k + (t * 0.25) % 1) / 12
        cr.set_source_rgba(*A, 0.17 * op * min(1.0, f * 5))
        y = vy + (h - vy) * f ** 2.2
        cr.move_to(w * 0.28, y)
        cr.line_to(w, y)
        cr.stroke()
    # haz de luz detrás del robot
    bx, by = w * 0.72, h * 0.80
    rg = cairo.RadialGradient(bx, by - 210, 0, bx, by - 210, 400)
    rg.add_color_stop_rgba(0, *A, 0.26 * op)
    rg.add_color_stop_rgba(1, *A, 0.0)
    cr.set_source(rg)
    cr.rectangle(0, 0, w, h)
    cr.fill()
    # ventanas flotando (profundidad y paralaje con el mouse)
    for (fx, fy, ww, hh, dp, ph, lines) in S["wins"]:
        wx = w * fx - (px - w / 2) * 0.025 * dp + math.sin(t * 0.5 + ph) * 8 * dp
        wy = h * fy - (py - h / 2) * 0.025 * dp + math.cos(t * 0.6 + ph) * 10 * dp
        a = (0.30 + 0.45 * dp) * pop * 0.8
        rrect(cr, wx + 3, wy + 12, ww, hh, 14)
        cr.set_source_rgba(0, 0, 0, 0.30 * a)
        cr.fill()
        rrect(cr, wx, wy, ww, hh, 14)
        cr.set_source_rgba(*mix(BG, (1, 1, 1), 0.08), 0.55 * a)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.16 * a)
        cr.set_line_width(1.0)
        cr.stroke()
        for k, c_ in enumerate((A2, (1.0, 0.75, 0.2), A)):
            cr.set_source_rgba(*c_, 0.85 * a)
            cr.arc(wx + 14 + k * 10, wy + 13, 2.6, 0, 2 * math.pi)
            cr.fill()
        for k, frac in enumerate(lines):
            cr.set_source_rgba(*(A if k % 3 == 0 else FG), (0.40 if k % 3 == 0 else 0.20) * a)
            rrect(cr, wx + 14, wy + 34 + k * 13, (ww - 28) * frac, 5, 2.5)
            cr.fill()
    # el robot, protagonista
    bob_s = 2.5 * (0.78 + 0.22 * pop)
    cr.set_source_rgba(*A, 0.30 * op)                                   # anillo de escenario bajo sus pies
    cr.set_line_width(1.2)
    cr.save()
    cr.translate(bx, by + 6)
    cr.scale(1, 0.22)
    cr.new_sub_path()
    cr.arc(0, 0, 120, 0, 2 * math.pi)
    cr.restore()
    cr.stroke()
    draw_buddy(cr, w, h, S, pal_full, bx, by, bob_s)
    # logo y título
    lx = w * 0.085
    draw_text(cr, "H Y P R A R C H", lx, h * 0.14, 17, FG, pop, bold=True)
    cr.set_source_rgba(*A, 0.9 * pop)
    cr.rectangle(lx, h * 0.14 + 10, 54, 2)
    cr.fill()
    draw_text(cr, S["title"], lx, h * 0.14 + 38, 13, DIM, pop)
    # opciones: una debajo de la otra
    pos = game_pos(w, h, len(S["idx"]))
    sel_y = None
    sel_item = None
    for k, i in enumerate(S["idx"]):
        it = S["items"][i]
        x, y = pos[k]
        stag = clamp((t - 0.05 - k * 0.07) / 0.45)
        st = spring(stag) if U.BOUNCY else ease_out_strong(stag)
        a = clamp(stag * 2.0) * pop if S["closing"] is None else pop
        sel = (S["sel"] == i)
        hv = S["hov"].get(i, 0.0)
        xx = x + (1 - st) * -70 + hv * 14
        if sel:
            sel_y = y
        col = FG if (sel or hv > 0.4) else mix(DIM, FG, 0.35)
        if sel:                                           # resplandor suave del texto elegido
            draw_text(cr, it["label"], xx + 1, y + 1, 34, A, a * 0.30, bold=True)
            draw_text(cr, it["label"], xx - 1, y - 1, 34, A2, a * 0.20, bold=True)
        draw_text(cr, it["label"], xx, y, 34 if sel else 30, col, a * (1.0 if sel else 0.78), bold=sel)
        if sel:
            sel_item = it
    # indicador que se desliza hacia lo elegido (barra + flecha)
    if sel_y is not None:
        S["ind"] += (sel_y - S["ind"]) * (1 - math.exp(-S["dt"] * 14)) if S["ind"] else (sel_y - S["ind"])
        iy = S["ind"] if S["ind"] else sel_y
        rrect(cr, lx - 28, iy - 30, 4, 38, 2)
        cr.set_source_rgba(*A, 0.95 * pop)
        cr.fill()
        ax = lx - 20 + math.sin(t * 5) * 2                    # flecha dibujada (no depende de la tipografía)
        cr.move_to(ax, iy - 19)
        cr.line_to(ax + 11, iy - 10)
        cr.line_to(ax, iy - 1)
        cr.close_path()
        cr.set_source_rgba(*A, 0.95 * pop)
        cr.fill()
    # cuadro "qué hace esta opción" abajo a la derecha: aparece con un fundido cada vez que cambia la opción elegida
    if S["sel"] != S.get("info_id"):
        S["info_id"], S["info_t"] = S["sel"], t
        S["kick"] = t
    if sel_item is not None and (sel_item["sub"] or sel_item["label"]):
        ia = clamp((t - S.get("info_t", 0.0)) / 0.28)
        ia = ease_out_strong(ia) * pop
        cw_, pad_ = min(400.0, w * 0.32), 22.0
        lines = wrap_text(cr, sel_item["sub"], 13.5, cw_ - 2 * pad_)
        ch_ = pad_ * 2 + 34 + 18 * max(1, len(lines))
        cx_, cy_ = w - cw_ - w * 0.035, h - ch_ - h * 0.085 + (1 - ia) * 14
        rrect(cr, cx_ + 3, cy_ + 12, cw_, ch_, 18)
        cr.set_source_rgba(0, 0, 0, 0.28 * ia)
        cr.fill()
        rrect(cr, cx_, cy_, cw_, ch_, 18)
        cr.set_source_rgba(*mix(BG, (1, 1, 1), 0.07), 0.80 * ia)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.18 * ia)
        cr.set_line_width(1.0)
        cr.stroke()
        cr.set_source_rgba(*A, 0.95 * ia)                                  # hilo de color arriba
        cr.set_line_width(1.6)
        cr.move_to(cx_ + 18, cy_ + 0.8)
        cr.line_to(cx_ + cw_ - 18, cy_ + 0.8)
        cr.stroke()
        draw_text(cr, "QUÉ HACE", cx_ + pad_, cy_ + pad_ + 4, 9.5, A, ia * 0.95, bold=True)
        draw_text(cr, sel_item["label"], cx_ + pad_, cy_ + pad_ + 26, 18, FG, ia, bold=True)
        for k, ln in enumerate(lines):
            draw_text(cr, ln, cx_ + pad_, cy_ + pad_ + 50 + k * 18, 13.5, mix(FG, DIM, 0.35), ia)
    # ayudas de teclas, como en los juegos
    kx, ky = lx - 28, h - 46
    kx += keycap(cr, kx, ky, "↑ ↓", "Elegir", pal, pop * 0.9)
    kx += keycap(cr, kx, ky, "Enter", "Aceptar", pal, pop * 0.9)
    kx += keycap(cr, kx, ky, "Esc", "Volver", pal, pop * 0.9)
    draw_text(cr, "hyprarch · una casa para IAs", w - 26, h - 30, 10.5, DIM, pop * 0.7, right=True)


def draw_scene(cr, w, h, S, pal, pal_full):
    A, A2, BG, SF, FG, DIM = (pal[k] for k in ("ACCENT", "ACCENT2", "BG", "SURFACE", "FG", "DIM"))
    t = S["t"]
    if S["closing"] is not None:
        op = pop = 1 - clamp(S["closing"] / U.CLOSE_T)
    else:
        op = clamp(t / (U.OPEN_T * 0.5))
        pop = clamp(t / (U.OPEN_T * 0.4))
    if S["layout"] == "game":
        draw_game(cr, w, h, S, pal, pal_full, op, pop)
        for rp in list(S["ripples"]):                       # ondas al hacer clic
            age = t - rp[2]
            if age > 0.6:
                S["ripples"].remove(rp)
                continue
            k = age / 0.6
            cr.set_source_rgba(*A, (1 - k) * 0.6)
            cr.set_line_width(2.5 * (1 - k) + 0.5)
            cr.new_sub_path()
            cr.arc(rp[0], rp[1], 14 + 110 * ease_out_strong(k), 0, 2 * math.pi)
            cr.stroke()
        return
    cr.set_source_rgba(*mix(BG, (0, 0, 0), 0.5), (0.50 if U.FRESH else 0.72) * op)       # fresh: se ve más el escritorio detrás
    cr.paint()
    draw_life(cr, w, h, S, pal, op)
    lay = S["layout"]
    cx, cy = w / 2, h / 2
    S["tg"] = targets(w, h, S)

    if U.STARK:                                                           # parpadeo de holograma
        pop *= 0.93 + 0.07 * abs(math.sin(t * 47)) if int(t * 9) % 11 == 0 else 1.0
    # personajito compañero
    if lay == "orbit":
        if U.FRESH:                                                        # anillos finos y suaves alrededor del personaje
            for k, (rr, al, dash) in enumerate(((0.19, 0.20, None), (0.255, 0.12, [3, 7]), (0.34, 0.08, [2, 9]))):
                cr.save()
                if dash:
                    cr.set_dash(dash, t * (8 if k % 2 else -8))
                cr.new_sub_path()
                cr.arc(cx, cy + 30, min(w, h) * rr, 0, 2 * math.pi)
                cr.set_source_rgba(1, 1, 1, al * pop)
                cr.set_line_width(1.0)
                cr.stroke()
                cr.restore()
        if U.STARK:
            draw_reactor(cr, cx, cy + 30, min(w, h) * 0.20, pal, t, pop)
            for _i, _c in S["pos"].items():                                # rayos finos del reactor a cada nodo
                cr.set_source_rgba(*A, 0.22 * pop)
                cr.set_line_width(0.8)
                cr.move_to(cx, cy + 30)
                cr.line_to(_c[0], _c[1])
                cr.stroke()
        draw_buddy(cr, w, h, S, pal_full, cx, cy + 118, 1.7 * (0.75 + 0.25 * pop))
        draw_text(cr, S["title"], cx, cy - min(w, h) * 0.39 - 4, 26, FG, pop, bold=True, center=True)
    elif lay == "row":
        draw_buddy(cr, w, h, S, pal_full, cx, cy - 18, 1.35 * (0.75 + 0.25 * pop))
        draw_text(cr, S["title"], cx, cy - 285, 26, FG, pop, bold=True, center=True)
        draw_text(cr, "← →  elegir · Enter  confirmar · Esc  salir", cx, cy + 215, 11, DIM, pop * 0.75, center=True)
    elif lay == "wheel":
        draw_buddy(cr, w, h, S, pal_full, cx - 330, cy + 150, 1.5 * (0.75 + 0.25 * pop))
        draw_text(cr, S["title"], cx - 330, cy - 110, 22, FG, pop, bold=True, center=True)
        draw_text(cr, "↑ ↓  elegir · Enter  confirmar · Esc  salir", cx - 330, cy - 84, 11, DIM, pop * 0.8, center=True)
    elif lay == "input":
        if U.STARK:
            draw_reactor(cr, cx, cy - 120, min(w, h) * 0.13, pal, t, pop)
        draw_buddy(cr, w, h, S, pal_full, cx, cy - 70, 1.3 * (0.75 + 0.25 * pop))
        draw_text(cr, S["title"], cx, cy - min(w, h) * 0.30, 24, FG, pop, bold=True, center=True)
        draw_text(cr, "Enter  confirmar · Esc  cancelar", cx, cy + 118, 11, DIM, pop * 0.8, center=True)
    else:
        draw_buddy(cr, w, h, S, pal_full, w - 120, h - 40, 1.2 * (0.75 + 0.25 * pop))
        draw_text(cr, S["title"], cx, cy - min(h * 0.40, 320), 22, FG, pop, bold=True, center=True)

    # buscador (rueda y burbujas): una pastilla flotante, sin recuadro de lista
    if S["search"]:
        sw, sh = (540, 50) if lay == "input" else (360, 42)
        sx, sy = cx - sw / 2 + (90 if lay == "wheel" else 0), (cy - 190 if lay == "wheel" else (cy + 50 if lay == "input" else cy - min(h * 0.40, 320) + 18))
        if U.NEUMO:
            U.paint_item(cr, sx, sy, sw, sh, 21, pal, pop, True, 0.0, A, t)
        else:
            rrect(cr, sx, sy, sw, sh, 21)
            cr.set_source_rgba(*SF, 0.9 * pop)
            cr.fill_preserve()
            cr.set_source_rgba(*A, (0.55 + 0.3 * math.sin(t * 2.2)) * pop)
            cr.set_line_width(1.3)
            cr.stroke()
        draw_text(cr, "", sx + 22, sy + sh / 2 + 6, 15, A, pop, center=True)
        if S["query"]:
            draw_text(cr, S["query"], sx + 44, sy + sh / 2 + 6, 15, FG, pop)
            ew = text_w(cr, S["query"], 15)
        else:
            draw_text(cr, S["placeholder"], sx + 44, sy + sh / 2 + 6, 14, DIM, pop)
            ew = 0
        if int(t * 2) % 2 == 0:
            cr.set_source_rgba(*A, pop)
            cr.rectangle(sx + 44 + ew + 2, sy + 10, 2, sh - 20)
            cr.fill()

    if not S["idx"] and lay != "input":
        draw_text(cr, "Sin resultados", cx, cy + 20, 16, DIM, pop, center=True)

    # ítems: la posición real persigue a la posición objetivo (movimiento orgánico)
    order_i = 0
    dt = S["dt"]
    draws = []
    for i, (tx, ty, tsc, tal, rad) in S["tg"].items():
        cur = S["pos"].get(i)
        if cur is None:
            cur = [cx, cy + (20 if lay != "orbit" else 0), 0.2, 0.0]
            S["pos"][i] = cur
        ease = 1 - math.exp(-dt * (9 if U.BOUNCY else 12))
        stag = clamp((t - 0.03 - order_i * U.STAGGER) / U.ITEM_T)
        st = (spring(stag) if U.BOUNCY else ease_out_strong(stag)) if S["closing"] is None else 1.0
        if S["closing"] is not None:                                      # al cerrar, todo vuelve al centro
            k = clamp(S["closing"] / U.CLOSE_T)
            tx, ty = tx + (cx - tx) * k, ty + (cy - ty) * k
            tsc *= 1 - 0.6 * k
        cur[0] += (tx - cur[0]) * ease
        cur[1] += (ty - cur[1]) * ease
        cur[2] += (tsc - cur[2]) * ease
        cur[3] += (tal - cur[3]) * ease
        order_i += 1
        draws.append((i, cur, rad, st))
    for i in list(S["pos"]):
        if i not in S["tg"]:
            del S["pos"][i]
    draws.sort(key=lambda d: (S["sel"] == d[0], S["hov"].get(d[0], 0.0)))      # el elegido se dibuja encima

    for i, cur, rad, st in draws:
        it = S["items"][i]
        sel = (S["sel"] == i)
        hv = S["hov"].get(i, 0.0)
        a = clamp(cur[3] * clamp(st) * pop)
        x, y, sc = cur[0], cur[1], cur[2]
        if lay == "wheel":
            rw, rh = 520 * sc, 52 * sc
            rx, ry = x - rw / 2, y - rh / 2
            if U.DEPTH:
                for dy, al in ((8, 0.10), (4, 0.15), (2, 0.2)):
                    rrect(cr, rx, ry + dy, rw, rh, 20)
                    cr.set_source_rgba(0, 0, 0, al * a)
                    cr.fill()
            U.paint_item(cr, rx, ry, rw, rh, 20, pal, a, sel, hv, A, t)
            tcol = BG if (sel and not U.NEUMO) else FG
            fs = 15 * sc
            draw_icon(cr, it, rx + 30 * sc, y, 26 * sc, BG if (sel and not U.NEUMO) else A, a, pal)
            lab = it["label"].upper() if U.CYBER else it["label"]
            draw_text(cr, clip_text(cr, lab, fs, rw - 90 * sc - (170 * sc if it["sub"] else 0)), rx + 58 * sc, y + 5 * sc, fs, tcol, a, bold=sel)
            if it["sub"]:
                draw_text(cr, clip_text(cr, it["sub"], 11 * sc, 200 * sc), rx + rw - 18 * sc, y + 4 * sc, 11 * sc,
                          BG if (sel and not U.NEUMO) else DIM, a * 0.9, right=True)
        elif lay in ("row", "grid"):
            # fresco: tarjeta de cristal con esquinas suaves (fila) o ícono limpio con placa solo al apuntar (cuadrícula)
            sz = 112 if lay == "row" else 88
            lift = -8 * max(hv, 1.0 if sel else 0.0)
            tx_, ty_ = x - sz / 2, y - sz / 2 + lift
            if lay == "row" or sel or hv > 0.05:
                if U.DEPTH and (sel or hv > 0.05 or lay == "row"):
                    for dy, al in ((16, 0.07), (10, 0.10), (5, 0.14)):
                        rrect(cr, tx_ + 4, ty_ + dy, sz - 8, sz, sz * 0.27)
                        cr.set_source_rgba(0, 0, 0, al * a * (1.0 if lay == "row" else max(hv, 1.0 if sel else 0.0)))
                        cr.fill()
                U.paint_item(cr, tx_, ty_, sz, sz, sz * 0.27, pal, a, sel, hv, A, t)
            isz = 52 if lay == "row" else 50
            ic_y = ty_ + (sz * 0.40 if lay == "row" else sz * 0.46)
            draw_icon(cr, it, x, ic_y, isz, BG if (sel and lay == "row" and not (U.NEUMO or U.CYBER)) else (A if lay == "row" else FG), a, pal)
            lab = clip_text(cr, it["label"], 13, sz + 20)
            if lay == "row":
                draw_text(cr, lab, x, ty_ + sz - 16, 13, BG if (sel and not (U.NEUMO or U.CYBER)) else FG, a, bold=sel, center=True)
            else:
                draw_text(cr, lab, x, ty_ + sz + 18, 12.5, FG, a * (1.0 if (sel or hv > 0.1) else 0.82), bold=sel, center=True)
        else:
            glow = max(hv, 1.0 if sel else 0.0)
            r = rad * sc * (1.0 + (0.10 if lay == "orbit" else 0.0) * glow)
            if lay == "orbit":
                r *= 1.0 + 0.04 * math.sin(t * 2.0 + i)
            paint_orb(cr, x, y, r, pal, a, sel, hv, A, t)
            isz = r * (1.0 if lay == "orbit" else 0.95)
            draw_icon(cr, it, x, y - r * 0.02, isz * (0.82 if lay == "orbit" else 0.92), BG if (sel and not (U.NEUMO or U.CYBER)) else (A if lay == "orbit" else FG), a, pal)
            show = sel or hv > 0.25 or lay == "orbit"
            if show:
                lab = it["label"].upper() if U.CYBER else it["label"]
                fs = 14 if lay == "orbit" else 12.5
                draw_text(cr, clip_text(cr, lab, fs, 150), x, y + r + 18 * (1 if lay == "orbit" else 0.9), fs, FG, a * (1.0 if (sel or hv > 0.25) else 0.78),
                          bold=sel, center=True)
            if lay == "bubbles" and it["sub"] and (sel or hv > 0.6):
                draw_text(cr, clip_text(cr, it["sub"], 10.5, 180), x, y + r + 34, 10.5, DIM, a, center=True)

    # ondas al hacer clic
    for rp in list(S["ripples"]):
        age = t - rp[2]
        if age > 0.7:
            S["ripples"].remove(rp)
            continue
        k = age / 0.7
        cr.set_source_rgba(*A, (1 - k) * 0.7)
        cr.set_line_width(3 * (1 - k) + 0.5)
        cr.new_sub_path()                       # sin esto el trazo se une con el punto anterior (línea suelta)
        cr.arc(rp[0], rp[1], 20 + 160 * ease_out_strong(k), 0, 2 * math.pi)
        cr.stroke()
    if U.CYBER:                                                              # tinte de líneas de escaneo sobre todo
        cr.set_source_rgba(*A, 0.03 * op)
        for yy in range(0, int(h), 4):
            cr.rectangle(0, yy, w, 1)
        cr.fill()
    if lay not in ("orbit", "row"):
        draw_text(cr, f"{len(S['idx'])} / {len(S['items'])}" if S["query"] else f"{len(S['items'])}", w - 24, 30, 11, DIM, pop * 0.8, right=True)


# ----------------------------------------------------------------------------- ejecución


def hit_item(S, px, py):
    best, bd = None, 1e9
    if S["layout"] == "game":                                  # opciones del menú de juego: una fila alta por opción
        w, h = S["size"]
        for (x, y), i in zip(game_pos(w, h, len(S["idx"])), S["idx"]):
            if x - 34 <= px <= x + 460 and y - 34 <= py <= y + 30:
                return i
        return None
    for i, cur in S["pos"].items():
        x, y, sc = cur[0], cur[1], cur[2]
        if S["layout"] == "wheel":
            if abs(px - x) <= 260 * sc and abs(py - y) <= 28 * sc:
                d = abs(py - y)
                if d < bd:
                    best, bd = i, d
        elif S["layout"] in ("row", "grid"):
            half = 56 if S["layout"] == "row" else 46
            if abs(px - x) <= half and -half - 6 <= py - y <= half + 26:
                d = math.hypot(px - x, py - y)
                if d < bd:
                    best, bd = i, d
        else:
            rad = (54 if S["layout"] == "orbit" else 40) * sc
            d = math.hypot(px - x, py - y)
            if d <= rad and d < bd:
                best, bd = i, d
    return best


def run(args):
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gdk, GLib, Gtk, Gtk4LayerShell as LS

    def opt(name, default=None):
        return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default

    ensure_env()
    U.overlay_hold()                               # el personajito del escritorio se esconde mientras este menú trae el suyo
    layout = opt("--layout", "wheel")
    if "--input" in args:                          # modo escribir: devuelve el texto tipeado (para HEX, nombres, etc.)
        layout = "input"
        items = [dict(id="__input__", label="", icon="", sub="")]
    else:
        items = parse_items(sys.stdin.read())
        if not items:
            return 1
    layout = {"tiles": "orbit", "list": "wheel"}.get(layout, layout)
    if U.FRESH:                          # estilo fresco: menú de juego (pocas opciones) y cuadrícula limpia de íconos
        layout = {"orbit": "game", "row": "game", "bubbles": "grid"}.get(layout, layout)
    elif layout == "grid":
        layout = "bubbles"
    if layout not in ("orbit", "wheel", "bubbles", "row", "grid", "game", "input"):
        layout = "wheel"
    pal = U.load_palette()
    pal_full = BUDDY.load_palette() if BUDDY else pal
    rnd = random.Random(7)
    S = dict(items=items, layout=layout, title=opt("--title", ""), placeholder=opt("--placeholder", "Escribí para buscar…"),
             ind=0.0, wins=[(fx, fy, ww, hh, dp, ph, [rnd.uniform(0.3, 1.0) for _ in range(int(hh / 13) - 2)])
                            for fx, fy, ww, hh, dp, ph in ((0.50, 0.17, 240, 150, 1.0, 0.0), (0.79, 0.10, 210, 120, 0.7, 1.6),
                                                           (0.58, 0.47, 190, 118, 0.6, 3.1), (0.85, 0.40, 220, 140, 1.2, 4.4),
                                                           (0.46, 0.64, 170, 100, 0.5, 2.2), (0.90, 0.66, 170, 104, 0.85, 5.3))],
             search=("--no-search" not in args and layout not in ("orbit", "row", "game")), query="", scroll=0, idx=([] if layout == "input" else list(range(len(items)))), sel=(-1 if layout == "input" else 0),
             selk=0.0, t0=time.time(), t=0.0, dt=0.016, last=time.time(), closing=None, close_t0=None, hov={}, hover=None,
             ptr=(640.0, 400.0), result=None, size=(1280, 800), pos={}, tg={}, ripples=[], drift=0.0,
             parts=[(rnd.random(), rnd.random(), rnd.uniform(0.6, 2.0), rnd.uniform(0.8, 2.2), rnd.random() * 6.28, rnd.uniform(0.5, 3)) for _ in range(46)])
    want = opt("--select")
    if want:
        for i, it in enumerate(items):
            if it["id"] == want:
                S["sel"] = i
    app = Gtk.Application(application_id="local.hyprarch.pick")
    code = {"v": 1}

    def reselect():
        if S["idx"] and S["sel"] not in S["idx"]:
            S["sel"] = S["idx"][0]
        elif not S["idx"]:
            S["sel"] = -1

    def sel_pos():
        return S["idx"].index(S["sel"]) if S["sel"] in S["idx"] else 0

    def on_activate(app):
        win = Gtk.ApplicationWindow(application=app)
        win.set_decorated(False)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(win, edge, True)
        LS.set_exclusive_zone(win, -1)
        LS.set_namespace(win, "hyprarch-menu")
        LS.set_keyboard_mode(win, LS.KeyboardMode.EXCLUSIVE)
        area = Gtk.DrawingArea()
        win.set_child(area)
        css = Gtk.CssProvider()
        css.load_from_data(b"window, window.background { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(win.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def close(result=None):
            if S["closing"] is None:
                S["closing"] = 0.0
                S["close_t0"] = time.time()
                S["result"] = result
                U.play("menu-select" if result is not None else "menu-back")

        def draw(_a, cr, w, h):
            S["size"] = (w, h)
            try:
                import cairo

                cr.set_operator(cairo.OPERATOR_CLEAR)
                cr.paint()
                cr.set_operator(cairo.OPERATOR_OVER)
                draw_scene(cr, w, h, S, pal, pal_full)
            except Exception as e:
                if os.environ.get("HYPRARCH_DEBUG"):
                    import traceback

                    traceback.print_exc()
                    print("error de dibujo:", repr(e), file=sys.stderr)

        area.set_draw_func(draw)

        def on_motion(_c, px, py):
            S["ptr"] = (px, py)
            hv = hit_item(S, px, py)
            if hv != S["hover"]:
                S["hover"] = hv
                if hv is not None:
                    S["sel"] = hv
                    if layout == "wheel" and hv in S["idx"]:
                        S["selk_target"] = S["idx"].index(hv)
                    U.play(f"menu-move-{(S['idx'].index(hv) if hv in S['idx'] else 0) % 6}")

        def on_click(_g, _n, px, py):
            if S["closing"] is not None:
                return
            S["ripples"].append((px, py, S["t"]))
            iid = hit_item(S, px, py)
            if layout == "input":
                return
            if iid is not None:
                close(items[iid]["id"])
            elif layout == "orbit":
                cx, cy = S["size"][0] / 2, S["size"][1] / 2 + 118
                if math.hypot(px - cx, py - cy) > min(S["size"]) * 0.45:
                    close()
            else:
                close()

        def move(delta):
            if not S["idx"]:
                return
            k = max(0, min(len(S["idx"]) - 1, sel_pos() + delta))
            S["sel"] = S["idx"][k]
            if layout in ("bubbles", "grid"):
                vis = 4 if layout == "grid" else 5
                row = k // cols()
                if row < S["scroll"]:
                    S["scroll"] = row
                elif row >= S["scroll"] + vis:
                    S["scroll"] = row - vis + 1
            U.play(f"menu-move-{k % 6}")

        def cols():
            if layout == "grid":
                return grid_cols(len(S["idx"]))
            return max(3, int(math.ceil(math.sqrt(max(1, min(len(S["idx"]), 60)) * 1.7))))

        def on_key(_c, keyval, _kc, state):
            name = Gdk.keyval_name(keyval) or ""
            ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
            if name == "Escape":
                close()
            elif name in ("Return", "KP_Enter"):
                if layout == "input":
                    if S["query"].strip():
                        close(S["query"].strip())
                elif S["sel"] in S["idx"]:
                    close(items[S["sel"]]["id"])
            elif name == "Down" or (name == "Tab" and not ctrl) or (ctrl and name in ("n", "j")):
                move(cols() if layout in ("bubbles", "grid") else 1)
            elif name in ("Up", "ISO_Left_Tab") or (ctrl and name in ("p", "k")):
                move(-cols() if layout in ("bubbles", "grid") else -1)
            elif name == "Right":
                move(1)
            elif name == "Left":
                move(-1)
            elif name == "Page_Down":
                move(7)
            elif name == "Page_Up":
                move(-7)
            elif name == "Home":
                move(-9999)
            elif name == "End":
                move(9999)
            elif name == "BackSpace" and S["search"]:
                S["query"] = S["query"][:-1]
                S["idx"] = filtered(items, S["query"])
                S["scroll"] = 0
                reselect()
            elif layout in ("orbit", "row", "game") and name.isdigit() and 1 <= int(name) <= len(S["idx"]):
                close(items[S["idx"][int(name) - 1]]["id"])
            elif S["search"] and not ctrl:
                ch = Gdk.keyval_to_unicode(keyval)
                if ch and chr(ch).isprintable():
                    S["query"] += chr(ch)
                    S["idx"] = filtered(items, S["query"])
                    S["scroll"] = 0
                    reselect()
                    U.play("menu-hover")
            return True

        def on_scroll(_c, _dx, dy):
            if layout == "wheel":
                move(1 if dy > 0 else -1)
            elif layout in ("bubbles", "grid"):
                rows = int(math.ceil(len(S["idx"]) / cols()))
                vis = 4 if layout == "grid" else 5
                S["scroll"] = int(max(0, min(max(0, rows - vis), S["scroll"] + (1 if dy > 0 else -1))))
            return True

        mo = Gtk.EventControllerMotion()
        mo.connect("motion", on_motion)
        mo.connect("leave", lambda *_: S.update(hover=None))
        area.add_controller(mo)
        cl = Gtk.GestureClick()
        cl.connect("pressed", on_click)
        area.add_controller(cl)
        kc = Gtk.EventControllerKey()
        kc.connect("key-pressed", on_key)
        win.add_controller(kc)
        sc = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        sc.connect("scroll", on_scroll)
        area.add_controller(sc)

        def tick():
            now = time.time()
            S["dt"] = max(0.001, min(0.05, now - S["last"]))
            S["last"] = now
            S["t"] = now - S["t0"]
            S["drift"] += S["dt"] * (0.0 if S["hover"] is not None else 0.06)      # la órbita gira despacio y frena al apuntar
            tgt = S.get("selk_target")
            if tgt is None or layout != "wheel":
                tgt = sel_pos()
            S["selk"] += (sel_pos() - S["selk"]) * (1 - math.exp(-S["dt"] * 11)) if layout == "wheel" else 0
            if S["close_t0"] is not None:
                S["closing"] = now - S["close_t0"]
                if S["closing"] > U.CLOSE_T:
                    if S["result"] is not None:
                        print(str(S["result"]), flush=True)
                        code["v"] = 0
                    app.quit()
                    return False
            for i in range(len(items)):
                cur = S["hov"].get(i, 0.0)
                S["hov"][i] = cur + ((1.0 if S["sel"] == i else 0.0) - cur) * 0.30
            area.queue_draw()
            return True

        U.play("menu-open")
        GLib.timeout_add(16, tick)
        win.present()

    app.connect("activate", on_activate)
    app.run(None)
    return code["v"]


def render_frames(outdir):
    import cairo

    out = Path(outdir)
    out.mkdir(parents=True, exist_ok=True)
    pal = U.load_palette()
    pal_full = BUDDY.load_palette() if BUDDY else pal
    power = parse_items("lock\tBloquear\t\napagar\tApagar\t\nreiniciar\tReiniciar\t\nsuspender\tSuspender\t\nsalir\tCerrar sesión\t")
    apps = parse_items("\n".join(f"{n}\t{n}\t\t{s}" for n, s in (
        ("Firefox", "Navegador web"), ("Archivos", "Thunar"), ("Terminal", "kitty"), ("Mousepad", "Editor de texto"),
        ("mpv", "Reproductor"), ("Zathura", "Visor de PDF"), ("Neovim", "Editor"), ("btop", "Monitor del sistema"),
        ("Bluetooth", "Gestor"), ("Volumen", "Control de audio"), ("Imágenes", "imv"), ("Tema", "Colores"),
        ("Calculadora", "Utilidad"), ("Fotos", "Visor"), ("Música", "Reproductor"), ("Steam", "Juegos"), ("Discord", "Chat"),
        ("Códigos", "Editor"), ("Notas", "Obsidian"), ("Mapas", "Web"))))
    cases = (("q1-orbita", "orbit", power, 1.3, "", 1, (860, 330)), ("q2-rueda", "wheel", apps, 1.3, "", 3, (640, 420)),
             ("q3-burbujas", "bubbles", apps, 1.4, "", 5, (600, 380)), ("q4-busqueda", "wheel", apps, 1.3, "ar", 0, (640, 420)))
    for name, lay, items, t, q, sel, ptr in cases:
        title0 = {"orbit": "¿Qué querés hacer?", "wheel": "Portapapeles", "bubbles": "Aplicaciones"}[lay]
        if U.FRESH:
            lay = {"orbit": "game", "bubbles": "grid"}.get(lay, lay)
            if lay == "game":
                items = parse_items("continue\tContinuar\t\tCierra este menú y sigues trabajando donde estabas.\n"
                                    "lock\tBloquear\t\tBloquea la pantalla. Tus programas siguen abiertos; para volver se pide la contraseña.\n"
                                    "suspend\tSuspender\t\tPone el equipo en reposo y ahorra energía. Al volver, todo está como lo dejaste.\n"
                                    "reboot\tReiniciar\t\tCierra todo y vuelve a encender el equipo. Guardá tu trabajo antes.\n"
                                    "poweroff\tApagar\t\tCierra todo y apaga el equipo por completo. Guardá tu trabajo antes.\n"
                                    "exit\tCerrar sesión\t\tCierra tu sesión y vuelve a la pantalla de inicio. Se cierran tus programas.")
                sel = 4
        S = dict(items=items, layout=lay, title=title0,
                 placeholder="Escribí para buscar…", search=(lay not in ("orbit", "row")), query=q, scroll=0, idx=[], sel=sel, selk=0.0, t=t, dt=0.05,
                 closing=None, hov={sel: 1.0}, hover=sel, ptr=ptr, size=(1280, 800), pos={}, tg={}, ripples=[], drift=0.0, ind=0.0,
                 info_id=sel, info_t=-5.0, kick=-5.0,
                 wins=[(fx, fy, ww, hh, dp, ph, [random.Random(int(ph * 10) + k).uniform(0.3, 1.0) for k in range(int(hh / 13) - 2)])
                       for fx, fy, ww, hh, dp, ph in ((0.50, 0.17, 240, 150, 1.0, 0.0), (0.79, 0.10, 210, 120, 0.7, 1.6),
                                                      (0.58, 0.47, 190, 118, 0.6, 3.1), (0.85, 0.40, 220, 140, 1.2, 4.4),
                                                      (0.46, 0.64, 170, 100, 0.5, 2.2), (0.90, 0.66, 170, 104, 0.85, 5.3))],
                 parts=[(random.Random(i).random(), random.Random(i + 9).random(), 1.0, 1.4, i * 0.7, 1.5) for i in range(40)])
        S["idx"] = filtered(items, q)
        if sel not in S["idx"]:
            S["sel"] = S["idx"][0] if S["idx"] else -1
        S["selk"] = float(S["idx"].index(S["sel"])) if S["sel"] in S["idx"] else 0.0
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1280, 800)
        cr = cairo.Context(surf)
        cr.set_source_rgb(0.03, 0.05, 0.04)
        cr.paint()
        for _ in range(40):                 # varias pasadas para que las posiciones lleguen a su objetivo
            S["t"] = S["t"] + 0.0
            draw_scene(cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1280, 800)), 1280, 800, S, pal, pal_full)
        draw_scene(cr, 1280, 800, S, pal, pal_full)
        path = out / f"{name}.png"
        surf.write_to_png(str(path))
        print(path)
    return 0


if __name__ == "__main__":
    a = sys.argv[1:]
    if a and a[0] == "frames":
        sys.exit(render_frames(a[1] if len(a) > 1 else "frames"))
    sys.exit(run(a))
