#!/usr/bin/env bash
# hyprarch-update — actualizar el sistema con una red de seguridad.
#
#   hyprarch-update          actualiza (pide confirmación y muestra lo que cambia); guarda antes la lista de versiones
#   hyprarch-update undo     deshace la última actualización con los paquetes que ya estaban descargados
#   hyprarch-update status   cuántas actualizaciones hay y cuándo fue la última
#
# Antes de cada actualización se guarda ~/.local/state/hyprarch/updates/<fecha>.txt (nombre y versión de cada paquete).
# «undo» compara con esa lista y reinstala las versiones anteriores desde /var/cache/pacman/pkg (pacman las conserva).
# No funciona en la sesión en vivo del USB (todo vive en memoria): primero instala hyprarch en el disco.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hyprarch/updates"
T() { hyprarch-i18n "$1" "${2:-$1}" 2>/dev/null || printf '%s' "${2:-$1}"; }
note() { command -v notify-send >/dev/null 2>&1 && notify-send -a hyprarch -t "${3:-9000}" "$1" "${2:-}"; }
online() { [[ $(nmcli -t -f STATE general 2>/dev/null) == connected ]] || timeout 3 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>/dev/null; }
term() { kitty --class hyprarch-ai-answer -o font_size=11 -o window_padding_width=14 --title "$1" -e bash -c "$2"; }
mkdir -p "$STATE"

[[ -d /run/archiso ]] && { note "$(T upd.title 'Actualizar')" "$(T upd.live 'En el USB en vivo no se actualiza. Instala hyprarch en el disco primero.')"; exit 0; }

latest() { ls -1 "$STATE"/*.txt 2>/dev/null | sort | tail -n1; }

do_update() {
  online || { note "$(T upd.title 'Actualizar')" "$(T upd.nonet 'Falta Internet. Conéctate al Wi-Fi y vuelve a intentarlo.')"; exit 0; }
  local snap
  snap="$STATE/$(date +%Y%m%d-%H%M%S).txt"
  pacman -Q > "$snap" 2>/dev/null
  term "Actualizar hyprarch" "printf '\n  Se guardó la lista de versiones actual para poder deshacer.\n\n'; sudo pacman -Syu; rc=\$?; echo; if [ \$rc -eq 0 ]; then echo '  Listo.'; else echo '  Algo falló (código '\$rc'). Puedes deshacer con: hyprarch-update undo'; fi; read -rp '  (Enter para cerrar) ' _; exit \$rc"
  note "$(T upd.title 'Actualizar')" "$(T upd.done 'Terminó. Si se actualizó el sistema, reinicia para usar lo nuevo.')"
}

do_undo() {
  local snap; snap=$(latest)
  [[ -n $snap ]] || { note "$(T upd.title 'Actualizar')" "$(T upd.nosnap 'No hay ninguna actualización guardada que deshacer.')"; exit 0; }
  local list files="" missing="" name old cur f
  declare -A now
  while read -r name cur; do now[$name]=$cur; done < <(pacman -Q 2>/dev/null)   # una sola consulta (cientos de paquetes)
  list=$(mktemp)
  # paquetes cuya versión actual difiere de la guardada
  while read -r name old; do
    cur=${now[$name]:-}
    [[ -n $cur && $cur != "$old" ]] || continue
    f=""; for c in /var/cache/pacman/pkg/"$name"-"$old"-*.pkg.tar.*; do [[ -f $c && $c != *.sig ]] && f=$c; done
    if [[ -n $f ]]; then files+="$f "; echo "$name $cur -> $old" >> "$list"; else missing+="$name "; fi
  done < "$snap"
  if [[ ! -s $list ]]; then
    note "$(T upd.title 'Actualizar')" "$(T upd.nochange 'No hay cambios que deshacer.')"; rm -f "$list"; exit 0
  fi
  term "Deshacer actualización" "printf '\n  Se volverá a estas versiones:\n\n'; cat '$list'; [ -n '$missing' ] && printf '\n  (sin copia guardada, se dejan como están: $missing)\n'; echo; read -rp '  ¿Seguir? [s/N] ' r; case \$r in s|S|y|Y) sudo pacman -U --noconfirm $files; echo; echo '  Listo. Reinicia la sesión.';; *) echo '  Cancelado.';; esac; read -rp '  (Enter para cerrar) ' _"
  rm -f "$list"
}

case ${1:-update} in
  update) do_update ;;
  undo)   do_undo ;;
  status) printf 'última lista guardada: %s\n' "$(latest || echo ninguna)"; ;;
  *)      echo "uso: hyprarch-update [undo|status]" >&2; exit 2 ;;
esac
