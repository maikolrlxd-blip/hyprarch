#!/usr/bin/env bash
# hyprarch-win — ventanas al estilo Windows, sin plugins ni procesos residentes (cada llamada hace su trabajo y termina).
#
#   hyprarch-win left | right      ajusta la ventana a la mitad izquierda / derecha de la pantalla (Super + ← / →)
#   hyprarch-win max               maximiza (Super + ↑)
#   hyprarch-win down              restaura si estaba maximizada o ajustada; si no, la minimiza (Super + ↓)
#   hyprarch-win minimize          la manda al espacio «minimizadas» (se ve en la barra; Super + M)
#   hyprarch-win restore           trae de vuelta la última minimizada (Super + Shift + M)
#   hyprarch-win restore-all       trae de vuelta todas las minimizadas
#
# Al ajustar o maximizar se guarda cómo estaba la ventana (en mosaico o flotante, su tamaño y sitio) para poder restaurarla.
set -u
RUN=${XDG_RUNTIME_DIR:-}
[[ -n $RUN && -d $RUN ]] || { echo "hyprarch-win: falta el directorio de sesion (XDG_RUNTIME_DIR)" >&2; exit 1; }
ST="$RUN/hyprarch-win"
mkdir -p "$ST" && chmod 700 "$ST"
GAP=8
# una sola ejecucion a la vez: dos restauraciones simultaneas leian la misma ultima ventana y perdian entradas de la lista
exec 9>"$ST/.lock" && flock -w 5 9 || exit 1

ev() { hyprctl eval "$1" >/dev/null 2>&1; }
note() { command -v notify-send >/dev/null 2>&1 && notify-send -t 2500 "$1" "${2:-}"; }
dsp() { ev "hl.dispatch(hl.dsp.window.$1)"; }       # dsp 'float({ action = "enable", window = "..." })'

load_active() {
  win=$(hyprctl activewindow -j 2>/dev/null)
  addr=$(jq -r '.address // empty' <<<"$win" 2>/dev/null)
  [[ $addr =~ ^0x[0-9a-fA-F]+$ ]] || return 1                   # sin ventana activa: nada que hacer
  W="window = \"address:$addr\""
  STATE="$ST/$addr"
}
win="" addr="" W="" STATE=""

save_state() {  # guarda cómo estaba la ventana la primera vez que se toca
  [[ -e $STATE ]] && return 0
  jq -c '{floating, at, size}' <<<"$win" > "$STATE"
}

workarea() {  # x y ancho alto del área útil del monitor de la ventana (descontando la barra)
  local mon; mon=$(jq -r '.monitor // 0' <<<"$win")
  hyprctl monitors -j | jq -r --argjson id "$mon" \
    '.[] | select(.id == $id) | "\(.x + .reserved[0]) \(.y + .reserved[1]) \((.width / .scale | floor) - .reserved[0] - .reserved[2]) \((.height / .scale | floor) - .reserved[1] - .reserved[3])"'
}

snap() {  # left | right
  local wx wy ww wh x w h
  read -r wx wy ww wh < <(workarea)
  [[ -n ${ww:-} ]] || exit 0
  save_state
  [[ $(jq -r '.fullscreen' <<<"$win") != 0 ]] && dsp "fullscreen({ mode = \"maximized\", action = \"toggle\", $W })"
  w=$(( (ww - GAP * 3) / 2 )); h=$(( wh - GAP * 2 ))
  if [[ $1 == left ]]; then x=$(( wx + GAP )); else x=$(( wx + GAP * 2 + w )); fi
  dsp "float({ action = \"enable\", $W })"
  dsp "resize({ x = $w, y = $h, exact = true, $W })"
  dsp "move({ x = $x, y = $(( wy + GAP )), $W })"
}

maximize() {
  save_state
  [[ $(jq -r '.fullscreen' <<<"$win") == 0 ]] && dsp "fullscreen({ mode = \"maximized\", action = \"toggle\", $W })"
}

restore() {  # devuelve 0 si había algo que restaurar
  local fs; fs=$(jq -r '.fullscreen' <<<"$win")
  [[ $fs != 0 || -e $STATE ]] || return 1
  [[ $fs != 0 ]] && dsp "fullscreen({ mode = \"maximized\", action = \"toggle\", $W })"
  if [[ -e $STATE ]]; then
    local fl x y w h
    fl=$(jq -r '.floating' "$STATE"); x=$(jq -r '.at[0]' "$STATE"); y=$(jq -r '.at[1]' "$STATE")
    w=$(jq -r '.size[0]' "$STATE"); h=$(jq -r '.size[1]' "$STATE")
    for v in "$x" "$y" "$w" "$h"; do [[ $v =~ ^-?[0-9]+$ ]] || { rm -f -- "$STATE"; return 0; }; done
    if [[ $fl == true ]]; then
      dsp "resize({ x = $w, y = $h, exact = true, $W })"
      dsp "move({ x = $x, y = $y, $W })"
    else
      dsp "float({ action = \"disable\", $W })"                  # vuelve al mosaico
    fi
    rm -f -- "$STATE"
  fi
  return 0
}

minimize() {
  save_state
  printf '%s\n' "$addr" >> "$ST/minimized"
  dsp "move({ workspace = \"special:minimizadas\", follow = false, $W })"
  note "Ventana minimizada" "Super + Shift + M la trae de vuelta"
}

restore_one() {
  [[ -s $ST/minimized ]] || { note "No hay ventanas minimizadas"; return 0; }
  local last ws
  last=$(tail -n1 "$ST/minimized")
  sed -i '$d' "$ST/minimized"
  [[ $last =~ ^0x[0-9a-fA-F]+$ ]] || return 0
  hyprctl clients -j | jq -e --arg a "$last" 'any(.[]; .address == $a)' >/dev/null 2>&1 || { restore_one; return; }
  ws=$(hyprctl activeworkspace -j | jq -r '.id')
  [[ $ws =~ ^[0-9]+$ ]] || return 1
  ev "hl.dispatch(hl.dsp.window.move({ workspace = \"$ws\", window = \"address:$last\" }))"
  ev "hl.dispatch(hl.dsp.focus({ window = \"address:$last\" }))"
  rm -f -- "$ST/$last"
}

case ${1:-} in
  left|right) load_active || exit 0; snap "$1" ;;
  max)        load_active || exit 0; maximize ;;
  down)       load_active || exit 0; restore || minimize ;;
  minimize)   load_active || exit 0; minimize ;;
  restore)    restore_one ;;
  restore-all) while [[ -s $ST/minimized ]]; do restore_one; done ;;
  *) echo "Uso: hyprarch-win {left|right|max|down|minimize|restore|restore-all}" >&2; exit 2 ;;
esac
