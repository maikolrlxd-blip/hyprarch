#!/usr/bin/env python3
"""hyprarch-intro — animación de entrada a pantalla completa (se reproduce al iniciar la sesión).

Uso:
  hyprarch-intro            la reproduce ahora (clic o cualquier tecla = saltar)
  hyprarch-intro --once     solo una vez por arranque (la usa Hyprland al iniciar)
  hyprarch-intro frames D   (desarrollo) dibuja fotogramas clave en PNG dentro de la carpeta D

Se desactiva con:  echo off > ~/.config/hyprarch/intro
Los colores salen del tema activo (los mismos que usa el personajito).
"""
import importlib.machinery
import importlib.util
import math
import os
import random
import re
import sys
import time
from pathlib import Path

DURATION = 6.4          # segundos en total
SKIP_FADE = 0.45        # al saltar, el desvanecido final dura esto

# ----------------------------------------------------------------------------- utilidades


def clamp(x, a=0.0, b=1.0):
    return max(a, min(b, x))


def ease_out(x):
    x = clamp(x)
    return 1 - (1 - x) ** 3


def ease_in_out(x):
    x = clamp(x)
    return x * x * (3 - 2 * x)


def seg(t, a, b):
    """Progreso 0..1 de t dentro del tramo [a, b]."""
    return clamp((t - a) / (b - a)) if b > a else (1.0 if t >= a else 0.0)


def load_palette():
    default = dict(ACCENT="39ff14", ACCENT2="ff1f4b", BG="0a0c0b", FG="d7ffe3", DIM="5f7367")
    pal = dict(default)
    try:
        home = Path.home()
        cur = (home / ".config/hyprarch/current").read_text().strip() or "verde"
        f = home / ".config/hyprarch/custom.env" if cur == "custom" else Path(f"/usr/share/hyprarch/themes/{cur}.env")
        for line in f.read_text().splitlines():
            m = re.match(r'^([A-Z0-9_]+)=("?)([^"#]*)\2', line.strip())
            if m and m.group(1) in default:
                pal[m.group(1)] = m.group(3).strip()
    except Exception:
        pass
    out = {}
    for k, d in default.items():
        v = str(pal.get(k, d)).strip().lstrip("#")
        v = v if re.fullmatch(r"[0-9a-fA-F]{6}", v) else d
        out[k] = tuple(int(v[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return out


def load_buddy():
    """Importa draw_mascot del personajito (si está instalado) para que entre volando a saludar."""
    for name in ("hyprarch-buddy", "claude-presence"):
        for base in ("/usr/local/bin", str(Path(__file__).resolve().parent)):
            p = Path(base) / name
            if p.exists():
                try:
                    loader = importlib.machinery.SourceFileLoader("buddy_mod", str(p))
                    spec = importlib.util.spec_from_loader("buddy_mod", loader)
                    mod = importlib.util.module_from_spec(spec)
                    loader.exec_module(mod)
                    return mod
                except Exception:
                    pass
    return None


# ----------------------------------------------------------------------------- dibujo


class Scene:
    def __init__(self, pal, buddy=None, seed=3):
        self.pal = pal
        self.buddy = buddy
        rnd = random.Random(seed)
        self.stars = [(rnd.random(), rnd.random() ** 1.5 * 0.6, rnd.random(), rnd.random() * 6.28) for _ in range(140)]
        self.glitch = [(rnd.random(), rnd.random() * 0.8 + 0.2) for _ in range(48)]

    # --- piezas -------------------------------------------------------------
    def glow_line(self, cr, x0, y0, x1, y1, col, width, alpha):
        for k, a in ((10, 0.06), (5, 0.12), (2.2, 0.30), (1.0, 1.0)):
            cr.set_source_rgba(*col, alpha * a)
            cr.set_line_width(width * k)
            cr.move_to(x0, y0)
            cr.line_to(x1, y1)
            cr.stroke()

    def sky(self, cr, w, h, hor, t):
        A = self.pal["ACCENT"]
        for sx, sy, br, ph in self.stars:
            tw = 0.55 + 0.45 * math.sin(t * 2.2 + ph)
            cr.set_source_rgba(0.85, 1.0, 0.92, 0.55 * br * tw * seg(t, 0.3, 1.4))
            cr.arc(sx * w, sy * hor, 0.9 + br, 0, 2 * math.pi)
            cr.fill()
        # resplandor del horizonte
        import cairo
        rg = cairo.LinearGradient(0, hor - h * 0.28, 0, hor)
        rg.add_color_stop_rgba(0, *A, 0.0)
        rg.add_color_stop_rgba(1, *A, 0.20 * seg(t, 0.5, 1.6))
        cr.set_source(rg)
        cr.rectangle(0, hor - h * 0.28, w, h * 0.28)
        cr.fill()

    def sun(self, cr, w, h, hor, t):
        import cairo
        A, A2 = self.pal["ACCENT"], self.pal["ACCENT2"]
        p = ease_out(seg(t, 0.9, 2.5))
        if p <= 0:
            return
        R = h * 0.19
        cx = w / 2
        cy = hor - R * 0.28 + (1 - p) * R * 1.55
        cr.save()
        cr.rectangle(0, 0, w, hor)             # el sol sale por detrás del horizonte
        cr.clip()
        # halo
        halo = cairo.RadialGradient(cx, cy, R * 0.6, cx, cy, R * 2.3)
        halo.add_color_stop_rgba(0, *A, 0.28 * p)
        halo.add_color_stop_rgba(1, *A, 0.0)
        cr.set_source(halo)
        cr.arc(cx, cy, R * 2.3, 0, 2 * math.pi)
        cr.fill()
        # disco con degradado
        g = cairo.LinearGradient(0, cy - R, 0, cy + R)
        g.add_color_stop_rgba(0, *A, 1.0)
        g.add_color_stop_rgba(1, A[0] * 0.45, A[1] * 0.45, A[2] * 0.45, 1.0)
        cr.set_source(g)
        cr.arc(cx, cy, R, 0, 2 * math.pi)
        cr.fill()
        # rayas que se engrosan hacia abajo
        cr.set_source_rgba(*self.pal["BG"], 1.0)
        for k in range(7):                      # de la mitad del sol hacia el horizonte, cada vez más gruesas
            f = k / 6
            y = cy - R * 0.42 + R * 0.66 * f
            th = R * 0.018 + R * 0.060 * f
            cr.rectangle(cx - R, y, 2 * R, th)
            cr.fill()
        # aro carmesí
        cr.set_source_rgba(*A2, 0.9)
        cr.set_line_width(max(2.0, h * 0.0035))
        cr.arc(cx, cy, R, 0, 2 * math.pi)
        cr.stroke()
        cr.restore()

    def grid(self, cr, w, h, hor, t):
        A = self.pal["ACCENT"]
        gp = seg(t, 0.55, 1.9)
        if gp <= 0:
            return
        cr.save()
        cr.rectangle(0, hor, w, h - hor)
        cr.clip()
        cx = w / 2
        n = 22
        for i in range(-n, n + 1):
            xb = cx + i * w * 0.115
            a = (0.55 if i % 4 else 0.85) * gp * (1 - abs(i) / (n + 3))
            self.glow_line(cr, cx + i * 3, hor, xb, h, A, 0.7, a * 0.9)
        scroll = (t * 0.42) % 1.0
        for k in range(18):
            f = ((k + scroll) / 18)
            y = hor + (h - hor) * f ** 2.4
            a = gp * min(1.0, f * 6) * 0.9
            self.glow_line(cr, 0, y, w, y, A, 0.7, a * 0.85)
        cr.restore()

    def horizon(self, cr, w, h, hor, t):
        A2 = self.pal["ACCENT2"]
        p = ease_out(seg(t, 0.05, 0.85))
        if p <= 0:
            return
        half = p * w * 0.52
        self.glow_line(cr, w / 2 - half, hor, w / 2 + half, hor, A2, 1.2, 0.95)

    def text_spaced(self, cr, s, cx, y, size, spacing, color, alpha, count=None, dx=0.0):
        import cairo
        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(size)
        widths = [cr.text_extents(c).x_advance for c in s]
        total = sum(widths) + spacing * (len(s) - 1)
        x = cx - total / 2 + dx
        n = len(s) if count is None else count
        for i, ch in enumerate(s[:n]):
            cr.set_source_rgba(*color, alpha)
            cr.move_to(x, y)
            cr.show_text(ch)
            x += widths[i] + spacing

    def title(self, cr, w, h, t):
        import cairo
        A, A2, FG = self.pal["ACCENT"], self.pal["ACCENT2"], self.pal["FG"]
        s = "HYPRARCH"
        size = h * 0.115
        y = h * 0.30
        letters = int(seg(t, 1.9, 2.9) * (len(s) + 0.999))
        if letters <= 0:
            return
        # glitch: durante el tramo de aparición y en ráfagas cortas después
        gl = 0.0
        if 1.9 <= t < 3.1:
            gl = 1.0 - seg(t, 2.6, 3.1)
        elif 4.6 < t < 4.72 or 5.1 < t < 5.18:
            gl = 0.7
        jitter = (random.Random(int(t * 30)).random() - 0.5) * size * 0.25 * gl
        sp = size * 0.20
        cr.save()
        cr.set_operator(cairo.OPERATOR_ADD)
        if gl > 0:
            self.text_spaced(cr, s, w / 2, y, size, sp, A2, 0.75, letters, dx=-size * 0.05 * gl + jitter)
            self.text_spaced(cr, s, w / 2, y, size, sp, (0.1, 0.9, 1.0), 0.65, letters, dx=size * 0.05 * gl - jitter)
        cr.set_operator(cairo.OPERATOR_OVER)
        # resplandor y trazo principal
        for blur_a, off in ((0.10, 3), (0.18, 1.5)):
            for ox, oy in ((-off, 0), (off, 0), (0, -off), (0, off)):
                cr.save()
                cr.translate(ox, oy)
                self.text_spaced(cr, s, w / 2, y, size, sp, A, blur_a, letters, dx=jitter)
                cr.restore()
        self.text_spaced(cr, s, w / 2, y, size, sp, FG, 0.97, letters, dx=jitter)
        cr.restore()
        # destello que barre el título una vez
        sw = seg(t, 3.1, 3.9)
        if 0 < sw < 1:
            cr.save()
            cr.set_operator(cairo.OPERATOR_ADD)
            g = cairo.LinearGradient(w * (0.25 + 0.5 * sw) - 60, 0, w * (0.25 + 0.5 * sw) + 60, 0)
            g.add_color_stop_rgba(0, 1, 1, 1, 0.0)
            g.add_color_stop_rgba(0.5, 1, 1, 1, 0.22)
            g.add_color_stop_rgba(1, 1, 1, 1, 0.0)
            cr.set_source(g)
            cr.rectangle(w * 0.2, y - size, w * 0.6, size * 1.3)
            cr.fill()
            cr.restore()

    def subtitle(self, cr, w, h, t):
        s = "una casa para IAs"
        p = seg(t, 3.0, 4.0)
        if p <= 0:
            return
        n = int(p * (len(s) + 0.999))
        size = h * 0.030
        y = h * 0.30 + h * 0.075
        self.text_spaced(cr, s, w / 2, y, size, size * 0.30, self.pal["DIM"] if p >= 1 else self.pal["FG"], 0.95, n)
        # cursor que parpadea mientras escribe y un poco después
        if t < 4.9 and int(t * 4) % 2 == 0:
            import cairo
            cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(size)
            widths = [cr.text_extents(c).x_advance for c in s]
            total = sum(widths) + size * 0.30 * (len(s) - 1)
            x = w / 2 - total / 2 + sum(widths[:n]) + size * 0.30 * n
            cr.set_source_rgba(*self.pal["ACCENT"], 0.95)
            cr.rectangle(x + 2, y - size * 0.85, size * 0.12, size * 0.95)
            cr.fill()

    def mascot(self, cr, w, h, t):
        if not self.buddy:
            return
        p = ease_in_out(seg(t, 3.9, 5.3))
        if p <= 0:
            return
        rest = (w - 90, h - 24)                          # donde vive el personajito
        x = rest[0] + (1 - p) * w * 0.30
        y = rest[1] - math.sin(p * math.pi) * h * 0.20   # llega en arco
        try:
            self.buddy.draw_mascot(cr, x, y, "done" if p >= 1 else "working", t, self.pal_full,
                                   look=(-1.0 + p, 0.0), scale=1.0, facing=-1 if p < 1 else 1)
        except Exception:
            pass

    def overlay(self, cr, w, h, t):
        # líneas de escaneo y una banda de luz que baja despacio
        cr.set_source_rgba(0, 0, 0, 0.10)
        for y in range(0, int(h), 3):
            cr.rectangle(0, y, w, 1)
        cr.fill()
        import cairo
        by = ((t * 0.16) % 1.3 - 0.15) * h
        g = cairo.LinearGradient(0, by - h * 0.08, 0, by + h * 0.08)
        g.add_color_stop_rgba(0, 1, 1, 1, 0.0)
        g.add_color_stop_rgba(0.5, 1, 1, 1, 0.035)
        g.add_color_stop_rgba(1, 1, 1, 1, 0.0)
        cr.set_source(g)
        cr.rectangle(0, by - h * 0.08, w, h * 0.16)
        cr.fill()
        # viñeta
        v = cairo.RadialGradient(w / 2, h * 0.5, h * 0.35, w / 2, h * 0.5, h * 0.95)
        v.add_color_stop_rgba(0, 0, 0, 0, 0.0)
        v.add_color_stop_rgba(1, 0, 0, 0, 0.55)
        cr.set_source(v)
        cr.rectangle(0, 0, w, h)
        cr.fill()

    # --- cuadro completo ----------------------------------------------------
    def draw(self, cr, w, h, t, skip_t=None):
        import cairo
        if skip_t is not None:                       # al saltar, se acelera hasta el desvanecido final
            t = max(t, DURATION - SKIP_FADE) + (t - skip_t) * 0.0
        hor = h * 0.62
        cr.push_group()
        cr.set_source_rgb(*self.pal["BG"])
        cr.paint()
        self.sky(cr, w, h, hor, t)
        self.sun(cr, w, h, hor, t)
        # suelo bajo el horizonte
        cr.set_source_rgba(0, 0, 0, 0.55 * seg(t, 0.5, 1.5))
        cr.rectangle(0, hor, w, h - hor)
        cr.fill()
        self.grid(cr, w, h, hor, t)
        self.horizon(cr, w, h, hor, t)
        self.title(cr, w, h, t)
        self.subtitle(cr, w, h, t)
        self.mascot(cr, w, h, t)
        self.overlay(cr, w, h, t)
        # pista para saltar
        if 1.0 < t < DURATION - 0.8:
            cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            cr.set_font_size(h * 0.016)
            msg = "clic para saltar"
            ext = cr.text_extents(msg)
            cr.set_source_rgba(*self.pal["DIM"], 0.55)
            cr.move_to(w / 2 - ext.x_advance / 2, h - h * 0.03)
            cr.show_text(msg)
        cr.pop_group_to_source()
        fade = 1.0 - seg(t, DURATION - 0.8, DURATION)    # el escritorio se revela
        cr.paint_with_alpha(clamp(fade))


def make_scene():
    pal = load_palette()
    buddy = load_buddy()
    sc = Scene(pal, buddy)
    # el personajito necesita la paleta completa de sus colores
    try:
        sc.pal_full = buddy.load_palette() if buddy else pal
    except Exception:
        sc.pal_full = pal
    return sc


# ----------------------------------------------------------------------------- ejecución


def start_sound():
    """Reproduce el sonido de la entrada (sintetizado, sincronizado con la animación). Devuelve el proceso o None."""
    import subprocess

    try:
        mode = (Path.home() / ".config/hyprarch/intro").read_text().strip().lower()
    except OSError:
        mode = ""
    f = Path("/usr/share/hyprarch/sounds/intro.wav")
    if mode == "mute" or (Path.home() / ".cache/hyprarch-buddy/mute").exists() or not f.exists():
        return None
    for player in (["pw-play"], ["paplay"], ["aplay", "-q"]):
        try:
            return subprocess.Popen(player + [str(f)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            continue
    return None


def run(once=False):
    if once:
        marker = Path(f"/tmp/.hyprarch-intro-{os.getuid()}")
        if marker.exists():
            return 0
        try:
            marker.write_text("1")
        except OSError:
            pass
    try:
        if (Path.home() / ".config/hyprarch/intro").read_text().strip().lower() in ("off", "no", "0"):
            return 0
    except OSError:
        pass

    import atexit
    import gi

    # el personajito del escritorio se esconde mientras la entrada trae el suyo (solo puede haber uno a la vez)
    ovl = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hyprarch-overlay.pid"
    try:
        ovl.write_text(str(os.getpid()))
        atexit.register(lambda: ovl.exists() and ovl.read_text().strip() == str(os.getpid()) and ovl.unlink())
    except OSError:
        pass

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import GLib, Gtk, Gtk4LayerShell as LS

    scene = make_scene()
    S = {"t0": None, "skip": None, "snd": None}
    app = Gtk.Application(application_id="local.hyprarch.intro")

    def on_activate(app):
        win = Gtk.ApplicationWindow(application=app)
        win.set_decorated(False)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(win, edge, True)
        LS.set_exclusive_zone(win, -1)
        LS.set_namespace(win, "hyprarch-intro")
        LS.set_keyboard_mode(win, LS.KeyboardMode.ON_DEMAND)
        area = Gtk.DrawingArea()
        win.set_child(area)
        css = Gtk.CssProvider()
        css.load_from_data(b"window, window.background { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(win.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def draw(_a, cr, w, h):
            if S["t0"] is None:
                S["t0"] = time.time()
                S["snd"] = start_sound()           # el sonido arranca con el primer cuadro
            t = time.time() - S["t0"]
            try:
                import cairo
                cr.set_operator(cairo.OPERATOR_CLEAR)
                cr.paint()
                cr.set_operator(cairo.OPERATOR_OVER)
                scene.draw(cr, w, h, t, S["skip"])
            except Exception:
                pass

        area.set_draw_func(draw)

        def skip(*_):
            if S["t0"] is not None and S["skip"] is None:
                S["skip"] = time.time() - S["t0"]
                S["t0"] = time.time() - (DURATION - SKIP_FADE)   # salta directo al desvanecido
                if S["snd"] is not None:                          # y corta el sonido
                    try:
                        S["snd"].terminate()
                    except OSError:
                        pass

        click = Gtk.GestureClick()
        click.connect("pressed", skip)
        area.add_controller(click)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda *a: skip())
        win.add_controller(keys)

        def tick():
            if S["t0"] is not None and time.time() - S["t0"] > DURATION:
                app.quit()
                return False
            area.queue_draw()
            return True

        GLib.timeout_add(16, tick)
        win.present()

    app.connect("activate", on_activate)
    app.run(None)
    return 0


def render_frames(outdir):
    import cairo

    out = Path(outdir)
    out.mkdir(parents=True, exist_ok=True)
    sc = make_scene()
    for name, t in (("a-horizonte", 0.5), ("b-rejilla", 1.5), ("c-sol", 2.4), ("d-titulo", 3.0),
                    ("e-subtitulo", 3.8), ("f-claudito", 4.7), ("g-final", 5.9)):
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1280, 720)
        cr = cairo.Context(surf)
        cr.set_source_rgb(0.03, 0.03, 0.03)   # "escritorio" de ejemplo detrás del desvanecido
        cr.paint()
        sc.draw(cr, 1280, 720, t)
        path = out / f"{name}.png"
        surf.write_to_png(str(path))
        print(path)
    return 0


if __name__ == "__main__":
    args = sys.argv[1:]
    if args and args[0] == "frames":
        sys.exit(render_frames(args[1] if len(args) > 1 else "frames"))
    sys.exit(run(once="--once" in args))
