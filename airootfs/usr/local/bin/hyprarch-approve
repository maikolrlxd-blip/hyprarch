#!/usr/bin/env python3
"""hyprarch-approve — la isla de Hyro: te pregunta antes de que la IA haga algo.

Lo llama Claude Code como «hook» PermissionRequest: recibe por la entrada estándar qué quiere hacer la IA,
muestra una isla animada arriba, centrada, con Hyro, y devuelve tu decisión.

Reglas de seguridad (no se negocian):
  · NUNCA aprueba solo: permitir exige un CLIC tuyo (ninguna tecla permite; Esc rechaza).
  · Si algo falla, no hay pantalla o pasa el tiempo (2 min), sale sin decidir y Claude pregunta como siempre.
  · No guarda ni envía nada a ningún sitio.

Prueba a mano:  echo '{"tool_name":"Bash","tool_input":{"command":"ls"}}' | hyprarch-approve
"""
import json
import math
import os
import subprocess
import sys
import time

TIMEOUT_S = 120

if "gtk4-layer-shell" not in os.environ.get("LD_PRELOAD", ""):      # se relanza solo con el entorno correcto
    env = dict(os.environ)
    env["LD_PRELOAD"] = (env.get("LD_PRELOAD", "") + " /usr/lib/libgtk4-layer-shell.so").strip()
    env["GSK_RENDERER"] = "cairo"
    try:
        os.execvpe(sys.executable, [sys.executable] + sys.argv, env)
    except OSError:
        sys.exit(0)

try:
    payload = json.loads(sys.stdin.read() or "{}")
except ValueError:
    payload = {}

try:
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gdk, GLib, Gtk, Gtk4LayerShell as LS
except Exception:
    sys.exit(0)                                   # sin pantalla: Claude pregunta como siempre

if not os.environ.get("WAYLAND_DISPLAY"):
    sys.exit(0)

PAD = 20                                          # margen transparente alrededor: aquí se dibuja la sombra
PILL_W, PILL_H = 600, 112
WIN_W, WIN_H = PILL_W + 2 * PAD, PILL_H + 2 * PAD
TOP = 40                                          # justo bajo la barra (la isla empieza en TOP + PAD)
SOUNDS = "/usr/share/hyprarch/sounds"

TOOL = str(payload.get("tool_name") or "una acción")
INP = payload.get("tool_input") or {}
def _chars(v):
    return len(v) if isinstance(v, str) else 0


if isinstance(INP, dict):
    if TOOL == "Bash" and INP.get("command"):
        # los saltos de línea NO se esconden: cada uno se ve como « ¶ » (un comando de varias líneas no puede parecer uno solo)
        DETAIL = str(INP["command"]).strip().replace("\r", "").replace("\n", " ¶ ")
    elif TOOL == "Write" and INP.get("file_path"):
        DETAIL = f"{INP['file_path']}  ({_chars(INP.get('content'))} caracteres)"
    elif TOOL == "Edit" and INP.get("file_path"):
        DETAIL = f"{INP['file_path']}  (cambia {_chars(INP.get('old_string'))} por {_chars(INP.get('new_string'))} caracteres)"
    else:
        DETAIL = (INP.get("command") or INP.get("file_path") or INP.get("path") or INP.get("url")
                  or INP.get("pattern") or json.dumps(INP, ensure_ascii=False))
else:
    DETAIL = str(INP)
DETAIL = str(DETAIL)
# al pasar el ratón se ve la petición COMPLETA, con los caracteres de control escapados (nada queda oculto)
FULL = json.dumps(INP, ensure_ascii=True, indent=1)[:1800]

VERBS = {"Bash": "ejecutar un comando", "Write": "crear un archivo", "Edit": "modificar un archivo",
         "Read": "leer un archivo", "WebFetch": "abrir una página", "WebSearch": "buscar en internet"}
TITLE = VERBS.get(TOOL, f"usar {TOOL}")

CSS = b"""
window { background: transparent; }
.pill { background-color: rgba(8, 12, 18, 0.97);
        background-image: radial-gradient(circle at 92% 125%, rgba(255, 170, 60, 0.34), rgba(255, 170, 60, 0.0) 62%),
                          linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.0) 38%);
        border: 1px solid rgba(255, 255, 255, 0.10); border-radius: 26px; padding: 14px 18px 14px 12px;
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.60), 0 2px 6px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.10); }
.title { color: #9aa9b1; font-size: 12px; }
.title b { color: #ffffff; font-weight: 700; }
.dot { color: #ffb347; font-size: 9px; }
.detail { color: #f1f6f8; font-family: monospace; font-size: 12.5px; background: rgba(255,255,255,0.075);
          border: 1px solid rgba(255,255,255,0.06); border-radius: 11px; padding: 6px 11px; }
.key { color: #7d8f97; font-size: 10px; background: rgba(255,255,255,0.09); border-radius: 5px; padding: 0 5px; margin-left: 4px; }
button { border: none; border-radius: 999px; padding: 6px 16px; font-weight: 600; font-size: 12.5px; min-height: 0;
         transition: background 140ms ease-out, color 140ms ease-out, box-shadow 140ms ease-out; }
button.deny { background: rgba(255, 255, 255, 0.075); color: #d3dce0; }
button.deny:hover { background: rgba(255, 90, 110, 0.88); color: #ffffff; box-shadow: 0 4px 14px rgba(255, 90, 110, 0.45); }
.allow { background: #ffffff; color: #0a0f14; padding: 6px 22px; border-radius: 999px; font-weight: 600; font-size: 12.5px;
         box-shadow: 0 3px 12px rgba(255, 255, 255, 0.18); transition: background 140ms ease-out, box-shadow 140ms ease-out; }
.allow:hover { background: #5ef2c8; box-shadow: 0 5px 18px rgba(94, 242, 200, 0.55); }
button:active { background: #cfd8dc; }
"""

# estado compartido con el dibujo del personaje
ST = {"look": 0.0, "mood": "normal", "t0": time.monotonic()}


def ease_out_back(x):
    c1, c3 = 1.70158, 2.70158
    return 1 + c3 * (x - 1) ** 3 + c1 * (x - 1) ** 2


def play(name):
    """Sonido suave (si hay reproductor); nunca bloquea ni falla."""
    path = os.path.join(SOUNDS, name)
    if not os.path.exists(path):
        return
    for cmd in (["pw-play", "--volume", "0.6", path], ["paplay", path]):
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except OSError:
            continue


def draw_face(_area, cr, w, h):
    """Hyro vivo: flota, parpadea, la antena se mueve y los ojos miran el botón que tocas."""
    t = time.monotonic() - ST["t0"]
    cx, cy = w / 2, h / 2 + 4
    r = min(w, h) * 0.30
    bob = 2.4 * math.sin(t * 2.4)
    tilt = math.radians(3.0 * math.sin(t * 1.7))
    mood = ST["mood"]
    glow = (1.0, 0.68, 0.26) if mood != "deny" else (1.0, 0.35, 0.43)
    if mood == "allow":
        glow = (0.37, 0.95, 0.78)

    # brillo que respira detrás de la cabeza
    pulse = 0.22 + 0.10 * math.sin(t * 2.0)
    g = __import__("cairo").RadialGradient(cx, cy + bob, r * 0.4, cx, cy + bob, min(w, h) / 2 - 1)   # nunca más grande que el lienzo: si no, se ve un cuadrado
    g.add_color_stop_rgba(0, glow[0], glow[1], glow[2], pulse)
    g.add_color_stop_rgba(1, glow[0], glow[1], glow[2], 0)
    cr.set_source(g)
    cr.paint()

    # sombra en el suelo (profundidad): se achica cuando sube
    cr.save()
    cr.translate(cx, h - 7)
    cr.scale(1.0, 0.22)
    sh = 1.0 - 0.10 * math.sin(t * 2.4)
    cr.arc(0, 0, r * 0.95 * sh, 0, 2 * math.pi)
    cr.set_source_rgba(0, 0, 0, 0.45)
    cr.fill()
    cr.restore()

    cr.save()
    cr.translate(cx, cy + bob)
    cr.rotate(tilt)
    # antena: se mece
    sway = math.radians(9 * math.sin(t * 3.1))
    cr.save()
    cr.translate(r * 0.30, -r * 0.88)
    cr.rotate(sway)
    cr.set_source_rgb(0.37, 0.95, 0.78)
    cr.move_to(-r * 0.05, 0)
    cr.line_to(r * 0.60, -r * 0.62)
    cr.line_to(r * 0.52, r * 0.16)
    cr.close_path()
    cr.fill()
    cr.restore()
    # casco (octógono) con degradado y brillo
    cr.new_path()
    for i in range(8):
        a = math.radians(22.5 + 45 * i)
        (cr.move_to if i == 0 else cr.line_to)(r * math.cos(a), r * math.sin(a))
    cr.close_path()
    lg = __import__("cairo").LinearGradient(0, -r, 0, r)
    lg.add_color_stop_rgb(0, 0.10, 0.16, 0.22)
    lg.add_color_stop_rgb(1, 0.03, 0.06, 0.09)
    cr.set_source(lg)
    cr.fill_preserve()
    cr.set_source_rgb(0.37, 0.95, 0.78)
    cr.set_line_width(2.2)
    cr.set_line_join(1)
    cr.stroke()
    cr.set_source_rgba(1, 1, 1, 0.16)                       # reflejo arriba a la izquierda
    cr.set_line_width(1.6)
    cr.move_to(-r * 0.62, -r * 0.55)
    cr.line_to(-r * 0.25, -r * 0.84)
    cr.stroke()
    # visor
    vw, vh = r * 1.30, r * 0.58
    cr.set_source_rgb(0.015, 0.03, 0.05)
    x0, y0 = -vw / 2, -vh / 2 + 1
    rad = vh * 0.28
    cr.new_sub_path()
    cr.arc(x0 + vw - rad, y0 + rad, rad, -math.pi / 2, 0)
    cr.arc(x0 + vw - rad, y0 + vh - rad, rad, 0, math.pi / 2)
    cr.arc(x0 + rad, y0 + vh - rad, rad, math.pi / 2, math.pi)
    cr.arc(x0 + rad, y0 + rad, rad, math.pi, 3 * math.pi / 2)
    cr.close_path()
    cr.fill()
    # ojos: parpadeo cada ~3 s y miran hacia el botón
    phase = t % 3.3
    blink = 0.12 if phase > 3.18 else 1.0
    look = ST["look"] * r * 0.16
    ew, eh = r * 0.20, r * 0.24 * blink
    if mood == "allow":
        cr.set_source_rgb(0.55, 1.0, 0.85)
        eh = r * 0.14
    elif mood == "deny":
        cr.set_source_rgb(1.0, 0.55, 0.62)
    else:
        cr.set_source_rgb(0.80, 1.0, 0.95)
    for dx in (-r * 0.30, r * 0.30):
        cr.rectangle(dx + look - ew / 2, 1 - eh / 2, ew, eh)
        cr.fill()
    cr.restore()

    # insignia de aviso: rebota
    s = 1.0 + 0.16 * max(0.0, math.sin(t * 4.6))
    bx, by = 10, 12
    cr.save()
    cr.translate(bx, by)
    cr.scale(s, s)
    cr.arc(0, 0, 8.5, 0, 2 * math.pi)
    cr.set_source_rgb(1.0, 0.70, 0.28)
    cr.fill()
    cr.set_source_rgb(0.1, 0.07, 0.02)
    cr.rectangle(-1, -4.6, 2, 5.6)
    cr.fill()
    cr.rectangle(-1, 2.4, 2, 2)
    cr.fill()
    cr.restore()


def say(behavior, message=None):
    d = {"behavior": behavior}
    if message:
        d["message"] = message
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": d}}), flush=True)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=None)
        self.decided = False
        self.win = None
        self.face = None

    # ---- decisión: se responde YA y después se anima la salida ----
    def decide(self, behavior):
        if self.decided:
            return
        self.decided = True
        if behavior == "allow":
            say("allow")
            play("menu-select.wav")
        elif behavior == "deny":
            say("deny", "La persona rechazó esta acción desde Hyro.")
            play("menu-select.wav")
        self.animate_out()

    def animate_out(self):
        t0 = time.monotonic()
        mon_y = TOP

        def step():
            k = min(1.0, (time.monotonic() - t0) / 0.20)
            self.win.set_opacity(1.0 - k)
            LS.set_margin(self.win, LS.Edge.TOP, int(mon_y - 26 * k))
            if k >= 1.0:
                self.quit()
                return False
            return True
        GLib.timeout_add(16, step)

    def animate_in(self):
        t0 = time.monotonic()
        start = 0

        def step():
            k = min(1.0, (time.monotonic() - t0) / 0.42)
            e = ease_out_back(k)
            self.win.set_opacity(min(1.0, k * 2.4))
            LS.set_margin(self.win, LS.Edge.TOP, int(max(0, start + (TOP - start) * e)))
            return k < 1.0
        GLib.timeout_add(16, step)

    def do_activate(self):
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=self)
        self.win = win
        win.set_default_size(WIN_W, WIN_H)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_anchor(win, LS.Edge.TOP, True)
        LS.set_exclusive_zone(win, -1)               # sin anclar a izquierda/derecha: layer-shell la centra
        LS.set_namespace(win, "hyprarch-approve")
        LS.set_keyboard_mode(win, LS.KeyboardMode.ON_DEMAND)
        LS.set_margin(win, LS.Edge.TOP, 0)
        win.set_opacity(0.0)

        wrap = Gtk.Box()
        wrap.set_margin_start(PAD)
        wrap.set_margin_end(PAD)
        wrap.set_margin_top(PAD)
        wrap.set_margin_bottom(PAD)
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        outer.add_css_class("pill")
        outer.set_size_request(PILL_W, -1)
        face = Gtk.DrawingArea()
        face.set_content_width(88)
        face.set_content_height(84)
        face.set_valign(Gtk.Align.CENTER)
        face.set_draw_func(draw_face)
        self.face = face
        outer.append(face)

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        col.set_hexpand(True)
        col.set_valign(Gtk.Align.CENTER)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        dot = Gtk.Label(label="●")
        dot.add_css_class("dot")
        t = Gtk.Label(xalign=0.0)
        t.set_markup(f"<b>Claude</b>  necesita permiso para {GLib.markup_escape_text(TITLE)}")
        t.add_css_class("title")
        t.set_hexpand(True)
        head.append(dot)
        head.append(t)

        d = Gtk.Label(label=DETAIL, xalign=0.0, ellipsize=3)            # una sola línea con «…» al final
        d.add_css_class("detail")
        d.set_tooltip_text(FULL)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        deny = Gtk.Button(label="Rechazar")
        deny.add_css_class("deny")
        deny.connect("clicked", lambda _b: self.decide("deny"))
        # «Permitir» NO es un botón: un botón se activa también con el teclado (Espacio o Enter con el foco). Esto es una etiqueta
        # que solo reacciona a un clic del puntero dentro de su área: ninguna tecla puede aprobar.
        allow = Gtk.Label(label="Permitir")
        allow.add_css_class("allow")
        tap = Gtk.GestureClick()
        tap.set_button(1)

        def on_tap(_g, _n, x, y):
            inside = 0 <= x < allow.get_width() and 0 <= y < allow.get_height()
            if inside and time.monotonic() - self.shown_at > 0.45:        # ignora un clic justo al aparecer la tarjeta
                self.decide("allow")
        tap.connect("released", on_tap)
        allow.add_controller(tap)
        # los ojos de Hyro miran el botón sobre el que está el ratón
        for btn, look, mood in ((deny, -1.0, "deny"), (allow, 1.0, "allow")):
            m = Gtk.EventControllerMotion()
            m.connect("enter", lambda *_a, lk=look, md=mood: ST.update(look=lk, mood=md))
            m.connect("leave", lambda *_a: ST.update(look=0.0, mood="normal"))
            btn.add_controller(m)
        esc = Gtk.Label(label="Esc")
        esc.add_css_class("key")
        esc.set_tooltip_text("Esc rechaza. Para permitir hay que hacer clic.")
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        row.append(deny)
        row.append(esc)
        row.append(spacer)
        row.append(allow)

        for w in (head, d, row):
            col.append(w)
        outer.append(col)
        wrap.append(outer)
        win.set_child(wrap)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)          # antes que los botones
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)
        self.shown_at = time.monotonic()
        win.present()
        play("menu-open.wav")
        self.animate_in()
        GLib.timeout_add(40, lambda: (self.face.queue_draw(), True)[1])      # ~25 cuadros/s para el personaje
        GLib.timeout_add_seconds(TIMEOUT_S, lambda: (self.timeout(), False)[1])

    def timeout(self):
        if not self.decided:
            self.decided = True              # sin respuesta: que pregunte Claude
            self.animate_out()

    def on_key(self, _c, keyval, _code, _state):
        # Permitir SOLO con clic: un Enter perdido mientras escribes en otra ventana no puede aprobar nada.
        if keyval == Gdk.KEY_Escape:
            self.decide("deny")
        return True


if __name__ == "__main__":
    try:
        App().run([])
    except Exception:
        pass
    sys.exit(0)
