{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window",
    "custom/close"
  ],
  "modules-center": ["clock", "custom/sys"],
  "modules-right": [
    "custom/claude",
    "tray",
    "hyprland/language",
    "group/sistema",
    "group/conex",
    "battery",
    "custom/theme",
    "custom/help",
    "custom/power"
  ],

  "group/sistema": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"]
  },

  "group/conex": {
    "orientation": "horizontal",
    "modules": ["network", "bluetooth", "pulseaudio", "backlight"]
  },

  "custom/sys": {
    "exec": "hyprarch-sysstate",
    "return-type": "json",
    "interval": 3,
    "tooltip": true
  },

  "custom/launcher": {
    "format": "",
    "tooltip-format": "Aplicaciones (SUPER + D)",
    "tooltip": true,
    "on-click": "fuzzel"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true
  },

  "custom/close": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Cerrar ventana activa (SUPER + Q)",
    "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
  },

  "hyprland/language": {
    "format": " {shortDescription}"
  },

  "clock": {
    "format": "{:%a %d %b   %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<span color='#ffffff'><b>{}</b></span>"
      }
    }
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "states": { "warning": 70, "critical": 90 },
    "tooltip": true,
    "on-click": "$HOME/.config/hypr/scripts/once.sh hyprarch-btop btop"
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 3,
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "$HOME/.config/hypr/scripts/once.sh hyprarch-btop btop"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },

  "network": {
    "interval": 3,
    "format-wifi": " {essid} {signalStrength}%",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": " sin red",
    "tooltip-format": "{ifname}  {ipaddr}\n↑ {bandwidthUpBytes}  ↓ {bandwidthDownBytes}",
    "on-click": "$HOME/.config/hypr/scripts/once.sh hyprarch-nmtui nmtui"
  },

  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-off": "",
    "format-disabled": "",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " mute",
    "format-icons": { "default": ["", ""] },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl -q set 5%+",
    "on-scroll-down": "brightnessctl -q set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  },

  "tray": {
    "spacing": 8
  },

  "custom/claude": {
    "exec": "claude-presence status",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "kitty --class claude-code -e claude"
  },

  "custom/theme": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Cambiar colores (SUPER + T)",
    "on-click": "$HOME/.config/hypr/scripts/once.sh hyprarch-theme hyprarch-theme"
  },

  "custom/help": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Atajos de teclado (SUPER + F1)",
    "on-click": "$HOME/.config/hypr/scripts/keybinds.sh"
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Energía (SUPER + Esc)",
    "on-click": "$HOME/.config/hypr/scripts/powermenu.sh"
  }
}
