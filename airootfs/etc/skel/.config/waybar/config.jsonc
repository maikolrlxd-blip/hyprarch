{
  // Barra de tareas estilo Windows, abajo: espacios a la izquierda, inicio y apps abiertas CENTRADAS, bandeja y reloj a la derecha.
  // Arriba queda libre para la isla de Hyro (hyprarch-island), que cuelga del borde superior.
  "layer": "top",
  "position": "bottom",
  "height": 50,
  "margin-bottom": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  "modules-left": [
    "group/workspaces",
    "custom/ws-events"
  ],
  "modules-center": [
    "custom/launcher",
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray",
    "hyprland/language",
    "group/sistema",
    "group/conex",
    "battery",
    "custom/theme",
    "custom/control",
    "clock",
    "custom/power"
  ],

  // Centro de control (Wi-Fi, volumen, brillo, modos, notificaciones): se abre aquí o con SUPER + X
  "custom/control": {
    "format": "",
    "tooltip-format": "Centro de control (SUPER + X)",
    "tooltip": true,
    "on-click": "hyprarch-control"
  },

  // Apps abiertas, como la barra de Windows: clic = abrir/traer, clic central = cerrar
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["local.hyprarch.claudepresence"]
  },

  "group/sistema": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"]
  },

  "group/conex": {
    "orientation": "horizontal",
    "modules": ["network", "bluetooth", "pulseaudio", "backlight"]
  },

  "custom/sys": {
    "exec": "hyprarch-sysstate",
    "return-type": "json",
    "interval": 3,
    "tooltip": true
  },

  "custom/launcher": {
    "format": "",
    "tooltip-format": "Inicio (tecla Super)",
    "tooltip": true,
    "on-click": "hyprarch-start"
  },

  // Espacios de trabajo: el módulo hyprland/workspaces de Waybar 0.15 no puede cambiar de espacio con
  // Hyprland en Lua (manda "dispatch workspace N", que ya no es válido). Se usan 5 botones propios;
  // un script oculto (custom/ws-events) escucha los eventos de Hyprland y avisa a Waybar con RTMIN+8.
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"]
  },

  "custom/ws-events": {
    "exec": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" watch",
    "return-type": "json",
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "restart-interval": 2
  },

  "custom/ws1": { "exec": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" show 1", "return-type": "json", "format": "{text}", "signal": 8, "exec-on-event": false, "on-click": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" focus 1" },
  "custom/ws2": { "exec": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" show 2", "return-type": "json", "format": "{text}", "signal": 8, "exec-on-event": false, "on-click": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" focus 2" },
  "custom/ws3": { "exec": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" show 3", "return-type": "json", "format": "{text}", "signal": 8, "exec-on-event": false, "on-click": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" focus 3" },
  "custom/ws4": { "exec": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" show 4", "return-type": "json", "format": "{text}", "signal": 8, "exec-on-event": false, "on-click": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" focus 4" },
  "custom/ws5": { "exec": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" show 5", "return-type": "json", "format": "{text}", "signal": 8, "exec-on-event": false, "on-click": "exec bash \"$HOME/.config/waybar/hyprarch-workspaces\" focus 5" },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true
  },

  "custom/close": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Cerrar ventana activa (SUPER + Q)",
    "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
  },

  "hyprland/language": {
    "format": " {shortDescription}"
  },

  "clock": {
    "format": "{:%a %d %b   %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<span color='#ffffff'><b>{}</b></span>"
      }
    }
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "states": { "warning": 70, "critical": 90 },
    "tooltip": true,
    "on-click": "$HOME/.config/hypr/scripts/once.sh hyprarch-btop btop"
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 3,
    "states": { "warning": 85, "critical": 95 },
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "$HOME/.config/hypr/scripts/once.sh hyprarch-btop btop"
  },

  "temperature": {
    "warning-threshold": 80,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },

  "network": {
    "interval": 3,
    "format-wifi": " {essid} {signalStrength}%",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": " sin red",
    "format-linked": "sin IP",
    "format-disabled": "red desactivada",
    "tooltip-format": "{ifname}  {ipaddr}\n↑ {bandwidthUpBytes}  ↓ {bandwidthDownBytes}",
    "on-click": "hyprarch-wifi"
  },

  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-off": "",
    "format-disabled": "",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " mute",
    "format-icons": { "default": ["", ""] },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl -q set 5%+",
    "on-scroll-down": "brightnessctl -q set 5%-"
  },

  "battery": {
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  },

  "tray": {
    "spacing": 8
  },

  "custom/claude": {
    "exec": "claude-presence status",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "hyprarch-ai open float",
    "on-click-right": "hyprarch-ai open full"
  },

  "custom/theme": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Cambiar colores (SUPER + T)",
    "on-click": "hyprarch-theme"
  },

  "custom/help": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Atajos de teclado (SUPER + F1)",
    "on-click": "$HOME/.config/hypr/scripts/keybinds.sh"
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Energía (SUPER + Esc)",
    "on-click": "$HOME/.config/hypr/scripts/powermenu.sh"
  }
}
